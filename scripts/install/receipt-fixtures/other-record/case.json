{
  "about": "A record that is neither the version file nor the receipt. The installers remove it if its SHA-256 matches; oskac, which computes no SHA-256, cannot tell it is unchanged and keeps it.",
  "setup": [
    {
      "name": "notes",
      "path": "@OSKA_HOME@/notes.txt",
      "text": "notes\n"
    }
  ],
  "expect": {
    "sh": {
      "removed": [
        "@EXE@",
        "@OSKA_HOME@/version",
        "@OSKA_HOME@/notes.txt",
        "@OSKA_HOME@/receipt.json",
        "@BIN@",
        "@OSKA_HOME@"
      ],
      "kept": [],
      "path_hint": false
    },
    "ps1": {
      "removed": [
        "@EXE@",
        "@OSKA_HOME@/version",
        "@OSKA_HOME@/notes.txt",
        "@OSKA_HOME@/receipt.json",
        "@BIN@",
        "@OSKA_HOME@"
      ],
      "kept": [],
      "path_hint": false
    },
    "oskac_unix": {
      "removed": [
        "@EXE@",
        "@OSKA_HOME@/version",
        "@OSKA_HOME@/receipt.json",
        "@BIN@"
      ],
      "kept": [
        "@OSKA_HOME@/notes.txt",
        "@OSKA_HOME@"
      ],
      "path_hint": false
    },
    "oskac_windows": {
      "removed": [
        "@EXE@",
        "@OSKA_HOME@/version",
        "@OSKA_HOME@/receipt.json",
        "@BIN@"
      ],
      "kept": [
        "@OSKA_HOME@/notes.txt",
        "@OSKA_HOME@"
      ],
      "path_hint": false
    }
  }
}
