{
  "about": "An object that repeats a key refuses the whole uninstall: which value counts is not certain.",
  "setup": [
    {
      "name": "victim",
      "path": "@HOME@/victim",
      "text": "victim\n"
    }
  ],
  "expect": {
    "sh": {
      "refused": "unsafe_path"
    },
    "ps1": {
      "refused": "unsafe_path"
    },
    "oskac_unix": {
      "refused": "unsafe_path"
    },
    "oskac_windows": {
      "refused": "unsafe_path"
    }
  }
}
