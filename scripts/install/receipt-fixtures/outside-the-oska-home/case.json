{
  "about": "A record outside the Oska home refuses the whole uninstall, even with a matching SHA-256.",
  "setup": [
    {
      "name": "victim",
      "path": "@HOME@/victim",
      "text": "victim\n"
    }
  ],
  "expect": {
    "sh": {
      "refused": "unsafe_path"
    },
    "ps1": {
      "refused": "unsafe_path"
    },
    "oskac_unix": {
      "refused": "unsafe_path"
    },
    "oskac_windows": {
      "refused": "unsafe_path"
    }
  }
}
