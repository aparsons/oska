{
  "about": "The receipt's binary is not the oskac that runs the uninstall. The installers remove it if its SHA-256 matches; oskac keeps every binary and record, as the install is not its own.",
  "setup": [
    {
      "name": "other",
      "path": "@BIN@/oskac-other",
      "text": "another oskac\n"
    }
  ],
  "expect": {
    "sh": {
      "removed": [
        "@BIN@/oskac-other",
        "@OSKA_HOME@/version",
        "@OSKA_HOME@/receipt.json"
      ],
      "kept": [
        "@BIN@",
        "@OSKA_HOME@"
      ],
      "path_hint": false
    },
    "ps1": {
      "removed": [
        "@BIN@/oskac-other",
        "@OSKA_HOME@/version",
        "@OSKA_HOME@/receipt.json"
      ],
      "kept": [
        "@BIN@",
        "@OSKA_HOME@"
      ],
      "path_hint": false
    },
    "oskac_unix": {
      "removed": [],
      "kept": [
        "@BIN@/oskac-other",
        "@OSKA_HOME@/version",
        "@OSKA_HOME@/receipt.json",
        "@BIN@",
        "@OSKA_HOME@"
      ],
      "path_hint": false
    },
    "oskac_windows": {
      "removed": [],
      "kept": [
        "@BIN@/oskac-other",
        "@OSKA_HOME@/version",
        "@OSKA_HOME@/receipt.json",
        "@BIN@",
        "@OSKA_HOME@"
      ],
      "path_hint": false
    }
  }
}
