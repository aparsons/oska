{
  "about": "A listed path that is a symlink refuses the whole uninstall, even when its target's SHA-256 matches.",
  "setup": [
    {
      "name": "victim",
      "path": "@HOME@/victim",
      "text": "victim\n"
    },
    {
      "path": "@OSKA_HOME@/link",
      "link_to": "@HOME@/victim"
    }
  ],
  "expect": {
    "sh": {
      "refused": "unsafe_path"
    },
    "ps1": {
      "refused": "unsafe_path"
    },
    "oskac_unix": {
      "refused": "unsafe_path"
    },
    "oskac_windows": {
      "refused": "unsafe_path"
    }
  }
}
