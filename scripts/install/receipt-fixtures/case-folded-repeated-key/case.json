{
  "about": "Keys that differ only in case count as repeated, as PowerShell cannot tell them apart: the whole uninstall is refused.",
  "setup": [
    {
      "name": "victim",
      "path": "@HOME@/victim",
      "text": "victim\n"
    }
  ],
  "expect": {
    "sh": {
      "refused": "unsafe_path"
    },
    "ps1": {
      "refused": "unsafe_path"
    },
    "oskac_unix": {
      "refused": "unsafe_path"
    },
    "oskac_windows": {
      "refused": "unsafe_path"
    }
  }
}
