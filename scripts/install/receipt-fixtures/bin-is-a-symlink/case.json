{
  "about": "A bin directory that is a symlink (not root's) refuses the whole uninstall.",
  "link_first": [
    {
      "path": "@BIN@",
      "link_to": "@HOME@/real-bin"
    }
  ],
  "expect": {
    "sh": {
      "refused": "unsafe_path"
    },
    "ps1": {
      "refused": "unsafe_path"
    },
    "oskac_unix": {
      "refused": "unsafe_path"
    },
    "oskac_windows": {
      "refused": "unsafe_path"
    }
  }
}
