{
  "about": "An Oska home that is itself a symlink (not root's) refuses the whole uninstall.",
  "link_first": [
    {
      "path": "@OSKA_HOME@",
      "link_to": "@HOME@/real-oska"
    }
  ],
  "expect": {
    "sh": {
      "refused": "unsafe_path"
    },
    "ps1": {
      "refused": "unsafe_path"
    },
    "oskac_unix": {
      "refused": "unsafe_path"
    },
    "oskac_windows": {
      "refused": "unsafe_path"
    }
  }
}
