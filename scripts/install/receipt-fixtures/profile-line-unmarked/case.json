{
  "about": "A profile line that is not the marked line the installer writes refuses the whole uninstall.",
  "setup": [
    {
      "path": "@HOME@/.profile",
      "text": "# mine\nrm -rf ~\n"
    }
  ],
  "expect": {
    "sh": {
      "refused": "unsafe_path"
    },
    "ps1": {
      "refused": "unsafe_path"
    },
    "oskac_unix": {
      "refused": "unsafe_path"
    },
    "oskac_windows": {
      "refused": "unsafe_path"
    }
  }
}
