{
  "about": "A record in a subdirectory other than bin refuses the whole uninstall.",
  "setup": [
    {
      "name": "sub",
      "path": "@OSKA_HOME@/sub/version",
      "text": "@VERSION@\n"
    }
  ],
  "expect": {
    "sh": {
      "refused": "unsafe_path"
    },
    "ps1": {
      "refused": "unsafe_path"
    },
    "oskac_unix": {
      "refused": "unsafe_path"
    },
    "oskac_windows": {
      "refused": "unsafe_path"
    }
  }
}
