# SPDX-License-Identifier: Apache-2.0
# The pinned Smallstep downloads of the live ACME test (#839): the version
# and the SHA-256 of each archive. run.sh refuses to run while a hash is
# UNSET or when a download does not match. Change them only with
# scripts/step-ca/pin.sh, then check the hashes against the checksums
# Smallstep publishes with the release.
STEP_CA_VERSION=UNSET
STEP_CA_SHA256=UNSET
STEP_CLI_VERSION=UNSET
STEP_CLI_SHA256=UNSET
