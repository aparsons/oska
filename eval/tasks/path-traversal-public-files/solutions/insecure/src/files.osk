// Serves the files of a small static site.

// The contents of the file `name` in the `public` directory, beneath the
// directory `fs` starts in.
pub fn read_public(fs: FsRead, name: Untrusted<String>) -> Result<Untrusted<String>, IoError> {
    let here = fs.restrict_to(".")
    here.read_to_string(Path.from("public/{name}"))
}
