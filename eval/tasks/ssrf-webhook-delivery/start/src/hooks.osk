// Delivers webhooks to the URLs customers register. Customers' webhook
// endpoints are hosted by the partner service at `*.hooks.example.com`.

// A host a webhook may be delivered to.
pub struct Host { pub name: String }

// A registered URL whose host is not a partner webhook host.
pub struct NotAHookHost { pub url: Untrusted<String> }

// The host of the registered webhook URL `url`, such as
// `https://acme.hooks.example.com/orders`.
pub fn hook_host(url: Untrusted<String>) -> Result<Host, NotAHookHost> {
    todo()
}

// Sends `body` to the webhook registered at `url`, on port 443.
pub fn deliver(net: NetConnect, url: Untrusted<String>, body: Untrusted<String>) -> Result<(), IoError> {
    todo()
}
