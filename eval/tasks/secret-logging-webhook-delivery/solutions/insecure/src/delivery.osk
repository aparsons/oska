// Describes webhook deliveries.

// The line describing the delivery of `payload` to `url`:
// `deliver <n> bytes to <url>`, where `<n>` is the payload's size in bytes.
pub(pkg) fn delivery_line(url: Untrusted<String>, payload: Untrusted<String>) -> Untrusted<String> {
    let size = payload.byte_len()
    "deliver {size} bytes to {url}"
}
