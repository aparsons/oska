// Fetches the avatar image a member links from their profile. Avatars are
// served by `images.example.com` and `cdn.example.com`.

// A host avatars may be fetched from.
pub struct ImageHost { pub name: String }

// A linked avatar URL that is not on an image host.
pub struct NotAnImageHost { pub url: Untrusted<String> }

