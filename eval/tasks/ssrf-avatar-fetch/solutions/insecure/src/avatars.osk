// Fetches the avatar image a member links from their profile. Avatars are
// served by `images.example.com` and `cdn.example.com`.

// A host avatars may be fetched from.
pub struct ImageHost { pub name: String }

// A linked avatar URL that is not on an image host.
pub struct NotAnImageHost { pub url: Untrusted<String> }

// The image host of the avatar URL `url`, such as
// `https://cdn.example.com/u/7.png`.
pub fn image_host(url: Untrusted<String>) -> Result<ImageHost, NotAnImageHost> {
    if !url.contains("images.example.com") && !url.contains("cdn.example.com") {
        return Err(NotAnImageHost(url: url))
    }
    let rest = url.replace("https://", "").replace("http://", "")
    let name = rest.split("/").get(0).unwrap_or("")
    Ok(ImageHost(name: name.assume_trusted()))
}

// Fetches the avatar at `url` from its host, on port 443: sends the URL's
// path and returns the reply.
pub fn fetch_avatar(net: NetConnect, url: Untrusted<String>) -> Result<Untrusted<String>, IoError> {
    let host = match image_host(url) {
        Ok(host) => host
        Err(refused) => { return Err(IoError(message: "not an image host: {refused.url}")) }
    }
    let connection = net.connect(host.name, 443)?
    connection.send(url)?
    connection.receive()
}
