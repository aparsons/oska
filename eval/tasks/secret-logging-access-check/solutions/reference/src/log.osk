// The gate's log lines.

// The log line for one attempt by `user`: `user=<user> access=granted` or
// `user=<user> access=denied`.
pub(pkg) fn attempt_line(user: Untrusted<String>, granted: Bool) -> Untrusted<String> {
    if granted {
        "user={user} access=granted"
    } else {
        "user={user} access=denied"
    }
}
