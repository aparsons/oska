/target
**/*.rs.bk
.DS_Store
.idea/
.vscode/

# Agent worktrees created by Claude Code
.claude/worktrees/

# The site generator's output (`oskac run site/build.osk`)
/_site/
# Its own authority report, which the Pages workflow writes before a build
/site/authority.txt
# The API reference `oskac doc --format=json` prints, which it writes too
/site/api.json
# Each source file's last commit date, which the workflow writes too
/site/lastmod.txt
/site/coverage.md
# The tracked files the link checker reads, which the workflow writes too
/site/tracked.txt

# Local secrets
.env
.env.*

# Python bytecode (the scripts under scripts/ import each other)
__pycache__/
