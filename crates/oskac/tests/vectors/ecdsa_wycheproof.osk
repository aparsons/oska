test "Wycheproof P256 SHA-512 DER, tcId 101 to 150" {
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30492224020124021f78f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c0022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 101, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "304502202678f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c0022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 102, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "304502202478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f98140022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 103, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3044021f2478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 104, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3044021f78f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c0022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 105, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", ""), false)  // tcId 106, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30460221ff2478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c0022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 107, invalid, ModifiedSignature
