    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k316(), "313233343030", "306502307ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffd023100b6b681dc484f4f020fd3f7e626d88edc6ded1b382ef3e143d60887b51394260832d4d8f2ef70458f9fa90e38c2e19e4f"), true)  // tcId 354, valid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k317(), "313233343030", "3006020102020101"), true)  // tcId 355, valid, SmallRandS
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k318(), "313233343030", "3006020102020102"), true)  // tcId 356, valid, SmallRandS
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k319(), "313233343030", "3006020102020103"), true)  // tcId 357, valid, SmallRandS
