    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k233(), "313233343030", "3035023055555555555555555555555555555555555555555555555542766f2b5167b9f51d5e0490c2e58d28f9a40878eeec6326020101"), true)  // tcId 405, valid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k233(), "313233343030", "3035023055555555555555555555555555555555555555555555555542766f2b5167b9f51d5e0490c2e58d28f9a40878eeec6326020100"), false)  // tcId 406, invalid, ArithmeticError
