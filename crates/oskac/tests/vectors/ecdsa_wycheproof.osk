test "Wycheproof P384 SHA-384 P1363, tcId 251 to 280" {
    t.assert_eq(run(ecdsa.Curve.P384, 384, false, k210(), "313233343030", "234503fcca578121986d96be07fbc8da5d894ed8588c6dbcdbe974b4b813b21c52d20a8928f2e2fdac14705b0705498ccd7b9b766b97b53d1a80fc0b760af16a11bf4a59c7c367c6c7275dfb6e18a88091eed3734bf5cf41b3dc6fecd6d3baaf"), true)  // tcId 251, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P384, 384, false, k210(), "0000000000000000000000000000000000000000", "5cad9ae1565f2588f86d821c2cc1b4d0fdf874331326568f5b0e130e4e0c0ec497f8f5f564212bd2a26ecb782cf0a18dbf2e9d0980fbb00696673e7fbb03e1f854b9d7596b759a17bf6e6e67a95ea6c1664f82dc449ae5ea779abd99c78e6840"), true)  // tcId 252, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P384, 384, false, k299(), "4d657373616765", "07648b6660d01ba2520a09d298adf3b1a02c32744bd2877208f5a4162f6c984373139d800a4cdc1ffea15bce4871a0ed99fd367012cb9e02cde2749455e0d495c52818f3c14f6e6aad105b0925e2a7290ac4a06d9fadf4b15b578556fe332a5f"), true)  // tcId 253, valid, EdgeCasePublicKey
