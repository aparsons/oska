    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "304902202478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c02280022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb20000"), false)  // tcId 135, invalid, InvalidEncoding
