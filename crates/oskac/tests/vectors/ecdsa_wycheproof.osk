    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "304402202478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c0022000a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34e"), false)  // tcId 147, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", ""), false)  // tcId 148, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "304602202478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c00222ff00a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 149, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "302502202478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c0090180"), false)  // tcId 150, invalid, ModifiedSignature
}

test "Wycheproof P256 SHA-512 DER, tcId 151 to 200" {
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "302502202478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c0020100"), false)  // tcId 151, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30460221012478f1cf49f6d858ac900a7af177222661ac95e206d32ee63020beee955ca711022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 152, invalid, RangeCheck
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30460221ff2478f1d149f6d856ac900a7af1772226e7dea086b8a3f1dc48ad29689c965c6f022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 153, invalid, RangeCheck
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3047022201002478f0d049f6d957ac900a7af17721e38bc048db775a1554f631b727fc1ed2c0022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 154, invalid, RangeCheck
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30450220db870e2fb60927a8536ff5850e88ddd95b3a64cba0446f9ec3990bd467067e40022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 155, invalid, ModifiedInteger
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3046022100db870e2eb60927a9536ff5850e88ddd918215f79475c0e23b752d6976369a391022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 156, invalid, ModifiedInteger
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30460221fedb870e30b60927a7536ff5850e88ddd99e536a1df92cd119cfdf41116aa358ef022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 157, invalid, ModifiedInteger
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30460221012478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c0022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 158, invalid, IntegerOverflow
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "304e02290100000000000000002478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c0022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 159, invalid, IntegerOverflow
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3046022101a07a59c3a41688548eb315e94effca0efd1ffe0a13467061783dde1cce167403022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 160, invalid, RangeCheck
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30450220a07a59c5a41688528eb315e94effca0f835208aec517335790ca4896d5502961022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 161, invalid, RangeCheck
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "304702220100a07a58c4a41689538eb315e94effc9cc2733b10383cd56d03e4ed65634d89fb2022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 162, invalid, RangeCheck
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30460221ff5f85a63b5be977ac714cea16b10035f0bfc6fca393d12e237b7beca62e4cb14e022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 163, invalid, ModifiedInteger
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30460221fe5f85a63c5be977ab714cea16b10035f102e001f5ecb98f9e87c221e331e98bfd022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 164, invalid, ModifiedInteger
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3046022101a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 165, invalid, IntegerOverflow
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30450220a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 166, invalid, IntegerOverflow
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "304e0229010000000000000000a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2022100a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 167, invalid, IntegerOverflow
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3006020100020100"), false)  // tcId 168, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3006020100020101"), false)  // tcId 169, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30060201000201ff"), false)  // tcId 170, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026020100022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"), false)  // tcId 171, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026020100022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632550"), false)  // tcId 172, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026020100022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632552"), false)  // tcId 173, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026020100022100ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"), false)  // tcId 174, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026020100022100ffffffff00000001000000000000000000000001000000000000000000000000"), false)  // tcId 175, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3006020101020100"), false)  // tcId 176, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3006020101020101"), false)  // tcId 177, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30060201010201ff"), false)  // tcId 178, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026020101022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"), false)  // tcId 179, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026020101022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632550"), false)  // tcId 180, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026020101022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632552"), false)  // tcId 181, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026020101022100ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"), false)  // tcId 182, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026020101022100ffffffff00000001000000000000000000000001000000000000000000000000"), false)  // tcId 183, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30060201ff020100"), false)  // tcId 184, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30060201ff020101"), false)  // tcId 185, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30060201ff0201ff"), false)  // tcId 186, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30260201ff022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"), false)  // tcId 187, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30260201ff022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632550"), false)  // tcId 188, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30260201ff022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632552"), false)  // tcId 189, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30260201ff022100ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"), false)  // tcId 190, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "30260201ff022100ffffffff00000001000000000000000000000001000000000000000000000000"), false)  // tcId 191, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551020100"), false)  // tcId 192, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551020101"), false)  // tcId 193, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc6325510201ff"), false)  // tcId 194, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3046022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"), false)  // tcId 195, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3046022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632550"), false)  // tcId 196, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3046022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632552"), false)  // tcId 197, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3046022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551022100ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"), false)  // tcId 198, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3046022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551022100ffffffff00000001000000000000000000000001000000000000000000000000"), false)  // tcId 199, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632550020100"), false)  // tcId 200, invalid, InvalidSignature
}

test "Wycheproof P256 SHA-512 DER, tcId 201 to 250" {
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632550020101"), false)  // tcId 201, invalid, InvalidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "3026022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc6325500201ff"), false)  // tcId 202, invalid, InvalidSignature
