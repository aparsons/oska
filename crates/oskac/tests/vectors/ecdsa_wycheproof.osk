    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k211(), "313233343030", "30660231ff12b30abef6b5476fe6b612ae557c0425661e26b44b1bfe1a138f7ca6eeda02a462743d328394f8b71dd11a2a25001f64023100e7bf25603e2d07076ff30b7a2abec473da8b11c572b35fc631991d5de62ddca7525aaba89325dfd04fecc47bff426f82"), false)  // tcId 153, invalid, RangeCheck
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k211(), "313233343030", "30670232010012b30abef6b5476fe6b612ae557c0425661e26b44b1bfde13e404c1d1a3f0fdbd49bfd2d7ced1b1ef6d69e61b6eebbd7023100e7bf25603e2d07076ff30b7a2abec473da8b11c572b35fc631991d5de62ddca7525aaba89325dfd04fecc47bff426f82"), false)  // tcId 154, invalid, RangeCheck
