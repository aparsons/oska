test "Wycheproof P256 SHA-256 DER, tcId 101 to 150" {
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "3049222402012b021fa3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 101, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "3045022029a3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 102, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "304502202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e98022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 103, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "3044021f2ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 104, invalid, ModifiedSignature
