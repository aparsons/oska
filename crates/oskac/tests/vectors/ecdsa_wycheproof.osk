    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k205(), "68656c6c6f2c20776f726c64", "3026020103022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254e"), true)  // tcId 549, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k206(), "68656c6c6f2c20776f726c64", "3026020104022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254e"), false)  // tcId 550, invalid, ArithmeticError
}

test "Wycheproof P256 SHA-512 DER, tcId 551 to 554" {
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k207(), "68656c6c6f2c20776f726c64", "303502104319055358e8617b0c46353d039cdab3022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254e"), false)  // tcId 551, invalid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k208(), "68656c6c6f2c20776f726c64", "3042021d00ffffffff00000000000000004319055258e8617b0c46353d039cdab4022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254e"), false)  // tcId 552, invalid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k209(), "68656c6c6f2c20776f726c64", "303502205f6d3aa0d327c13702513d4299f297ab182fcf670f96291fab19572e7a6e01c402110100000000000000000000000000000000"), true)  // tcId 553, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k209(), "68656c6c6f2c20776f726c64", "304502205f6d3aa0d327c13702513d4299f297ab182fcf670f96291fab19572e7a6e01c4022100ffffffff00000000fffffffffffffffebce6faada7179e84f3b9cac2fc632551"), true)  // tcId 554, valid, ValidSignature
}

test "Wycheproof P384 SHA-384 DER, tcId 1 to 50" {
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k210(), "", "3064023032401249714e9091f05a5e109d5c1216fdc05e98614261aa0dbd9e9cd4415dee29238afbd3b103c1e40ee5c9144aee0f02304326756fb2c4fd726360dd6479b5849478c7a9d054a833a58c1631c33b63c3441336ddf2c7fe0ed129aae6d4ddfeb753"), true)  // tcId 1, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k210(), "4d7367", "3066023100d7143a836608b25599a7f28dec6635494c2992ad1e2bbeecb7ef601a9c01746e710ce0d9c48accb38a79ede5b9638f3402310080f9e165e8c61035bf8aa7b5533960e46dd0e211c904a064edb6de41f797c0eae4e327612ee3f816f4157272bb4fabc9"), true)  // tcId 2, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k210(), "313233343030", "30650230234503fcca578121986d96be07fbc8da5d894ed8588c6dbcdbe974b4b813b21c52d20a8928f2e2fdac14705b0705498c023100cd7b9b766b97b53d1a80fc0b760af16a11bf4a59c7c367c6c7275dfb6e18a88091eed3734bf5cf41b3dc6fecd6d3baaf"), true)  // tcId 3, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k210(), "0000000000000000000000000000000000000000", "306502305cad9ae1565f2588f86d821c2cc1b4d0fdf874331326568f5b0e130e4e0c0ec497f8f5f564212bd2a26ecb782cf0a18d023100bf2e9d0980fbb00696673e7fbb03e1f854b9d7596b759a17bf6e6e67a95ea6c1664f82dc449ae5ea779abd99c78e6840"), true)  // tcId 4, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k211(), "313233343030", "3064023012b30abef6b5476fe6b612ae557c0425661e26b44b1bfe19daf2ca28e3113083ba8e4ae4cc45a0320abd3394f1c548d702301840da9fc1d2f8f8900cf485d5413b8c2574ee3a8d4ca03995ca30240e09513805bf6209b58ac7aa9cff54eecd82b9f1"), true)  // tcId 5, valid, ValidSignature
