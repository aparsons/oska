test "Wycheproof P256 SHA-256 DER, tcId 1 to 50" {
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k0(), "", "3045022100b292a619339f6e567a305c951c0dcbcc42d16e47f219f9e98e76e09d8770b34a02200177e60492c5a8242f76f07bfe3661bde59ec2a17ce5bd2dab2abebdf89a62e2"), true)  // tcId 1, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k0(), "4d7367", "30450220530bd6b0c9af2d69ba897f6b5fb59695cfbf33afe66dbadcf5b8d2a2a6538e23022100d85e489cb7a161fd55ededcedbf4cc0c0987e3e3f0f242cae934c72caa3f43e9"), true)  // tcId 2, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k0(), "313233343030", "3046022100a8ea150cb80125d7381c4c1f1da8e9de2711f9917060406a73d7904519e51388022100f3ab9fa68bd47973a73b2d40480c2ba50c22c9d76ec217257288293285449b86"), true)  // tcId 3, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k0(), "0000000000000000000000000000000000000000", "3045022100986e65933ef2ed4ee5aada139f52b70539aaf63f00a91f29c69178490d57fb7102203dafedfb8da6189d372308cbf1489bbbdabf0c0217d1c0ff0f701aaa7a694b9c"), true)  // tcId 4, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "304402202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e1802204cd60b855d442f5b3c7b11eb6c4e0ae7525fe710fab9aa7c77a67f79e6fadd76"), true)  // tcId 5, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "304402202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e180220b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 6, invalid, MissingZero
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "304502202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), true)  // tcId 7, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "30814502202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 8, invalid, BerEncodedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "3082004502202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 9, invalid, BerEncodedSignature
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "304602202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 10, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "304402202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 11, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "3085010000004502202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 12, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "308901000000000000004502202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 13, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "30847fffffff02202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 14, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "30848000000002202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 15, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "3084ffffffff02202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 16, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "3085ffffffffff02202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db"), false)  // tcId 17, invalid, InvalidEncoding
