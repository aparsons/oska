test "Wycheproof P384 SHA-256 DER, tcId 1 to 50" {
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k210(), "", "3065023100d670d637fcb2da85a22f74ac92939ee2ee5e7d1bb8d6d0afd6f1ef0f883a43872ba285430d4df43f93784e1cd6e6f63702303774da5d699f6bd62b329376e3b6d3612abc67cb945a109d506d3fde45f4c33893c4428250ef6ccfd6e417400344eabb"), true)  // tcId 1, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k210(), "4d7367", "3065023100857f3cd339be8d0a67a5e6cacd5fd267e666b610b660fcd6ac053f04d8e4606777b825327a00796de9d7d77ed846f0b502306fa2b6853764d17480de64c271f2f8b2d22da6289cfda991f12fbea2b177903cdb3e9bdec99cbfce079f6b3a381595e5"), true)  // tcId 2, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k210(), "313233343030", "3066023100a95f66dadda96af63a18d8cd32cb6c1178a4a50e64dcd1ef29e6e10d4fc6f58923b66f9d93f424bfc5d0da8ac546b07e023100c8fcd88a1d86ee74774031bc938d8607a9993e9c4c3c2d77066a1a929857a8a71b711a98942bbda1e17e93ce2f10cdcf"), true)  // tcId 3, valid, ValidSignature
