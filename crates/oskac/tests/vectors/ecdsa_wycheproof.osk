    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k31(), "313233343030", "30440220555555550000000055555555555555553ef7a8e48d07df81a693439654210c7002204523ce342e4994bb8968bf6613f60c06c86111f15a3a389309e72cd447d5dd99"), true)  // tcId 382, valid, ModularInverse
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k32(), "313233343030", "30440220555555550000000055555555555555553ef7a8e48d07df81a693439654210c70022037d765be3c9c78189ad30edb5097a4db670de11686d01420e37039d4677f4809"), true)  // tcId 383, valid, ModularInverse
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k33(), "313233343030", "30440220555555550000000055555555555555553ef7a8e48d07df81a693439654210c70022044237823b54e0c74c2bf5f759d9ac5f8cb897d537ffa92effd4f0bb6c9acd860"), true)  // tcId 384, valid, ModularInverse
