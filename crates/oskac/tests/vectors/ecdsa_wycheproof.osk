test "Wycheproof P384 SHA-384 DER, tcId 401 to 450" {
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k229(), "313233343030", "30160209009c44febf31c3594d020900839ed28247c2b06b"), true)  // tcId 401, valid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k230(), "313233343030", "301e020d09df8b682430beef6f5fd7c7d0020d0fd0a62e13778f4222a0d61c8a"), true)  // tcId 402, valid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k231(), "313233343030", "30260211008a598e563a89f526c32ebec8de26367a02110084f633e2042630e99dd0f1e16f7a04bf"), true)  // tcId 403, valid, ArithmeticError
