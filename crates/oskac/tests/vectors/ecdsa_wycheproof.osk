test "Wycheproof P384 SHA-384 DER, tcId 101 to 150" {
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k211(), "313233343030", "30692234020112022fb30abef6b5476fe6b612ae557c0425661e26b44b1bfe19daf2ca28e3113083ba8e4ae4cc45a0320abd3394f1c548d7023100e7bf25603e2d07076ff30b7a2abec473da8b11c572b35fc631991d5de62ddca7525aaba89325dfd04fecc47bff426f82"), false)  // tcId 101, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k211(), "313233343030", "3065023010b30abef6b5476fe6b612ae557c0425661e26b44b1bfe19daf2ca28e3113083ba8e4ae4cc45a0320abd3394f1c548d7023100e7bf25603e2d07076ff30b7a2abec473da8b11c572b35fc631991d5de62ddca7525aaba89325dfd04fecc47bff426f82"), false)  // tcId 102, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k211(), "313233343030", "3065023012b30abef6b5476fe6b612ae557c0425661e26b44b1bfe19daf2ca28e3113083ba8e4ae4cc45a0320abd3394f1c54857023100e7bf25603e2d07076ff30b7a2abec473da8b11c572b35fc631991d5de62ddca7525aaba89325dfd04fecc47bff426f82"), false)  // tcId 103, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k211(), "313233343030", "3064022f12b30abef6b5476fe6b612ae557c0425661e26b44b1bfe19daf2ca28e3113083ba8e4ae4cc45a0320abd3394f1c548023100e7bf25603e2d07076ff30b7a2abec473da8b11c572b35fc631991d5de62ddca7525aaba89325dfd04fecc47bff426f82"), false)  // tcId 104, invalid, ModifiedSignature
    t.assert_eq(run(ecdsa.Curve.P384, 384, true, k211(), "313233343030", "3064022fb30abef6b5476fe6b612ae557c0425661e26b44b1bfe19daf2ca28e3113083ba8e4ae4cc45a0320abd3394f1c548d7023100e7bf25603e2d07076ff30b7a2abec473da8b11c572b35fc631991d5de62ddca7525aaba89325dfd04fecc47bff426f82"), false)  // tcId 105, invalid, ModifiedSignature
