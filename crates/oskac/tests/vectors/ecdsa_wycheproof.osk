    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "304902202478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c022250201000220a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 144, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "313233343030", "304502202478f1d049f6d857ac900a7af1772226a4c59b345fbb90613c66f42b98f981c0022102a07a59c4a41688538eb315e94effca0f4039035c6c2ed1dc84841359d1b34eb2"), false)  // tcId 145, invalid, ModifiedSignature
