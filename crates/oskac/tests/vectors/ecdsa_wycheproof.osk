// `std.ecdsa` against Wycheproof's ECDSA vectors: `ecdsa_secp256r1_sha256`,
// `ecdsa_secp256r1_sha512`, `ecdsa_secp384r1_sha384` and
// `ecdsa_secp384r1_sha256`, each in its ASN.1 (DER) form and, for
// SHA-256 on P-256 and SHA-384 on P-384, its IEEE P1363 form too, from
// `testvectors_v1/` of C2SP/wycheproof at commit
// 65ca494727a52944c204441c860b039e6786b99b,
// converted once into Oska, each with its tcId, expected result and first
// flag. Every test is `valid` or `invalid`: a `valid` one must verify and an
// `invalid` one must not. The message is hashed here
// with `std.sha2`, and the key is the uncompressed point of its group.
// `native_ecdsa.rs` runs this file natively; the interpreter takes minutes
// over it. The RFC 6979 and edge-case tests that run on both backends are in
// `fixtures/ecdsa_vectors.osk`.

use std.ecdsa
use std.sha2

fn hex(text: String) -> Bytes {
    Bytes.from_hex(text).unwrap_or(Bytes.new())
}

fn digest(hash: Int, message: Bytes) -> Bytes {
    if hash == 256 {
        sha2.sha256(message)
    } else if hash == 384 {
        sha2.sha384(message)
    } else {
        sha2.sha512(message)
    }
}

// The verdict on `signature` of `message` (hashed with SHA-`hash`) by `key`,
// all in hexadecimal: `false` when the key does not load.
fn run(curve: ecdsa.Curve, hash: Int, der: Bool, key: String, message: String, signature: String) -> Bool {
    match ecdsa.PublicKey.from_bytes(curve, hex(key)) {
        Some(k) => {
            let d = digest(hash, hex(message))
            if der {
                ecdsa.verify_der(k, d, hex(signature))
            } else {
                ecdsa.verify(k, d, hex(signature))
            }
        }
        None => false
    }
}

