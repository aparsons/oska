test "Wycheproof P256 SHA-256 DER, tcId 451 to 484" {
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k96(), "4d657373616765", "30440220664eb7ee6db84a34df3c86ea31389a5405badd5ca99231ff556d3e75a233e73a022059f3c752e52eca46137642490a51560ce0badc678754b8f72e51a2901426a1bd"), true)  // tcId 451, valid, EdgeCasePublicKey
