    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k0(), "", "30450220093f3825c0cf820cced816a3a67446c85606a6d529e43857643fccc11e1f705f1f0220769782888c63058630f97a5891c8700e82979e4f233586bfc5042fa73cb70a4e"), false)  // tcId 544, invalid, InvalidEncoding
