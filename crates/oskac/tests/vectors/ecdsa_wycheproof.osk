test "Wycheproof P256 SHA-256 DER, tcId 351 to 400" {
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k2(), "313233343030", "3046022100ffffffff00000001000000000000000000000000fffffffffffffffffffffffc022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254e"), false)  // tcId 351, invalid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k3(), "313233343030", "3046022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254f022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254e"), true)  // tcId 352, valid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k4(), "313233343030", "304502207ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffd022100909135bdb6799286170f5ead2de4f6511453fe50914f3df2de54a36383df8dd4"), true)  // tcId 353, valid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k5(), "313233343030", "304402207ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffd022027b4577ca009376f71303fd5dd227dcef5deb773ad5f5a84360644669ca249a5"), true)  // tcId 354, valid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k6(), "313233343030", "3006020105020101"), true)  // tcId 355, valid, SmallRandS
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k7(), "313233343030", "3006020105020103"), true)  // tcId 356, valid, SmallRandS
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k8(), "313233343030", "3006020105020105"), true)  // tcId 357, valid, SmallRandS
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k9(), "313233343030", "3006020105020106"), true)  // tcId 358, valid, SmallRandS
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k10(), "313233343030", "3006020106020101"), true)  // tcId 359, valid, SmallRandS
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k11(), "313233343030", "3006020106020103"), true)  // tcId 360, valid, SmallRandS
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k12(), "313233343030", "3006020106020106"), true)  // tcId 361, valid, SmallRandS
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k13(), "313233343030", "3006020106020107"), true)  // tcId 362, valid, SmallRandS
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k13(), "313233343030", "3026022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632557020107"), false)  // tcId 363, invalid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k14(), "313233343030", "3026020106022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc75fbd8"), false)  // tcId 364, invalid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k15(), "313233343030", "3027020201000221008f1e3c7862c58b16bb76eddbb76eddbb516af4f63f2d74d76e0d28c9bb75ea88"), true)  // tcId 365, valid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k16(), "313233343030", "302c02072d9b4d347952d6022100ef3043e7329581dbb3974497710ab11505ee1c87ff907beebadd195a0ffe6d7a"), true)  // tcId 366, valid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k17(), "313233343030", "3032020d1033e67e37b32b445580bf4eff0221008b748b74000000008b748b748b748b7466e769ad4a16d3dcd87129b8e91d1b4d"), true)  // tcId 367, valid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k18(), "313233343030", "302702020100022100ef9f6ba4d97c09d03178fa20b4aaad83be3cf9cb824a879fec3270fc4b81ef5b"), true)  // tcId 368, valid, ArithmeticError
