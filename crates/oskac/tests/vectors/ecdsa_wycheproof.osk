    t.assert_eq(run(ecdsa.Curve.P256, 256, false, k71(), "313233343030", "7ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffdbfffffff36db6db7a492492492492492146c573f4c6dfc8d08a443e258970b09"), true)  // tcId 199, valid, ArithmeticError
