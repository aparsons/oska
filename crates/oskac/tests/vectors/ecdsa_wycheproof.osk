test "Wycheproof P256 SHA-512 DER, tcId 401 to 450" {
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "3132363937393837363434", "3045022100b731dc0d92c2cc7a605d78233f7814699bdf1cab2df297b6844eec4015af8ea0022039b1a0cc88eb85bcdc356b3620c51f1298c60aec5306b107e900ffdba049dd6f"), true)  // tcId 401, valid, SpecialCaseHash
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "333939323432353533", "3046022100ef73c4fa322da39fb6503bab6b66b64d241056afbcd6908f84b61ccbbe890433022100f1ef85413e5764aa58a3128ccfcf388324fe5340e5edf8d0135ae76786ce415b"), true)  // tcId 402, valid, SpecialCaseHash
    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k1(), "31363031393737393737", "30450220694cd30e2ad0182579331474b271ee2d48723bc8415dc6513873586ce705b76b022100c5ac0c0ed5a4017d110cb45d63aa955dc7dc5ce23e7965c5397c3ff46a884636"), true)  // tcId 403, valid, SpecialCaseHash
