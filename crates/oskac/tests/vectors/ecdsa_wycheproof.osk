test "Wycheproof P384 SHA-256 DER, tcId 351 to 400" {
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k313(), "313233343030", "3066023100fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000fffffffe023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52970"), false)  // tcId 351, invalid, ArithmeticError
