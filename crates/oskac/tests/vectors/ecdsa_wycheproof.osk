test "Wycheproof P256 SHA-256 DER, tcId 51 to 100" {
    t.assert_eq(run(ecdsa.Curve.P256, 256, true, k1(), "313233343030", "308002202ba3a8be6b94d5ec80a6d9d1190a436effe50d85a1eee859b8cc6af9bd5c2e18022100b329f479a2bbd0a5c384ee1493b1f5186a87139cac5df4087c134b49156847db060811220000"), false)  // tcId 51, invalid, InvalidEncoding
