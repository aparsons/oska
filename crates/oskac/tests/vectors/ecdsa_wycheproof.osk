    t.assert_eq(run(ecdsa.Curve.P256, 512, true, k202(), "68656c6c6f2c20776f726c64", "3046022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632556022100ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254e"), false)  // tcId 547, invalid, ArithmeticError
