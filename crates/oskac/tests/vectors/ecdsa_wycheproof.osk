    t.assert_eq(run(ecdsa.Curve.P384, 384, false, k299(), "4d657373616765", "441800ea9377c27865be000ad008eb3d7502bdd105824b26d15cf3d06452969a9d0607a915a8fe989215fc4d61af6e05dce29faa5137f75ad77e03918c8ee6747cc7a39b0a69f8b915654cac4cf4bfd9c87cc46ae1631b5c6baebd4fc08ff8fd"), true)  // tcId 255, valid, EdgeCasePublicKey
