test "Wycheproof P384 SHA-256 DER, tcId 451 to 472" {
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k302(), "4d657373616765", "3065023008076af74d9aca7e8736110c77dc8e500c211d574cac8c2ec914d5e30ee663b5bcebab44b7116124a289a32e1c3c6c3c0231008f2e722c43674685641c57c8c1ed8dcea74aed0eb50c394ffa44b033ab5a5a58af422612cb1f8e08f5a7b4fb8d027553"), true)  // tcId 451, valid, EdgeCasePublicKey
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k302(), "4d657373616765", "3066023100934b89b2647372376d08a70d0d9d5126e4bf627942294862ccb3c64a539305c645ad7a7e17068e7196b4fd99df126a0d023100832a0278c244b9b18768ed498e2c7869e2c0b5fc2c4c5071f45d8b173779dab008839ab10c10df1e1e47e9a41248973e"), true)  // tcId 452, valid, EdgeCasePublicKey
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k302(), "4d657373616765", "3066023100ea9bf433ebdeb5515c1e56607803098c2db8af5cbb54bb256ada709a00d5a626de8eb6eb0af53ad0beac869c6bafd86f0231009eae95d2c41b670f2ed70fa0f01370141749bb4447ca063677308c17485cac90afd7df1da16c542f204526fa342dd44c"), true)  // tcId 453, valid, EdgeCasePublicKey
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k303(), "4d657373616765", "30650230750bfb52b08003d4cc11bbc677005ff76facd7922450bd0b9d8fb0db01b6162ad106925096a3f311405aee322ba8fa4e023100aad1626127816f28526f9244bdb5ceb9484c7e45cf6fcda0f921e2621514ccdcf28f06d41466fb52e619356cc3d4ffbf"), true)  // tcId 454, valid, EdgeCasePublicKey
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k303(), "4d657373616765", "306502303ec493f00b1ea554b8725b7e39d50dea0017cf1558d70a0fe11c72d6ba4a5df084bb4cd3faeb8f7057612f1318f3c165023100e6297e29986b6a01490aa6d0ca7ddbfe8f173340688010d9dd278a0a93be09606a8da9b3159e3f4e55a4010a6590dec2"), true)  // tcId 455, valid, EdgeCasePublicKey
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k303(), "4d657373616765", "3066023100ce1d27dba63bbd9332e27f471e22ee105768f95ea1d031d4617b9e88033c9596d3e67abebb6d2e8b7e52c5bb3368aa5b023100cc85133e6553ff21812987e58d9abe00a8acb7cc1354247bcfdacc8a914189c159034b92d59932301f17e2447863da4b"), true)  // tcId 456, valid, EdgeCasePublicKey
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k304(), "4d657373616765", "306502307054a5bd3eec9debc0113eafecf27d11b5186ce67aa430b57c6eb3c98e239c16370bb8aa6d0cc8cb2c554186b7dd82b6023100e820c50fb0ef6208407dd37d34796ea21771a988d5eafbd9b12caceec15e1519861407dfced9f20d7898ee0fa0afb61c"), true)  // tcId 457, valid, EdgeCasePublicKey
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k304(), "4d657373616765", "306602310080f3ca043a055dd0784aa37d8c3afabbfc8160606afc1d54463b3af1e56b8269e5fa850808def439f83cfd4d3a375661023100fe0030173c18cfd88b3ab317430e55722ec9ae8a3d8fda64243c325262da11a2f7183d2d2a462b42ec2f6a6c8f9bf12b"), true)  // tcId 458, valid, EdgeCasePublicKey
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k304(), "4d657373616765", "3066023100b57d6915f6ef8bc76246fe073372ac289fbd9c1b9451e261aeccb927dfbc39419fe51aa936afc3e5ae6d18b99fa7a863023100dacf1c1c7a6ec67e4a6a4b2d7c0fdad0a9e8e92f65a2bdd3b42548aae9853128fd36291d492ca1b51990b3b62fae3860"), true)  // tcId 459, valid, EdgeCasePublicKey
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k210(), "", "3f1065023100d670d637fcb2da85a22f74ac92939ee2ee5e7d1bb8d6d0afd6f1ef0f883a43872ba285430d4df43f93784e1cd6e6f63702303774da5d699f6bd62b329376e3b6d3612abc67cb945a109d506d3fde45f4c33893c4428250ef6ccfd6e417400344eabb"), false)  // tcId 460, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k210(), "", "30661f023100d670d637fcb2da85a22f74ac92939ee2ee5e7d1bb8d6d0afd6f1ef0f883a43872ba285430d4df43f93784e1cd6e6f63702303774da5d699f6bd62b329376e3b6d3612abc67cb945a109d506d3fde45f4c33893c4428250ef6ccfd6e417400344eabb"), false)  // tcId 461, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k210(), "", "3066023100d670d637fcb2da85a22f74ac92939ee2ee5e7d1bb8d6d0afd6f1ef0f883a43872ba285430d4df43f93784e1cd6e6f6371f02303774da5d699f6bd62b329376e3b6d3612abc67cb945a109d506d3fde45f4c33893c4428250ef6ccfd6e417400344eabb"), false)  // tcId 462, invalid, InvalidEncoding
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k398(), "68656c6c6f2c20776f726c64", "3036020102023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52970"), true)  // tcId 463, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k399(), "68656c6c6f2c20776f726c64", "3036020103023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52970"), false)  // tcId 464, invalid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k398(), "68656c6c6f2c20776f726c64", "3066023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52975023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52970"), false)  // tcId 465, invalid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k400(), "68656c6c6f2c20776f726c64", "3066023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52971023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52970"), false)  // tcId 466, invalid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k401(), "68656c6c6f2c20776f726c64", "3036020102023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52970"), true)  // tcId 467, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k402(), "68656c6c6f2c20776f726c64", "3036020103023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52970"), false)  // tcId 468, invalid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k403(), "68656c6c6f2c20776f726c64", "304d0218389cb27e0bc8d21fa7e5f24cb74f58851313e696333ad68e023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52970"), false)  // tcId 469, invalid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k404(), "68656c6c6f2c20776f726c64", "304d0218389cb27e0bc8d220a7e5f24db74f58851313e695333ad68f023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52970"), false)  // tcId 470, invalid, ArithmeticError
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k405(), "68656c6c6f2c20776f726c64", "304502304fd5dd99138e6f1002d2d23591b2f94071a7f5ad49ddb970dc859275bfe51f193470d443e793196901e88bbe749614d702110100000000000000000000000000000000"), true)  // tcId 471, valid, ValidSignature
    t.assert_eq(run(ecdsa.Curve.P384, 256, true, k405(), "68656c6c6f2c20776f726c64", "306502304fd5dd99138e6f1002d2d23591b2f94071a7f5ad49ddb970dc859275bfe51f193470d443e793196901e88bbe749614d7023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372dde581a0db248b0a77aecec196accc52973"), true)  // tcId 472, valid, ValidSignature
}
