// SPDX-License-Identifier: Apache-2.0
// `std.x509` over crafted certificate chains (every one, natively only). GENERATED by
// `scripts/x509-roots/chains.py full`: every certificate is made with the Python
// `cryptography` package, valid from 2024-01-01 to 2034-01-01 unless its case
// says otherwise, and every check is at 2025-06-15. The roots are not in
// Mozilla's store, so each test passes its own store. Real certificates (every
// root of Mozilla's store) are in `vectors/x509_mozilla_roots.osk`.

use std.x509

fn now() -> Int {
    1749945600
}

fn hex(text: String) -> Bytes {
    Bytes.from_hex(text).unwrap_or(Bytes.new())
}

