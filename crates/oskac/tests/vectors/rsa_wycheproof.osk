test "Wycheproof rsa_signature_2048_sha256, 241 to 259" {
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 241, invalid, InvalidPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", "313233343030"), false)  // tcId 242, invalid, InvalidPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 243, invalid, ShortPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 244, invalid, SignatureMalleability
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 245, invalid, SignatureMalleability
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 246, invalid, SignatureMalleability
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 247, invalid, InvalidSignature
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 248, invalid, InvalidSignature
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 249, invalid, InvalidSignature
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 250, invalid, InvalidSignature
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 251, invalid, InvalidSignature
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 252, invalid, InvalidSignature
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 253, invalid, InvalidSignature
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 254, invalid, InvalidSignature
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 255, invalid, WrongPrimitive
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 256, invalid, WrongPrimitive
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 257, invalid, WrongPrimitive
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k1(), "03", "33363730", ""), true)  // tcId 258, valid, SmallSignature
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k2(), "03", "32353934", ""), true)  // tcId 259, valid, EdgeCaseSignature
}

test "Wycheproof rsa_signature_2048_sha384, 1 to 20" {
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha384, k3(), "010001", "", ""), true)  // tcId 1, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha384, k3(), "010001", "0000000000000000000000000000000000000000", ""), true)  // tcId 2, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha384, k3(), "010001", "54657374", ""), true)  // tcId 3, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha384, k3(), "010001", "313233343030", ""), true)  // tcId 4, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha384, k3(), "010001", "4d657373616765", ""), true)  // tcId 5, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha384, k3(), "010001", "61", ""), true)  // tcId 6, valid, 
