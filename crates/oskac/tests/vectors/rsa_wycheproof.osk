// `std.rsa` against Wycheproof's RSA signature vectors, from `testvectors_v1/`
// of C2SP/wycheproof at commit
// 65ca494727a52944c204441c860b039e6786b99b,
// converted once into Oska, each with its tcId, expected result and first flag.
// RSASSA-PKCS1-v1_5: `rsa_signature_2048_sha256` whole, the first 60 tests of
// each key of `rsa_signature_2048_sha384`, `rsa_signature_2048_sha512`,
// `rsa_signature_3072_sha256` and `rsa_signature_4096_sha512`, and the first 24
// of each key of `rsa_signature_8192_sha256`. RSASSA-PSS, only the groups whose
// MGF1 hash is the signature's hash and whose salt is as long as the digest,
// which is all `std.rsa` verifies: `rsa_pss_2048_sha256_mgf1_32` whole, the first
// 50 tests of each key of `rsa_pss_2048_sha384_mgf1_48`,
// `rsa_pss_3072_sha256_mgf1_32` and `rsa_pss_4096_sha512_mgf1_64`, and those
// groups of `rsa_pss_misc`. A `valid` test must verify and an `invalid` one
// must not. The one `acceptable` test, a PKCS#1 v1.5 signature whose
// `DigestInfo` has no `NULL` parameter, is refused here, as the module takes
// exactly one encoding. The message is hashed here with `std.sha2`.
// `native_rsa.rs` runs this file natively; the interpreter takes minutes over
// it. The edge cases that run on both backends are in `fixtures/rsa_vectors.osk`.

use std.rsa
use std.sha2

fn hex(text: String) -> Bytes {
    Bytes.from_hex(text).unwrap_or(Bytes.new())
}

fn digest(hash: rsa.HashAlgorithm, message: Bytes) -> Bytes {
    match hash {
        rsa.HashAlgorithm.Sha256 => sha2.sha256(message)
        rsa.HashAlgorithm.Sha384 => sha2.sha384(message)
        rsa.HashAlgorithm.Sha512 => sha2.sha512(message)
    }
}

// The verdict on a PKCS#1 v1.5 `signature` of `message` by the key with
// `modulus` and `exponent`, all in hexadecimal: `false` when the key does
// not load.
fn run_pkcs1(hash: rsa.HashAlgorithm, modulus: String, exponent: String, message: String, signature: String) -> Bool {
    match rsa.PublicKey.from_components(hex(modulus), hex(exponent)) {
        Some(key) => rsa.verify_pkcs1(key, hash, digest(hash, hex(message)), hex(signature))
        None => false
    }
}

// The same for a PSS signature.
fn run_pss(hash: rsa.HashAlgorithm, modulus: String, exponent: String, message: String, signature: String) -> Bool {
    match rsa.PublicKey.from_components(hex(modulus), hex(exponent)) {
        Some(key) => rsa.verify_pss(key, hash, digest(hash, hex(message)), hex(signature))
        None => false
    }
}

fn k0() -> String {
    ""
}

fn k1() -> String {
    ""
}

fn k2() -> String {
    ""
}

fn k3() -> String {
    ""
}

fn k4() -> String {
    ""
}

fn k5() -> String {
    ""
}

fn k6() -> String {
    ""
}

fn k7() -> String {
    ""
}

fn k8() -> String {
    ""
}

fn k9() -> String {
    ""
}

fn k10() -> String {
    ""
}

test "Wycheproof rsa_signature_2048_sha256, 1 to 20" {
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "", ""), true)  // tcId 1, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "0000000000000000000000000000000000000000", ""), true)  // tcId 2, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "54657374", ""), true)  // tcId 3, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), true)  // tcId 4, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "4d657373616765", ""), true)  // tcId 5, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "61", ""), true)  // tcId 6, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "e0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff", ""), true)  // tcId 7, valid, 
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 8, acceptable, MissingNull
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 9, invalid, BerEncodedPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 10, invalid, BerEncodedPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 11, invalid, InvalidAsnInPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 12, invalid, InvalidAsnInPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 13, invalid, InvalidAsnInPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 14, invalid, InvalidAsnInPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 15, invalid, InvalidAsnInPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 16, invalid, InvalidAsnInPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 17, invalid, InvalidAsnInPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 18, invalid, InvalidAsnInPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 19, invalid, InvalidAsnInPadding
    t.assert_eq(run_pkcs1(rsa.HashAlgorithm.Sha256, k0(), "010001", "313233343030", ""), false)  // tcId 20, invalid, InvalidAsnInPadding
}

