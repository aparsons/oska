// Every form a secret allows (#224). It checks cleanly, and its report's
// `audit` lists each `expose()`, and nothing else.

struct Key { word: Secret<U32>, flag: Secret<Bool> }

fn make() -> Key {
    let w: Secret<U32> = Secret.new(7)
    Key(word: w, flag: Secret.new(true))
}

fn arithmetic(a: Secret<U32>, b: Secret<U32>, p: U32) -> Secret<U32> {
    let wrapped = (a + b) - (a * p)
    let mixed = (a & b) | (a ^ 92)
    let shifted = (~a << p) >> 3
    (wrapped ^ mixed ^ shifted).rotl(7).rotr(3)
}

fn conversions(a: Secret<U8>, b: Secret<U32>, c: Secret<U64>) -> Secret<U64> {
    let x: Secret<U32> = a.to_u32()
    let y: Secret<U8> = b.wrapping_to_u8()
    let z: Secret<U32> = c.wrapping_to_u32()
    (x ^ z).to_u64() ^ a.to_u64() ^ y.to_u64() ^ c.wrapping_to_u8().to_u64()
}

fn choose(a: Secret<U64>, b: Secret<U64>, c: Secret<Bool>) -> Secret<U64> {
    let same = a.ct_eq(b)
    let either = same.and(c).or(c.xor(same)).not()
    either.ct_select(a, b)
}

fn buffer(key: Secret<Bytes>, mac: Bytes, w: Secret<U32>) -> Bool {
    var out = Secret.new(Bytes.new())
    out.push(key.at(0))
    out.push_u32_be(key.read_u32_be(0) ^ w)
    out.push_u32_le(key.read_u32_le(4))
    out.push_u64_be(key.read_u64_be(0))
    out.push_u64_le(key.read_u64_le(0))
    out.append(key.slice(0, key.len()))
    out.constant_time_eq(mac) && out.constant_time_eq_secret(key)
}

fn key_bytes(env: Env) -> Secret<Bytes> {
    env.secret("HMAC_KEY").to_bytes()
}

fn reveal(key: Key, c: Secret<Bool>) -> U32 {
    if c.expose() {
        key.word.expose()
    } else {
        0
    }
}
