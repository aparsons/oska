// SPDX-License-Identifier: Apache-2.0
// Every refusal of a secret (#224): each function is one position where
// a secret's value would decide a branch (`E0353`), a memory address
// (`E0354`), a variable-time instruction or a panic (`E0355`), or an
// ordering (`E0356`), or is compared with `==` (`E0351`).

fn if_condition(c: Secret<Bool>) -> Int {
    if c { 1 } else { 0 }
}

fn while_condition(c: Secret<Bool>) {
    while c { }
}

fn contract(a: Secret<U32>, b: Secret<U32>) -> Int
    requires a.ct_eq(b)
{
    0
}

fn scrutinee(k: Secret<U8>) -> Int {
    match k {
        _ => 0
    }
}

fn guard(c: Secret<Bool>, n: Int) -> Int {
    match n {
        _ if c => 1
        _ => 0
    }
}

fn range_bound(k: Secret<U32>) {
    for i in 0..k { }
}

fn and_or_not(a: Secret<Bool>, b: Secret<Bool>) -> Secret<Bool> {
    let x = a && b
    let y = a || b
    !a
}

fn index(table: List<U8>, k: Secret<U32>) -> U8 {
    table.at(k)
}

fn offset(key: Secret<Bytes>, k: Secret<U32>) -> Secret<U32> {
    key.read_u32_be(k)
}

fn slice_bound(data: Bytes, k: Secret<U64>) -> Bytes {
    data.slice(0, k)
}

fn length(k: Secret<U8>) -> Bytes {
    Bytes.zeroed(k)
}

fn hash_key(k: Secret<Bytes>) -> Int {
    k.hash()
}

fn division(k: Secret<U32>) -> Secret<U32> {
    (k / 3) ^ (k % 5)
}

fn shift_amount(k: Secret<U32>, p: U32) -> Secret<U32> {
    (p << k) ^ k.rotl(k.to_u64())
}

fn ordering(k: Secret<U32>, p: U32) -> Bool {
    k < p
}

fn equality(a: Secret<U32>, b: Secret<U32>, x: Secret<Bytes>, y: Secret<Bytes>) -> Bool {
    let ints = a == b
    x != y
}
