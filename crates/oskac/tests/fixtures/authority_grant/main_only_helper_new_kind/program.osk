// The grant lists only `main`, with `Stdout`. The snippet adds a helper
// that reaches `NetConnect`, a kind no grant entry covers: the program
// goes past its grant although `main` did not widen.

fn fetch(net: NetConnect) -> Result<Connection, IoError> {
    net.restrict_to("example.com", 443).connect()
}

fn main(io: Stdout) -> Result<(), IoError> {
    io.println("ran")
}
