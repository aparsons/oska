// SPDX-License-Identifier: Apache-2.0
// A small program on `std.store`: it keeps notes in the directory `notes`
// of the working directory, adds the notes it is given and prints what the
// store holds, so a second run shows what the first one wrote.
use std.json
use std.store

struct Note { text: Untrusted<String>, pinned: Bool }

fn to_value(note: Note) -> json.Value {
    json.Value.Object([
        json.Member(key: "text", value: json.Value.Text(note.text)),
        json.Member(key: "pinned", value: json.Value.Bool(note.pinned)),
    ])
}

fn from_value(value: json.Value) -> Option<Note> {
    let text = value.text("text")?
    let pinned = value.bool("pinned")?
    Some(Note(text: text, pinned: pinned))
}

fn show(io: Stdout, notes: store.Reader<Note>, id: String) -> Result<(), IoError> {
    match notes.get(id) {
        Some(note) => io.println("{id}: {note.text}")?
        None => io.println("{id}: none")?
    }
    Ok(())
}

fn main(io: Stdout, fs: Fs) -> Result<(), IoError> {
    let read = fs.read_only().restrict_to("notes")
    let dir = fs.write_only().restrict_to("notes")
    let key = Secret.new("store key".to_bytes())
    let codec = store.Codec.new(to_value, from_value)
    match store.read(read, key, codec) {
        Ok(notes) => {
            let n = notes.len()
            io.println("before: {n} notes")?
        }
        Err(e) => io.println(e.message())?
    }
    let opened = store.open(read, dir, key, codec, |s: store.Store<Note>| {
        var notes = s
        let _ = notes.put("a", Note(text: "buy milk", pinned: false))
        let _ = notes.put("b", Note(text: "call back", pinned: true))
        let _ = notes.put("a", Note(text: "buy oat milk", pinned: false))
        let _ = notes.delete("b")
        notes.len()
    })
    match opened {
        Ok(n) => io.println("wrote, {n} left")?
        Err(e) => io.println(e.message())?
    }
    match store.read(read, key, codec) {
        Ok(notes) => {
            show(io, notes, "a")?
            show(io, notes, "b")?
        }
        Err(e) => io.println(e.message())?
    }
    Ok(())
}
