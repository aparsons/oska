# A legacy client: initialize, initialized, ping, the tool list and a call.
> {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"c","version":"1"}}}
< {"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-11-25","capabilities":{"tools":{}},"serverInfo":{"name":"notes","version":"1.0.0"},"instructions":"Read the notes, and save drafts."}}
> {"jsonrpc":"2.0","method":"notifications/initialized"}
> {"jsonrpc":"2.0","id":2,"method":"ping"}
< {"jsonrpc":"2.0","id":2,"result":{}}
> {"jsonrpc":"2.0","id":3,"method":"tools/list"}
< {"jsonrpc":"2.0","id":3,"result":{"tools":[{"name":"list_notes","description":"List the names of the notes.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},{"name":"read_note","title":"Read a note","description":"Read one note.","inputSchema":{"type":"object","properties":{"path":{"type":"string","description":"A file name under the notes directory."}},"required":["path"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},{"name":"save_note","description":"Save a draft, replacing a draft of the same name.","inputSchema":{"type":"object","properties":{"path":{"type":"string","description":"A file name under the notes directory."},"text":{"type":"string","description":"What the draft says."}},"required":["path","text"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"openWorldHint":false}}]}}
> {"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"read_note","arguments":{"path":"a.txt"}}}
< {"jsonrpc":"2.0","id":4,"result":{"content":[{"type":"text","text":"hello note\n"}],"isError":false}}
> {"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"read_note","arguments":{}}}
< {"jsonrpc":"2.0","id":5,"result":{"content":[{"type":"text","text":"invalid arguments: $.path: expected a required member"}],"isError":true}}
> {"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"nope"}}
< {"jsonrpc":"2.0","id":6,"error":{"code":-32602,"message":"Unknown tool: nope"}}
> {"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"arguments":{}}}
< {"jsonrpc":"2.0","id":7,"error":{"code":-32602,"message":"tools/call needs a tool name string"}}
> {"jsonrpc":"2.0","id":8,"method":"tools/call"}
< {"jsonrpc":"2.0","id":8,"error":{"code":-32602,"message":"tools/call needs a tool name string"}}
> {"jsonrpc":"2.0","id":9,"method":"resources/list"}
< {"jsonrpc":"2.0","id":9,"error":{"code":-32601,"message":"method not found: resources/list"}}
# Once a client has chosen the legacy era, a request needs no metadata, but server/discover still does.
> {"jsonrpc":"2.0","id":11,"method":"server/discover"}
< {"jsonrpc":"2.0","id":11,"error":{"code":-32602,"message":"params._meta is required"}}
> {"jsonrpc":"2.0","id":12,"method":"server/discover","params":{"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}
< {"jsonrpc":"2.0","id":12,"result":{"resultType":"complete","supportedVersions":["2026-07-28","2025-11-25"],"capabilities":{"tools":{}},"instructions":"Read the notes, and save drafts.","_meta":{"io.modelcontextprotocol/serverInfo":{"name":"notes","version":"1.0.0"}}}}
# Another initialize is answered the same way.
> {"jsonrpc":"2.0","id":13,"method":"initialize","params":{"protocolVersion":"2026-07-28"}}
< {"jsonrpc":"2.0","id":13,"result":{"protocolVersion":"2025-11-25","capabilities":{"tools":{}},"serverInfo":{"name":"notes","version":"1.0.0"},"instructions":"Read the notes, and save drafts."}}
> {"jsonrpc":"2.0","id":14,"method":"initialize","params":{}}
< {"jsonrpc":"2.0","id":14,"error":{"code":-32602,"message":"initialize needs a protocolVersion string"}}
> {"jsonrpc":"2.0","id":15,"method":"initialize"}
< {"jsonrpc":"2.0","id":15,"error":{"code":-32602,"message":"initialize needs a protocolVersion string"}}
