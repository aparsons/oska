    t.assert(seals("3992cacc40453ccde10cf3aaa440c3ea95779d8ff3739400962fbc91b9a6001f", "d53b337787fd169248a71c1d", "f706259e91af4f399163f3a5313d8c00a59fa229d1e2413773f9331b65c4259a7f", "b1", "2cad1c99e9f734cd530954fbb038f02902")) // 1 bytes
    t.assert(seals("808ec8028de35543c99e378479cebf77d8c68008e0475b745aa083a67d21184b", "952788d6d93d686837914209", "8fad1b0f0fcf82460ffbcad5", "13c1e220ccbfb00cbe4d5fa835f6a1", "de94d05eed2b4bb66e9e50d9f9e62d25bd95a2e3dc07b3028e4395fa5b39a0")) // 15 bytes
