    t.assert(seals("70981924a559458547a1b5b248605bb692bd61112f55000e01075bc8be77e694", "3226304a5af9810bf306ea5e", "0023d1ec8fc315b6f3d892ee2701da19f5200b004de7601a9ef26540b234d84340", "fe027882ac13b994b3080d3fb11f4483280538a71226962d4cdbf3aafd89ce8c8daede64d256e7511e3d451336cd36d903a582bf7c2707e2ed7306e3cae5de5e93a3df55134156ce435011bb328d58e39e68505ff32a03addd56eaeb49070e3bfd882d61f49255d91eff4d978c0ac4ea775d69f07a584d6f16517d19ea88f22e", "6a00d1b96aa8bd44ff2be625203d6ed106d72f76077611d9a81fcaf310887f98ceb77de94f82d87d8806abe65ba94ac2d384c06614ddae6d4917b44a640b5ff3d310017e77c1f25edea3c5df4fcfcab2495a3f63bc2750caf84c3f110451b23d6d5b7d510248be60d179f638580a0efda2dd394908eb24bcd8f67ca43bc6c310e3d0cb45329ddb432b180d59c1acc062")) // 128 bytes
    t.assert(seals("d10f8e3b4611201ac4d55f7225a2e357f7180b1687ca370ee07166b7df76fec6", "8e1297d8401cc766deae81f4", "f7", "2d1395848f8dda0b0ce972e2f2df3b28590d69fcbc930c47a4af2612e519c7e3b3d122bd2e22d36a4ab62d2483629c8f5fdc72b05aab4b8f5bd463394b364edc222d56a0de29c93e334cc898ebb32e3f92c6b518354071b59ff1d3d9e1842b4feb2dd8e90654266270187383b48de80ba713d0fc598e151c4027d7952dbb47d464", "ab88554383c043982fd15a9ea1f72bc266a2ffa854547ed5523785e16de66874e66e5f098566a78f3ce5d62eb3c48294ce65419d22890aed2138549a36b55459ccadfcbc39cc672fb172e9e47bce674a568e9dd39f500a32a2485e56949bbe7ec1009da3822a611d6562fcdd2c7d58c7d2f51d49502405ed372dccfacde22dbe115e64626d532f0d1ebed58bf01d246a71")) // 129 bytes
    t.assert(seals("65ce342de4f8f1914bce6df51b5824c17070820b8a1a01b3e28413f3f5268791", "61f34197d50b62da42cafbd8", "", "", "")) // 200 bytes
}

// A sealed message of 53 bytes: every bit of every byte changed
// in turn, which a correct tag check refuses.
test "a changed bit anywhere in a sealed message is refused" {
    let key = hex("7973b941f613cd4990118e4445ce2dc86169f85d6cd0eb1dbba90fc0604620c2")
    let nonce = hex("82182a4cc086f1edc3c4aa8c")
    let aad = hex("49d3aec428a145285f75c8f45c3f8ac7f574f1a5")
    let sealed = hex("d86b352ac02b45ebad95bb404b90957c9bb80308ad9b979a1ed789f35f47e86e7667504b00f347fc17726dc1414bfee10fd452ee18")
    t.assert(opens(key, nonce, aad, sealed))
    for i in 0..sealed.len() {
        for bit in 0..8 {
            var forged = sealed
            forged.set(i, forged.at(i) ^ (1 << bit.to_u8()))
            t.assert(!opens(key, nonce, aad, forged))
        }
    }
}

test "a changed key, nonce or additional data is refused" {
    let key = hex("7973b941f613cd4990118e4445ce2dc86169f85d6cd0eb1dbba90fc0604620c2")
    let nonce = hex("82182a4cc086f1edc3c4aa8c")
    let aad = hex("49d3aec428a145285f75c8f45c3f8ac7f574f1a5")
    let sealed = hex("d86b352ac02b45ebad95bb404b90957c9bb80308ad9b979a1ed789f35f47e86e7667504b00f347fc17726dc1414bfee10fd452ee18")
    var other_key = key
    other_key.set(0, other_key.at(0) ^ 1)
    var other_nonce = nonce
    other_nonce.set(11, other_nonce.at(11) ^ 128)
    t.assert(!opens(other_key, nonce, aad, sealed))
    t.assert(!opens(key, other_nonce, aad, sealed))
    t.assert(!opens(key, nonce, hex("00"), sealed))
    t.assert(!opens(key, nonce, aad.slice(0, 19), sealed))
}

test "a message cut short, extended or empty is refused" {
    let key = hex("7973b941f613cd4990118e4445ce2dc86169f85d6cd0eb1dbba90fc0604620c2")
    let nonce = hex("82182a4cc086f1edc3c4aa8c")
    let aad = hex("49d3aec428a145285f75c8f45c3f8ac7f574f1a5")
    let sealed = hex("d86b352ac02b45ebad95bb404b90957c9bb80308ad9b979a1ed789f35f47e86e7667504b00f347fc17726dc1414bfee10fd452ee18")
    for cut in 0..sealed.len() {
        t.assert(!opens(key, nonce, aad, sealed.slice(0, cut)))
    }
    var longer = sealed
    longer.push(0)
    t.assert(!opens(key, nonce, aad, longer))
    t.assert(!opens(key, nonce, aad, Bytes.new()))
}

test "a key or a nonce of the wrong length gives none" {
    let key = hex("7973b941f613cd4990118e4445ce2dc86169f85d6cd0eb1dbba90fc0604620c2")
    let nonce = hex("82182a4cc086f1edc3c4aa8c")
    let aad = Bytes.new()
    let message = Secret.new("message".to_bytes())
    t.assert(!chacha20poly1305.seal(Secret.new(key.slice(0, 31)), nonce, aad, message).is_some())
    t.assert(!chacha20poly1305.seal(Secret.new(hex("7973b941f613cd4990118e4445ce2dc86169f85d6cd0eb1dbba90fc0604620c200")), nonce, aad, message).is_some())
    t.assert(!chacha20poly1305.seal(Secret.new(Bytes.new()), nonce, aad, message).is_some())
    t.assert(!chacha20poly1305.seal(Secret.new(key), nonce.slice(0, 11), aad, message).is_some())
    t.assert(!chacha20poly1305.seal(Secret.new(key), hex("82182a4cc086f1edc3c4aa8c00"), aad, message).is_some())
    t.assert(!chacha20poly1305.seal(Secret.new(key), Bytes.new(), aad, message).is_some())
    t.assert(!opens(key.slice(0, 31), nonce, aad, hex("d86b352ac02b45ebad95bb404b90957c9bb80308ad9b979a1ed789f35f47e86e7667504b00f347fc17726dc1414bfee10fd452ee18")))
    t.assert(!opens(key, nonce.slice(0, 11), aad, hex("d86b352ac02b45ebad95bb404b90957c9bb80308ad9b979a1ed789f35f47e86e7667504b00f347fc17726dc1414bfee10fd452ee18")))
}
