    t.assert(seals("5c0509e9f9ae496d6e45e73dfb935d5cdfc32ae7e4addcc297557a4d12b3501c", "99c8ca08008837887f13d45f", "9ad2a089857ee564dfd98bb48756064b80773c01946716bbaf59478f0bea2a6f11", "3e3d0828fe824ef16be6d02d64377035dd", "bf4a133974450a6c7f2127edbd0f1b652a4e937c94af48fa759b54df02745c68cb")) // 17 bytes
    t.assert(seals("5974cfdebe4f0db018d64e308096e6f5157794b983ec9ec0b4b82c55328eb909", "a1f445ce1a4227a0f37516dc", "71", "72fe236a01bb3d72643bc6c101e458f6c7e7050060f4c25ecc10b9901183a7", "da12c47d9551f0310d68a41b2a41522c693c1dc2907e9b7e4c7a4036b2b2a6df512cac2d57b5d4ce9a33cc0191acd2")) // 31 bytes
