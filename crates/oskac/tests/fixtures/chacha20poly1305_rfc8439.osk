    t.assert(seals("8d2a8d90c779a17090afd3bb23483d675d4cce75a5ee736726405a5b2e19fd34", "28d9e06f7f2d0a334c3d842d", "3eec060073be02e4d3d5c177286a0c70", "51baca80a19df220622860f788107d394fcfb7a921e52efbaf07cde2a1d955836b", "a02d58f1aec99b49df26ab0207a950aaf6e45b49fd1f57198cf165d874d44a7513c6ab54949a7e9faa319b6cd36d3c9b34")) // 33 bytes
    t.assert(seals("1374428050d774bf53d7353e929856bfe738111f54754edc250c2dcc54d22f99", "26258a0405a4c5a58713bfb1", "752f16c40fd577c9cf9c1b94437aa96d56251ed1", "1c1e8902053429e4a4c9868bced04793ab9c21ba455bf5877f1562d7818312dab5b2b7f4cb63d8a2dadbdb7e71ce6c435e49296331048de8ecdc9016d4bf9a", "673dcc0a0498e0978c6895c96e98996bc8e304921343346f08413877dbb860199a656ae44731765c25024824bb7e1cf0ca7e487b442bd87127910d02f6713cea7bc954dde63c8cf0ca82dd030953e3")) // 63 bytes
    t.assert(seals("42a257c5516f7c046c43c595cc835084feaf4859cbb0397aa8c3448dd3292f1d", "77d84809cc04c2ba3aa527a6", "f877f0f470b6c192c55e783a", "363723fbafd558c4e3f69915c3646206a44c0d88e4033d3cc6bc3b15af84fa2b83ca30032059d1d9926ef41afc465437d995a5e69b5c51ced418c4b0cc0a71af", "61c4bc60d895aa87e24b16f621a6a672142cef9693edcdbd1fbc6688a3e2668d38a044f2ed4fc1d7915c16b93f11570faa5906502c995c82d8429d79565768e3592ed9ccea946e7b148a27a9bb7515a6")) // 64 bytes
