// SPDX-License-Identifier: Apache-2.0
// `std.chacha20poly1305` against RFC 8439's AEAD test vectors (section
// 2.8.2 and appendix A.5), on both backends (the native test corpus runs
// every test-bearing fixture), then messages of every length around the
// block sizes, recorded from OpenSSL through Python's `cryptography`
// package, and forgery, truncation and wrong-length tests. Wycheproof's
// vectors are in `chacha20poly1305_wycheproof.osk`.

use std.chacha20poly1305

fn hex(text: String) -> Bytes {
    Bytes.from_hex(text).unwrap_or(Bytes.new())
}

// Whether sealing `message` gives `expected` (ciphertext then tag) and
// opening `expected` gives `message` back.
fn seals(key: String, nonce: String, aad: String, message: String, expected: String) -> Bool {
    let secret_key = Secret.new(hex(key))
    let made = match chacha20poly1305.seal(secret_key, hex(nonce), hex(aad), Secret.new(hex(message))) {
        Some(out) => out.constant_time_eq(hex(expected))
        None => false
    }
    let opened = match chacha20poly1305.open(secret_key, hex(nonce), hex(aad), hex(expected)) {
        Some(out) => out.constant_time_eq(hex(message))
        None => false
    }
    made && opened
}

fn opens(key: Bytes, nonce: Bytes, aad: Bytes, sealed: Bytes) -> Bool {
    match chacha20poly1305.open(Secret.new(key), nonce, aad, sealed) {
        Some(_) => true
        None => false
    }
}

test "RFC 8439 section 2.8.2, the sunscreen message" {
    t.assert(seals("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f", "070000004041424344454647", "50515253c0c1c2c3c4c5c6c7", "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e", "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691"))
}

test "RFC 8439 appendix A.5, the Internet-Draft message" {
    t.assert(seals("1c9240a5eb55d38af333888604f6b5f0473917c1402b80099dca5cbc207075c0", "000000000102030405060708", "f33388860000000000004e91", "", ""))
}

