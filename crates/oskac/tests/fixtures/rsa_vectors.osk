// SPDX-License-Identifier: Apache-2.0
// `std.rsa` on both backends: a 2048-bit key (generated with OpenSSL) and its
// RSASSA-PKCS1-v1_5 and RSASSA-PSS signatures of the message "sample" with
// SHA-256, SHA-384 and SHA-512, the edge cases that change one of them, and
// the limits on a key. Wycheproof's RSA signature set runs natively, in
// `vectors/rsa_wycheproof.osk`.

use std.rsa

fn hex(text: String) -> Bytes {
    Bytes.from_hex(text).unwrap_or(Bytes.new())
}

fn modulus() -> String {
    ""
}

fn hash_of(bits: Int) -> rsa.HashAlgorithm {
    if bits == 256 {
        rsa.HashAlgorithm.Sha256
    } else if bits == 384 {
        rsa.HashAlgorithm.Sha384
    } else {
        rsa.HashAlgorithm.Sha512
    }
}

// Whether the PKCS#1 v1.5 `signature` verifies for the key (`modulus`, `exponent`) and the digest, all in hexadecimal; `false` when the key does not load.
fn pkcs1(bits: Int, modulus: String, exponent: String, digest: String, signature: String) -> Bool {
    match rsa.PublicKey.from_components(hex(modulus), hex(exponent)) {
        Some(key) => rsa.verify_pkcs1(key, hash_of(bits), hex(digest), hex(signature))
        None => false
    }
}

// The same for a PSS signature.
fn pss(bits: Int, modulus: String, exponent: String, digest: String, signature: String) -> Bool {
    match rsa.PublicKey.from_components(hex(modulus), hex(exponent)) {
        Some(key) => rsa.verify_pss(key, hash_of(bits), hex(digest), hex(signature))
        None => false
    }
}

fn loads(modulus: String, exponent: String) -> Bool {
    rsa.PublicKey.from_components(hex(modulus), hex(exponent)).is_some()
}

test "PKCS#1 v1.5 signatures with SHA-256, SHA-384 and SHA-512" {
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), true)
    t.assert_eq(pkcs1(384, modulus(), "010001", "9a9083505bc92276aec4be312696ef7bf3bf603f4bbd381196a029f340585312313bca4a9b5b890efee42c77b1ee25fe", ""), true)
    t.assert_eq(pkcs1(512, modulus(), "010001", "39a5e04aaff7455d9850c605364f514c11324ce64016960d23d5dc57d3ffd8f49a739468ab8049bf18eef820cdb1ad6c9015f838556bc7fad4138b23fdf986c7", ""), true)
}

test "PSS signatures with SHA-256, SHA-384 and SHA-512 and a salt as long as the digest" {
    t.assert_eq(pss(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), true)
    t.assert_eq(pss(384, modulus(), "010001", "9a9083505bc92276aec4be312696ef7bf3bf603f4bbd381196a029f340585312313bca4a9b5b890efee42c77b1ee25fe", ""), true)
    t.assert_eq(pss(512, modulus(), "010001", "39a5e04aaff7455d9850c605364f514c11324ce64016960d23d5dc57d3ffd8f49a739468ab8049bf18eef820cdb1ad6c9015f838556bc7fad4138b23fdf986c7", ""), true)
}

test "a signature of another scheme, hash or message is refused" {
    t.assert_eq(pss(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // PKCS#1 v1.5 signature as PSS
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // PSS signature as PKCS#1 v1.5
    t.assert_eq(pkcs1(384, modulus(), "010001", "9a9083505bc92276aec4be312696ef7bf3bf603f4bbd381196a029f340585312313bca4a9b5b890efee42c77b1ee25fe", ""), false)  // the SHA-256 signature as SHA-384
    t.assert_eq(pkcs1(512, modulus(), "010001", "39a5e04aaff7455d9850c605364f514c11324ce64016960d23d5dc57d3ffd8f49a739468ab8049bf18eef820cdb1ad6c9015f838556bc7fad4138b23fdf986c7", ""), false)  // the SHA-256 signature as SHA-512
    t.assert_eq(pkcs1(256, modulus(), "010001", "95a2f1edb08a76120b82cec7c93ca477618639f04beac7d2aeba2dc039d43715", ""), false)  // a digest of another message
    t.assert_eq(pss(256, modulus(), "010001", "95a2f1edb08a76120b82cec7c93ca477618639f04beac7d2aeba2dc039d43715", ""), false)  // a digest of another message
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1", ""), false)  // a digest one byte short
    t.assert_eq(pss(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf00", ""), false)  // a digest one byte long
}

test "a signature that differs, or is not the modulus' length or below it, is refused" {
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // one bit changed
    t.assert_eq(pss(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // one bit changed
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // the modulus itself
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // the signature plus the modulus, one byte longer
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // one byte short
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // empty
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // zero
    t.assert_eq(pss(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // zero
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // one
}

test "only the one encoding of the padded message is accepted" {
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), true)  // rebuilt here with the private key: a control
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // no NULL parameter
    t.assert_eq(pkcs1(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // a byte after the digest
    t.assert_eq(pss(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // a salt of 20 bytes
    t.assert_eq(pss(256, modulus(), "010001", "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", ""), false)  // no salt
}

test "a key must be a 2048 to 8192-bit odd modulus with an odd exponent from 3 to below 2^32" {
    t.assert_eq(loads(modulus(), "010001"), true)
    t.assert_eq(loads(modulus(), "0000010001"), true)  // leading zero bytes of the exponent
    t.assert_eq(loads("".join(["00", modulus()]), "010001"), true)  // a leading zero byte of the modulus
    t.assert_eq(loads(modulus(), "03"), true)  // 3
    t.assert_eq(loads(modulus(), "ffffffff"), true)  // 2^32 - 1
    t.assert_eq(loads(modulus(), "0100000001"), false)  // 2^32 + 1
    t.assert_eq(loads(modulus(), "01"), false)  // 1
    t.assert_eq(loads(modulus(), "02"), false)  // 2
    t.assert_eq(loads(modulus(), "010000"), false)  // even
    t.assert_eq(loads(modulus(), ""), false)  // empty
    t.assert_eq(loads(modulus(), "00"), false)  // zero
    t.assert_eq(loads("c24ba811210092b5ab8aeae0b5d59e6c26aa4cf33efb86e1ec51814bf92ac85cbb76497126ed41b563c5fd0379460fd8f34a38e9e3988dab19a43f5a012162c40e7a1d28ec1c5826da43dd8a1fe6a9826abf8e5f7c2ee5a99b48d145d4ff7c83d965a9507946bea51679b981fead78aa78b3b74ac3fedef2582b5c5420f3f0c1", "010001"), false)  // 1024 bits
    t.assert_eq(loads("", "010001"), false)  // 2047 bits
    t.assert_eq(loads("", "010001"), true)  // 2048 bits
    t.assert_eq(loads("", "010001"), true)  // 8192 bits
    t.assert_eq(loads("", "010001"), false)  // 8193 bits
    t.assert_eq(loads("", "010001"), false)  // even
    t.assert_eq(loads("", "010001"), false)  // empty modulus
}

test "bits is the modulus' length in bits" {
    match rsa.PublicKey.from_components(hex(modulus()), hex("010001")) {
        Some(key) => t.assert_eq(key.bits(), 2048)
        None => t.assert_eq("no key", "a key")
    }
    match rsa.PublicKey.from_components(hex(""), hex("010001")) {
        Some(key) => t.assert_eq(key.bits(), 2055)
        None => t.assert_eq("no key", "a key")
    }
}
