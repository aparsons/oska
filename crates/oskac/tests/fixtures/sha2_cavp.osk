// SPDX-License-Identifier: Apache-2.0
// `std.sha2` against NIST CAVP's SHA-256 and SHA-512 byte-oriented test
// vectors (CAVS 11.0, `shabytetestvectors.zip`), on both backends. Every
// vector of `SHA256ShortMsg.rsp` and `SHA512ShortMsg.rsp`, and the first 16
// of `SHA256LongMsg.rsp` and `SHA512LongMsg.rsp`, whose messages run to
// 1648 and 1712 bytes. Taken from the copies in
// pyca/cryptography at commit 5f96a30ebd5b7f5c2ea482b5a267c59dbb658172
// (`vectors/cryptography_vectors/hashes/SHA2/`), converted once into Oska.
// A message of length 0 is written `00` in the files; it is empty here.

use std.sha2

fn hex(text: String) -> Bytes {
    Bytes.from_hex(text).unwrap_or(Bytes.new())
}

fn secret256(data: Bytes) -> String {
    sha2.sha256_secret(Secret.new(data)).expose().to_hex()
}

test "SHA256ShortMsg, part 1 of 5" {
    t.assert_eq(sha2.sha256(hex("")).to_hex(), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    t.assert_eq(sha2.sha256(hex("d3")).to_hex(), "28969cdfa74a12c82f3bad960b0b000aca2ac329deea5c2328ebc6f2ba9802c1")
    t.assert_eq(sha2.sha256(hex("11af")).to_hex(), "5ca7133fa735326081558ac312c620eeca9970d1e70a4b95533d956f072d1f98")
    t.assert_eq(sha2.sha256(hex("b4190e")).to_hex(), "dff2e73091f6c05e528896c4c831b9448653dc2ff043528f6769437bc7b975c2")
    t.assert_eq(sha2.sha256(hex("74ba2521")).to_hex(), "b16aa56be3880d18cd41e68384cf1ec8c17680c45a02b1575dc1518923ae8b0e")
    t.assert_eq(sha2.sha256(hex("c299209682")).to_hex(), "f0887fe961c9cd3beab957e8222494abb969b1ce4c6557976df8b0f6d20e9166")
    t.assert_eq(sha2.sha256(hex("e1dc724d5621")).to_hex(), "eca0a060b489636225b4fa64d267dabbe44273067ac679f20820bddc6b6a90ac")
    t.assert_eq(sha2.sha256(hex("06e076f5a442d5")).to_hex(), "3fd877e27450e6bbd5d74bb82f9870c64c66e109418baa8e6bbcff355e287926")
    t.assert_eq(sha2.sha256(hex("5738c929c4f4ccb6")).to_hex(), "963bb88f27f512777aab6c8b1a02c70ec0ad651d428f870036e1917120fb48bf")
    t.assert_eq(sha2.sha256(hex("3334c58075d3f4139e")).to_hex(), "078da3d77ed43bd3037a433fd0341855023793f9afd08b4b08ea1e5597ceef20")
    t.assert_eq(sha2.sha256(hex("74cb9381d89f5aa73368")).to_hex(), "73d6fad1caaa75b43b21733561fd3958bdc555194a037c2addec19dc2d7a52bd")
    t.assert_eq(sha2.sha256(hex("76ed24a0f40a41221ebfcf")).to_hex(), "044cef802901932e46dc46b2545e6c99c0fc323a0ed99b081bda4216857f38ac")
    t.assert_eq(sha2.sha256(hex("9baf69cba317f422fe26a9a0")).to_hex(), "fe56287cd657e4afc50dba7a3a54c2a6324b886becdcd1fae473b769e551a09b")
    t.assert_eq(sha2.sha256(hex("68511cdb2dbbf3530d7fb61cbc")).to_hex(), "af53430466715e99a602fc9f5945719b04dd24267e6a98471f7a7869bd3b4313")
    t.assert_eq(sha2.sha256(hex("af397a8b8dd73ab702ce8e53aa9f")).to_hex(), "d189498a3463b18e846b8ab1b41583b0b7efc789dad8a7fb885bbf8fb5b45c5c")
    t.assert_eq(sha2.sha256(hex("294af4802e5e925eb1c6cc9c724f09")).to_hex(), "dcbaf335360de853b9cddfdafb90fa75567d0d3d58af8db9d764113aef570125")
}

