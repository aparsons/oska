test "SHA256ShortMsg, part 4 of 5" {
    t.assert_eq(sha2.sha256(hex("4eef5107459bddf8f24fc7656fd4896da8711db50400c0164847f692b886ce8d7f4d67395090b3534efd7b0d298da34b")).to_hex(), "7c5d14ed83dab875ac25ce7feed6ef837d58e79dc601fb3c1fca48d4464e8b83")
    t.assert_eq(sha2.sha256(hex("047d2758e7c2c9623f9bdb93b6597c5e84a0cd34e610014bcb25b49ed05c7e356e98c7a672c3dddcaeb84317ef614d342f")).to_hex(), "7d53eccd03da37bf58c1962a8f0f708a5c5c447f6a7e9e26137c169d5bdd82e4")
    t.assert_eq(sha2.sha256(hex("3d83df37172c81afd0de115139fbf4390c22e098c5af4c5ab4852406510bc0e6cf741769f44430c5270fdae0cb849d71cbab")).to_hex(), "99dc772e91ea02d9e421d552d61901016b9fd4ad2df4a8212c1ec5ba13893ab2")
    t.assert_eq(sha2.sha256(hex("33fd9bc17e2b271fa04c6b93c0bdeae98654a7682d31d9b4dab7e6f32cd58f2f148a68fbe7a88c5ab1d88edccddeb30ab21e5e")).to_hex(), "cefdae1a3d75e792e8698d5e71f177cc761314e9ad5df9602c6e60ae65c4c267")
    t.assert_eq(sha2.sha256(hex("77a879cfa11d7fcac7a8282cc38a43dcf37643cc909837213bd6fd95d956b219a1406cbe73c52cd56c600e55b75bc37ea69641bc")).to_hex(), "c99d64fa4dadd4bc8a389531c68b4590c6df0b9099c4d583bc00889fb7b98008")
    t.assert_eq(sha2.sha256(hex("45a3e6b86527f20b4537f5af96cfc5ad8777a2dde6cf7511886c5590ece24fc61b226739d207dabfe32ba6efd9ff4cd5db1bd5ead3")).to_hex(), "4d12a849047c6acd4b2eee6be35fa9051b02d21d50d419543008c1d82c427072")
    t.assert_eq(sha2.sha256(hex("25362a4b9d74bde6128c4fdc672305900947bc3ada9d9d316ebcf1667ad4363189937251f149c72e064a48608d940b7574b17fefc0df")).to_hex(), "f8e4ccab6c979229f6066cc0cb0cfa81bb21447c16c68773be7e558e9f9d798d")
    t.assert_eq(sha2.sha256(hex("3ebfb06db8c38d5ba037f1363e118550aad94606e26835a01af05078533cc25f2f39573c04b632f62f68c294ab31f2a3e2a1a0d8c2be51")).to_hex(), "6595a2ef537a69ba8583dfbf7f5bec0ab1f93ce4c8ee1916eff44a93af5749c4")
    t.assert_eq(sha2.sha256(hex("2d52447d1244d2ebc28650e7b05654bad35b3a68eedc7f8515306b496d75f3e73385dd1b002625024b81a02f2fd6dffb6e6d561cb7d0bd7a")).to_hex(), "cfb88d6faf2de3a69d36195acec2e255e2af2b7d933997f348e09f6ce5758360")
    t.assert_eq(sha2.sha256(hex("4cace422e4a015a75492b3b3bbfbdf3758eaff4fe504b46a26c90dacc119fa9050f603d2b58b398cad6d6d9fa922a154d9e0bc4389968274b0")).to_hex(), "4d54b2d284a6794581224e08f675541c8feab6eefa3ac1cfe5da4e03e62f72e4")
    t.assert_eq(sha2.sha256(hex("8620b86fbcaace4ff3c2921b8466ddd7bacae07eefef693cf17762dcabb89a84010fc9a0fb76ce1c26593ad637a61253f224d1b14a05addccabe")).to_hex(), "dba490256c9720c54c612a5bd1ef573cd51dc12b3e7bd8c6db2eabe0aacb846b")
    t.assert_eq(sha2.sha256(hex("d1be3f13febafefc14414d9fb7f693db16dc1ae270c5b647d80da8583587c1ad8cb8cb01824324411ca5ace3ca22e179a4ff4986f3f21190f3d7f3")).to_hex(), "02804978eba6e1de65afdbc6a6091ed6b1ecee51e8bff40646a251de6678b7ef")
    t.assert_eq(sha2.sha256(hex("f499cc3f6e3cf7c312ffdfba61b1260c37129c1afb391047193367b7b2edeb579253e51d62ba6d911e7b818ccae1553f6146ea780f78e2219f629309")).to_hex(), "0b66c8b4fefebc8dc7da0bbedc1114f228aa63c37d5c30e91ab500f3eadfcec5")
    t.assert_eq(sha2.sha256(hex("6dd6efd6f6caa63b729aa8186e308bc1bda06307c05a2c0ae5a3684e6e460811748690dc2b58775967cfcc645fd82064b1279fdca771803db9dca0ff53")).to_hex(), "c464a7bf6d180de4f744bb2fe5dc27a3f681334ffd54a9814650e60260a478e3")
    t.assert_eq(sha2.sha256(hex("6511a2242ddb273178e19a82c57c85cb05a6887ff2014cf1a31cb9ba5df1695aadb25c22b3c5ed51c10d047d256b8e3442842ae4e6c525f8d7a5a944af2a")).to_hex(), "d6859c0b5a0b66376a24f56b2ab104286ed0078634ba19112ace0d6d60a9c1ae")
    t.assert_eq(sha2.sha256(hex("e2f76e97606a872e317439f1a03fcd92e632e5bd4e7cbc4e97f1afc19a16fde92d77cbe546416b51640cddb92af996534dfd81edb17c4424cf1ac4d75aceeb")).to_hex(), "18041bd4665083001fba8c5411d2d748e8abbfdcdfd9218cb02b68a78e7d4c23")
}

