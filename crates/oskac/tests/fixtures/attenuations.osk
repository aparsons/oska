// SPDX-License-Identifier: Apache-2.0
// Every way a program narrows a filesystem capability, for the golden
// tests of the authority report's attenuations.

// A literal root, then a narrower one.
fn docs(read: FsRead) -> DirRead {
    read.restrict_to("docs").restrict_to(Path.new("guide"))
}

fn output(write: FsWrite) -> DirWrite {
    write.restrict_to("_site")
}

// A root named by a module constant is the constant's text (#83).
const SITE: String = "_site"

fn built(write: FsWrite) -> DirWrite {
    write.restrict_to(SITE)
}

// The root is only known when the program runs.
fn named(read: FsRead, name: String) -> DirRead {
    read.restrict_to(name)
}

// A directory narrowed with a path built from untrusted text.
fn per_user(uploads: Dir, name: Untrusted<String>) -> Dir {
    uploads.restrict_to(Path.from(name))
}

// One file: from a trusted literal, and from a path beneath a directory.
fn readme(read: FsRead) -> FileRead {
    read.restrict_to_file("README.md")
}

fn upload(uploads: DirRead, name: Untrusted<String>) -> FileRead {
    uploads.restrict_to_file(Path.from(name))
}

fn page(site: DirWrite) -> FileWrite {
    site.restrict_to_file(Path.new("index.html"))
}

// Passing on less authority has no root.
fn reader(app: Dir) -> DirRead {
    app.read_only()
}

fn writer(app: Dir) -> DirWrite {
    app.write_only()
}

// Whole-filesystem access, written out.
fn everything(fs: Fs) -> Dir {
    fs.restrict_to("/")
}

fn main(fs: Fs) {
    let read = fs.read_only()
    let write = fs.write_only()
    let source = docs(read)
    let site = output(write)
}

// Impls of one trait for two instances of a generic type are named apart,
// in the function list and in the attenuations (#265).
trait Publish {
    fn out(self, write: FsWrite) -> DirWrite
}

struct Site<T> {
    name: T,
}

impl Publish for Site<Int> {
    fn out(self, write: FsWrite) -> DirWrite {
        write.restrict_to("numbered")
    }
}

impl Publish for Site<String> {
    fn out(self, write: FsWrite) -> DirWrite {
        write.restrict_to("named")
    }
}

// The network narrows by host and port, and a listener by port, and each is
// listed with its address (ADR 0023). A host or port known only at run
// time is computed.
fn site(net: Net) -> HostConnect {
    net.connect_only().restrict_to("oskalang.dev", 443)
}

fn local(net: NetConnect) -> HostConnect {
    net.restrict_to("::1", 8080)
}

fn pick(net: NetConnect, host: String, port: Int) -> HostConnect {
    net.restrict_to(host, port)
}

fn serve(net: NetListen) -> LoopbackListen {
    net.restrict_to_loopback(0)
}

// A test narrows too, and is listed under its name (#150).
test "reads a note" {
    let notes = t.fs.read_only().restrict_to("notes")
}
