// SHA-384 is not SHA-512 cut to 48 bytes: it starts from other constants.
test "sha384 is not a truncated sha512" {
    t.assert(sha2.sha384("abc".to_bytes()) != sha2.sha512("abc".to_bytes()).slice(0, 48))
}
