// `sha2.sha384` against FIPS 180-4's examples and digests recorded from
// coreutils' `sha384sum`, on both backends (the native test corpus runs
// every test-bearing fixture). The message of length `n` is the bytes
// `(k * 7 + 3) % 256` for `k` below `n`, made by `message`. The
// one-million-`a` example runs as a program, in `native_kex_primitives.rs`.

use std.sha2

fn hex(text: String) -> Bytes {
    Bytes.from_hex(text).unwrap_or(Bytes.new())
}

fn message(n: Int) -> Bytes {
    var out = Bytes.new()
    for k in 0..n {
        out.push(((k * 7 + 3) % 256).to_u8())
    }
    out
}

// FIPS 180-4's examples: the empty message, "abc", and the two-block
// message of 896 bits.
test "sha384 of the FIPS 180-4 examples" {
    t.assert_eq(sha2.sha384("abc".to_bytes()).to_hex(), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    t.assert_eq(sha2.sha384("".to_bytes()).to_hex(), "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")
    t.assert_eq(sha2.sha384("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu".to_bytes()).to_hex(), "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")
}

