test "sha256 of every length from 0 to 130 bytes" {
    let digests = digests256()
    for n in 0..131 {
        t.assert_eq(sha2.sha256(message(n)).to_hex(), digests.at(n))
    }
}

test "sha512 of every length from 0 to 130 bytes" {
    let digests = digests512()
    for n in 0..131 {
        t.assert_eq(sha2.sha512(message(n)).to_hex(), digests.at(n))
    }
}

test "sha256_secret of every length from 0 to 130 bytes" {
    let digests = digests256()
    for n in 0..131 {
        t.assert_eq(secret256(message(n)), digests.at(n))
    }
}

// A 200-byte message, fed in two pieces at every split point and in three
// with an empty piece between, gives the one-shot digest.
test "Sha256 at every split point of 200 bytes" {
    let data = message(200)
    t.assert_eq(sha2.sha256(data).to_hex(), "2c7e18c942ef065b526a2d4e5546283749cd3ddfb51d8fc71f42717363685f46")
    for at in 0..201 {
        var h = sha2.Sha256.new()
        h.update(data.slice(0, at))
        h.update(Bytes.new())
        h.update(data.slice(at, 200))
        t.assert_eq(h.finish().to_hex(), "2c7e18c942ef065b526a2d4e5546283749cd3ddfb51d8fc71f42717363685f46")
    }
}

test "Sha512 at every split point of 200 bytes" {
    let data = message(200)
    t.assert_eq(sha2.sha512(data).to_hex(), "cca3c0276046ef9f2897bdfc3ec330f77f4959914b1462bd581b232ddb3e9aa98acf5f5a2b21c7f49d2e43721daa61a2b5cee6af6052dfeb766e66ddb0d1719c")
    for at in 0..201 {
        var h = sha2.Sha512.new()
        h.update(data.slice(0, at))
        h.update(Bytes.new())
        h.update(data.slice(at, 200))
        t.assert_eq(h.finish().to_hex(), "cca3c0276046ef9f2897bdfc3ec330f77f4959914b1462bd581b232ddb3e9aa98acf5f5a2b21c7f49d2e43721daa61a2b5cee6af6052dfeb766e66ddb0d1719c")
    }
}

test "Sha256Secret at every split point of 200 bytes" {
    let data = message(200)
    for at in 0..201 {
        var h = sha2.Sha256Secret.new()
        h.update(Secret.new(data.slice(0, at)))
        h.update(Secret.new(Bytes.new()))
        h.update(Secret.new(data.slice(at, 200)))
        t.assert_eq(h.finish().expose().to_hex(), "2c7e18c942ef065b526a2d4e5546283749cd3ddfb51d8fc71f42717363685f46")
    }
}

test "a hasher fed one byte at a time" {
    let data = message(130)
    var a = sha2.Sha256.new()
    var b = sha2.Sha512.new()
    var c = sha2.Sha256Secret.new()
    for k in 0..130 {
        a.update(data.slice(k, k + 1))
        b.update(data.slice(k, k + 1))
        c.update(Secret.new(data.slice(k, k + 1)))
    }
    t.assert_eq(a.finish().to_hex(), digests256().at(130))
    t.assert_eq(b.finish().to_hex(), digests512().at(130))
    t.assert_eq(c.finish().expose().to_hex(), digests256().at(130))
}

// A hasher is a value: a copy made part-way finishes on its own, and the
// original goes on as if no copy were made.
test "a copied hasher forks" {
    var h = sha2.Sha256.new()
    h.update("ab".to_bytes())
    var fork = h
    h.update("c".to_bytes())
    fork.update("d".to_bytes())
    t.assert_eq(h.finish().to_hex(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    t.assert_eq(fork.finish().to_hex(), "a52d159f262b2c6ddb724a61840befc36eb30c88877a4030b65cbe86298449c9")
    var s = sha2.Sha512.new()
    s.update("ab".to_bytes())
    let early = s
    s.update("c".to_bytes())
    t.assert_eq(s.finish().to_hex(), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    t.assert_eq(early.finish().to_hex(), "2d408a0717ec188158278a796c689044361dc6fdde28d6f04973b80896e1823975cdbf12eb63f9e0591328ee235d80e9b5bf1aa6a44f4617ff3caf6400eb172d")
    var k = sha2.Sha256Secret.new()
    k.update(Secret.new("ab".to_bytes()))
    var other = k
    k.update(Secret.new("c".to_bytes()))
    other.update(Secret.new("d".to_bytes()))
    t.assert_eq(k.finish().expose().to_hex(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    t.assert_eq(other.finish().expose().to_hex(), "a52d159f262b2c6ddb724a61840befc36eb30c88877a4030b65cbe86298449c9")
}

test "a digest of untrusted bytes is trusted" {
    let raw: Untrusted<Bytes> = "abc".to_bytes()
    let digest: Bytes = sha2.sha256(raw)
    t.assert_eq(digest.len(), 32)
    t.assert_eq(sha2.sha512(raw).len(), 64)
}
