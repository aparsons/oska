// SPDX-License-Identifier: Apache-2.0
// `std.sha2` against FIPS 180-4's examples and digests recorded from
// coreutils' `sha256sum`, `sha384sum` and `sha512sum`, on both backends (the native
// test corpus runs every test-bearing fixture). The message of length `n`
// is the bytes `(k * 7 + 3) % 256` for `k` below `n`, made by `message`.
// The one-million-`a` example runs as a program, in `native_sha2.rs`.

use std.sha2

fn hex(text: String) -> Bytes {
    Bytes.from_hex(text).unwrap_or(Bytes.new())
}

fn message(n: Int) -> Bytes {
    var out = Bytes.new()
    for k in 0..n {
        out.push(((k * 7 + 3) % 256).to_u8())
    }
    out
}

fn secret256(data: Bytes) -> String {
    sha2.sha256_secret(Secret.new(data)).expose().to_hex()
}

// FIPS 180-4's examples (and NIST's example computations): "abc", and the
// two-block messages of 448 bits (SHA-256) and 896 bits (SHA-512).
test "sha256 of the FIPS 180-4 examples" {
    t.assert_eq(sha2.sha256("abc".to_bytes()).to_hex(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    t.assert_eq(sha2.sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".to_bytes()).to_hex(), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
}

test "sha512 of the FIPS 180-4 examples" {
    t.assert_eq(sha2.sha512("abc".to_bytes()).to_hex(), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    t.assert_eq(sha2.sha512("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu".to_bytes()).to_hex(), "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")
}

// FIPS 180-4's SHA-384 examples ("abc", the 896-bit message, and the empty
// message), and digests of the fixture's messages for every
// length from 0 to 130 bytes.
test "sha384 of the FIPS 180-4 examples" {
    t.assert_eq(sha2.sha384("abc".to_bytes()).to_hex(), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    t.assert_eq(sha2.sha384("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu".to_bytes()).to_hex(), "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")
    t.assert_eq(sha2.sha384(Bytes.new()).to_hex(), "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")
}

