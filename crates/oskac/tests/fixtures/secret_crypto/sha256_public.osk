// The SHA-256 compression function (FIPS 180-4) over public words,
// on the padded one-block messages "abc" and "", against their digests.
fn constants() -> List<U32> {
    [
    1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
    3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
    3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
    2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
    666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
    2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
    1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298
    ]
}
fn big_s0(x: U32) -> U32 {
    x.rotr(2) ^ x.rotr(13) ^ x.rotr(22)
}

fn big_s1(x: U32) -> U32 {
    x.rotr(6) ^ x.rotr(11) ^ x.rotr(25)
}

fn small_s0(x: U32) -> U32 {
    x.rotr(7) ^ x.rotr(18) ^ (x >> 3)
}

fn small_s1(x: U32) -> U32 {
    x.rotr(17) ^ x.rotr(19) ^ (x >> 10)
}

fn ch(e: U32, f: U32, g: U32) -> U32 {
    (e & f) ^ (~e & g)
}

fn maj(a: U32, b: U32, c: U32) -> U32 {
    (a & b) ^ (a & c) ^ (b & c)
}

struct Digest { h0: U32, h1: U32, h2: U32, h3: U32, h4: U32, h5: U32, h6: U32, h7: U32 }

fn compress(h: Digest, block: Bytes) -> Digest {
    let k = constants()
    var w: List<U32> = List.new()
    for t in 0..16 {
        w.push(block.read_u32_be(t * 4))
    }
    for t in 16..64 {
        let s1 = small_s1(w.at(t - 2))
        let s0 = small_s0(w.at(t - 15))
        w.push(s1.wrapping_add(w.at(t - 7)).wrapping_add(s0.wrapping_add(w.at(t - 16))))
    }
    var a = h.h0
    var b = h.h1
    var c = h.h2
    var d = h.h3
    var e = h.h4
    var f = h.h5
    var g = h.h6
    var hh = h.h7
    for t in 0..64 {
        let t1 = hh.wrapping_add(big_s1(e)).wrapping_add(ch(e, f, g).wrapping_add(k.at(t))).wrapping_add(w.at(t))
        let t2 = big_s0(a).wrapping_add(maj(a, b, c))
        hh = g
        g = f
        f = e
        e = d.wrapping_add(t1)
        d = c
        c = b
        b = a
        a = t1.wrapping_add(t2)
    }
    Digest(h0: h.h0.wrapping_add(a), h1: h.h1.wrapping_add(b), h2: h.h2.wrapping_add(c), h3: h.h3.wrapping_add(d), h4: h.h4.wrapping_add(e), h5: h.h5.wrapping_add(f), h6: h.h6.wrapping_add(g), h7: h.h7.wrapping_add(hh))
}

fn digest(stdout: Stdout, message: Bytes) {
    var block = message
    block.push(128)
    while block.len() < 56 {
        block.push(0)
    }
    block.push_u64_be((message.len() * 8).to_u64())
    let start = Digest(h0: 1779033703, h1: 3144134277, h2: 1013904242, h3: 2773480762, h4: 1359893119, h5: 2600822924, h6: 528734635, h7: 1541459225)
    let h = compress(start, block)
    var out = Bytes.new()
    out.push_u32_be(h.h0)
    out.push_u32_be(h.h1)
    out.push_u32_be(h.h2)
    out.push_u32_be(h.h3)
    out.push_u32_be(h.h4)
    out.push_u32_be(h.h5)
    out.push_u32_be(h.h6)
    out.push_u32_be(h.h7)
    let text = out.to_hex()
    let _ = stdout.println(text)
}

fn main(stdout: Stdout) {
    digest(stdout, Bytes.from_hex("616263").unwrap_or(Bytes.new()))
    digest(stdout, Bytes.new())
}
