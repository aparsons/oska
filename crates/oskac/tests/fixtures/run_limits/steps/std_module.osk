// Steps: 2. A call into a `std` module is a step when the function is
// written in Oska. Every function `std.html` declares is implemented in
// the runtime today, as `println` is, so its calls are no step; the
// calls of `heading`, an Oska function that uses it, are.
//
// - `heading("a<b")` and `heading("c")`: 2.
// - `html.text`, `Html.concat` and `Html.render` (runtime): 0.
use std.html

fn heading(text: String) -> html.Html {
    html.Html.raw(html.TrustedHtml.new("<h1>")).concat(html.text(text))
}

fn main(io: Stdout) {
    let page = heading("a<b").concat(heading("c"))
    let _ = io.println(page.render())
}
