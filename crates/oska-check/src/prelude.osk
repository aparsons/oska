// The prelude: what every module sees without `use`. It has the built-in
// capabilities, `Option`, `Result`, `List` and the methods of `String`,
// the types tests and structured concurrency use, and the core traits.
// The primitive types (`Int`, the sized integers `I8` to `U64`, `Bool`,
// `String`) and `()` are built into the language.
//
// A capability is a value that grants authority, such as `Stdout` or
// `FsRead`. Only `main` receives the built-in ones, as parameters, and no
// code can construct one: a function can reach only the capabilities it
// is passed. Most of them narrow to a smaller capability, never a larger
// one (ADR 0008).
//
// Trust (ADR 0006): a `String` parameter or result is trusted text, a
// **structural position**. `Untrusted<String>` is untrusted text: sources
// return it, and a **data position** declares it, which also accepts
// trusted text.
//
// A text operation marked `#[follows_trust]` is trust-polymorphic: its
// receiver and every `String` in its parameters accept text of either
// trust, and every `String` in its result is untrusted when any of them
// is untrusted. Results that are not text, such as `Int` or `Bool`, are
// trusted. Without the attribute, `String` means trusted everywhere, the
// receiver included.

// For maintainers: this file is parsed in prelude mode, so functions may
// omit their bodies (the runtime implements them) and `#[capability]`
// marks a built-in capability, whose fields are private. Grow it only as
// the examples and the tests need it. The comment block directly above a
// `pub` item is its description in the API reference (`oskac doc` and
// oskalang.dev/api/), so write it for a reader of the API.

// ---- Built-in capabilities -------------------------------------------

// Standard input. `main` declares it to read lines that the user or
// another program sends.
#[capability]
pub struct Stdin { handle: Int }

impl Stdin {
    // The next line, without its line break, or `None` at end of input.
    pub fn read_line(self) -> Result<Option<Untrusted<String>>, IoError>
}

// Standard output.
#[capability]
pub struct Stdout { handle: Int }

impl Stdout {
    // Write `line` and a line break. Any text may be written: output is a
    // data position.
    pub fn println(self, line: Untrusted<String>) -> Result<(), IoError>
}

// Standard error, for messages about the program's own run.
#[capability]
pub struct Stderr { handle: Int }

impl Stderr {
    // Write `line` and a line break.
    pub fn println(self, line: Untrusted<String>) -> Result<(), IoError>
}

// The filesystem capabilities `main` declares. Their `restrict_to`
// attenuates to a directory capability for `dir`, a trusted path: a
// structural position, so untrusted text can never choose which part of
// the filesystem a program gets (ADR 0008). Attenuation never fails: a
// root that cannot be opened, because it is missing, the wrong kind, or a
// symlink, gives a capability whose every operation returns an `IoError`
// naming the root and the reason.
//
// `Fs`, `FsRead` and `FsWrite` only attenuate: they have no method that
// takes a path. Reading and writing go through a directory or file
// capability, and a call of a removed method gets `E0273`.
#[capability]
pub struct Fs { handle: Int }

impl Fs {
    // The directory capability for `dir` and everything beneath it.
    pub fn restrict_to(self, dir: String) -> Dir
    // The same reach, for reading only.
    pub fn read_only(self) -> FsRead
    // The same reach, for writing only.
    pub fn write_only(self) -> FsWrite
}

// Read access to the filesystem, as `main` declares it. Narrow it with
// `restrict_to` or `restrict_to_file` before reading.
#[capability]
pub struct FsRead { handle: Int }

impl FsRead {
    // The read-only directory capability for `dir`, a trusted path, and
    // everything beneath it.
    pub fn restrict_to(self, dir: String) -> DirRead
    // The file capability for the one file at `file`, which must be
    // trusted text. See `FileRead`.
    pub fn restrict_to_file(self, file: String) -> FileRead
}

// Write access to the filesystem, as `main` declares it. Narrow it with
// `restrict_to` or `restrict_to_file` before writing.
#[capability]
pub struct FsWrite { handle: Int }

impl FsWrite {
    // The write-only directory capability for `dir`, a trusted path, and
    // everything beneath it.
    pub fn restrict_to(self, dir: String) -> DirWrite
    // The file capability for the one file at `file`, which must be
    // trusted text. See `FileWrite`.
    pub fn restrict_to_file(self, file: String) -> FileWrite
}

// A directory capability: it reaches only its root directory and
// everything beneath it. A `Path` given to one is relative to the root,
// and may come from untrusted text, through `Path.from`: an empty or
// absolute path, `..` that climbs above the root, and a symlink anywhere
// beneath the root are refused with an `IoError`. `..` that stays inside
// the root is resolved as written.
//
// `restrict_to` narrows to the subdirectory at `dir`, which stays under
// the same root, so its `Path` may be untrusted. A `dir` that is a file is
// not a directory, and the result reaches nothing. `restrict_to_file` on
// `DirRead` and `DirWrite` is the way to a single file.
#[capability]
pub struct Dir { handle: Int }

impl Dir {
    // The capability for the subdirectory at `dir`, beneath this root.
    pub fn restrict_to(self, dir: Path) -> Dir
    // The same directory, for reading only.
    pub fn read_only(self) -> DirRead
    // The same directory, for writing only.
    pub fn write_only(self) -> DirWrite
}

// A directory capability that only reads. See `Dir`.
#[capability]
pub struct DirRead { handle: Int }

impl DirRead {
    // The capability for the subdirectory at `dir`, beneath this root.
    pub fn restrict_to(self, dir: Path) -> DirRead
    // The file capability for the file at `file` beneath the root, which
    // may be named by untrusted text through `Path.from`. See `FileRead`.
    pub fn restrict_to_file(self, file: Path) -> FileRead
    // The whole file at `path`, as text. What a file holds comes from
    // outside the program, so it is untrusted.
    pub fn read_to_string(self, path: Path) -> Result<Untrusted<String>, IoError>
    // The names of the entries of the directory at `path` (`"."` is the
    // root itself), sorted so the order is the same on every host. A name
    // comes from outside the program, so it is untrusted.
    pub fn list_dir(self, path: Path) -> Result<List<Untrusted<String>>, IoError>
}

// A directory capability that only writes. See `Dir`.
#[capability]
pub struct DirWrite { handle: Int }

impl DirWrite {
    // The capability for the subdirectory at `dir`, beneath this root.
    pub fn restrict_to(self, dir: Path) -> DirWrite
    // The file capability for the file at `file` beneath the root, which
    // may be named by untrusted text through `Path.from`. See `FileWrite`.
    pub fn restrict_to_file(self, file: Path) -> FileWrite
    // Create the file at `path`, or replace what it holds, with
    // `contents`. A symlink at `path` is never followed.
    pub fn write(self, path: Path, contents: Untrusted<String>) -> Result<(), IoError>
    // Create the directory at `path`; its parent must exist. A directory
    // already there is kept, with everything in it, and anything else
    // there is an error. A symlink at `path` is never followed.
    pub fn create_dir(self, path: Path) -> Result<(), IoError>
}

// A file capability: it reaches exactly one file, and takes no path. It
// holds its parent directory and the file's name, and each use opens that
// name beneath the directory without following a symlink, so a file
// replaced between uses can never lead outside. The file is not checked
// when the capability is made: a missing parent directory, or a name that
// is not a plain file, makes every operation return an `IoError`. There is
// no capability that both reads and writes one file.
#[capability]
pub struct FileRead { handle: Int }

impl FileRead {
    // The whole file, as text. What a file holds comes from outside the
    // program, so it is untrusted.
    pub fn read_to_string(self) -> Result<Untrusted<String>, IoError>
}

// A file capability that only writes. See `FileRead`.
#[capability]
pub struct FileWrite { handle: Int }

impl FileWrite {
    // Create the file, or replace what it holds, with `contents`.
    pub fn write(self, contents: Untrusted<String>) -> Result<(), IoError>
}

// Network access, as `main` declares it. It has no runtime yet: a
// program that is given it checks, but `oskac run` refuses it (`E0370`).
#[capability]
pub struct Net { handle: Int }

impl Net {
    // The capability to open connections, and nothing else.
    pub fn connect_only(self) -> NetConnect
    // The capability to accept connections, and nothing else.
    pub fn listen_only(self) -> NetListen
}

// The capability to open network connections. No runtime yet, like `Net`.
#[capability]
pub struct NetConnect { handle: Int }

impl NetConnect {
    // Connect to `host`. The host decides where the program connects, so
    // it is structural: untrusted text can't redirect it (SSRF).
    pub fn connect(self, host: String, port: Int) -> Result<Connection, IoError>
}

// An open connection to one host. It carries the authority to talk to
// that host, so it is capability-bearing, and it can't be forged.
pub cap struct Connection { net: NetConnect }

impl Connection {
    // A request body is data: it may be untrusted.
    pub fn send(self, body: Untrusted<String>) -> Result<(), IoError>
    // What the host sent back: text from outside the program.
    pub fn receive(self) -> Result<Untrusted<String>, IoError>
}

// The capability to accept network connections. It has no methods yet,
// and no runtime, like `Net`.
#[capability]
pub struct NetListen { handle: Int }

// The process environment: its variables and its secrets.
#[capability]
pub struct Env { handle: Int }

impl Env {
    // The environment variable `name`, or `None` when it is not set.
    pub fn get(self, name: String) -> Option<Untrusted<String>>
    // The secret `name`, such as an API token.
    pub fn secret(self, name: String) -> Secret<String>
}

// A secret value. It has no `Display` and no `Eq`, and cannot be
// interpolated: compare it with `constant_time_eq`, and read it with
// `expose`, which is an audit site.
pub struct Secret<T> { value: T }

impl<T> Secret<T> {
    // The secret's value. Every call is an audit site.
    pub fn expose(self) -> T
}

impl Secret<String> {
    // Compare without leaking timing information.
    pub fn constant_time_eq(self, other: Untrusted<String>) -> Bool
    // Compare with another secret without leaking timing information,
    // and without exposing either.
    pub fn constant_time_eq_secret(self, other: Secret<String>) -> Bool
}

// The wall clock. A test's `t.clock` is fixed.
#[capability]
pub struct Clock { handle: Int }

impl Clock {
    // Milliseconds since the Unix epoch.
    pub fn now_millis(self) -> Int
}

// A source of random numbers. A test's `t.random` is seeded, so a test
// gets the same numbers on every run.
#[capability]
pub struct Random { handle: Int }

impl Random {
    // A pseudo-random integer from 0 up to, but excluding, 2^63.
    pub fn next_int(self) -> Int
}

// Channels and `select`, for concurrency that is not deterministic. It
// has no methods and no runtime yet (`E0370`). `scope` and `spawn` need
// no capability.
#[capability]
pub struct Sched { handle: Int }

// The capability to start processes, which `std.proc` takes. It has no
// runtime yet (`E0370`).
#[capability]
pub struct Spawn { handle: Int }

// ---- Tests ---------------------------------------------------------------

// The type of `t`, the built-in value in every `test` body. Its fields are
// stand-in capabilities: an in-memory `fs`, a fixed `clock`, a seeded
// `random`, and a recording `stdout`. An `#[integration]` test gets the
// same `t`; the runtime decides which capabilities are real. A failed
// assertion fails the test.
pub cap struct TestContext {
    pub fs: Fs,
    pub clock: Clock,
    pub random: Random,
    pub stdout: Stdout,
}

impl TestContext {
    // Fail the test unless `cond` is true.
    pub fn assert(self, cond: Bool)
    // Fail the test unless `actual` equals `expected`.
    pub fn assert_eq<T: Eq>(self, actual: T, expected: T)
    // Fail the test if `actual` equals `other`.
    pub fn assert_ne<T: Eq>(self, actual: T, other: T)
    // Fail the test with `message`.
    pub fn fail(self, message: String)
    // Compare `value`, rendered as `dbg` renders it, with its stored
    // snapshot, `snapshots/<test-file>/<test-name>.snap`. The test runner
    // reads and writes the file, after the test has run: a missing or
    // different snapshot fails the test, and `oskac test --update`
    // writes it instead.
    pub fn assert_snapshot<T>(self, value: T)
    // Every line printed to `stdout` so far in this test, one per
    // `println`, without its line break.
    pub fn printed(self) -> List<Untrusted<String>>
}

// ---- Core types --------------------------------------------------------

// A value that may be missing: `Some(value)`, or `None`.
pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    // `Ok` with the value, or `Err(err)` when there is none, ready for
    // `?`.
    pub fn ok_or<E>(self, err: E) -> Result<T, E>
    // Whether there is a value.
    pub fn is_some(self) -> Bool
    // The value, or `default` when there is none.
    pub fn unwrap_or(self, default: T) -> T
}

// The outcome of an operation that can fail: `Ok(value)`, or `Err(error)`.
// `?` returns an `Err` from the enclosing function.
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    // Whether it is `Ok`.
    pub fn is_ok(self) -> Bool
    // The `Ok` value, or `default` for an `Err`.
    pub fn unwrap_or(self, default: T) -> T
}

// A growable list. `[a, b, c]` makes one, and `for item in list` visits
// its items in order.
pub struct List<T> { handle: Int }

impl<T> List<T> {
    // An empty list.
    pub fn new() -> List<T>
    // Add `item` at the end. The list must be a `var`.
    pub fn push(var self, item: T)
    // The number of items.
    pub fn len(self) -> Int
    // The number of items, the same as `len`.
    pub fn count(self) -> Int
    // The item at `index`, from 0, or `None` when the index is out of
    // bounds.
    pub fn get(self, index: Int) -> Option<T>
    // The item at `index`. An index out of bounds is a bug: it panics
    // (`P0002`). Use `get` when the index may be out of bounds.
    pub fn at(self, index: Int) -> T
    // A new list of `f` applied to each item, in order.
    pub fn map<U>(self, f: fn(T) -> U) -> List<U>
}

// `start..end`, which excludes `end`.
pub struct Range<T> { pub start: T, pub end: T }

// Methods of text. Each follows trust (see the prelude's description): it
// accepts trusted or untrusted text, and its text result is untrusted
// when any text it was given is.
impl String {
    // The lines, without their line breaks.
    #[follows_trust]
    pub fn lines(self) -> List<String>
    // The number of characters (Unicode code points).
    #[follows_trust]
    pub fn len(self) -> Int
    // The number of bytes in its UTF-8 encoding.
    #[follows_trust]
    pub fn byte_len(self) -> Int
    // Without leading and trailing whitespace.
    #[follows_trust]
    pub fn trim(self) -> String
    // The pieces between occurrences of `separator`.
    #[follows_trust]
    pub fn split(self, separator: String) -> List<String>
    // Whether `needle` occurs in it.
    #[follows_trust]
    pub fn contains(self, needle: String) -> Bool
    // Whether it starts with `prefix`.
    #[follows_trust]
    pub fn starts_with(self, prefix: String) -> Bool
    // Whether it ends with `suffix`.
    #[follows_trust]
    pub fn ends_with(self, suffix: String) -> Bool
    // Every occurrence of `from` replaced by `to`. An empty `from`
    // occurs nowhere.
    #[follows_trust]
    pub fn replace(self, from: String, to: String) -> String
    // `parts` with the text between each two: `",".join(["a", "b"])` is
    // `"a,b"`.
    #[follows_trust]
    pub fn join(self, parts: List<String>) -> String
    // Each character (Unicode code point) as a text of its own, in order.
    #[follows_trust]
    pub fn chars(self) -> List<String>
    // The characters from index `start` up to, but excluding, `end`. An
    // index out of bounds, or `start` past `end`, is a bug: it panics
    // (`P0035`).
    #[follows_trust]
    pub fn slice(self, start: Int, end: Int) -> String
    // The text `times` times over. A negative count panics (`P0036`), and
    // so does a result too long to build (`P0037`).
    #[follows_trust]
    pub fn repeat(self, times: Int) -> String
    // Every letter in lower case, by Unicode's rules, one character at a
    // time: `"ÀB".to_lowercase()` is `"àb"`. A capital sigma is always
    // `σ`, wherever it stands.
    #[follows_trust]
    pub fn to_lowercase(self) -> String
    // The decimal integer the whole text spells, if it is one.
    #[follows_trust]
    pub fn parse_int(self) -> Option<Int>
}

impl Untrusted<String> {
    // A trust assertion: a validator vouches for text it has checked.
    // Every call is an audit site.
    pub fn assume_trusted(self) -> String
}

// A path, relative to a directory capability's root. A directory
// capability refuses one that would leave its root.
pub struct Path { raw: String }

impl Path {
    // A path from trusted text, such as a literal.
    pub fn new(raw: String) -> Path
    // A path from untrusted text, such as a name a user typed. It is safe
    // because the directory capability it is given to confines it.
    pub fn from(raw: Untrusted<String>) -> Path
}

// The program's command-line arguments: a program input, not a capability.
pub struct Args { handle: Int }

impl Args {
    // The argument at `index`, or `None`. Index 0 is the program's own
    // path.
    // An argument comes from outside the program, so it is untrusted.
    pub fn get(self, index: Int) -> Option<Untrusted<String>>
}

// Plain data: code may construct one to report its own failures.
pub struct IoError { pub message: Untrusted<String> }

impl Display for IoError {
    fn to_string(self) -> String
}

// ---- Structured concurrency ---------------------------------------------

// The handle `scope |s| { ... }` binds. A scope does not exit until all of
// its tasks have finished. Deterministic parallelism needs no capability,
// so a scope is plain data.
pub struct Scope { handle: Int }

impl Scope {
    // Start `task` in parallel, inside this scope. A spawned task may
    // perform effects, so it is a `cap fn`; a pure closure fits too.
    pub fn spawn<T>(self, task: cap fn() -> T) -> Task<T>
}

// A running task. `join` waits for it and returns its result.
pub struct Task<T> { handle: Int }

impl<T> Task<T> {
    // Wait for the task to finish, and return its result.
    pub fn join(self) -> T
}

// ---- Core functions ----------------------------------------------------

// Print `value` for debugging and return it. An error under `--release`.
pub fn dbg<T>(value: T) -> T

// A placeholder for code not yet written: it fits any type, and fails
// when reached. The fix for a non-exhaustive `match` uses it as the body
// of each arm it adds.
pub fn todo<T>() -> T

// ---- Core traits -------------------------------------------------------

// Equality: `==` and `!=` need `Eq`. `()` is `Eq` without an impl.
pub trait Eq {
    // Whether `self` equals `other`.
    #[follows_trust]
    fn eq(self, other: Self) -> Bool
}

impl Eq for Int { fn eq(self, other: Int) -> Bool }
impl Eq for I8 { fn eq(self, other: I8) -> Bool }
impl Eq for I16 { fn eq(self, other: I16) -> Bool }
impl Eq for I32 { fn eq(self, other: I32) -> Bool }
impl Eq for I64 { fn eq(self, other: I64) -> Bool }
impl Eq for U8 { fn eq(self, other: U8) -> Bool }
impl Eq for U16 { fn eq(self, other: U16) -> Bool }
impl Eq for U32 { fn eq(self, other: U32) -> Bool }
impl Eq for U64 { fn eq(self, other: U64) -> Bool }
impl Eq for Bool { fn eq(self, other: Bool) -> Bool }
impl Eq for String { fn eq(self, other: String) -> Bool }
impl Eq for Path { fn eq(self, other: Path) -> Bool }
impl Eq for IoError { fn eq(self, other: IoError) -> Bool }
impl<T: Eq> Eq for Option<T> { fn eq(self, other: Option<T>) -> Bool }
impl<T: Eq, E: Eq> Eq for Result<T, E> { fn eq(self, other: Result<T, E>) -> Bool }
impl<T: Eq> Eq for List<T> { fn eq(self, other: List<T>) -> Bool }

// A value that can be hashed.
pub trait Hash {
    // A hash of the value.
    #[follows_trust]
    fn hash(self) -> Int
}

// A value with a text form, which `"{value}"` interpolation uses.
pub trait Display {
    // The value as text.
    #[follows_trust]
    fn to_string(self) -> String
}

impl Display for String {
    fn to_string(self) -> String
}

impl Display for Int {
    fn to_string(self) -> String
}

// A conversion from `T`. `?` uses it to turn one error type into
// another.
pub trait From<T> {
    // The value made from `value`.
    fn from(value: T) -> Self
}
