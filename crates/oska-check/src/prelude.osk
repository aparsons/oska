// The Oska prelude: declarations every module sees without `use`.
//
// It is parsed in prelude mode, so functions may omit their bodies (the
// runtime implements them) and `#[capability]` marks a built-in
// capability. A capability's fields are private, so code outside the
// prelude cannot construct one.
//
// The primitive types (`Int`, the sized integers, `Bool`, `String`) and
// `()` are built into the checker, not declared here.
//
// Grow this file only as the examples and the tests need it.
//
// Trust (ADR 0006): a `String` parameter or result is trusted text, a
// **structural position**. `Untrusted<String>` is untrusted text: sources
// return it, and a **data position** declares it, which also accepts
// trusted text.
//
// A text operation marked `#[follows_trust]` is trust-polymorphic: its
// receiver and every `String` in its parameters accept text of either
// trust, and every `String` in its result is untrusted when any of them
// is untrusted. Results that are not text, such as `Int` or `Bool`, are
// trusted. Without the attribute, `String` means trusted everywhere, the
// receiver included.

// ---- Built-in capabilities -------------------------------------------

#[capability]
pub struct Stdin { handle: Int }

impl Stdin {
    // The next line, without its line break, or `None` at end of input.
    pub fn read_line(self) -> Result<Option<Untrusted<String>>, IoError>
}

#[capability]
pub struct Stdout { handle: Int }

impl Stdout {
    pub fn println(self, line: Untrusted<String>) -> Result<(), IoError>
}

#[capability]
pub struct Stderr { handle: Int }

impl Stderr {
    pub fn println(self, line: Untrusted<String>) -> Result<(), IoError>
}

#[capability]
pub struct Fs { handle: Int }

impl Fs {
    pub fn restrict_to(self, dir: String) -> Fs
    pub fn read_only(self) -> FsRead
    pub fn write_only(self) -> FsWrite
}

#[capability]
pub struct FsRead { handle: Int }

impl FsRead {
    pub fn restrict_to(self, dir: String) -> FsRead
    pub fn read_to_string(self, path: Path) -> Result<Untrusted<String>, IoError>
}

#[capability]
pub struct FsWrite { handle: Int }

impl FsWrite {
    pub fn restrict_to(self, dir: String) -> FsWrite
    // Create the file at `path`, or replace what it holds, with
    // `contents`.
    pub fn write(self, path: Path, contents: Untrusted<String>) -> Result<(), IoError>
}

#[capability]
pub struct Net { handle: Int }

impl Net {
    pub fn connect_only(self) -> NetConnect
    pub fn listen_only(self) -> NetListen
}

#[capability]
pub struct NetConnect { handle: Int }

impl NetConnect {
    // Connect to `host`. The host decides where the program connects, so
    // it is structural: untrusted text can't redirect it (SSRF).
    pub fn connect(self, host: String, port: Int) -> Result<Connection, IoError>
}

// An open connection to one host. It carries the authority to talk to
// that host, so it is capability-bearing, and it can't be forged.
pub cap struct Connection { net: NetConnect }

impl Connection {
    // A request body is data: it may be untrusted.
    pub fn send(self, body: Untrusted<String>) -> Result<(), IoError>
    // What the host sent back: text from outside the program.
    pub fn receive(self) -> Result<Untrusted<String>, IoError>
}

#[capability]
pub struct NetListen { handle: Int }

#[capability]
pub struct Env { handle: Int }

impl Env {
    // The environment variable `name`, or `None` when it is not set.
    pub fn get(self, name: String) -> Option<Untrusted<String>>
    // The secret `name`, such as an API token.
    pub fn secret(self, name: String) -> Secret<String>
}

// A secret value. It has no `Display` and no `Eq`, and cannot be
// interpolated: compare it with `constant_time_eq`, and read it with
// `expose`, which is an audit site.
pub struct Secret<T> { value: T }

impl<T> Secret<T> {
    // The secret's value. Every call is an audit site.
    pub fn expose(self) -> T
}

impl Secret<String> {
    // Compare without leaking timing information.
    pub fn constant_time_eq(self, other: Untrusted<String>) -> Bool
    // Compare with another secret without leaking timing information,
    // and without exposing either.
    pub fn constant_time_eq_secret(self, other: Secret<String>) -> Bool
}

#[capability]
pub struct Clock { handle: Int }

impl Clock {
    // Milliseconds since the Unix epoch.
    pub fn now_millis(self) -> Int
}

#[capability]
pub struct Random { handle: Int }

impl Random {
    // A pseudo-random integer from 0 up to, but excluding, 2^63.
    pub fn next_int(self) -> Int
}

#[capability]
pub struct Sched { handle: Int }

#[capability]
pub struct Spawn { handle: Int }

// ---- Tests ---------------------------------------------------------------

// The type of `t`, the built-in value in every `test` body. Its fields are
// stand-in capabilities: an in-memory `fs`, a fixed `clock`, a seeded
// `random`, and a recording `stdout`. An `#[integration]` test gets the
// same `t`; the runtime decides which capabilities are real. A failed
// assertion fails the test.
pub cap struct TestContext {
    pub fs: Fs,
    pub clock: Clock,
    pub random: Random,
    pub stdout: Stdout,
}

impl TestContext {
    pub fn assert(self, cond: Bool)
    pub fn assert_eq<T: Eq>(self, actual: T, expected: T)
    pub fn assert_ne<T: Eq>(self, actual: T, other: T)
    pub fn fail(self, message: String)
}

// ---- Core types --------------------------------------------------------

pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    pub fn ok_or<E>(self, err: E) -> Result<T, E>
    pub fn is_some(self) -> Bool
    // The value, or `default` when there is none.
    pub fn unwrap_or(self, default: T) -> T
}

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> Bool
    // The `Ok` value, or `default` for an `Err`.
    pub fn unwrap_or(self, default: T) -> T
}

// A growable list. Its representation is built in.
pub struct List<T> { handle: Int }

impl<T> List<T> {
    pub fn new() -> List<T>
    pub fn push(var self, item: T)
    pub fn len(self) -> Int
    pub fn count(self) -> Int
    pub fn get(self, index: Int) -> Option<T>
    // The item at `index`. An index out of bounds is a bug: it panics
    // (`P0002`). Use `get` when the index may be out of bounds.
    pub fn at(self, index: Int) -> T
    pub fn map<U>(self, f: fn(T) -> U) -> List<U>
}

// `start..end`, which excludes `end`.
pub struct Range<T> { pub start: T, pub end: T }

impl String {
    #[follows_trust]
    pub fn lines(self) -> List<String>
    // The number of characters (Unicode code points).
    #[follows_trust]
    pub fn len(self) -> Int
    // The number of bytes in its UTF-8 encoding.
    #[follows_trust]
    pub fn byte_len(self) -> Int
    // Without leading and trailing whitespace.
    #[follows_trust]
    pub fn trim(self) -> String
    // The pieces between occurrences of `separator`.
    #[follows_trust]
    pub fn split(self, separator: String) -> List<String>
    #[follows_trust]
    pub fn contains(self, needle: String) -> Bool
    // The decimal integer the whole text spells, if it is one.
    #[follows_trust]
    pub fn parse_int(self) -> Option<Int>
}

impl Untrusted<String> {
    // A trust assertion: a validator vouches for text it has checked.
    // Every call is an audit site.
    pub fn assume_trusted(self) -> String
}

pub struct Path { raw: String }

impl Path {
    pub fn new(raw: String) -> Path
    pub fn from(raw: Untrusted<String>) -> Path
}

// The program's command-line arguments: a program input, not a capability.
pub struct Args { handle: Int }

impl Args {
    pub fn get(self, index: Int) -> Option<Untrusted<String>>
}

// Plain data: code may construct one to report its own failures.
pub struct IoError { pub message: Untrusted<String> }

impl Display for IoError {
    fn to_string(self) -> String
}

// ---- Structured concurrency ---------------------------------------------

// The handle `scope |s| { ... }` binds. A scope does not exit until all of
// its tasks have finished. Deterministic parallelism needs no capability,
// so a scope is plain data.
pub struct Scope { handle: Int }

// A spawned task may perform effects, so it is a `cap fn`; a pure closure
// fits too.
impl Scope {
    pub fn spawn<T>(self, task: cap fn() -> T) -> Task<T>
}

// A running task. `join` waits for it and returns its result.
pub struct Task<T> { handle: Int }

impl<T> Task<T> {
    pub fn join(self) -> T
}

// ---- Core functions ----------------------------------------------------

// Print `value` for debugging and return it. An error under `--release`.
pub fn dbg<T>(value: T) -> T

// A placeholder for code not yet written: it fits any type, and fails
// when reached. The fix for a non-exhaustive `match` uses it as the body
// of each arm it adds.
pub fn todo<T>() -> T

// ---- Core traits -------------------------------------------------------

pub trait Eq {
    #[follows_trust]
    fn eq(self, other: Self) -> Bool
}

// `==` and `!=` need `Eq`. `()` is `Eq` without an impl.
impl Eq for Int { fn eq(self, other: Int) -> Bool }
impl Eq for I8 { fn eq(self, other: I8) -> Bool }
impl Eq for I16 { fn eq(self, other: I16) -> Bool }
impl Eq for I32 { fn eq(self, other: I32) -> Bool }
impl Eq for I64 { fn eq(self, other: I64) -> Bool }
impl Eq for U8 { fn eq(self, other: U8) -> Bool }
impl Eq for U16 { fn eq(self, other: U16) -> Bool }
impl Eq for U32 { fn eq(self, other: U32) -> Bool }
impl Eq for U64 { fn eq(self, other: U64) -> Bool }
impl Eq for Bool { fn eq(self, other: Bool) -> Bool }
impl Eq for String { fn eq(self, other: String) -> Bool }
impl Eq for Path { fn eq(self, other: Path) -> Bool }
impl Eq for IoError { fn eq(self, other: IoError) -> Bool }
impl<T: Eq> Eq for Option<T> { fn eq(self, other: Option<T>) -> Bool }
impl<T: Eq, E: Eq> Eq for Result<T, E> { fn eq(self, other: Result<T, E>) -> Bool }
impl<T: Eq> Eq for List<T> { fn eq(self, other: List<T>) -> Bool }

pub trait Hash {
    #[follows_trust]
    fn hash(self) -> Int
}

pub trait Display {
    #[follows_trust]
    fn to_string(self) -> String
}

impl Display for String {
    fn to_string(self) -> String
}

impl Display for Int {
    fn to_string(self) -> String
}

pub trait From<T> {
    fn from(value: T) -> Self
}
