// The prelude: what every module sees without `use`. It has the built-in
// capabilities, `Option`, `Result`, `List` and the methods of `String`,
// the types tests and structured concurrency use, and the core traits.
// The primitive types (`Int`, the sized integers `I8` to `U64`, `Bool`,
// `String`) and `()` are built into the language.
//
// A capability is a value that grants authority, such as `Stdout` or
// `FsRead`. Only `main` receives the built-in ones, as parameters, and no
// code can construct one: a function can reach only the capabilities it
// is passed. Most of them narrow to a smaller capability, never a larger
// one (ADR 0008).
//
// Trust (ADR 0006): a `String` parameter or result is trusted text, a
// **structural position**. `Untrusted<String>` is untrusted text: sources
// return it, and a **data position** declares it, which also accepts
// trusted text. `Bytes` carries the same flag (#223): `Untrusted<Bytes>`
// is bytes from outside the program, under the same rules.
//
// An operation marked `#[follows_trust]` is trust-polymorphic: its
// receiver and every `String` and `Bytes` in its parameters accept values
// of either trust, and every `String` and `Bytes` in its result is
// untrusted when any of them is untrusted. Results that carry no flag,
// such as `Int` or `Bool`, are trusted. Without the attribute, `String`
// and `Bytes` mean trusted everywhere, the receiver included.

// For maintainers: this file is parsed in prelude mode, so functions may
// omit their bodies (the runtime implements them) and `#[capability]`
// marks a built-in capability, whose fields are private. Grow it only as
// the examples and the tests need it. The comment block directly above a
// `pub` item is its description in the API reference (`oskac doc` and
// oskalang.dev/api/), so write it for a reader of the API.

// ---- Built-in capabilities -------------------------------------------

// Standard input. `main` declares it to read lines that the user or
// another program sends.
#[capability]
pub struct Stdin { handle: Int }

impl Stdin {
    // The next line, without its line break, or `None` at end of input.
    pub fn read_line(self) -> Result<Option<Untrusted<String>>, IoError>
}

// Standard output.
#[capability]
pub struct Stdout { handle: Int }

impl Stdout {
    // Write `line` and a line break. Any text may be written: output is a
    // data position.
    pub fn println(self, line: Untrusted<String>) -> Result<(), IoError>
}

// Standard error, for messages about the program's own run.
#[capability]
pub struct Stderr { handle: Int }

impl Stderr {
    // Write `line` and a line break.
    pub fn println(self, line: Untrusted<String>) -> Result<(), IoError>
}

// The filesystem capabilities `main` declares. Their `restrict_to`
// attenuates to a directory capability for `dir`, a trusted path: a
// structural position, so untrusted text can never choose which part of
// the filesystem a program gets (ADR 0008). Attenuation never fails: a
// root that cannot be opened, because it is missing, the wrong kind, or a
// symlink, gives a capability whose every operation returns an `IoError`
// naming the root and the reason.
//
// `Fs`, `FsRead` and `FsWrite` only attenuate: they have no method that
// takes a path. Reading and writing go through a directory or file
// capability, and a call of a removed method gets `E0273`.
#[capability]
pub struct Fs { handle: Int }

impl Fs {
    // The directory capability for `dir` and everything beneath it.
    pub fn restrict_to(self, dir: String) -> Dir
    // The same reach, for reading only.
    pub fn read_only(self) -> FsRead
    // The same reach, for writing only.
    pub fn write_only(self) -> FsWrite
}

// Read access to the filesystem, as `main` declares it. Narrow it with
// `restrict_to` or `restrict_to_file` before reading.
#[capability]
pub struct FsRead { handle: Int }

impl FsRead {
    // The read-only directory capability for `dir`, a trusted path, and
    // everything beneath it.
    pub fn restrict_to(self, dir: String) -> DirRead
    // The file capability for the one file at `file`, which must be
    // trusted text. See `FileRead`.
    pub fn restrict_to_file(self, file: String) -> FileRead
}

// Write access to the filesystem, as `main` declares it. Narrow it with
// `restrict_to` or `restrict_to_file` before writing.
#[capability]
pub struct FsWrite { handle: Int }

impl FsWrite {
    // The write-only directory capability for `dir`, a trusted path, and
    // everything beneath it.
    pub fn restrict_to(self, dir: String) -> DirWrite
    // The file capability for the one file at `file`, which must be
    // trusted text. See `FileWrite`.
    pub fn restrict_to_file(self, file: String) -> FileWrite
}

// A directory capability: it reaches only its root directory and
// everything beneath it. A `Path` given to one is relative to the root,
// and may come from untrusted text, through `Path.from`: an empty or
// absolute path, `..` that climbs above the root, and a symlink anywhere
// beneath the root are refused with an `IoError`. `..` that stays inside
// the root is resolved as written.
//
// `restrict_to` narrows to the subdirectory at `dir`, which stays under
// the same root, so its `Path` may be untrusted. A `dir` that is a file is
// not a directory, and the result reaches nothing. `restrict_to_file` on
// `DirRead` and `DirWrite` is the way to a single file.
#[capability]
pub struct Dir { handle: Int }

impl Dir {
    // The capability for the subdirectory at `dir`, beneath this root.
    pub fn restrict_to(self, dir: Path) -> Dir
    // The same directory, for reading only.
    pub fn read_only(self) -> DirRead
    // The same directory, for writing only.
    pub fn write_only(self) -> DirWrite
}

// A directory capability that only reads. See `Dir`.
#[capability]
pub struct DirRead { handle: Int }

impl DirRead {
    // The capability for the subdirectory at `dir`, beneath this root.
    pub fn restrict_to(self, dir: Path) -> DirRead
    // The file capability for the file at `file` beneath the root, which
    // may be named by untrusted text through `Path.from`. See `FileRead`.
    pub fn restrict_to_file(self, file: Path) -> FileRead
    // The whole file at `path`, as text. What a file holds comes from
    // outside the program, so it is untrusted.
    pub fn read_to_string(self, path: Path) -> Result<Untrusted<String>, IoError>
    // The bytes of the file at `path`, as they are, UTF-8 or not.
    pub fn read_bytes(self, path: Path) -> Result<Untrusted<Bytes>, IoError>
    // The names of the entries of the directory at `path` (`"."` is the
    // root itself), sorted so the order is the same on every host. A name
    // comes from outside the program, so it is untrusted.
    pub fn list_dir(self, path: Path) -> Result<List<Untrusted<String>>, IoError>
}

// A directory capability that only writes. See `Dir`.
#[capability]
pub struct DirWrite { handle: Int }

impl DirWrite {
    // The capability for the subdirectory at `dir`, beneath this root.
    pub fn restrict_to(self, dir: Path) -> DirWrite
    // The file capability for the file at `file` beneath the root, which
    // may be named by untrusted text through `Path.from`. See `FileWrite`.
    pub fn restrict_to_file(self, file: Path) -> FileWrite
    // Create the file at `path`, or replace what it holds, with
    // `contents`. A symlink at `path` is never followed.
    pub fn write(self, path: Path, contents: Untrusted<String>) -> Result<(), IoError>
    // `write` with bytes: the file holds exactly `contents`.
    pub fn write_bytes(self, path: Path, contents: Untrusted<Bytes>) -> Result<(), IoError>
    // Create the directory at `path`; its parent must exist. A directory
    // already there is kept, with everything in it, and anything else
    // there is an error. A symlink at `path` is never followed.
    pub fn create_dir(self, path: Path) -> Result<(), IoError>
}

// A file capability: it reaches exactly one file, and takes no path. It
// holds its parent directory and the file's name, and each use opens that
// name beneath the directory without following a symlink, so a file
// replaced between uses can never lead outside. The file is not checked
// when the capability is made: a missing parent directory, or a name that
// is not a plain file, makes every operation return an `IoError`. There is
// no capability that both reads and writes one file.
#[capability]
pub struct FileRead { handle: Int }

impl FileRead {
    // The whole file, as text. What a file holds comes from outside the
    // program, so it is untrusted.
    pub fn read_to_string(self) -> Result<Untrusted<String>, IoError>
    // The file's bytes, as they are, UTF-8 or not.
    pub fn read_bytes(self) -> Result<Untrusted<Bytes>, IoError>
}

// A file capability that only writes. See `FileRead`.
#[capability]
pub struct FileWrite { handle: Int }

impl FileWrite {
    // Create the file, or replace what it holds, with `contents`.
    pub fn write(self, contents: Untrusted<String>) -> Result<(), IoError>
    // `write` with bytes: the file holds exactly `contents`.
    pub fn write_bytes(self, contents: Untrusted<Bytes>) -> Result<(), IoError>
}

// Network access, as `main` declares it. `Net`, `NetConnect` and
// `NetListen` grant no connection themselves: like `Fs`, they only
// attenuate (ADR 0023). A program narrows `NetConnect` to one host and port
// with `restrict_to`, which gives a `HostConnect`, and only that can
// connect. Every narrowing is listed in the authority report.
#[capability]
pub struct Net { handle: Int }

impl Net {
    // The capability to open connections, and nothing else.
    pub fn connect_only(self) -> NetConnect
    // The capability to accept connections, and nothing else.
    pub fn listen_only(self) -> NetListen
    // `connect_only().restrict_to(host, port)`.
    pub fn restrict_to(self, host: String, port: Int) -> HostConnect
}

// The capability to open network connections, as `main` declares it. It
// opens none itself: narrow it with `restrict_to`.
#[capability]
pub struct NetConnect { handle: Int }

impl NetConnect {
    // The host capability for `host` at `port`. `host` is a DNS name, an
    // IPv4 literal or an IPv6 literal. It decides where the program
    // connects, so it is structural: untrusted text can't redirect it
    // (SSRF) without a trust assertion, which `oskac audit` lists. A host
    // that is none of those, or a port outside 1 to 65535, is not refused
    // here: `connect` fails with an `IoError` that says why.
    pub fn restrict_to(self, host: String, port: Int) -> HostConnect
    // The DNS servers the operating system is configured with, in order,
    // as IPv4 address literals, for `std.dns`. Windows keeps them in its
    // network parameters (`GetNetworkParams`); every other platform
    // keeps them in `resolv.conf`, which `std.dns` reads itself, so this
    // gives an empty list there. It reaches nobody: it reads this
    // machine's settings.
    pub fn system_name_servers(self) -> Result<List<String>, IoError>
}

// A host capability: it reaches one host at one port and nothing else, so
// `connect` takes no destination. Name resolution happens inside
// `connect`, which tries each address the name resolves to in turn. A
// connect or read that gets no answer fails after a documented default
// (10 seconds to connect, 30 to read). Failures read the same on every
// platform: `host not found`, `connection refused`, `timed out`,
// `network unreachable`, `host unreachable` and `connection reset`.
#[capability]
pub struct HostConnect { handle: Int }

impl HostConnect {
    // Open a connection to the host and port this capability is confined to.
    pub fn connect(self) -> Result<Connection, IoError>
    // The host this capability is confined to, as it was given.
    pub fn name(self) -> String
    // The port this capability is confined to.
    pub fn port(self) -> Int
    // Send `message` as one UDP datagram to the host and port this
    // capability is confined to, and wait for one datagram back, at most
    // 5 seconds: for `std.dns`. The host must be an IPv4 or IPv6 literal:
    // a name is not resolved here. A datagram from anywhere else is
    // ignored, and so is one whose first two bytes (a DNS transaction id)
    // are not the message's own. What comes back is from outside the program, so it is
    // untrusted.
    pub fn exchange_datagram(self, message: Bytes) -> Result<Untrusted<Bytes>, IoError>
}

// An open connection to one host. It carries the authority to talk to
// that host, so it is capability-bearing, and it can't be forged. It is
// closed when its last reference goes, or by `close`.
pub cap struct Connection { host: HostConnect }

impl Connection {
    // A request body is data: it may be untrusted.
    pub fn send(self, body: Untrusted<String>) -> Result<(), IoError>
    // What the host sent back: text from outside the program. It is empty
    // at the end of the stream, and an `IoError` when the bytes that
    // arrived are not UTF-8.
    pub fn receive(self) -> Result<Untrusted<String>, IoError>
    // `send` and `receive` with bytes.
    pub fn send_bytes(self, body: Untrusted<Bytes>) -> Result<(), IoError>
    // What the host sent back, as bytes from outside the program: an
    // empty `Bytes` at the end of the stream.
    pub fn receive_bytes(self) -> Result<Untrusted<Bytes>, IoError>
    // The host this connection was opened to, which its capability named.
    pub fn host(self) -> String
    // End the connection. Every later use fails.
    pub fn close(self)
}

// The capability to accept network connections, as `main` declares it. It
// accepts none itself: narrow it with `restrict_to_loopback`.
#[capability]
pub struct NetListen { handle: Int }

impl NetListen {
    // The listener on this machine's loopback address (`127.0.0.1`, else
    // `::1`) at `port`, 0 to 65535: 0 chooses a free port, which `port`
    // reports. Nothing off the machine can reach it. A port that cannot be
    // listened on is not refused here: `accept` fails with an `IoError`.
    pub fn restrict_to_loopback(self, port: Int) -> LoopbackListen
}

// A loopback listener, for a local test server. It accepts connections
// from this machine only, and has no wider form in this milestone.
#[capability]
pub struct LoopbackListen { handle: Int }

impl LoopbackListen {
    // Wait for the next connection, at most 30 seconds.
    pub fn accept(self) -> Result<Connection, IoError>
    // The port it listens on, once it listens; or 0 when it could not.
    pub fn port(self) -> Int
}

// The process environment: its variables and its secrets.
#[capability]
pub struct Env { handle: Int }

impl Env {
    // The environment variable `name`, or `None` when it is not set.
    pub fn get(self, name: String) -> Option<Untrusted<String>>
    // The secret `name`, such as an API token.
    pub fn secret(self, name: String) -> Secret<String>
}

// A secret value. It has no `Display`, no `Eq` and no `Hash`, and cannot
// be interpolated: compare it with `constant_time_eq` or `ct_eq`, and
// read it with `expose`, which is an audit site.
//
// `Secret<U8>`, `Secret<U32>` and `Secret<U64>` are secret integers,
// computed on without exposing them. `+ - *` wrap, and the bitwise and
// shift operators work as on the public type; a public operand of the
// same type, a literal included, gives a secret result. A secret cannot
// decide a branch (`E0353`), an index, an offset, a length or a hash key
// (`E0354`), a division, a remainder or a shift or rotation amount
// (`E0355`), or an ordering (`E0356`), and `==` on one is `E0351`. So no
// operation on a secret panics, or takes a path or reads memory, that
// depends on its value. `Secret<Bool>` is the result of `ct_eq`, and
// `Secret<Bytes>` holds key material.
pub struct Secret<T> { value: T }

impl<T> Secret<T> {
    // `value`, made secret. Adding secrecy never weakens a guarantee, so
    // this is not an audit site. It makes `Secret<U8>`, `Secret<U32>`,
    // `Secret<U64>`, `Secret<Bool>` and `Secret<Bytes>` only (`E0223`);
    // a `Secret<String>` comes from `Env.secret` (`E0271`).
    pub fn new(value: T) -> Secret<T>
    // The secret's value. Every call is an audit site.
    pub fn expose(self) -> T
}

impl Secret<String> {
    // Compare without leaking timing information.
    pub fn constant_time_eq(self, other: Untrusted<String>) -> Bool
    // Compare with another secret without leaking timing information,
    // and without exposing either.
    pub fn constant_time_eq_secret(self, other: Secret<String>) -> Bool
    // Its UTF-8 encoding, as secret bytes, such as an HMAC key made from
    // an environment secret. The secret stays secret, so this is not an
    // audit site.
    #[follows_trust]
    pub fn to_bytes(self) -> Secret<Bytes>
}

// A secret integer has the public type's rotations (by a public amount,
// which panics with `P0008` out of range, as the public one does),
// widening and wrapping narrowing, but no checked narrowing, which would
// panic on a secret value.
impl Secret<U8> {
    // The bits rotated left by `n`, as `U8.rotl` does.
    pub fn rotl(self, n: Int) -> Secret<U8>
    // The bits rotated right by `n`, as `U8.rotr` does.
    pub fn rotr(self, n: Int) -> Secret<U8>
    // Whether the two are equal, as a secret.
    pub fn ct_eq(self, other: Secret<U8>) -> Secret<Bool>
    // The same value as a secret `U32`.
    pub fn to_u32(self) -> Secret<U32>
    // The same value as a secret `U64`.
    pub fn to_u64(self) -> Secret<U64>
}

impl Secret<U32> {
    // The bits rotated left by `n`, as `U32.rotl` does.
    pub fn rotl(self, n: Int) -> Secret<U32>
    // The bits rotated right by `n`, as `U32.rotr` does.
    pub fn rotr(self, n: Int) -> Secret<U32>
    // Whether the two are equal, as a secret.
    pub fn ct_eq(self, other: Secret<U32>) -> Secret<Bool>
    // The same value as a secret `U64`.
    pub fn to_u64(self) -> Secret<U64>
    // The low 8 bits, as a secret `U8`.
    pub fn wrapping_to_u8(self) -> Secret<U8>
}

impl Secret<U64> {
    // The bits rotated left by `n`, as `U64.rotl` does.
    pub fn rotl(self, n: Int) -> Secret<U64>
    // The bits rotated right by `n`, as `U64.rotr` does.
    pub fn rotr(self, n: Int) -> Secret<U64>
    // Whether the two are equal, as a secret.
    pub fn ct_eq(self, other: Secret<U64>) -> Secret<Bool>
    // The low 8 bits, as a secret `U8`.
    pub fn wrapping_to_u8(self) -> Secret<U8>
    // The low 32 bits, as a secret `U32`.
    pub fn wrapping_to_u32(self) -> Secret<U32>
}

// A secret condition. `&&`, `||` and `!` would branch on it (`E0353`):
// combine conditions with `and`, `or`, `xor` and `not`, which evaluate
// both operands.
impl Secret<Bool> {
    // Whether both hold.
    pub fn and(self, other: Secret<Bool>) -> Secret<Bool>
    // Whether either holds.
    pub fn or(self, other: Secret<Bool>) -> Secret<Bool>
    // Whether exactly one holds.
    pub fn xor(self, other: Secret<Bool>) -> Secret<Bool>
    // Whether the condition does not hold.
    pub fn not(self) -> Secret<Bool>
    // `if_true` when the condition holds, otherwise `if_false`, without
    // a branch: both are evaluated. `T` is `U8`, `U32`, `U64`, `Bool` or
    // `Bytes`; two `Bytes` must have the same length, or it panics
    // (`P0042`).
    pub fn ct_select<T>(self, if_true: Secret<T>, if_false: Secret<T>) -> Secret<T>
}

// A secret buffer, such as a key. Its length, and every index and offset
// into it, are public; the bytes and the integers read from them are
// secret. Out of bounds, a method panics as `Bytes`'s does.
// Like `Bytes`'s, each operation follows the trust of its inputs: a
// secret of untrusted bytes gives untrusted results (#223).
// There are no 16-bit endian reads or pushes, because there is no
// `Secret<U16>` for them to give or take: `U16` has no bitwise
// operators to compute on a secret with.
impl Secret<Bytes> {
    // The number of bytes, which is public.
    #[follows_trust]
    pub fn len(self) -> Int
    // The byte at `index`, as a secret.
    #[follows_trust]
    pub fn at(self, index: Int) -> Secret<U8>
    // The bytes from `start` up to, but excluding, `end`, as a secret.
    #[follows_trust]
    pub fn slice(self, start: Int, end: Int) -> Secret<Bytes>
    // The `U32` stored big-endian at byte `offset`, as a secret.
    #[follows_trust]
    pub fn read_u32_be(self, offset: Int) -> Secret<U32>
    // The `U32` stored little-endian at byte `offset`, as a secret.
    #[follows_trust]
    pub fn read_u32_le(self, offset: Int) -> Secret<U32>
    // The `U64` stored big-endian at byte `offset`, as a secret.
    #[follows_trust]
    pub fn read_u64_be(self, offset: Int) -> Secret<U64>
    // The `U64` stored little-endian at byte `offset`, as a secret.
    #[follows_trust]
    pub fn read_u64_le(self, offset: Int) -> Secret<U64>
    // `byte` added at the end.
    #[follows_trust]
    pub fn push(var self, byte: Secret<U8>)
    // `other`'s bytes added at the end.
    #[follows_trust]
    pub fn append(var self, other: Secret<Bytes>)
    // `value`'s bytes added at the end, in big-endian order.
    #[follows_trust]
    pub fn push_u32_be(var self, value: Secret<U32>)
    // `value`'s bytes added at the end, in little-endian order.
    #[follows_trust]
    pub fn push_u32_le(var self, value: Secret<U32>)
    // `value`'s bytes added at the end, in big-endian order.
    #[follows_trust]
    pub fn push_u64_be(var self, value: Secret<U64>)
    // `value`'s bytes added at the end, in little-endian order.
    #[follows_trust]
    pub fn push_u64_le(var self, value: Secret<U64>)
    // Compare without leaking timing information: the time depends on
    // the lengths only.
    #[follows_trust]
    pub fn constant_time_eq(self, other: Untrusted<Bytes>) -> Bool
    // Compare with another secret, exposing neither.
    #[follows_trust]
    pub fn constant_time_eq_secret(self, other: Secret<Bytes>) -> Bool
}

// The wall clock. A test's `t.clock` is fixed.
#[capability]
pub struct Clock { handle: Int }

impl Clock {
    // Milliseconds since the Unix epoch.
    pub fn now_millis(self) -> Int
}

// A source of random numbers. A test's `t.random` is seeded, so a test
// gets the same numbers on every run.
#[capability]
pub struct Random { handle: Int }

impl Random {
    // A pseudo-random integer from 0 up to, but excluding, 2^63.
    pub fn next_int(self) -> Int

    // `n` bytes for keys and nonces, from the operating system's secure
    // random source. A test's `t.random` gives the same bytes on every run.
    // A negative `n` panics (`P0042`), as `Bytes.zeroed` does.
    pub fn secure_bytes(self, n: Int) -> Secret<Bytes>
}

// Authority to spend model tokens and calls, which `std.llm` takes. Its
// counters live in the runtime, so every copy of a budget draws from the
// same counters. `main`'s is unlimited; `limit` attenuates it. A test's
// `t.budget` has 100000 tokens and 100 calls. Tokens are counted, not
// money, because prices differ by model and change.
#[capability]
pub struct Budget { handle: Int }

impl Budget {
    // A child budget of at most `tokens` tokens and `calls` calls, drawn
    // from this one: each is clamped to what this budget has left, so it
    // never has more. A negative amount counts as 0.
    pub fn limit(self, tokens: Int, calls: Int) -> Budget
    // What it has left to reserve: the least that it or any budget it
    // was limited from has left, `None` where all are unlimited.
    pub fn remaining(self) -> Allowance
    // What it, and every budget limited from it, has spent.
    pub fn spent(self) -> Spending
    // Reserve `tokens` tokens and one call before a request, or refuse
    // with `OverBudget` when it or any budget it was limited from has
    // less left, or has no tokens left at all. A negative amount counts
    // as 0. A model client, such as `std.llm`, calls it before each
    // request; a program that settles for less than it used cheats only
    // itself, since a budget can only spend what it was given.
    pub fn reserve(self, tokens: Int) -> Result<Reservation, OverBudget>
}

// Tokens and calls reserved from a `Budget` and not yet settled. Settle
// it once, with `debit` or `release`; settling it again changes nothing.
pub struct Reservation { handle: Int, tokens: Int, open: Bool }

impl Reservation {
    // Spend the call and every token a reply used: its input, output,
    // cache-creation and cache-read tokens, as the model reports them
    // (a negative count counts as 0). The rest of the reservation is
    // returned. A reply may use more than was reserved, since input
    // tokens are known only after it; they are spent all the same.
    pub fn debit(self, input: Int, output: Int, cache_creation: Int, cache_read: Int)
    // Return the whole reservation, spending nothing: the request was
    // never sent.
    pub fn release(self)
}

// What a `Budget` has left: `None` where it is unlimited.
pub struct Allowance {
    pub tokens: Option<Int>,
    pub calls: Option<Int>,
}

// What a `Budget` has spent.
pub struct Spending {
    pub tokens: Int,
    pub calls: Int,
}

// The refusal of a reservation that a `Budget` cannot cover: the tokens
// asked for, with one call, and what the budget had left.
pub struct OverBudget {
    pub asked: Int,
    pub left: Allowance,
}

impl Display for OverBudget {
    // `over budget: asked for 500 tokens and 1 call, with 100 tokens and
    // 3 calls left`, with `unlimited` for an amount without a limit.
    fn to_string(self) -> String
}

// Channels and `select`, for concurrency that is not deterministic. It
// has no methods and no runtime yet (`E0370`). `scope` and `spawn` need
// no capability.
#[capability]
pub struct Sched { handle: Int }

// The capability to start processes, which `std.proc` takes. It has no
// runtime yet (`E0370`).
#[capability]
pub struct Spawn { handle: Int }

// ---- Approval ------------------------------------------------------------

// Someone who can say yes to a consequential action, such as a tool that
// deletes a file or sends a message: a person at the terminal
// (`Approver.terminal`), or a test's `t.approver`. Only an approver makes
// an `Approval`, so a tool that takes one has proof that a person said
// yes. Its fields are private, and it has no other constructor.
pub cap struct Approver { stdin: Stdin, stderr: Stderr }

impl Approver {
    // An approver that asks the person at the terminal: it writes each
    // question to `stderr`, never to standard output, which a pipeline or
    // an MCP server may own, and reads the answer from `stdin`. It is only
    // as strong as whoever writes to `stdin`: never build one over the
    // standard input of an MCP server, or of anything a script feeds.
    pub fn terminal(stdin: Stdin, stderr: Stderr) -> Approver
    // Ask for a yes to the action `summary` describes, with `details`,
    // such as the arguments a model chose for a tool. It shows
    // `approval needed: ` and the summary, then each detail on a line of
    // its own, indented. Each is in double quotes, as `dbg` shows text:
    // `"` and `\` escaped, and control, bidirectional and other invisible
    // characters written as escapes such as `\n` and `\u{202e}`, so
    // neither can disguise itself. Then `approve? [y/N]`. Only `y` or
    // `yes`, in any case and with any spaces around it, approves; any
    // other answer, the end of input or a failed read or write is `None`.
    pub fn confirm(self, summary: String, details: List<Untrusted<String>>) -> Option<Approval>
}

// A person's yes to one action: the summary and details they approved.
// Only an `Approver` makes one. It is single use: the tool it is given to
// calls `consume`, and every later `consume`, of it or of any copy of it,
// is refused with `ApprovalError.Used`.
pub struct Approval {
    summary: String,
    details: List<Untrusted<String>>,
    handle: Int,
}

impl Approval {
    // The summary that was approved.
    pub fn summary(self) -> String
    // The details that were approved.
    pub fn details(self) -> List<Untrusted<String>>
    // Whether it approved exactly this summary and these details and is
    // still unused: whether `consume` would succeed. It does not use the
    // approval, so a tool that acts on one calls `consume`, not this.
    pub fn matches(self, summary: String, details: List<Untrusted<String>>) -> Bool
    // Use the approval for the action `summary` and `details` describe:
    // `Ok` once, when it matches and has not been used. A used one is
    // refused with `ApprovalError.Used`, and one given for a different
    // action with `ApprovalError.Mismatch`, which leaves it unused.
    pub fn consume(self, summary: String, details: List<Untrusted<String>>) -> Result<(), ApprovalError>
}

// A question an approver was asked: what `t.approvals_asked` records.
pub struct ApprovalRequest {
    pub summary: String,
    pub details: List<Untrusted<String>>,
}

// Why `Approval.consume` refused an approval.
pub enum ApprovalError {
    // It was used already: one yes covers one action.
    Used,
    // It approved a different summary or different details.
    Mismatch,
}

impl Display for ApprovalError {
    // `approval already used: one approval covers one action`, or
    // `approval does not match: it was given for a different action`.
    fn to_string(self) -> String
}

// ---- Tests ---------------------------------------------------------------

// The type of `t`, the built-in value in every `test` body. Its fields are
// stand-in capabilities: an in-memory `fs`, a fixed `clock`, a seeded
// `random`, a recording `stdout`, a `budget` of 100000 tokens and 100
// calls whose spending a test reads with `t.budget.spent()`, and an
// `approver` that answers from the test's script (`answer_approval`)
// and records what it was asked (`approvals_asked`). An
// `#[integration]` test gets the same `t`; the runtime decides which
// capabilities are real, its budget has the same limits, and its
// `approver` still answers from the script. A failed assertion fails
// the test.
//
// `t.net` is a stand-in `Net` in a plain test: every connection and every
// listen fails with the same `IoError`, and `net_attempts` lists where code
// tried to go. Under `--integration` it is the real network.
pub cap struct TestContext {
    pub fs: Fs,
    pub clock: Clock,
    pub random: Random,
    pub stdout: Stdout,
    pub budget: Budget,
    pub approver: Approver,
    pub net: Net,
}

impl TestContext {
    // Fail the test unless `cond` is true.
    pub fn assert(self, cond: Bool)
    // Fail the test unless `actual` equals `expected`.
    pub fn assert_eq<T: Eq>(self, actual: T, expected: T)
    // Fail the test if `actual` equals `other`.
    pub fn assert_ne<T: Eq>(self, actual: T, other: T)
    // Fail the test with `message`.
    pub fn fail(self, message: String)
    // Compare `value`, rendered as `dbg` renders it, with its stored
    // snapshot, `snapshots/<test-file>/<test-name>.snap`. The test runner
    // reads and writes the file, after the test has run: a missing or
    // different snapshot fails the test, and `oskac test --update`
    // writes it instead.
    pub fn assert_snapshot<T>(self, value: T)
    // Every line printed to `stdout` so far in this test, one per
    // `println`, without its line break.
    pub fn printed(self) -> List<Untrusted<String>>
    // Script `t.approver`'s answer to the next question it is asked:
    // `true` approves, `false` refuses. Answers are given in the order
    // they were scripted; a question with none left is refused.
    pub fn answer_approval(self, yes: Bool)
    // Every question `t.approver` has been asked so far, in order: its
    // summary and details, as the code that asked gave them.
    pub fn approvals_asked(self) -> List<ApprovalRequest>
    // Every connection `t.net` has been asked to open or listener it has
    // been asked to make so far, in order, as `host:port` (a listener as
    // `loopback:port`), whether or not the host allowed it.
    pub fn net_attempts(self) -> List<String>
}

// ---- Core types --------------------------------------------------------

// A value that may be missing: `Some(value)`, or `None`.
pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    // `Ok` with the value, or `Err(err)` when there is none, ready for
    // `?`.
    pub fn ok_or<E>(self, err: E) -> Result<T, E>
    // Whether there is a value.
    pub fn is_some(self) -> Bool
    // The value, or `default` when there is none.
    pub fn unwrap_or(self, default: T) -> T
}

// The outcome of an operation that can fail: `Ok(value)`, or `Err(error)`.
// `?` returns an `Err` from the enclosing function.
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    // Whether it is `Ok`.
    pub fn is_ok(self) -> Bool
    // The `Ok` value, or `default` for an `Err`.
    pub fn unwrap_or(self, default: T) -> T
}

// A growable list. `[a, b, c]` makes one, and `for item in list` visits
// its items in order.
pub struct List<T> { handle: Int }

impl<T> List<T> {
    // An empty list.
    pub fn new() -> List<T>
    // Add `item` at the end. The list must be a `var`.
    pub fn push(var self, item: T)
    // The number of items.
    pub fn len(self) -> Int
    // The number of items, the same as `len`.
    pub fn count(self) -> Int
    // The item at `index`, from 0, or `None` when the index is out of
    // bounds.
    pub fn get(self, index: Int) -> Option<T>
    // The item at `index`. An index out of bounds is a bug: it panics
    // (`P0002`). Use `get` when the index may be out of bounds.
    pub fn at(self, index: Int) -> T
    // A new list of `f` applied to each item, in order.
    pub fn map<U>(self, f: fn(T) -> U) -> List<U>
}

// A packed buffer of bytes: a value, like `List`, copied on write. A
// mutating method changes a `Bytes` that nothing else holds in place, and
// copies one that is shared first, so appending in a loop is not
// quadratic. Its representation is built in.
//
// Every method follows trust: bytes or text it gives are untrusted when
// the receiver or a `Bytes` or `String` argument is, and the integers it
// reads are trusted, as `len` of untrusted text is (#223). `new` and
// `zeroed` take no bytes or text; they follow trust so that what they
// give starts with a trust of its own, as a string literal does, and a
// `var` they start can take untrusted bytes later (`var buf =
// Bytes.new()` then `buf.append(raw)`).
//
// An index out of bounds in `at` or `set` panics (`P0002`), as in
// `List.at`. A slice or an endian read that does not lie wholly inside
// the buffer panics (`P0042`), and so does a negative length for
// `zeroed`. A buffer that would grow past 256 MiB panics (`P0043`). The
// cap is not yet checked where a buffer is made whole from outside the
// buffer methods: `String.to_bytes` and the capabilities' `read_bytes`
// give every byte, however many, and a read that no memory holds is an
// `IoError`.
pub struct Bytes { handle: Int }

impl Bytes {
    // An empty buffer.
    #[follows_trust]
    pub fn new() -> Bytes
    // A buffer of `len` zero bytes.
    #[follows_trust]
    pub fn zeroed(len: Int) -> Bytes
    // The bytes that `text` spells in hexadecimal, two digits a byte, in
    // either case; `None` when it spells none.
    #[follows_trust]
    pub fn from_hex(text: String) -> Option<Bytes>
    // The number of bytes.
    #[follows_trust]
    pub fn len(self) -> Int
    // The byte at `index`, or `None` when the index is out of bounds.
    #[follows_trust]
    pub fn get(self, index: Int) -> Option<U8>
    // The byte at `index`.
    #[follows_trust]
    pub fn at(self, index: Int) -> U8
    // The bytes from `start` up to, but excluding, `end`.
    #[follows_trust]
    pub fn slice(self, start: Int, end: Int) -> Bytes
    // The integer stored at byte `offset`, its most significant byte
    // first (`_be`, big-endian, the network's order) or last (`_le`).
    #[follows_trust]
    pub fn read_u16_be(self, offset: Int) -> U16
    // The `U16` stored little-endian at byte `offset`.
    #[follows_trust]
    pub fn read_u16_le(self, offset: Int) -> U16
    // The `U32` stored big-endian at byte `offset`.
    #[follows_trust]
    pub fn read_u32_be(self, offset: Int) -> U32
    // The `U32` stored little-endian at byte `offset`.
    #[follows_trust]
    pub fn read_u32_le(self, offset: Int) -> U32
    // The `U64` stored big-endian at byte `offset`.
    #[follows_trust]
    pub fn read_u64_be(self, offset: Int) -> U64
    // The `U64` stored little-endian at byte `offset`.
    #[follows_trust]
    pub fn read_u64_le(self, offset: Int) -> U64
    // Two lower-case hexadecimal digits a byte.
    #[follows_trust]
    pub fn to_hex(self) -> String
    // The text the bytes encode in UTF-8, or `None` when they are not
    // UTF-8.
    #[follows_trust]
    pub fn to_text(self) -> Option<String>
    // `byte` added at the end.
    #[follows_trust]
    pub fn push(var self, byte: U8)
    // The byte at `index` replaced by `byte`.
    #[follows_trust]
    pub fn set(var self, index: Int, byte: U8)
    // `other`'s bytes added at the end.
    #[follows_trust]
    pub fn append(var self, other: Bytes)
    // `value`'s bytes added at the end, in big- or little-endian order.
    #[follows_trust]
    pub fn push_u16_be(var self, value: U16)
    // `value`'s bytes added at the end, in little-endian order.
    #[follows_trust]
    pub fn push_u16_le(var self, value: U16)
    // `value`'s bytes added at the end, in big-endian order.
    #[follows_trust]
    pub fn push_u32_be(var self, value: U32)
    // `value`'s bytes added at the end, in little-endian order.
    #[follows_trust]
    pub fn push_u32_le(var self, value: U32)
    // `value`'s bytes added at the end, in big-endian order.
    #[follows_trust]
    pub fn push_u64_be(var self, value: U64)
    // `value`'s bytes added at the end, in little-endian order.
    #[follows_trust]
    pub fn push_u64_le(var self, value: U64)
}

// `start..end`, which excludes `end`.
pub struct Range<T> { pub start: T, pub end: T }

// Methods of text. Each follows trust (see the prelude's description): it
// accepts trusted or untrusted text, and its text result is untrusted
// when any text it was given is.
impl String {
    // The lines, without their line breaks.
    #[follows_trust]
    pub fn lines(self) -> List<String>
    // The number of characters (Unicode code points).
    #[follows_trust]
    pub fn len(self) -> Int
    // The number of bytes in its UTF-8 encoding.
    #[follows_trust]
    pub fn byte_len(self) -> Int
    // Without leading and trailing whitespace.
    #[follows_trust]
    pub fn trim(self) -> String
    // The pieces between occurrences of `separator`.
    #[follows_trust]
    pub fn split(self, separator: String) -> List<String>
    // Whether `needle` occurs in it.
    #[follows_trust]
    pub fn contains(self, needle: String) -> Bool
    // Whether it starts with `prefix`.
    #[follows_trust]
    pub fn starts_with(self, prefix: String) -> Bool
    // Whether it ends with `suffix`.
    #[follows_trust]
    pub fn ends_with(self, suffix: String) -> Bool
    // Every occurrence of `from` replaced by `to`. An empty `from`
    // occurs nowhere.
    #[follows_trust]
    pub fn replace(self, from: String, to: String) -> String
    // `parts` with the text between each two: `",".join(["a", "b"])` is
    // `"a,b"`.
    #[follows_trust]
    pub fn join(self, parts: List<String>) -> String
    // Each character (Unicode code point) as a text of its own, in order.
    #[follows_trust]
    pub fn chars(self) -> List<String>
    // The characters from index `start` up to, but excluding, `end`. An
    // index out of bounds, or `start` past `end`, is a bug: it panics
    // (`P0035`).
    #[follows_trust]
    pub fn slice(self, start: Int, end: Int) -> String
    // The text `times` times over. A negative count panics (`P0036`), and
    // so does a result too long to build (`P0037`).
    #[follows_trust]
    pub fn repeat(self, times: Int) -> String
    // Every letter in lower case, by Unicode's rules, one character at a
    // time: `"ÀB".to_lowercase()` is `"àb"`. A capital sigma is always
    // `σ`, wherever it stands.
    #[follows_trust]
    pub fn to_lowercase(self) -> String
    // The decimal integer the whole text spells, if it is one.
    #[follows_trust]
    pub fn parse_int(self) -> Option<Int>
    // Its UTF-8 encoding.
    #[follows_trust]
    pub fn to_bytes(self) -> Bytes
}

impl Untrusted<String> {
    // A trust assertion: a validator vouches for text it has checked.
    // Every call is an audit site.
    pub fn assume_trusted(self) -> String
}

impl Untrusted<Bytes> {
    // A trust assertion: a validator vouches for bytes it has checked.
    // Every call is an audit site.
    pub fn assume_trusted(self) -> Bytes
}

// A path, relative to a directory capability's root. A directory
// capability refuses one that would leave its root.
pub struct Path { raw: String }

impl Path {
    // A path from trusted text, such as a literal.
    pub fn new(raw: String) -> Path
    // A path from untrusted text, such as a name a user typed. It is safe
    // because the directory capability it is given to confines it.
    pub fn from(raw: Untrusted<String>) -> Path
}

// The program's command-line arguments: a program input, not a capability.
pub struct Args { handle: Int }

impl Args {
    // The argument at `index`, or `None`. Index 0 is the program's own
    // path.
    // An argument comes from outside the program, so it is untrusted.
    pub fn get(self, index: Int) -> Option<Untrusted<String>>
}

// Plain data: code may construct one to report its own failures.
pub struct IoError { pub message: Untrusted<String> }

impl Display for IoError {
    fn to_string(self) -> String
}

// ---- Fixed-width integers -----------------------------------------------

// `U8`, `U32` and `U64` have the bitwise and shift operators
// (`& | ^ ~ << >>`) and the rotations. A rotation moves the bits shifted
// out at one end back in at the other. An amount below 0, or not below
// the type's width, is a bug: it panics (`P0008`), as a shift's does.
//
// `+ - *` never wrap. `wrapping_add`, `wrapping_sub` and `wrapping_mul`
// do: they keep the low bits of the result, arithmetic modulo 2 to the
// type's width.
//
// Integer types convert only explicitly. `Int`, `U8`, `U16`, `U32` and
// `U64` each convert to each other with `to_<type>()`: one that widens
// never fails, and a value that does not fit its target panics (`P0001`).
// `wrapping_to_<type>()`, from a wider unsigned type to a narrower one,
// keeps the value's low bits instead.
impl Int {
    // The same value as a `U8`; it panics (`P0001`) when it does not fit.
    pub fn to_u8(self) -> U8
    // The same value as a `U16`; it panics (`P0001`) when it does not fit.
    pub fn to_u16(self) -> U16
    // The same value as a `U32`; it panics (`P0001`) when it does not fit.
    pub fn to_u32(self) -> U32
    // The same value as a `U64`; it panics (`P0001`) when it does not fit.
    pub fn to_u64(self) -> U64
}

impl U8 {
    // The bits rotated left by `n`.
    pub fn rotl(self, n: Int) -> U8
    // The bits rotated right by `n`.
    pub fn rotr(self, n: Int) -> U8
    // The sum, wrapping around modulo 2^8.
    pub fn wrapping_add(self, other: U8) -> U8
    // The difference, wrapping around modulo 2^8.
    pub fn wrapping_sub(self, other: U8) -> U8
    // The product, wrapping around modulo 2^8.
    pub fn wrapping_mul(self, other: U8) -> U8
    // The same value as an `Int`.
    pub fn to_int(self) -> Int
    // The same value as a `U16`.
    pub fn to_u16(self) -> U16
    // The same value as a `U32`.
    pub fn to_u32(self) -> U32
    // The same value as a `U64`.
    pub fn to_u64(self) -> U64
}

impl U16 {
    // The same value as an `Int`.
    pub fn to_int(self) -> Int
    // The same value as a `U8`; it panics (`P0001`) when it does not fit.
    pub fn to_u8(self) -> U8
    // The same value as a `U32`.
    pub fn to_u32(self) -> U32
    // The same value as a `U64`.
    pub fn to_u64(self) -> U64
    // The low 8 bits, as a `U8`.
    pub fn wrapping_to_u8(self) -> U8
}

impl U32 {
    // The bits rotated left by `n`.
    pub fn rotl(self, n: Int) -> U32
    // The bits rotated right by `n`.
    pub fn rotr(self, n: Int) -> U32
    // The sum, wrapping around modulo 2^32.
    pub fn wrapping_add(self, other: U32) -> U32
    // The difference, wrapping around modulo 2^32.
    pub fn wrapping_sub(self, other: U32) -> U32
    // The product, wrapping around modulo 2^32.
    pub fn wrapping_mul(self, other: U32) -> U32
    // The same value as an `Int`.
    pub fn to_int(self) -> Int
    // The same value as a `U8`; it panics (`P0001`) when it does not fit.
    pub fn to_u8(self) -> U8
    // The same value as a `U16`; it panics (`P0001`) when it does not fit.
    pub fn to_u16(self) -> U16
    // The same value as a `U64`.
    pub fn to_u64(self) -> U64
    // The low 8 bits, as a `U8`.
    pub fn wrapping_to_u8(self) -> U8
    // The low 16 bits, as a `U16`.
    pub fn wrapping_to_u16(self) -> U16
}

impl U64 {
    // The bits rotated left by `n`.
    pub fn rotl(self, n: Int) -> U64
    // The bits rotated right by `n`.
    pub fn rotr(self, n: Int) -> U64
    // The sum, wrapping around modulo 2^64.
    pub fn wrapping_add(self, other: U64) -> U64
    // The difference, wrapping around modulo 2^64.
    pub fn wrapping_sub(self, other: U64) -> U64
    // The product, wrapping around modulo 2^64.
    pub fn wrapping_mul(self, other: U64) -> U64
    // The same value as an `Int`; it panics (`P0001`) when it does not fit.
    pub fn to_int(self) -> Int
    // The same value as a `U8`; it panics (`P0001`) when it does not fit.
    pub fn to_u8(self) -> U8
    // The same value as a `U16`; it panics (`P0001`) when it does not fit.
    pub fn to_u16(self) -> U16
    // The same value as a `U32`; it panics (`P0001`) when it does not fit.
    pub fn to_u32(self) -> U32
    // The low 8 bits, as a `U8`.
    pub fn wrapping_to_u8(self) -> U8
    // The low 16 bits, as a `U16`.
    pub fn wrapping_to_u16(self) -> U16
    // The low 32 bits, as a `U32`.
    pub fn wrapping_to_u32(self) -> U32
}

// ---- Structured concurrency ---------------------------------------------

// The handle `scope |s| { ... }` binds. A scope does not exit until all of
// its tasks have finished. Deterministic parallelism needs no capability,
// so a scope is plain data.
pub struct Scope { handle: Int }

impl Scope {
    // Start `task` in parallel, inside this scope. A spawned task may
    // perform effects, so it is a `cap fn`; a pure closure fits too.
    pub fn spawn<T>(self, task: cap fn() -> T) -> Task<T>
}

// A running task. `join` waits for it and returns its result.
pub struct Task<T> { handle: Int }

impl<T> Task<T> {
    // Wait for the task to finish, and return its result.
    pub fn join(self) -> T
}

// ---- Core functions ----------------------------------------------------

// Print `value` for debugging and return it. An error under `--release`.
pub fn dbg<T>(value: T) -> T

// A placeholder for code not yet written: it fits any type, and fails
// when reached. The fix for a non-exhaustive `match` uses it as the body
// of each arm it adds.
pub fn todo<T>() -> T

// ---- Core traits -------------------------------------------------------

// Equality: `==` and `!=` need `Eq`. `()` is `Eq` without an impl.
pub trait Eq {
    // Whether `self` equals `other`.
    #[follows_trust]
    fn eq(self, other: Self) -> Bool
}

impl Eq for Int { fn eq(self, other: Int) -> Bool }
impl Eq for I8 { fn eq(self, other: I8) -> Bool }
impl Eq for I16 { fn eq(self, other: I16) -> Bool }
impl Eq for I32 { fn eq(self, other: I32) -> Bool }
impl Eq for I64 { fn eq(self, other: I64) -> Bool }
impl Eq for U8 { fn eq(self, other: U8) -> Bool }
impl Eq for U16 { fn eq(self, other: U16) -> Bool }
impl Eq for U32 { fn eq(self, other: U32) -> Bool }
impl Eq for U64 { fn eq(self, other: U64) -> Bool }
impl Eq for Bool { fn eq(self, other: Bool) -> Bool }
impl Eq for String { fn eq(self, other: String) -> Bool }
impl Eq for Path { fn eq(self, other: Path) -> Bool }
impl Eq for IoError { fn eq(self, other: IoError) -> Bool }
impl<T: Eq> Eq for Option<T> { fn eq(self, other: Option<T>) -> Bool }
impl<T: Eq, E: Eq> Eq for Result<T, E> { fn eq(self, other: Result<T, E>) -> Bool }
impl<T: Eq> Eq for List<T> { fn eq(self, other: List<T>) -> Bool }
impl Eq for Bytes { fn eq(self, other: Bytes) -> Bool }

// A value that can be hashed.
pub trait Hash {
    // A hash of the value.
    #[follows_trust]
    fn hash(self) -> Int
}

// The 64-bit FNV-1a hash of the bytes, the same on every platform.
impl Hash for Bytes { fn hash(self) -> Int }

// A value with a text form, which `"{value}"` interpolation uses.
pub trait Display {
    // The value as text.
    #[follows_trust]
    fn to_string(self) -> String
}

impl Display for String {
    fn to_string(self) -> String
}

impl Display for Int {
    fn to_string(self) -> String
}

// A conversion from `T`. `?` uses it to turn one error type into
// another.
pub trait From<T> {
    // The value made from `value`.
    fn from(value: T) -> Self
}
