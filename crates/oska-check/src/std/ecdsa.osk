// SPDX-License-Identifier: Apache-2.0
// `std.ecdsa`: verifying ECDSA signatures (FIPS 186-5, section 6.4.2) on
// the curves web certificates use, P-256 (secp256r1) and P-384
// (secp384r1), and signing on P-256. A module sees it only after `use
// std.ecdsa`. There is no key generation: a P-256 signing key is 32 secret
// bytes, such as `Random.secure_bytes(32)`, in 1 to n - 1.
//
// A key loads from its SEC1 uncompressed point, `0x04` then `x` then `y`
// (65 bytes on P-256, 97 on P-384), and is refused unless both
// coordinates are below the field prime and the point is on the curve. The
// curves have a cofactor of 1, so every point on them is in the group.
// `verify` takes the signature as the fixed-width `r || s` of IEEE P1363
// and `verify_der` as the DER `SEQUENCE { INTEGER r, INTEGER s }` that
// X.509 and TLS carry. Both take the digest of the message, not the
// message: the caller hashes it with the hash the signature names
// (`std.sha2` has SHA-256, SHA-384 and SHA-512). A digest longer than the
// curve's order is cut to its leftmost bytes, and a shorter one is taken as
// the integer it is, as the standard says.
//
// A signature is refused unless `r` and `s` are in 1 to n - 1. `s` is not
// required to be the low one of the two that verify, so an ECDSA
// signature is malleable as the standard has it. `verify_der` is strict:
// the encoding must be the one DER gives (a short-form length, a minimal
// positive integer, nothing after the sequence).
//
// Verification takes only public inputs, so its arithmetic is
// variable-time over public integers.
//
// `sign(key, digest)` signs the digest of a message with a P-256 `key`,
// which is a `Secret<Bytes>`, and gives the 64 bytes `r || s` of IEEE P1363
// (the form `verify` takes, and the one RFC 7518 section 3.4 gives ES256)
// as a secret, which the caller exposes where it needs the signature in the
// clear, as with `std.p256`. The digest is the caller's hash of the message
// (SHA-256 for ES256), any length: it is cut or taken as the integer it is,
// as `verify` does, so the signer is general over digests. The nonce is
// never the caller's: there is no parameter for it, so it can be neither
// repeated nor biased through this API. It is the deterministic nonce of
// RFC 6979 (section 3.2) with HMAC-SHA-256, so the same key and digest give
// the same signature, and two different digests give two different
// nonces, because the nonce is a function of the key and the digest. This
// is the default and the only mode: a random nonce would depend on
// the quality of the generator at every signature, which a deterministic
// one does not. The HMAC is SHA-256 whatever the digest is, as for a
// P-256 key with SHA-256, the pairing of RFC 6979's own vectors. `s` is
// not forced to the low one of the two, as with the vectors of the RFC.
//
// The key, the nonce and everything computed from them are secret integers
// (`std.p256_ops`), written so that no branch or memory address depends on
// a secret bit, which the checker proves and the native backend keeps, as
// for `std.p256`. The one thing the code reveals about them is a one-byte
// verdict, compared in constant time: whether the nonce, `r` and `s` were
// all usable. When they are not (a chance of about 2^-32) the procedure of
// RFC 6979 draws the next nonce from the same generator. The key never
// prints, interpolates, logs or compares (the rules for secrets), and the
// module has no audit site: no `expose()` and no `.assume_trusted()`. Every
// function is a pure function. A `PublicKey` is trusted with no assertion,
// as it is built from integers read out of the bytes and checked.
//
// This code is hand-written and has not been audited (ADR 0012). It is
// held by Project Wycheproof's ECDSA vectors, by RFC 6979's signatures and
// by `verify` accepting every signature `sign` makes, on the interpreter
// and natively on every supported platform.

// For maintainers: this file is Oska source, checked under the rules for
// user code and run as Oska by both backends. The comment block directly
// above a `pub` item is its description in the API reference.
//
// A number is a `List<U64>` of 32-bit limbs, least significant first, so
// a product of two limbs and the carries fit 64 bits. Arithmetic mod a
// prime is Montgomery's, with R = 2^(32 k) for a prime of k limbs: a
// value `a` is held as `a R mod m`, and `mont_mul` of two such gives the
// product in the same form. Points are projective, added and doubled with
// the complete formulas of Renes, Costello and Batina (2016, algorithms 4
// and 6, for a = -3), which hold for every pair of points, the identity
// and equal points included, so no case needs its own path.

use std.montgomery
use std.p256_ops
use std.sha2

// Which curve a key is on.
pub enum Curve {
    // NIST P-256, also called secp256r1 and prime256v1.
    P256,
    // NIST P-384, also called secp384r1.
    P384,
}

// An ECDSA public key: a point on P-256 or P-384, loaded from its SEC1
// uncompressed encoding by `from_bytes`, which checks it.
pub struct PublicKey { curve: Curve, x: List<U64>, y: List<U64>, encoding: Bytes }

impl PublicKey {
    // The key `bytes` encode on `curve`, or `None` unless they are the
    // SEC1 uncompressed encoding (`0x04`, `x`, `y`, each coordinate the
    // curve's width in bytes) of a point on the curve with both
    // coordinates below the field prime. A key from untrusted bytes needs
    // no trust assertion: its integers are read out of the bytes and
    // checked.
    pub fn from_bytes(curve: Curve, bytes: Untrusted<Bytes>) -> Option<PublicKey> {
        let c = params(curve)
        if bytes.len() != 1 + 2 * c.width || bytes.at(0) != 4 {
            return None
        }
        let x = montgomery.limbs_from_be(bytes, 1, c.limbs)
        let y = montgomery.limbs_from_be(bytes, 1 + c.width, c.limbs)
        if !montgomery.less(x, c.p.m) || !montgomery.less(y, c.p.m) || !on_curve(x, y, c) {
            return None
        }
        var encoding = Bytes.new()
        encoding.push(4)
        encoding.append(montgomery.limbs_to_be(x))
        encoding.append(montgomery.limbs_to_be(y))
        Some(PublicKey(curve: curve, x: x, y: y, encoding: encoding))
    }

    // The key's SEC1 uncompressed encoding, the bytes `from_bytes` accepted.
    pub fn to_bytes(self) -> Bytes {
        self.encoding
    }
}

// Whether `signature`, the 64 bytes (P-256) or 96 bytes (P-384) of `r`
// then `s`, each as a big-endian integer of the curve's width, is `key`'s
// ECDSA signature of the message whose hash is `digest`. A signature of
// any other length, or with `r` or `s` outside 1 to n - 1, is `false`.
pub fn verify(key: PublicKey, digest: Untrusted<Bytes>, signature: Untrusted<Bytes>) -> Bool {
    let c = params(key.curve)
    if signature.len() != 2 * c.width {
        return false
    }
    let r = montgomery.limbs_from_be(signature, 0, c.limbs)
    let s = montgomery.limbs_from_be(signature, c.width, c.limbs)
    check(key, c, digest, r, s)
}

// Whether `signature`, a DER `SEQUENCE { INTEGER r, INTEGER s }`, is
// `key`'s ECDSA signature of the message whose hash is `digest`. Only the
// DER encoding is accepted: a long-form or non-minimal length, an integer
// that is negative or has a redundant leading zero, an integer wider than
// the curve's order, or any byte after the sequence is `false`.
pub fn verify_der(key: PublicKey, digest: Untrusted<Bytes>, signature: Untrusted<Bytes>) -> Bool {
    let c = params(key.curve)
    // Both integers of the longest signature (97-byte `r` and `s` of a
    // P-384 signature with their zero bytes) fit a short-form length.
    if signature.len() < 8 || signature.at(0) != 48 || signature.at(1) >= 128 {
        return false
    }
    if signature.at(1).to_int() != signature.len() - 2 {
        return false
    }
    let r_end = der_integer_end(signature, 2)
    if r_end < 0 {
        return false
    }
    let s_end = der_integer_end(signature, r_end)
    if s_end != signature.len() {
        return false
    }
    let r_bytes = der_integer_value(signature, 2, r_end, c.width)
    let s_bytes = der_integer_value(signature, r_end, s_end, c.width)
    match r_bytes {
        Some(rb) => match s_bytes {
            Some(sb) => check(key, c, digest, montgomery.limbs_from_be(rb, 0, c.limbs), montgomery.limbs_from_be(sb, 0, c.limbs))
            None => false
        }
        None => false
    }
}

// ---- Signing ------------------------------------------------------------------

// The ECDSA signature (FIPS 186-5, section 6.4.1) of the message whose hash
// is `digest`, under the P-256 private key `key`, as the 64 bytes `r || s`
// (each a big-endian integer of 32 bytes) of IEEE P1363, which `verify`
// takes and RFC 7518 section 3.4 gives ES256. It is `None` unless `key` is
// 32 bytes and in 1 to n - 1; whether it is depends on the key's length and
// range and nothing else about it. The digest is any length, cut to its
// leftmost 32 bytes or taken as the integer it is, as in `verify`.
//
// The nonce is the deterministic one of RFC 6979 with HMAC-SHA-256: the
// same key and digest give the same signature, and the caller has no way to
// pick, repeat or bias a nonce. The key, the nonce and everything computed
// from them are secret integers, so no branch or memory address depends on
// them. The signature is returned as a secret, which the caller exposes
// where it needs it in the clear.
pub fn sign(key: Secret<Bytes>, digest: Untrusted<Bytes>) -> Option<Secret<Bytes>> {
    if !p256_ops.scalar_in_range(key) {
        return None
    }
    let e = digest_integer(params(Curve.P256), digest)
    // RFC 6979 section 3.2: the key and the hash as octets, `int2octets(x)`
    // and `bits2octets(h1)`, here both 32 bytes.
    var seed = Secret.new(Bytes.new())
    seed.append(key)
    seed.append(Secret.new(montgomery.limbs_to_be(e)))
    var k_key = Secret.new(Bytes.zeroed(32))
    var v = Secret.new(filled(32, 1))
    k_key = hmac_secret(k_key, with_separator(v, 0, seed))
    v = hmac_secret(k_key, v)
    k_key = hmac_secret(k_key, with_separator(v, 1, seed))
    v = hmac_secret(k_key, v)
    // The nonce candidates: the first that is usable signs. A candidate is
    // refused with a chance of about 2^-32, which is the draw of RFC 6979
    // section 3.2 step h.3.
    while true {
        v = hmac_secret(k_key, v)
        let signed = p256_ops.sign_with_nonce(key, v, e)
        if signed.usable {
            return Some(signed.signature)
        }
        k_key = hmac_secret(k_key, with_separator(v, 0, Secret.new(Bytes.new())))
        v = hmac_secret(k_key, v)
    }
    None
}

// `n` bytes, each `value`.
fn filled(n: Int, value: U8) -> Bytes {
    var out = Bytes.new()
    for _ in 0..n {
        out.push(value)
    }
    out
}

// `v`, then the byte `separator`, then `rest`.
fn with_separator(v: Secret<Bytes>, separator: U8, rest: Secret<Bytes>) -> Secret<Bytes> {
    var out = Secret.new(Bytes.new())
    out.append(v)
    out.push(Secret.new(separator))
    out.append(rest)
    out
}

// HMAC-SHA-256 (RFC 2104) of the secret `message` under the 32-byte secret
// `key`, in constant time. `std.hmac` takes a public message, and RFC 6979's
// carries the private key.
fn hmac_secret(key: Secret<Bytes>, message: Secret<Bytes>) -> Secret<Bytes> {
    var inner_key = Secret.new(Bytes.new())
    var outer_key = Secret.new(Bytes.new())
    let inner_pad: U8 = 54
    let outer_pad: U8 = 92
    for i in 0..32 {
        inner_key.push(key.at(i) ^ inner_pad)
        outer_key.push(key.at(i) ^ outer_pad)
    }
    // The other 32 bytes of the key's block are zeros, so just the pads.
    inner_key.append(Secret.new(filled(32, inner_pad)))
    outer_key.append(Secret.new(filled(32, outer_pad)))
    var inner = sha2.Sha256Secret.new()
    inner.update(inner_key)
    inner.update(message)
    var outer = sha2.Sha256Secret.new()
    outer.update(outer_key)
    outer.update(inner.finish())
    outer.finish()
}

// ---- DER --------------------------------------------------------------------

// The offset just past the DER `INTEGER` at `at` in `bytes`, or -1 when
// there is none there: the tag is 2, the length is a short-form one of 1 or
// more bytes that lie inside `bytes`, the value is positive, and a leading
// zero byte is there only because the next byte has its top bit set.
fn der_integer_end(bytes: Untrusted<Bytes>, at: Int) -> Int {
    if at + 2 > bytes.len() || bytes.at(at) != 2 || bytes.at(at + 1) >= 128 {
        return -1
    }
    let length = bytes.at(at + 1).to_int()
    let end = at + 2 + length
    if length == 0 || end > bytes.len() {
        return -1
    }
    let first = bytes.at(at + 2)
    if first >= 128 {
        return -1
    }
    if length > 1 && first == 0 && bytes.at(at + 3) < 128 {
        return -1
    }
    end
}

// The integer of the `INTEGER` between `start` and `end` (as
// `der_integer_end` gave them) as `width` big-endian bytes, or `None` when
// its value needs more than `width` bytes.
fn der_integer_value(bytes: Untrusted<Bytes>, start: Int, end: Int, width: Int) -> Option<Bytes> {
    var from = start + 2
    if bytes.at(from) == 0 {
        from = from + 1
    }
    let size = end - from
    if size > width {
        return None
    }
    var out = Bytes.zeroed(width - size)
    for i in from..end {
        out.push(bytes.at(i))
    }
    Some(out)
}

// ---- Verification -------------------------------------------------------------

// `e`: the leftmost `width` bytes of `digest`, as an integer, mod n (FIPS
// 186-5, section 6.4.1 step 2).
fn digest_integer(c: Domain, digest: Untrusted<Bytes>) -> List<U64> {
    let used = if digest.len() < c.width { digest.len() } else { c.width }
    var e_bytes = Bytes.zeroed(c.width - used)
    for i in 0..used {
        e_bytes.push(digest.at(i))
    }
    var e = montgomery.limbs_from_be(e_bytes, 0, c.limbs)
    if !montgomery.less(e, c.n.m) {
        e = montgomery.sub_limbs(e, c.n.m)
    }
    e
}

// Whether `(r, s)` is a signature of the hash `digest` by `key`: FIPS 186-5,
// section 6.4.2.
fn check(key: PublicKey, c: Domain, digest: Untrusted<Bytes>, r: List<U64>, s: List<U64>) -> Bool {
    let n = c.n
    if is_zero(r) || is_zero(s) || !montgomery.less(r, n.m) || !montgomery.less(s, n.m) {
        return false
    }
    let e = digest_integer(c, digest)
    // w = s^-1 mod n, kept in Montgomery form, which makes `mont_mul` of a
    // plain number and `w` the plain product.
    let w = montgomery.mont_pow(montgomery.mont_mul(s, n.r2, n), montgomery.sub_limbs(n.m, montgomery.small(2, c.limbs)), n)
    let u1 = montgomery.mont_mul(e, w, n)
    let u2 = montgomery.mont_mul(r, w, n)
    let p = c.p
    let q = Point(x: montgomery.mont_mul(key.x, p.r2, p), y: montgomery.mont_mul(key.y, p.r2, p), z: p.one)
    let g = Point(x: montgomery.mont_mul(c.gx, p.r2, p), y: montgomery.mont_mul(c.gy, p.r2, p), z: p.one)
    let sum = add_points(g, q, c)
    // [u1]G + [u2]Q, both at once: one doubling a bit, from the top, and
    // an addition for each bit set.
    var acc = Point(x: zero(c.limbs), y: p.one, z: zero(c.limbs))
    var i = c.limbs * 32 - 1
    while i >= 0 {
        acc = double_point(acc, c)
        let in_g = montgomery.bit_of(u1, i)
        let in_q = montgomery.bit_of(u2, i)
        if in_g && in_q {
            acc = add_points(acc, sum, c)
        } else if in_g {
            acc = add_points(acc, g, c)
        } else if in_q {
            acc = add_points(acc, q, c)
        }
        i = i - 1
    }
    if is_zero(acc.z) {
        return false
    }
    // The affine x of the result, mod n, must be r.
    let x_mont = montgomery.mont_mul(acc.x, montgomery.mont_pow(acc.z, montgomery.sub_limbs(p.m, montgomery.small(2, c.limbs)), p), p)
    var x = montgomery.mont_mul(x_mont, montgomery.small(1, c.limbs), p)
    if !montgomery.less(x, n.m) {
        x = montgomery.sub_limbs(x, n.m)
    }
    equal(x, r)
}

// Whether the affine point (x, y), both below p, is on the curve
// y^2 = x^3 - 3x + b.
fn on_curve(x: List<U64>, y: List<U64>, c: Domain) -> Bool {
    let p = c.p
    let xm = montgomery.mont_mul(x, p.r2, p)
    let ym = montgomery.mont_mul(y, p.r2, p)
    let three = montgomery.add_mod(p.one, montgomery.add_mod(p.one, p.one, p.m), p.m)
    let x2 = montgomery.mont_mul(xm, xm, p)
    let rhs = montgomery.add_mod(montgomery.mont_mul(xm, sub_mod(x2, three, p.m), p), montgomery.mont_mul(c.b, p.r2, p), p.m)
    equal(montgomery.mont_mul(ym, ym, p), rhs)
}

// ---- Points -------------------------------------------------------------------

// A point in projective coordinates (X : Y : Z), x = X/Z and y = Y/Z, each
// in Montgomery form mod p. The identity is (0 : 1 : 0).
struct Point { x: List<U64>, y: List<U64>, z: List<U64> }

// P + Q (Renes, Costello and Batina, algorithm 4), for any two points.
fn add_points(p1: Point, p2: Point, c: Domain) -> Point {
    let f = c.p
    let b = montgomery.mont_mul(c.b, f.r2, f)
    var t0 = montgomery.mont_mul(p1.x, p2.x, f)
    var t1 = montgomery.mont_mul(p1.y, p2.y, f)
    var t2 = montgomery.mont_mul(p1.z, p2.z, f)
    var t3 = montgomery.add_mod(p1.x, p1.y, f.m)
    var t4 = montgomery.add_mod(p2.x, p2.y, f.m)
    t3 = montgomery.mont_mul(t3, t4, f)
    t4 = montgomery.add_mod(t0, t1, f.m)
    t3 = sub_mod(t3, t4, f.m)
    t4 = montgomery.add_mod(p1.y, p1.z, f.m)
    var x3 = montgomery.add_mod(p2.y, p2.z, f.m)
    t4 = montgomery.mont_mul(t4, x3, f)
    x3 = montgomery.add_mod(t1, t2, f.m)
    t4 = sub_mod(t4, x3, f.m)
    x3 = montgomery.add_mod(p1.x, p1.z, f.m)
    var y3 = montgomery.add_mod(p2.x, p2.z, f.m)
    x3 = montgomery.mont_mul(x3, y3, f)
    y3 = montgomery.add_mod(t0, t2, f.m)
    y3 = sub_mod(x3, y3, f.m)
    var z3 = montgomery.mont_mul(b, t2, f)
    x3 = sub_mod(y3, z3, f.m)
    z3 = montgomery.add_mod(x3, x3, f.m)
    x3 = montgomery.add_mod(x3, z3, f.m)
    z3 = sub_mod(t1, x3, f.m)
    x3 = montgomery.add_mod(t1, x3, f.m)
    y3 = montgomery.mont_mul(b, y3, f)
    t1 = montgomery.add_mod(t2, t2, f.m)
    t2 = montgomery.add_mod(t1, t2, f.m)
    y3 = sub_mod(y3, t2, f.m)
    y3 = sub_mod(y3, t0, f.m)
    t1 = montgomery.add_mod(y3, y3, f.m)
    y3 = montgomery.add_mod(t1, y3, f.m)
    t1 = montgomery.add_mod(t0, t0, f.m)
    t0 = montgomery.add_mod(t1, t0, f.m)
    t0 = sub_mod(t0, t2, f.m)
    t1 = montgomery.mont_mul(t4, y3, f)
    t2 = montgomery.mont_mul(t0, y3, f)
    y3 = montgomery.mont_mul(x3, z3, f)
    y3 = montgomery.add_mod(y3, t2, f.m)
    x3 = montgomery.mont_mul(t3, x3, f)
    x3 = sub_mod(x3, t1, f.m)
    z3 = montgomery.mont_mul(t4, z3, f)
    t1 = montgomery.mont_mul(t3, t0, f)
    z3 = montgomery.add_mod(z3, t1, f.m)
    Point(x: x3, y: y3, z: z3)
}

// 2P (algorithm 6).
fn double_point(pt: Point, c: Domain) -> Point {
    let f = c.p
    let b = montgomery.mont_mul(c.b, f.r2, f)
    var t0 = montgomery.mont_mul(pt.x, pt.x, f)
    let t1 = montgomery.mont_mul(pt.y, pt.y, f)
    var t2 = montgomery.mont_mul(pt.z, pt.z, f)
    var t3 = montgomery.mont_mul(pt.x, pt.y, f)
    t3 = montgomery.add_mod(t3, t3, f.m)
    var z3 = montgomery.mont_mul(pt.x, pt.z, f)
    z3 = montgomery.add_mod(z3, z3, f.m)
    var y3 = montgomery.mont_mul(b, t2, f)
    y3 = sub_mod(y3, z3, f.m)
    var x3 = montgomery.add_mod(y3, y3, f.m)
    y3 = montgomery.add_mod(x3, y3, f.m)
    x3 = sub_mod(t1, y3, f.m)
    y3 = montgomery.add_mod(t1, y3, f.m)
    y3 = montgomery.mont_mul(x3, y3, f)
    x3 = montgomery.mont_mul(x3, t3, f)
    t3 = montgomery.add_mod(t2, t2, f.m)
    t2 = montgomery.add_mod(t2, t3, f.m)
    z3 = montgomery.mont_mul(b, z3, f)
    z3 = sub_mod(z3, t2, f.m)
    z3 = sub_mod(z3, t0, f.m)
    t3 = montgomery.add_mod(z3, z3, f.m)
    z3 = montgomery.add_mod(z3, t3, f.m)
    t3 = montgomery.add_mod(t0, t0, f.m)
    t0 = montgomery.add_mod(t3, t0, f.m)
    t0 = sub_mod(t0, t2, f.m)
    t0 = montgomery.mont_mul(t0, z3, f)
    y3 = montgomery.add_mod(y3, t0, f.m)
    t0 = montgomery.mont_mul(pt.y, pt.z, f)
    t0 = montgomery.add_mod(t0, t0, f.m)
    z3 = montgomery.mont_mul(t0, z3, f)
    x3 = sub_mod(x3, z3, f.m)
    z3 = montgomery.mont_mul(t0, t1, f)
    z3 = montgomery.add_mod(z3, z3, f.m)
    z3 = montgomery.add_mod(z3, z3, f.m)
    Point(x: x3, y: y3, z: z3)
}

// ---- The curves -----------------------------------------------------------------

// A curve y^2 = x^3 - 3x + b over GF(p) with a base point (gx, gy) of
// prime order n. `limbs` and `width` are the size of a number in limbs and
// in bytes. `b`, `gx` and `gy` are plain numbers.
struct Domain { limbs: Int, width: Int, p: montgomery.Field, n: montgomery.Field, b: List<U64>, gx: List<U64>, gy: List<U64> }

fn params(curve: Curve) -> Domain {
    match curve {
        Curve.P256 => curve_from(
            8,
            "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff",
            "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551",
            "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b",
            "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296",
            "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"
        )
        Curve.P384 => curve_from(
            12,
            "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff",
            "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973",
            "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef",
            "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7",
            "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f"
        )
    }
}

fn curve_from(limbs: Int, p: String, n: String, b: String, gx: String, gy: String) -> Domain {
    Domain(
        limbs: limbs,
        width: limbs * 4,
        p: montgomery.make_field(hex_limbs(p, limbs)),
        n: montgomery.make_field(hex_limbs(n, limbs)),
        b: hex_limbs(b, limbs),
        gx: hex_limbs(gx, limbs),
        gy: hex_limbs(gy, limbs)
    )
}

fn hex_limbs(text: String, limbs: Int) -> List<U64> {
    montgomery.limbs_from_be(Bytes.from_hex(text).unwrap_or(Bytes.new()), 0, limbs)
}

// ---- Numbers --------------------------------------------------------------------

const MASK: U64 = 4294967295

fn zero(limbs: Int) -> List<U64> {
    montgomery.small(0, limbs)
}

fn is_zero(x: List<U64>) -> Bool {
    for limb in x {
        if limb != 0 {
            return false
        }
    }
    true
}

fn equal(a: List<U64>, b: List<U64>) -> Bool {
    for i in 0..a.len() {
        if a.at(i) != b.at(i) {
            return false
        }
    }
    true
}

// `a - b` mod m, for `a` and `b` below `m`.
fn sub_mod(a: List<U64>, b: List<U64>, m: List<U64>) -> List<U64> {
    let diff = montgomery.sub_limbs(a, b)
    if !montgomery.less(a, b) {
        return diff
    }
    var out: List<U64> = List.new()
    var carry: U64 = 0
    for i in 0..a.len() {
        let limb = diff.at(i) + m.at(i) + carry
        out.push(limb & MASK)
        carry = limb >> 32
    }
    out
}
