// `std.sql`: the SQL sink. Like the prelude it is parsed in prelude mode
// and is signature-only; the runtime implementation comes with the
// interpreter (#9). A module sees these declarations only after
// `use std.sql`, as `sql.Db` and the like.
//
// Query text is a **structural position**: it must be a `sql"..."`
// literal. Values enter a query only as parameters, a **data position**.

// The text of a query. Only a `sql"..."` literal makes one: its field is
// private, so no other code can construct it.
pub struct SqlLiteral { text: String }

// A database connection. It reaches the database over the network, so it
// is capability-bearing, and its field is private, so it can't be forged.
pub cap struct Db { conn: NetConnect }

impl Db {
    // Run `query`, binding each `?` in it to the next of `params`.
    pub fn query(self, query: SqlLiteral, params: List<Untrusted<String>>) -> Result<List<Row>, SqlError>
}

// Connect to the database at `url`. The URL decides where the program
// connects, so it is structural, like a `NetConnect` host.
pub fn connect(net: NetConnect, url: String) -> Result<Db, SqlError>

// A result row. Its values come from the database, so they are untrusted.
pub struct Row { handle: Int }

impl Row {
    pub fn get(self, column: String) -> Option<Untrusted<String>>
}

pub struct SqlError { pub message: Untrusted<String> }

impl Display for SqlError {
    fn to_string(self) -> String
}
