// `std.sha384`: the SHA-384 hash function of FIPS 180-4, in one call
// (`sha384.sha384(data)`) or a piece at a time (`Sha384`), the transcript
// hash of TLS 1.3's SHA-384 cipher suites. A module sees it only after
// `use std.sha384`.
//
// A digest is trusted `Bytes`, whatever the trust of the data hashed: it
// is a fixed-length value computed from integers read out of the data,
// which the data cannot shape into anything structural. Hashing is for
// public data (a transcript, a certificate); there is no secret form.
//
// Every function here is a pure function, and the module has no audit
// site: no `expose()` and no `.assume_trusted()`.
//
// This code is hand-written and has not been audited (ADR 0012). It is
// held by FIPS 180-4's examples, the one-million-`a` example and digests
// recorded from `sha384sum` for every length from 0 to 130 bytes and
// around three blocks, on the interpreter and natively on every supported
// platform.

// For maintainers: this file is Oska source, checked under the rules for
// user code and run as Oska by both backends. The comment block directly
// above a `pub` item is its description in the API reference. SHA-384 is
// SHA-512 with another initial value and a digest cut to 48 bytes; the
// compression below is `std.sha2`'s `compress512`, which that module keeps
// private.

// The SHA-384 digest of `data`: 48 bytes.
pub fn sha384(data: Untrusted<Bytes>) -> Bytes {
    var hasher = Sha384.new()
    hasher.update(data)
    hasher.finish()
}

// A SHA-384 digest being computed, a piece of data at a time. It is a
// value: a copy made part-way hashes on independently of the original, so
// a shared prefix, such as a handshake transcript, is hashed once.
pub struct Sha384 { state: List<U64>, pending: Bytes, length: Int }

impl Sha384 {
    // A hasher that has hashed nothing yet.
    pub fn new() -> Sha384 {
        Sha384(state: initial384(), pending: Bytes.new(), length: 0)
    }

    // Hash `data` after everything hashed so far. Hashing the data in any
    // number of pieces, empty ones included, gives the digest of the
    // pieces joined.
    pub fn update(var self, data: Untrusted<Bytes>) {
        self.length = self.length + data.len()
        var at = 0
        if self.pending.len() > 0 {
            while at < data.len() && self.pending.len() < 128 {
                self.pending.push(data.at(at))
                at = at + 1
            }
            if self.pending.len() < 128 {
                return
            }
            self.state = compress512(self.state, self.pending, 0)
            self.pending = Bytes.new()
        }
        while data.len() - at >= 128 {
            self.state = compress512(self.state, data, at)
            at = at + 128
        }
        while at < data.len() {
            self.pending.push(data.at(at))
            at = at + 1
        }
    }

    // The SHA-384 digest of everything hashed: 48 bytes.
    pub fn finish(self) -> Bytes {
        var block = self.pending
        block.append(padding(self.pending.len()))
        // The length in bits is 128 bits wide; a `Bytes` never holds
        // enough for its high half to be anything but zero.
        block.push_u64_be(0)
        block.push_u64_be((self.length * 8).to_u64())
        var state = self.state
        var at = 0
        while at < block.len() {
            state = compress512(state, block, at)
            at = at + 128
        }
        var digest = Bytes.new()
        for i in 0..6 {
            digest.push_u64_be(state.at(i))
        }
        digest
    }
}

// The padding after `pending` bytes of a last block: the byte 128, then
// zeros up to the last 16 bytes of a block. The length is the caller's.
fn padding(pending: Int) -> Bytes {
    var pad = Bytes.new()
    pad.push(128)
    while (pending + pad.len()) % 128 != 112 {
        pad.push(0)
    }
    pad
}

// ---- The SHA-512 compression (FIPS 180-4, sections 4.1.3 and 6.4), which SHA-384 shares ------------------

// The initial hash value (section 5.3.4), in decimal.
fn initial384() -> List<U64> {
    [
        14680500436340154072, 7105036623409894663, 10473403895298186519, 1526699215303891257,
        7436329637833083697, 10282925794625328401, 15784041429090275239, 5167115440072839076
    ]
}

// The 80 round constants (section 4.2.3), in decimal.
fn constants512() -> List<U64> {
    [
        4794697086780616226, 8158064640168781261, 13096744586834688815, 16840607885511220156,
        4131703408338449720, 6480981068601479193, 10538285296894168987, 12329834152419229976,
        15566598209576043074, 1334009975649890238, 2608012711638119052, 6128411473006802146,
        8268148722764581231, 9286055187155687089, 11230858885718282805, 13951009754708518548,
        16472876342353939154, 17275323862435702243, 1135362057144423861, 2597628984639134821,
        3308224258029322869, 5365058923640841347, 6679025012923562964, 8573033837759648693,
        10970295158949994411, 12119686244451234320, 12683024718118986047, 13788192230050041572,
        14330467153632333762, 15395433587784984357, 489312712824947311, 1452737877330783856,
        2861767655752347644, 3322285676063803686, 5560940570517711597, 5996557281743188959,
        7280758554555802590, 8532644243296465576, 9350256976987008742, 10552545826968843579,
        11727347734174303076, 12113106623233404929, 14000437183269869457, 14369950271660146224,
        15101387698204529176, 15463397548674623760, 17586052441742319658, 1182934255886127544,
        1847814050463011016, 2177327727835720531, 2830643537854262169, 3796741975233480872,
        4115178125766777443, 5681478168544905931, 6601373596472566643, 7507060721942968483,
        8399075790359081724, 8693463985226723168, 9568029438360202098, 10144078919501101548,
        10430055236837252648, 11840083180663258601, 13761210420658862357, 14299343276471374635,
        14566680578165727644, 15097957966210449927, 16922976911328602910, 17689382322260857208,
        500013540394364858, 748580250866718886, 1242879168328830382, 1977374033974150939,
        2944078676154940804, 3659926193048069267, 4368137639120453308, 4836135668995329356,
        5532061633213252278, 6448918945643986474, 6902733635092675308, 7801388544844847127
    ]
}

fn big_sigma0_512(x: U64) -> U64 {
    x.rotr(28) ^ x.rotr(34) ^ x.rotr(39)
}

fn big_sigma1_512(x: U64) -> U64 {
    x.rotr(14) ^ x.rotr(18) ^ x.rotr(41)
}

fn small_sigma0_512(x: U64) -> U64 {
    x.rotr(1) ^ x.rotr(8) ^ (x >> 7)
}

fn small_sigma1_512(x: U64) -> U64 {
    x.rotr(19) ^ x.rotr(61) ^ (x >> 6)
}

// `state` after the 128-byte block of `data` at `offset` (section 6.4.2).
fn compress512(state: List<U64>, data: Untrusted<Bytes>, offset: Int) -> List<U64> {
    let k = constants512()
    var w: List<U64> = List.new()
    for t in 0..16 {
        w.push(data.read_u64_be(offset + t * 8))
    }
    for t in 16..80 {
        let s1 = small_sigma1_512(w.at(t - 2))
        let s0 = small_sigma0_512(w.at(t - 15))
        w.push(s1.wrapping_add(w.at(t - 7)).wrapping_add(s0).wrapping_add(w.at(t - 16)))
    }
    var a = state.at(0)
    var b = state.at(1)
    var c = state.at(2)
    var d = state.at(3)
    var e = state.at(4)
    var f = state.at(5)
    var g = state.at(6)
    var h = state.at(7)
    for t in 0..80 {
        let ch = (e & f) ^ (~e & g)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let t1 = h.wrapping_add(big_sigma1_512(e)).wrapping_add(ch).wrapping_add(k.at(t)).wrapping_add(w.at(t))
        let t2 = big_sigma0_512(a).wrapping_add(maj)
        h = g
        g = f
        f = e
        e = d.wrapping_add(t1)
        d = c
        c = b
        b = a
        a = t1.wrapping_add(t2)
    }
    [
        state.at(0).wrapping_add(a), state.at(1).wrapping_add(b),
        state.at(2).wrapping_add(c), state.at(3).wrapping_add(d),
        state.at(4).wrapping_add(e), state.at(5).wrapping_add(f),
        state.at(6).wrapping_add(g), state.at(7).wrapping_add(h)
    ]
}
