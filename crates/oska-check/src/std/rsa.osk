// `std.rsa`: verifying RSA signatures (RFC 8017), PKCS#1 v1.5 (section
// 8.2) and PSS (section 8.1), the two schemes web certificates and TLS
// use. A module sees it only after `use std.rsa`. There is no signing, no
// encryption and no key generation.
//
// A key loads from its modulus and public exponent, as the big-endian
// unsigned integers an X.509 `RSAPublicKey` holds (leading zero bytes
// are ignored), and is refused unless the modulus is odd and from 2048 to
// 8192 bits and the exponent is odd, at least 3 and below 2^32. A
// signature is as long as the modulus in bytes and, as an integer, below
// it; anything else is `false`.
//
// Both functions take the digest of the message, not the message: the
// caller hashes it with the hash the signature names (`std.sha2` has
// SHA-256, SHA-384 and SHA-512). `verify_pkcs1` rebuilds the one encoded
// message RFC 8017 allows (`00 01 FF..FF 00`, then the `DigestInfo` with
// its `NULL` parameter, then the digest) and compares the whole of it, so
// a signature with other padding, a different or missing parameter, or
// trailing bytes is `false`. `verify_pss` uses MGF1 with the same hash
// and a salt as long as the digest, the parameters of TLS 1.3's
// `rsa_pss_rsae_*` and of X.509's usual `RSASSA-PSS`.
//
// Every input is public, so the arithmetic here is variable-time over
// public integers: it holds nothing secret. Every function is a pure
// function, and the module has no audit site: no `expose()` and no
// `.assume_trusted()`. A `PublicKey` is trusted with no assertion, as it
// is built from integers read out of the bytes and checked.
//
// This code is hand-written and has not been audited (ADR 0012). It is
// held by Project Wycheproof's RSA PKCS#1 v1.5 and PSS vectors, on the
// interpreter and natively on every supported platform.

// For maintainers: this file is Oska source, checked under the rules for
// user code and run as Oska by both backends. The comment block directly
// above a `pub` item is its description in the API reference.
//
// A number is a `List<U64>` of 32-bit limbs, least significant first, and
// arithmetic mod the modulus is Montgomery's (see `std.ecdsa`, which has
// the same helpers): a value `a` is held as `a R mod m` for R = 2^(32 k).
// The exponent is below 2^32, so a verification is at most 32 squarings
// and as many multiplications.

use std.sha2

// The hash a signature was made with. It fixes the digest's length (32,
// 48 or 64 bytes) and, for PKCS#1 v1.5, its `DigestInfo`.
pub enum HashAlgorithm {
    Sha256,
    Sha384,
    Sha512,
}

// An RSA public key: a modulus and a public exponent, which
// `from_components` checks.
pub struct PublicKey { field: Field, exponent: List<U64>, size: Int, bits: Int }

impl PublicKey {
    // The key with `modulus` and `exponent`, big-endian unsigned integers
    // from trusted or untrusted bytes, or `None` unless the modulus is
    // odd and from 2048 to 8192 bits and the exponent is odd, at least 3
    // and below 2^32. A key from untrusted bytes needs no trust
    // assertion: its integers are read out of the bytes and checked.
    pub fn from_components(modulus: Untrusted<Bytes>, exponent: Untrusted<Bytes>) -> Option<PublicKey> {
        let m_start = first_nonzero(modulus)
        let e_start = first_nonzero(exponent)
        let size = modulus.len() - m_start
        if size < 256 || size > 1024 || exponent.len() - e_start > 4 || exponent.len() == e_start {
            return None
        }
        let bits = 8 * (size - 1) + bit_length(modulus.at(m_start))
        if bits < 2048 || bits > 8192 || modulus.at(modulus.len() - 1) % 2 == 0 {
            return None
        }
        let e = number_from(exponent, e_start, 1)
        if e.at(0) < 3 || e.at(0) % 2 == 0 {
            return None
        }
        let limbs = (size + 3) / 4
        Some(PublicKey(field: make_field(number_from(modulus, m_start, limbs)), exponent: e, size: size, bits: bits))
    }

    // The modulus' length in bits: 2048 to 8192.
    pub fn bits(self) -> Int {
        self.bits
    }
}

// Whether `signature` is `key`'s RSASSA-PKCS1-v1_5 signature of the message
// whose `hash` digest is `digest`. A digest that is not `hash`'s length is
// `false`, as is a signature that is not the modulus' length, not below
// the modulus, or whose padding is anything but the one encoding.
pub fn verify_pkcs1(key: PublicKey, hash: HashAlgorithm, digest: Untrusted<Bytes>, signature: Untrusted<Bytes>) -> Bool {
    if digest.len() != hash_length(hash) {
        return false
    }
    let decoded = public_operation(key, signature)
    if !decoded.is_some() {
        return false
    }
    let em = decoded.unwrap_or(Bytes.new())
    let info = digest_info(hash)
    let padding = key.size - 3 - info.len() - digest.len()
    if padding < 8 {
        return false
    }
    var expected = Bytes.new()
    expected.push(0)
    expected.push(1)
    for _ in 0..padding {
        expected.push(255)
    }
    expected.push(0)
    expected.append(info)
    for i in 0..digest.len() {
        expected.push(digest.at(i))
    }
    em == expected
}

// Whether `signature` is `key`'s RSASSA-PSS signature of the message whose
// `hash` digest is `digest`, made with MGF1 over `hash` and a salt as long
// as the digest (RFC 8017, section 9.1.2). A digest that is not `hash`'s
// length is `false`, as is a signature that is not the modulus' length,
// not below the modulus, or that does not decode as PSS.
pub fn verify_pss(key: PublicKey, hash: HashAlgorithm, digest: Untrusted<Bytes>, signature: Untrusted<Bytes>) -> Bool {
    let h_len = hash_length(hash)
    if digest.len() != h_len {
        return false
    }
    let decoded = public_operation(key, signature)
    if !decoded.is_some() {
        return false
    }
    let full = decoded.unwrap_or(Bytes.new())
    // EM is emLen = ceil((bits - 1) / 8) bytes: the whole value, or all
    // but its first byte, which must then be zero, when bits is 1 mod 8.
    let em_bits = key.bits - 1
    let em_len = (em_bits + 7) / 8
    var em = full
    if em_len == key.size - 1 {
        if full.at(0) != 0 {
            return false
        }
        em = full.slice(1, key.size)
    }
    if em_len < 2 * h_len + 2 || em.at(em_len - 1) != 188 {
        return false
    }
    let db_len = em_len - h_len - 1
    let masked = em.slice(0, db_len)
    let h = em.slice(db_len, em_len - 1)
    let unused = (8 * em_len - em_bits).to_u8()
    if unused > 0 && (masked.at(0) >> (8 - unused)) != 0 {
        return false
    }
    let mask = mgf1(hash, h, db_len)
    var db = Bytes.new()
    for i in 0..db_len {
        db.push(masked.at(i) ^ mask.at(i))
    }
    db.set(0, db.at(0) & (255 >> unused))
    let zeros = db_len - h_len - 1
    for i in 0..zeros {
        if db.at(i) != 0 {
            return false
        }
    }
    if db.at(zeros) != 1 {
        return false
    }
    var message = Bytes.zeroed(8)
    for i in 0..h_len {
        message.push(digest.at(i))
    }
    message.append(db.slice(zeros + 1, db_len))
    hash_bytes(hash, message) == h
}

// ---- RSA --------------------------------------------------------------------

// `signature` raised to the public exponent mod the modulus, as `size`
// big-endian bytes, or `None` unless it is `size` bytes and below the
// modulus.
fn public_operation(key: PublicKey, signature: Untrusted<Bytes>) -> Option<Bytes> {
    if signature.len() != key.size {
        return None
    }
    let f = key.field
    let s = number_from(signature, 0, f.m.len())
    if !less(s, f.m) {
        return None
    }
    let result = mont_mul(mont_pow(mont_mul(s, f.r2, f), key.exponent, f), small(1, f.m.len()), f)
    let bytes = limbs_to_be(result)
    Some(bytes.slice(bytes.len() - key.size, bytes.len()))
}

fn hash_length(hash: HashAlgorithm) -> Int {
    match hash {
        HashAlgorithm.Sha256 => 32
        HashAlgorithm.Sha384 => 48
        HashAlgorithm.Sha512 => 64
    }
}

fn hash_bytes(hash: HashAlgorithm, data: Bytes) -> Bytes {
    match hash {
        HashAlgorithm.Sha256 => sha2.sha256(data)
        HashAlgorithm.Sha384 => sha2.sha384(data)
        HashAlgorithm.Sha512 => sha2.sha512(data)
    }
}

// The `DigestInfo` before the digest (RFC 8017, section 9.2, note 1): the
// DER of a `SEQUENCE` of the hash's OID with a `NULL` parameter and an
// `OCTET STRING` for the digest.
fn digest_info(hash: HashAlgorithm) -> Bytes {
    let text = match hash {
        HashAlgorithm.Sha256 => "3031300d060960864801650304020105000420"
        HashAlgorithm.Sha384 => "3041300d060960864801650304020205000430"
        HashAlgorithm.Sha512 => "3051300d060960864801650304020305000440"
    }
    Bytes.from_hex(text).unwrap_or(Bytes.new())
}

// MGF1 (RFC 8017, appendix B.2.1): `length` bytes from `seed`.
fn mgf1(hash: HashAlgorithm, seed: Bytes, length: Int) -> Bytes {
    var out = Bytes.new()
    var counter = 0
    while out.len() < length {
        var block = seed
        block.push_u32_be(counter.to_u32())
        out.append(hash_bytes(hash, block))
        counter = counter + 1
    }
    out.slice(0, length)
}

// The index of the first byte of `bytes` that is not zero, or its length.
fn first_nonzero(bytes: Untrusted<Bytes>) -> Int {
    var i = 0
    while i < bytes.len() && bytes.at(i) == 0 {
        i = i + 1
    }
    i
}

// The number of bits in the nonzero byte `b`.
fn bit_length(b: U8) -> Int {
    var n = 0
    var rest = b
    while rest != 0 {
        n = n + 1
        rest = rest >> 1
    }
    n
}

// The big-endian number in the bytes of `bytes` from `start` to its end,
// as `limbs` limbs.
fn number_from(bytes: Untrusted<Bytes>, start: Int, limbs: Int) -> List<U64> {
    var padded = Bytes.zeroed(4 * limbs - (bytes.len() - start))
    for i in start..bytes.len() {
        padded.push(bytes.at(i))
    }
    limbs_from_be(padded, 0, limbs)
}

// A prime modulus of `m.len()` limbs, with what Montgomery arithmetic
// mod it needs: `n0` is -m^-1 mod 2^32, `r2` is R^2 mod m and `one` is R
// mod m (the number 1 in Montgomery form).
struct Field { m: List<U64>, n0: U64, r2: List<U64>, one: List<U64> }

// The Montgomery constants of the odd modulus `m`.
fn make_field(m: List<U64>) -> Field {
    let m0 = m.at(0)
    // Newton's iteration for the inverse of m0 mod 2^32: each step doubles
    // the bits right, and an odd m0 starts with 3.
    let two: U64 = 2
    var inverse = m0
    for _ in 0..5 {
        inverse = inverse.wrapping_mul(two.wrapping_sub(m0.wrapping_mul(inverse))) & MASK
    }
    let n0 = (4294967296 - inverse) & MASK
    // R mod m and R^2 mod m, by doubling 1 for 32 k and then 64 k times.
    var x = small(1, m.len())
    var one = x
    for i in 0..m.len() * 64 {
        x = add_mod(x, x, m)
        if i == m.len() * 32 - 1 {
            one = x
        }
    }
    Field(m: m, n0: n0, r2: x, one: one)
}

// ---- Numbers --------------------------------------------------------------------

const MASK: U64 = 4294967295

// The number `value` (below 2^32) in `limbs` limbs.
fn small(value: U64, limbs: Int) -> List<U64> {
    var out: List<U64> = [value]
    for _ in 1..limbs {
        out.push(0)
    }
    out
}

// The `limbs` limbs of the big-endian number of `4 * limbs` bytes at
// `start` in `bytes`.
fn limbs_from_be(bytes: Untrusted<Bytes>, start: Int, limbs: Int) -> List<U64> {
    var out: List<U64> = List.new()
    var i = limbs - 1
    while i >= 0 {
        out.push(bytes.read_u32_be(start + 4 * i).to_u64())
        i = i - 1
    }
    out
}

// `x` as big-endian bytes, four to a limb.
fn limbs_to_be(x: List<U64>) -> Bytes {
    var out = Bytes.new()
    var i = x.len() - 1
    while i >= 0 {
        out.push_u32_be(x.at(i).to_u32())
        i = i - 1
    }
    out
}

// Whether `a` < `b`.
fn less(a: List<U64>, b: List<U64>) -> Bool {
    var i = a.len() - 1
    while i >= 0 {
        if a.at(i) != b.at(i) {
            return a.at(i) < b.at(i)
        }
        i = i - 1
    }
    false
}

// Bit `i` of `x`.
fn bit_of(x: List<U64>, i: Int) -> Bool {
    ((x.at(i / 32) >> (i % 32).to_u64()) & 1) == 1
}

// `a - b`, modulo 2^(32 k) for numbers of k limbs.
fn sub_limbs(a: List<U64>, b: List<U64>) -> List<U64> {
    var diff: List<U64> = List.new()
    var borrow: U64 = 0
    for i in 0..a.len() {
        let limb = a.at(i) + 4294967296 - b.at(i) - borrow
        diff.push(limb & MASK)
        borrow = 1 - (limb >> 32)
    }
    diff
}

// `a + b` mod m, for `a` and `b` below `m`.
fn add_mod(a: List<U64>, b: List<U64>, m: List<U64>) -> List<U64> {
    var sum: List<U64> = List.new()
    var carry: U64 = 0
    for i in 0..a.len() {
        let limb = a.at(i) + b.at(i) + carry
        sum.push(limb & MASK)
        carry = limb >> 32
    }
    if carry == 1 || !less(sum, m) { sub_limbs(sum, m) } else { sum }
}

// The Montgomery product `a b R^-1` mod m of `a` and `b` below m: one
// pass a limb of `b`, adding `a b_i`, then the multiple of m that clears
// the lowest limb, and shifting down a limb.
fn mont_mul(a: List<U64>, b: List<U64>, f: Field) -> List<U64> {
    let k = f.m.len()
    var t: List<U64> = List.new()
    for _ in 0..k + 1 {
        t.push(0)
    }
    for i in 0..k {
        let bi = b.at(i)
        let s0 = t.at(0) + a.at(0) * bi
        let q = ((s0 & MASK) * f.n0) & MASK
        var c1 = s0 >> 32
        var c2 = ((s0 & MASK) + q * f.m.at(0)) >> 32
        var next: List<U64> = List.new()
        for j in 1..k {
            let s = t.at(j) + a.at(j) * bi + c1
            c1 = s >> 32
            let s2 = (s & MASK) + q * f.m.at(j) + c2
            c2 = s2 >> 32
            next.push(s2 & MASK)
        }
        let top = t.at(k) + c1 + c2
        next.push(top & MASK)
        next.push(top >> 32)
        t = next
    }
    var out: List<U64> = List.new()
    for i in 0..k {
        out.push(t.at(i))
    }
    if t.at(k) != 0 || !less(out, f.m) { sub_limbs(out, f.m) } else { out }
}

// `base` (in Montgomery form) to the power `exp`, in Montgomery form.
fn mont_pow(base: List<U64>, exp: List<U64>, f: Field) -> List<U64> {
    var acc = f.one
    var i = exp.len() * 32 - 1
    while i >= 0 {
        acc = mont_mul(acc, acc, f)
        if bit_of(exp, i) {
            acc = mont_mul(acc, base, f)
        }
        i = i - 1
    }
    acc
}
