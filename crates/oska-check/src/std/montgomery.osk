// SPDX-License-Identifier: Apache-2.0
// `std.montgomery`: the arithmetic over public multi-limb integers that
// `std.ecdsa` and `std.rsa` share. It is a hidden module, as `std.x509_roots`
// is: it is not part of the user-facing API, and no program is meant to
// `use` it (no stability promise holds for it). It holds nothing secret:
// every function is variable-time over public integers, as the two modules
// that use it are. `std.p256` has its own copy over `Secret<U64>`, since a
// secret integer is another type and its arithmetic must not branch.
//
// For maintainers: a number is a `List<U64>` of 32-bit limbs, least
// significant first, so a product of two limbs and the carries fit 64 bits.
// Arithmetic mod a prime is Montgomery's, with R = 2^(32 k) for a prime of
// k limbs: a value `a` is held as `a R mod m`, and `mont_mul` of two such
// gives the product in the same form.

const MASK: U64 = 4294967295

// A prime modulus of `m.len()` limbs, with what Montgomery arithmetic
// mod it needs: `n0` is -m^-1 mod 2^32, `r2` is R^2 mod m and `one` is R
// mod m (the number 1 in Montgomery form).
pub struct Field { pub m: List<U64>, pub n0: U64, pub r2: List<U64>, pub one: List<U64> }

// The Montgomery constants of the odd modulus `m`.
pub fn make_field(m: List<U64>) -> Field {
    let m0 = m.at(0)
    // Newton's iteration for the inverse of m0 mod 2^32: each step doubles
    // the bits right, and an odd m0 starts with 3.
    let two: U64 = 2
    var inverse = m0
    for _ in 0..5 {
        inverse = inverse.wrapping_mul(two.wrapping_sub(m0.wrapping_mul(inverse))) & MASK
    }
    let n0 = (4294967296 - inverse) & MASK
    // R mod m and R^2 mod m, by doubling 1 for 32 k and then 64 k times.
    var x = small(1, m.len())
    var one = x
    for i in 0..m.len() * 64 {
        x = add_mod(x, x, m)
        if i == m.len() * 32 - 1 {
            one = x
        }
    }
    Field(m: m, n0: n0, r2: x, one: one)
}

// The number `value` (below 2^32) in `limbs` limbs.
pub fn small(value: U64, limbs: Int) -> List<U64> {
    var out: List<U64> = [value]
    for _ in 1..limbs {
        out.push(0)
    }
    out
}

// The `limbs` limbs of the big-endian number of `4 * limbs` bytes at
// `start` in `bytes`.
pub fn limbs_from_be(bytes: Untrusted<Bytes>, start: Int, limbs: Int) -> List<U64> {
    var out: List<U64> = List.new()
    var i = limbs - 1
    while i >= 0 {
        out.push(bytes.read_u32_be(start + 4 * i).to_u64())
        i = i - 1
    }
    out
}

// `x` as big-endian bytes, four to a limb.
pub fn limbs_to_be(x: List<U64>) -> Bytes {
    var out = Bytes.new()
    var i = x.len() - 1
    while i >= 0 {
        out.push_u32_be(x.at(i).to_u32())
        i = i - 1
    }
    out
}

// Whether `a` < `b`.
pub fn less(a: List<U64>, b: List<U64>) -> Bool {
    var i = a.len() - 1
    while i >= 0 {
        if a.at(i) != b.at(i) {
            return a.at(i) < b.at(i)
        }
        i = i - 1
    }
    false
}

// Bit `i` of `x`.
pub fn bit_of(x: List<U64>, i: Int) -> Bool {
    ((x.at(i / 32) >> (i % 32).to_u64()) & 1) == 1
}

// `a - b`, modulo 2^(32 k) for numbers of k limbs.
pub fn sub_limbs(a: List<U64>, b: List<U64>) -> List<U64> {
    var diff: List<U64> = List.new()
    var borrow: U64 = 0
    for i in 0..a.len() {
        let limb = a.at(i) + 4294967296 - b.at(i) - borrow
        diff.push(limb & MASK)
        borrow = 1 - (limb >> 32)
    }
    diff
}

// `a + b` mod m, for `a` and `b` below `m`.
pub fn add_mod(a: List<U64>, b: List<U64>, m: List<U64>) -> List<U64> {
    var sum: List<U64> = List.new()
    var carry: U64 = 0
    for i in 0..a.len() {
        let limb = a.at(i) + b.at(i) + carry
        sum.push(limb & MASK)
        carry = limb >> 32
    }
    if carry == 1 || !less(sum, m) { sub_limbs(sum, m) } else { sum }
}

// The Montgomery product `a b R^-1` mod m of `a` and `b` below m: one
// pass a limb of `b`, adding `a b_i`, then the multiple of m that clears
// the lowest limb, and shifting down a limb.
pub fn mont_mul(a: List<U64>, b: List<U64>, f: Field) -> List<U64> {
    let k = f.m.len()
    var t: List<U64> = List.new()
    for _ in 0..k + 1 {
        t.push(0)
    }
    for i in 0..k {
        let bi = b.at(i)
        let s0 = t.at(0) + a.at(0) * bi
        let q = ((s0 & MASK) * f.n0) & MASK
        var c1 = s0 >> 32
        var c2 = ((s0 & MASK) + q * f.m.at(0)) >> 32
        var next: List<U64> = List.new()
        for j in 1..k {
            let s = t.at(j) + a.at(j) * bi + c1
            c1 = s >> 32
            let s2 = (s & MASK) + q * f.m.at(j) + c2
            c2 = s2 >> 32
            next.push(s2 & MASK)
        }
        let top = t.at(k) + c1 + c2
        next.push(top & MASK)
        next.push(top >> 32)
        t = next
    }
    var out: List<U64> = List.new()
    for i in 0..k {
        out.push(t.at(i))
    }
    if t.at(k) != 0 || !less(out, f.m) { sub_limbs(out, f.m) } else { out }
}

// `base` (in Montgomery form) to the power `exp`, in Montgomery form.
pub fn mont_pow(base: List<U64>, exp: List<U64>, f: Field) -> List<U64> {
    var acc = f.one
    var i = exp.len() * 32 - 1
    while i >= 0 {
        acc = mont_mul(acc, acc, f)
        if bit_of(exp, i) {
            acc = mont_mul(acc, base, f)
        }
        i = i - 1
    }
    acc
}
