// `std.rt`: the toolchain's own runtime module (ADR 0013). It is compiled
// into every native program and is the only source that may name a
// system-call or memory intrinsic. No user code can import it (`E0209`).
//
// An intrinsic is a body-less function whose name starts with `rt_sys_`
// (one Linux aarch64 system call) or `rt_mem_` (one memory or word
// operation). Both prefixes are reserved: `scripts/intrinsic-guard/guard.sh`
// fails the build if any other `.osk` file names such an identifier, and
// the checker reports `E0209` for it. The interpreter has no
// implementation of them.
//
// Every argument and result is an `Int` (a 64-bit word). A system call
// returns the kernel's raw result: a negative value is `-errno`.

// ---- System calls ----------------------------------------------------------

pub fn rt_sys_read(fd: Int, buf: Int, count: Int) -> Int
pub fn rt_sys_write(fd: Int, buf: Int, count: Int) -> Int
pub fn rt_sys_openat(dirfd: Int, path: Int, flags: Int, mode: Int) -> Int
pub fn rt_sys_close(fd: Int) -> Int
pub fn rt_sys_mkdirat(dirfd: Int, path: Int, mode: Int) -> Int
pub fn rt_sys_getdents64(fd: Int, buf: Int, count: Int) -> Int
pub fn rt_sys_fstat(fd: Int, buf: Int) -> Int
pub fn rt_sys_ftruncate(fd: Int, length: Int) -> Int
pub fn rt_sys_readlinkat(dirfd: Int, path: Int, buf: Int, size: Int) -> Int
pub fn rt_sys_fcntl(fd: Int, command: Int, arg: Int) -> Int
pub fn rt_sys_mmap(addr: Int, length: Int, prot: Int, flags: Int, fd: Int, offset: Int) -> Int
pub fn rt_sys_munmap(addr: Int, length: Int) -> Int
pub fn rt_sys_clock_gettime(clock: Int, tp: Int) -> Int
pub fn rt_sys_ioctl(fd: Int, request: Int, arg: Int) -> Int
pub fn rt_sys_getrandom(buf: Int, length: Int, flags: Int) -> Int
// Ends the process; does not return.
pub fn rt_sys_exit_group(status: Int) -> Int

// ---- Memory and words ------------------------------------------------------

// Loads of 8, 16, 32 and 64 bits at address `addr`, zero-extended into the
// `Int` (a 64-bit load is the whole word). Stores write the low 8, 16, 32 or
// 64 bits of `value` and ignore the rest.
pub fn rt_mem_load8(addr: Int) -> Int
pub fn rt_mem_load16(addr: Int) -> Int
pub fn rt_mem_load32(addr: Int) -> Int
pub fn rt_mem_store8(addr: Int, value: Int)
pub fn rt_mem_store16(addr: Int, value: Int)
pub fn rt_mem_store32(addr: Int, value: Int)
// The 64-bit word at address `addr`.
pub fn rt_mem_load64(addr: Int) -> Int
// Write `value` to the 64-bit word at address `addr`.
pub fn rt_mem_store64(addr: Int, value: Int)
// Bitwise operations on the 64-bit patterns; they never overflow-panic.
pub fn rt_mem_and(a: Int, b: Int) -> Int
pub fn rt_mem_or(a: Int, b: Int) -> Int
pub fn rt_mem_xor(a: Int, b: Int) -> Int
// Shifts by `n` (0 to 63): left, logical right, and arithmetic right.
pub fn rt_mem_shl(a: Int, n: Int) -> Int
pub fn rt_mem_shr(a: Int, n: Int) -> Int
pub fn rt_mem_sar(a: Int, n: Int) -> Int
// Wrapping addition and subtraction of 64-bit words, for addresses and
// sizes; they never overflow-panic.
pub fn rt_mem_add(a: Int, b: Int) -> Int
pub fn rt_mem_sub(a: Int, b: Int) -> Int
// Wrapping multiplication of 64-bit words (the low 64 bits of the product).
pub fn rt_mem_mul(a: Int, b: Int) -> Int

// ---- Values ----------------------------------------------------------------
//
// A heap value is the address of an object whose first word is its
// reference count. A negative count marks a static object in read-only
// memory, which is never counted or freed. A text object continues with
// its length in bytes, then its UTF-8 bytes; a list object with its length,
// its capacity, then its items.

// The address of `text`'s object.
pub fn rt_mem_text(text: String) -> Int
// The text whose object is at `object`: the reference the caller holds
// to it passes to the result.
pub fn rt_mem_as_text(object: Int) -> String
// The address of `path`'s object, and the `Path` whose object is at
// `object` (the reference passes, as for text).
// The same for a `Secret<String>` and an `IoError` (an object of a count and
// its one field).
pub fn rt_mem_secret(secret: Secret<String>) -> Int
pub fn rt_mem_as_secret(object: Int) -> Secret<String>
pub fn rt_mem_as_io_error(object: Int) -> IoError
pub fn rt_mem_path(path: Path) -> Int
pub fn rt_mem_as_path(object: Int) -> Path
// The address of `list`'s object, and the list of texts whose object is at
// `object` (the reference passes, as for text).
pub fn rt_mem_list(list: List<String>) -> Int
pub fn rt_mem_as_list(object: Int) -> List<String>
// The directory or file capability whose object is at `object`, as the
// runtime's `Root` (the reference passes, as for text).
pub fn rt_mem_as_root(object: Int) -> Root
// The address of the runtime's writable words, zero when the program
// starts: see `global`.
pub fn rt_mem_globals() -> Int

// ---- Memory ----------------------------------------------------------------
//
// The runtime's writable words, by index:
//
//   0 to 7  the allocator's free lists, one per size class: a block of
//           class c is 16 << c bytes, header included;
//   8       the next free byte of the chunk blocks are carved from;
//   9       the end of that chunk;
//   10      argc, 11 argv (the address of the pointer array), 12 envp, all
//           from the kernel's initial stack (`process_init`);
//   13      the standard output buffer (65536 bytes, mapped on first use),
//           14 the bytes in it, 15 how it is flushed (0 not decided yet, 1
//           when full, 2 after every line, for a terminal);
//   16      the standard input buffer, 17 where the unread bytes start,
//           18 where they end, 19 its capacity;
//   20      the state of `Random`'s generator, 21 whether it is seeded;
//   22      a large object's mapping kept for reuse when it was freed, or 0;
//   23      that mapping's length.
//
// Every object the allocator gives out is preceded by a header word: its
// block's size class, or for an object too large for any class, minus
// the length of its own mapping. Its first word is its reference count,
// which the generated code keeps; `free` is called when it drops to zero.

// The address of the runtime's writable word `index`.
fn global(index: Int) -> Int {
    rt_mem_add(rt_mem_globals(), rt_mem_shl(index, 3))
}

// The largest block, header included, a size class holds.
fn largest_block() -> Int {
    2048
}

// How many bytes the allocator maps at once to carve blocks from.
fn chunk_size() -> Int {
    1048576
}

// `mmap`'s flags: shared with no file, private, anonymous; and without
// reserving swap for it.
fn private_anonymous() -> Int {
    34
}

fn no_reserve() -> Int {
    16384
}

// Map `length` bytes of fresh zeroed memory with protection `prot` and
// `mmap`'s `flags` (at `addr` when they say it is fixed): its address.
// Running out of memory ends the process.
fn map(addr: Int, length: Int, prot: Int, flags: Int) -> Int {
    let at = rt_sys_mmap(addr, length, prot, flags, -1, 0)
    if at < 0 {
        out_of_memory()
    }
    at
}

fn out_of_memory() {
    let _ = write_text(2, "the native runtime is out of memory\n")
    exit(101)
}

// A new object of `size` bytes, a multiple of 8 that counts its reference
// count: its address. Its count is 1; the rest is not initialised.
pub fn alloc(size: Int) -> Int {
    let block = rt_mem_add(size, 8)
    var at = 0
    if block > largest_block() {
        var length = rt_mem_and(rt_mem_add(block, 65535), -65536)
        // The kept mapping, if it fits without wasting more than half.
        let kept = rt_mem_load64(global(22))
        let kept_length = rt_mem_load64(global(23))
        if kept != 0 && kept_length >= length && rt_mem_shr(kept_length, 1) <= length {
            rt_mem_store64(global(22), 0)
            at = kept
            length = kept_length
        } else {
            at = map(0, length, 3, private_anonymous())
        }
        rt_mem_store64(at, rt_mem_sub(0, length))
    } else {
        var class = 0
        var bytes = 16
        while bytes < block {
            bytes = rt_mem_shl(bytes, 1)
            class = rt_mem_add(class, 1)
        }
        let list = global(class)
        at = rt_mem_load64(list)
        if at != 0 {
            rt_mem_store64(list, rt_mem_load64(at))
        } else {
            at = carve(bytes)
        }
        rt_mem_store64(at, class)
    }
    let object = rt_mem_add(at, 8)
    rt_mem_store64(object, 1)
    object
}

// A new block of `bytes`, carved from the current chunk or a new one.
fn carve(bytes: Int) -> Int {
    var next = rt_mem_load64(global(8))
    if next == 0 || rt_mem_add(next, bytes) > rt_mem_load64(global(9)) {
        next = map(0, chunk_size(), 3, private_anonymous())
        rt_mem_store64(global(9), rt_mem_add(next, chunk_size()))
    }
    rt_mem_store64(global(8), rt_mem_add(next, bytes))
    next
}

// Return the object at `object`, whose count has dropped to zero, to the
// allocator.
pub fn free(object: Int) {
    let at = rt_mem_sub(object, 8)
    let class = rt_mem_load64(at)
    if class < 0 {
        // The last large object freed keeps its mapping, for the next to
        // reuse: a program that makes one large text after another maps
        // and faults in fresh memory far less often.
        let kept = rt_mem_load64(global(22))
        if kept != 0 {
            let _ = rt_sys_munmap(kept, rt_mem_load64(global(23)))
        }
        rt_mem_store64(global(22), at)
        rt_mem_store64(global(23), rt_mem_sub(0, class))
        return
    }
    let list = global(class)
    rt_mem_store64(at, rt_mem_load64(list))
    rt_mem_store64(list, at)
}

// Copy the `count` bytes at `from` to `to`, which do not overlap, a word
// at a time; the last few bytes by one word, or smaller pieces, that ends
// where they do (it may write again bytes already written, with the same
// values), so no access reaches past either end.
fn copy_bytes(to: Int, from: Int, count: Int) {
    if count >= 8 {
        var i = 0
        // Four words at a time while they last, then one.
        while rt_mem_add(i, 32) <= count {
            let a = rt_mem_load64(rt_mem_add(from, i))
            let b = rt_mem_load64(rt_mem_add(from, rt_mem_add(i, 8)))
            let c = rt_mem_load64(rt_mem_add(from, rt_mem_add(i, 16)))
            let d = rt_mem_load64(rt_mem_add(from, rt_mem_add(i, 24)))
            rt_mem_store64(rt_mem_add(to, i), a)
            rt_mem_store64(rt_mem_add(to, rt_mem_add(i, 8)), b)
            rt_mem_store64(rt_mem_add(to, rt_mem_add(i, 16)), c)
            rt_mem_store64(rt_mem_add(to, rt_mem_add(i, 24)), d)
            i = rt_mem_add(i, 32)
        }
        while rt_mem_add(i, 8) <= count {
            rt_mem_store64(rt_mem_add(to, i), rt_mem_load64(rt_mem_add(from, i)))
            i = rt_mem_add(i, 8)
        }
        if i < count {
            let tail = rt_mem_sub(count, 8)
            rt_mem_store64(rt_mem_add(to, tail), rt_mem_load64(rt_mem_add(from, tail)))
        }
        return
    }
    if count >= 4 {
        rt_mem_store32(to, rt_mem_load32(from))
        let tail = rt_mem_sub(count, 4)
        rt_mem_store32(rt_mem_add(to, tail), rt_mem_load32(rt_mem_add(from, tail)))
        return
    }
    if count >= 2 {
        rt_mem_store16(to, rt_mem_load16(from))
        let tail = rt_mem_sub(count, 2)
        rt_mem_store16(rt_mem_add(to, tail), rt_mem_load16(rt_mem_add(from, tail)))
        return
    }
    if count == 1 {
        rt_mem_store8(to, rt_mem_load8(from))
    }
}

// Whether the `count` bytes at `a` and at `b` are the same: a word at a
// time, the last few bytes as `copy_bytes` copies them.
fn bytes_equal(a: Int, b: Int, count: Int) -> Bool {
    if count >= 8 {
        var i = 0
        while rt_mem_add(i, 8) <= count {
            if rt_mem_load64(rt_mem_add(a, i)) != rt_mem_load64(rt_mem_add(b, i)) {
                return false
            }
            i = rt_mem_add(i, 8)
        }
        if i == count {
            return true
        }
        let tail = rt_mem_sub(count, 8)
        return rt_mem_load64(rt_mem_add(a, tail)) == rt_mem_load64(rt_mem_add(b, tail))
    }
    if count >= 4 {
        let tail = rt_mem_sub(count, 4)
        return rt_mem_load32(a) == rt_mem_load32(b) && rt_mem_load32(rt_mem_add(a, tail)) == rt_mem_load32(rt_mem_add(b, tail))
    }
    if count >= 2 {
        let tail = rt_mem_sub(count, 2)
        return rt_mem_load16(a) == rt_mem_load16(b) && rt_mem_load16(rt_mem_add(a, tail)) == rt_mem_load16(rt_mem_add(b, tail))
    }
    count == 0 || rt_mem_load8(a) == rt_mem_load8(b)
}

// Count one more reference to the object at `object`, unless it is static.
fn retain(object: Int) {
    let count = rt_mem_load64(object)
    if count >= 0 {
        rt_mem_store64(object, rt_mem_add(count, 1))
    }
}

// ---- Text ------------------------------------------------------------------

// A new text object of `length` bytes, its bytes not written yet: its
// address.
pub fn text_new(length: Int) -> Int {
    let object = alloc(rt_mem_and(rt_mem_add(length, 23), -8))
    rt_mem_store64(rt_mem_add(object, 8), length)
    object
}

// Copy `text`'s bytes into the text object at `object`, from its byte
// `at` on: the byte after them.
pub fn text_put(object: Int, at: Int, text: String) -> Int {
    let from = rt_mem_text(text)
    let length = rt_mem_load64(rt_mem_add(from, 8))
    copy_bytes(rt_mem_add(object, rt_mem_add(16, at)), rt_mem_add(from, 16), length)
    rt_mem_add(at, length)
}

// `Int.to_string`: the decimal text of `n`.
pub fn int_to_string(n: Int) -> String {
    int_text(n, false)
}

// The decimal text of the word `n`, read as unsigned when `unsigned` (a
// `U64` above `Int`'s range is a negative word).
fn int_text(n: Int, unsigned: Bool) -> String {
    if unsigned && n < 0 {
        // n / 10 and n % 10, unsigned: halve first, so it is positive.
        let tens = rt_mem_shr(n, 1) / 5
        let last = rt_mem_sub(n, rt_mem_add(rt_mem_shl(tens, 3), rt_mem_shl(tens, 1)))
        let length = digit_count(-tens) + 1
        let object = text_new(length)
        write_digits(object, length - 1, -tens)
        rt_mem_store8(rt_mem_add(object, 15 + length), 48 + last)
        return rt_mem_as_text(object)
    }
    // Digits come from the magnitude as a negative number, which every
    // `Int` has, `Int`'s most negative value included.
    let negative = n < 0
    let magnitude = if negative { n } else { -n }
    var length = digit_count(magnitude)
    if negative {
        length = length + 1
        let object = text_new(length)
        rt_mem_store8(rt_mem_add(object, 16), 45)
        write_digits(object, length, magnitude)
        return rt_mem_as_text(object)
    }
    let object = text_new(length)
    write_digits(object, length, magnitude)
    rt_mem_as_text(object)
}

// How many decimal digits `-magnitude` has, for `magnitude` <= 0.
fn digit_count(magnitude: Int) -> Int {
    var count = 1
    var rest = magnitude / 10
    while rest != 0 {
        count = count + 1
        rest = rest / 10
    }
    count
}

// Write the decimal digits of `-magnitude`, for `magnitude` <= 0, into the
// text object at `object`, ending before its byte `end`.
fn write_digits(object: Int, end: Int, magnitude: Int) {
    var at = rt_mem_add(object, rt_mem_add(16, end))
    var rest = magnitude
    var more = true
    while more {
        at = rt_mem_sub(at, 1)
        rt_mem_store8(at, 48 - rest % 10)
        rest = rest / 10
        more = rest != 0
    }
}

// ---- String methods --------------------------------------------------------
//
// Text is UTF-8, and a character is a code point, as the interpreter
// counts it: every byte that is not a continuation byte (10xxxxxx) starts
// one. A function here that is a prelude intrinsic takes its arguments as
// the method does, the receiver first.

// The address of the bytes of the text object at `object`.
fn text_data(object: Int) -> Int {
    rt_mem_add(object, 16)
}

// The length in bytes of the text object at `object`.
fn text_length(object: Int) -> Int {
    rt_mem_load64(rt_mem_add(object, 8))
}

// The text of the bytes from `from` up to `to` of `text`, whose object is
// at `object`: `text` itself when they are all of it.
fn text_part(text: String, object: Int, from: Int, to: Int) -> String {
    if from == 0 && to == text_length(object) {
        return text
    }
    let part = text_new(to - from)
    copy_bytes(text_data(part), rt_mem_add(text_data(object), from), to - from)
    rt_mem_as_text(part)
}

// `String.byte_len`.
pub fn string_byte_len(text: String) -> Int {
    text_length(rt_mem_text(text))
}

// `String.len`: the number of characters.
pub fn string_len(text: String) -> Int {
    let object = rt_mem_text(text)
    chars_in(text_data(object), text_length(object))
}

// How many characters the `count` bytes at `at` hold, eight bytes at a
// time: the bytes that are not continuation bytes.
fn chars_in(at: Int, count: Int) -> Int {
    var chars = 0
    var i = 0
    // A continuation byte has bit 7 set and bit 6 clear. `marks` has a 1 in
    // the low bit of each such byte (0x0101010101010101 masks them), and the
    // sums add the eight bytes up in the lowest.
    let low_bits = 72340172838076673
    let all = -1
    let byte = 255
    while rt_mem_add(i, 8) <= count {
        let word = rt_mem_load64(rt_mem_add(at, i))
        let marks = rt_mem_and(rt_mem_and(rt_mem_shr(word, 7), rt_mem_xor(rt_mem_shr(word, 6), all)), low_bits)
        let sum2 = rt_mem_add(marks, rt_mem_shr(marks, 8))
        let sum4 = rt_mem_add(sum2, rt_mem_shr(sum2, 16))
        let sum8 = rt_mem_add(sum4, rt_mem_shr(sum4, 32))
        chars = rt_mem_add(chars, rt_mem_sub(8, rt_mem_and(sum8, byte)))
        i = rt_mem_add(i, 8)
    }
    while i < count {
        if rt_mem_and(rt_mem_load8(rt_mem_add(at, i)), 192) != 128 {
            chars = rt_mem_add(chars, 1)
        }
        i = rt_mem_add(i, 1)
    }
    chars
}

// The byte offset of character `n` of the `count` bytes at `at`, which
// have at least `n` characters: `count` for the one past the last.
fn char_offset(at: Int, count: Int, n: Int) -> Int {
    var i = 0
    var seen = 0
    while seen < n && i < count {
        i = rt_mem_add(i, 1)
        while i < count && rt_mem_and(rt_mem_load8(rt_mem_add(at, i)), 192) == 128 {
            i = rt_mem_add(i, 1)
        }
        seen = rt_mem_add(seen, 1)
    }
    i
}

// The byte offset of the first occurrence of the `needle_length` bytes at
// `needle`, not before byte `from`, in the `length` bytes at `hay`, or -1.
// `needle_length` is not 0.
//
// Eight bytes at a time, it looks for the needle's first byte: a word with
// none is skipped whole, and in one with some it goes straight to the
// first, so only those bytes are compared with the needle.
fn find_bytes(hay: Int, length: Int, needle: Int, needle_length: Int, from: Int) -> Int {
    let first = rt_mem_load8(needle)
    // The first byte in all eight bytes of a word.
    let wide = rt_mem_or(first, rt_mem_shl(first, 8))
    let wider = rt_mem_or(wide, rt_mem_shl(wide, 16))
    let pattern = rt_mem_or(wider, rt_mem_shl(wider, 32))
    let ones = 72340172838076673
    let highs = -9187201950435737472
    let last = length - needle_length
    let all = -1
    // How a place that starts with the first byte is checked: a needle of
    // up to 8 bytes by two loads of `width` bytes that cover it (they may
    // overlap), a longer one by `bytes_equal`.
    let width = if needle_length > 8 {
        0
    } else if needle_length >= 4 {
        4
    } else if needle_length >= 2 {
        2
    } else {
        1
    }
    let tail_at = needle_length - width
    let head = if width == 4 { rt_mem_load32(needle) } else { rt_mem_load16(needle) }
    let tail = if width == 4 { rt_mem_load32(rt_mem_add(needle, tail_at)) } else { rt_mem_load16(rt_mem_add(needle, tail_at)) }
    var i = from
    while i <= last {
        if rt_mem_add(i, 8) <= length {
            // After the xor, a byte equal to the first byte is zero. The
            // lowest byte `zeros` marks (its top bit) is the first such;
            // higher marks may be false.
            let x = rt_mem_xor(rt_mem_load64(rt_mem_add(hay, i)), pattern)
            var zeros = rt_mem_and(rt_mem_and(rt_mem_sub(x, ones), rt_mem_xor(x, all)), highs)
            if zeros == 0 {
                i = rt_mem_add(i, 8)
                continue
            }
            // Skip to the lowest marked byte.
            if rt_mem_shl(zeros, 32) == 0 {
                zeros = rt_mem_shr(zeros, 32)
                i = rt_mem_add(i, 4)
            }
            if rt_mem_shl(zeros, 48) == 0 {
                zeros = rt_mem_shr(zeros, 16)
                i = rt_mem_add(i, 2)
            }
            if rt_mem_shl(zeros, 56) == 0 {
                i = rt_mem_add(i, 1)
            }
            if i > last {
                return -1
            }
        } else if rt_mem_load8(rt_mem_add(hay, i)) != first {
            i = rt_mem_add(i, 1)
            continue
        }
        let at = rt_mem_add(hay, i)
        if width == 4 {
            if rt_mem_load32(at) == head && rt_mem_load32(rt_mem_add(at, tail_at)) == tail {
                return i
            }
        } else if width == 2 {
            if rt_mem_load16(at) == head && rt_mem_load16(rt_mem_add(at, tail_at)) == tail {
                return i
            }
        } else if width == 1 || bytes_equal(at, needle, needle_length) {
            return i
        }
        i = rt_mem_add(i, 1)
    }
    -1
}

// `String.contains`.
pub fn string_contains(text: String, needle: String) -> Bool {
    let object = rt_mem_text(text)
    let other = rt_mem_text(needle)
    if text_length(other) == 0 {
        return true
    }
    find_bytes(text_data(object), text_length(object), text_data(other), text_length(other), 0) >= 0
}

// `String.starts_with`.
pub fn string_starts_with(text: String, prefix: String) -> Bool {
    let object = rt_mem_text(text)
    let other = rt_mem_text(prefix)
    let fits = text_length(other) <= text_length(object)
    fits && bytes_equal(text_data(object), text_data(other), text_length(other))
}

// `String.ends_with`.
pub fn string_ends_with(text: String, suffix: String) -> Bool {
    let object = rt_mem_text(text)
    let other = rt_mem_text(suffix)
    let skip = text_length(object) - text_length(other)
    skip >= 0 && bytes_equal(rt_mem_add(text_data(object), skip), text_data(other), text_length(other))
}

// `String == String`.
pub fn string_eq(a: String, b: String) -> Bool {
    let left = rt_mem_text(a)
    let right = rt_mem_text(b)
    if left == right {
        return true
    }
    let same_length = text_length(left) == text_length(right)
    same_length && bytes_equal(text_data(left), text_data(right), text_length(left))
}

// `String.slice`: the characters from `start` up to `end`, or, when they
// are out of range, the word 0 in place of a text, for the generated code
// to panic (`P0035`).
pub fn string_slice(text: String, start: Int, end: Int) -> String {
    let object = rt_mem_text(text)
    let length = text_length(object)
    let data = text_data(object)
    let chars = chars_in(data, length)
    if start < 0 || end < start || end > chars {
        return rt_mem_as_text(0)
    }
    if chars == length {
        return text_part(text, object, start, end)
    }
    let from = char_offset(data, length, start)
    let to = rt_mem_add(from, char_offset(rt_mem_add(data, from), length - from, end - start))
    text_part(text, object, from, to)
}

// Panic (`P0035`): `start` and `end` are the report around the message.
pub fn panic_slice(start: String, end: String, text: String, from: Int, to: Int) {
    let _ = write_text(2, start)
    let _ = write_text(2, "cannot slice characters ")
    let _ = write_text(2, int_text(from, false))
    let _ = write_text(2, "..")
    let _ = write_text(2, int_text(to, false))
    let _ = write_text(2, " of a text of ")
    let _ = write_text(2, int_text(string_len(text), false))
    let _ = write_text(2, " characters")
    let _ = write_text(2, end)
    exit(101)
}

// The longest text `String.repeat` builds, in bytes: 256 MiB.
fn max_repeated_bytes() -> Int {
    268435456
}

// `String.repeat`: the text `times` times over. For a negative `times`
// the word 0 in place of a text, and for a result that is too long the
// word -1, for the generated code to panic (`P0036`, `P0037`).
pub fn string_repeat(text: String, times: Int) -> String {
    if times < 0 {
        return rt_mem_as_text(0)
    }
    let object = rt_mem_text(text)
    let length = text_length(object)
    // An empty text repeats to an empty text however often.
    if length == 0 {
        return text
    }
    if times > max_repeated_bytes() / length {
        return rt_mem_as_text(-1)
    }
    if times == 1 {
        return text
    }
    let total = length * times
    let result = text_new(total)
    let data = text_data(result)
    copy_bytes(data, text_data(object), length)
    // Double what is written until it is all there.
    var done = length
    while done < total {
        let chunk = if done > total - done { total - done } else { done }
        copy_bytes(rt_mem_add(data, done), data, chunk)
        done = done + chunk
    }
    rt_mem_as_text(result)
}

// Panic (`P0036`): a negative count.
pub fn panic_repeat_negative(start: String, end: String, times: Int) {
    let _ = write_text(2, start)
    let _ = write_text(2, "cannot repeat a text ")
    let _ = write_text(2, int_text(times, false))
    let _ = write_text(2, " times")
    let _ = write_text(2, end)
    exit(101)
}

// Panic (`P0037`): a result too long.
pub fn panic_repeat_long(start: String, end: String, text: String, times: Int) {
    let _ = write_text(2, start)
    let _ = write_text(2, "repeating a text of ")
    let _ = write_text(2, int_text(string_byte_len(text), false))
    let _ = write_text(2, " bytes ")
    let _ = write_text(2, int_text(times, false))
    let _ = write_text(2, " times is too long")
    let _ = write_text(2, end)
    exit(101)
}

// `String.replace`: every occurrence of `from`, left to right and without
// overlap, replaced by `to`. An empty `from` occurs nowhere. Each
// occurrence is found once: where they start is kept in a buffer of words,
// which doubles as it fills, until the result's length is known.
pub fn string_replace(text: String, from: String, to: String) -> String {
    let object = rt_mem_text(text)
    let old = rt_mem_text(from)
    let new = rt_mem_text(to)
    let length = text_length(object)
    let old_length = text_length(old)
    let new_length = text_length(new)
    if old_length == 0 {
        return text
    }
    let data = text_data(object)
    let old_data = text_data(old)
    var capacity = 16
    var positions = alloc(rt_mem_add(8, rt_mem_shl(capacity, 3)))
    var found = 0
    var at = find_bytes(data, length, old_data, old_length, 0)
    while at >= 0 {
        if found == capacity {
            let larger = alloc(rt_mem_add(8, rt_mem_shl(capacity, 4)))
            copy_bytes(rt_mem_add(larger, 8), rt_mem_add(positions, 8), rt_mem_shl(capacity, 3))
            free(positions)
            positions = larger
            capacity = rt_mem_shl(capacity, 1)
        }
        rt_mem_store64(rt_mem_add(positions, rt_mem_shl(rt_mem_add(found, 1), 3)), at)
        found = rt_mem_add(found, 1)
        at = find_bytes(data, length, old_data, old_length, rt_mem_add(at, old_length))
    }
    if found == 0 {
        free(positions)
        return text
    }
    let result = text_new(length + found * (new_length - old_length))
    let new_data = text_data(new)
    var out = text_data(result)
    var read = 0
    var k = 0
    while k < found {
        at = rt_mem_load64(rt_mem_add(positions, rt_mem_shl(rt_mem_add(k, 1), 3)))
        copy_bytes(out, rt_mem_add(data, read), rt_mem_sub(at, read))
        out = rt_mem_add(out, rt_mem_sub(at, read))
        copy_bytes(out, new_data, new_length)
        out = rt_mem_add(out, new_length)
        read = rt_mem_add(at, old_length)
        k = rt_mem_add(k, 1)
    }
    copy_bytes(out, rt_mem_add(data, read), rt_mem_sub(length, read))
    free(positions)
    rt_mem_as_text(result)
}

// The length in bytes of the whitespace character (Unicode's `White_Space`)
// that starts at byte `i` of the `length` bytes at `data`, or 0 if none does.
fn whitespace_at(data: Int, i: Int, length: Int) -> Int {
    let b0 = rt_mem_load8(rt_mem_add(data, i))
    if b0 == 32 || (b0 >= 9 && b0 <= 13) {
        return 1
    }
    if b0 < 128 {
        return 0
    }
    if b0 == 194 {
        // U+0085 and U+00A0.
        if i + 1 < length {
            let b1 = rt_mem_load8(rt_mem_add(data, i + 1))
            if b1 == 133 || b1 == 160 {
                return 2
            }
        }
        return 0
    }
    if i + 2 >= length {
        return 0
    }
    let b1 = rt_mem_load8(rt_mem_add(data, i + 1))
    let b2 = rt_mem_load8(rt_mem_add(data, i + 2))
    // U+1680.
    if b0 == 225 && b1 == 154 && b2 == 128 {
        return 3
    }
    // U+3000.
    if b0 == 227 && b1 == 128 && b2 == 128 {
        return 3
    }
    if b0 == 226 {
        // U+2000 to U+200A, U+2028, U+2029 and U+202F.
        if b1 == 128 && ((b2 <= 138 && b2 >= 128) || b2 == 168 || b2 == 169 || b2 == 175) {
            return 3
        }
        // U+205F.
        if b1 == 129 && b2 == 159 {
            return 3
        }
    }
    0
}

// The length in bytes of the whitespace character that ends before byte
// `end` of the bytes at `data`, and starts at or after byte `low`, or 0.
fn whitespace_before(data: Int, low: Int, end: Int) -> Int {
    var size = 1
    while size <= 3 {
        if end - size >= low && whitespace_at(data, end - size, end) == size {
            return size
        }
        size = size + 1
    }
    0
}

// `String.trim`: without leading and trailing whitespace.
pub fn string_trim(text: String) -> String {
    let object = rt_mem_text(text)
    let data = text_data(object)
    var from = 0
    var to = text_length(object)
    while from < to {
        let size = whitespace_at(data, from, to)
        if size == 0 {
            break
        }
        from = from + size
    }
    while to > from {
        let size = whitespace_before(data, from, to)
        if size == 0 {
            break
        }
        to = to - size
    }
    text_part(text, object, from, to)
}

// `String.parse_int`: the decimal `Int` the whole text spells, an optional
// `+` or `-` then at least one ASCII digit, or `None` when it spells none
// or one outside `Int`'s range, as the interpreter's `str::parse` decides.
pub fn string_parse_int(text: String) -> Option<Int> {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let end = text_length(object)
    var at = 0
    var negative = false
    if end > 0 {
        let sign = rt_mem_load8(data)
        if sign == 45 || sign == 43 {
            negative = sign == 45
            at = 1
        }
    }
    if at == end {
        return None
    }
    // Digits accumulate as a negative number, which every `Int` has,
    // `Int`'s most negative value included.
    var value = 0
    while at < end {
        let digit = rt_mem_load8(rt_mem_add(data, at)) - 48
        if digit < 0 || digit > 9 {
            return None
        }
        if value < -922337203685477580 || (value == -922337203685477580 && digit > 8) {
            return None
        }
        value = value * 10 - digit
        at = at + 1
    }
    if negative {
        return Some(value)
    }
    if value == -9223372036854775807 - 1 {
        return None
    }
    Some(-value)
}

// `Path.new` and `Path.from`: a `Path`, an object of a count and the one
// field, `raw`. Releasing the last reference to it releases `raw` too (the
// drop function the backend generates for `Path`).
pub fn path_new(raw: String) -> Path {
    let object = alloc(16)
    let text = rt_mem_text(raw)
    retain(text)
    rt_mem_store64(rt_mem_add(object, 8), text)
    rt_mem_as_path(object)
}

// `Path == Path`: their text is the same.
pub fn path_eq(a: Path, b: Path) -> Bool {
    let left = rt_mem_load64(rt_mem_add(rt_mem_path(a), 8))
    let right = rt_mem_load64(rt_mem_add(rt_mem_path(b), 8))
    // The texts are borrowed; the references `rt_mem_as_text` hands out
    // are released after the call.
    retain(left)
    retain(right)
    string_eq(rt_mem_as_text(left), rt_mem_as_text(right))
}

// ---- Lists -----------------------------------------------------------------
//
// A list object is `[count][length][capacity][item 0][item 1]...`: room for
// `capacity` items, the first `length` of them there, one word each. The
// generated code reads and adds items inline, and releases them, by their
// type, when the last reference to the list goes. Before it adds an item to
// a list that is shared or full, it calls `list_reserve`.

// A new, empty list object with room for `capacity` items: its address.
fn list_new(capacity: Int) -> Int {
    let object = alloc(rt_mem_add(24, rt_mem_shl(capacity, 3)))
    rt_mem_store64(rt_mem_add(object, 8), 0)
    rt_mem_store64(rt_mem_add(object, 16), capacity)
    object
}

// A list object with the items of the list at `list`, unshared (its count
// is 1) and with room for one more: `list` itself when it is that already.
// Otherwise a new one, twice as large when `list` is full. The items move
// to it from an unshared `list`, which is freed; from a shared or static
// one they are copied, each retained when `counted` (the items hold
// references), and `list` is counted once less.
pub fn list_reserve(list: Int, counted: Bool) -> Int {
    let count = rt_mem_load64(list)
    let length = rt_mem_load64(rt_mem_add(list, 8))
    let capacity = rt_mem_load64(rt_mem_add(list, 16))
    if count == 1 && length < capacity {
        return list
    }
    var larger = capacity
    if length == capacity {
        larger = rt_mem_shl(capacity, 1)
    }
    if larger < 4 {
        larger = 4
    }
    let copy = list_new(larger)
    copy_bytes(rt_mem_add(copy, 24), rt_mem_add(list, 24), rt_mem_shl(length, 3))
    rt_mem_store64(rt_mem_add(copy, 8), length)
    if count == 1 {
        free(list)
        return copy
    }
    if counted {
        var i = 0
        while i < length {
            retain(rt_mem_load64(rt_mem_add(list, rt_mem_add(24, rt_mem_shl(i, 3)))))
            i = rt_mem_add(i, 1)
        }
    }
    if count > 0 {
        rt_mem_store64(list, rt_mem_sub(count, 1))
    }
    copy
}

// Add the word `item` to the end of the list at `list`, which is unshared:
// the list's address afterwards, which moves when it grows.
fn list_add(list: Int, item: Int) -> Int {
    let target = list_reserve(list, false)
    let length = rt_mem_load64(rt_mem_add(target, 8))
    rt_mem_store64(rt_mem_add(target, rt_mem_add(24, rt_mem_shl(length, 3))), item)
    rt_mem_store64(rt_mem_add(target, 8), rt_mem_add(length, 1))
    target
}

// A text object holding the `count` bytes at `at`: its address, holding a
// reference for the caller. An empty one is the static "".
fn text_of(at: Int, count: Int) -> Int {
    if count == 0 {
        return rt_mem_text("")
    }
    let object = text_new(count)
    copy_bytes(text_data(object), at, count)
    object
}

// `String.split`: the pieces between occurrences of `separator`, empty
// ones included. An empty separator occurs before and after every
// character, as Rust's `str::split` has it: "ab" splits into "", "a", "b"
// and "".
pub fn string_split(text: String, separator: String) -> List<String> {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    let other = rt_mem_text(separator)
    let other_data = text_data(other)
    let other_length = text_length(other)
    var list = list_new(4)
    if other_length == 0 {
        list = list_add(list, rt_mem_text(""))
        var i = 0
        while i < length {
            let size = sequence_length(rt_mem_load8(rt_mem_add(data, i)))
            list = list_add(list, text_of(rt_mem_add(data, i), size))
            i = rt_mem_add(i, size)
        }
        list = list_add(list, rt_mem_text(""))
        return rt_mem_as_list(list)
    }
    var at = find_bytes(data, length, other_data, other_length, 0)
    if at < 0 {
        // One piece, the whole text: the text itself.
        retain(object)
        return rt_mem_as_list(list_add(list, object))
    }
    var read = 0
    while at >= 0 {
        list = list_add(list, text_of(rt_mem_add(data, read), rt_mem_sub(at, read)))
        read = rt_mem_add(at, other_length)
        at = find_bytes(data, length, other_data, other_length, read)
    }
    list = list_add(list, text_of(rt_mem_add(data, read), rt_mem_sub(length, read)))
    rt_mem_as_list(list)
}

// `String.lines`: the lines, without their line endings, as Rust's
// `str::lines` has them. A line ends at a line feed, and a carriage return
// just before it goes too; the last line needs no ending, and an empty
// last line is no line.
pub fn string_lines(text: String) -> List<String> {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    let newline = text_data(rt_mem_text("\n"))
    var list = list_new(4)
    var start = 0
    while start < length {
        let found = find_bytes(data, length, newline, 1, start)
        var end = length
        var next = length
        if found >= 0 {
            end = found
            next = rt_mem_add(found, 1)
            if end > start && rt_mem_load8(rt_mem_add(data, rt_mem_sub(end, 1))) == 13 {
                end = rt_mem_sub(end, 1)
            }
        }
        list = list_add(list, text_of(rt_mem_add(data, start), rt_mem_sub(end, start)))
        start = next
    }
    rt_mem_as_list(list)
}

// `String.chars`: each character as a text of its own.
pub fn string_chars(text: String) -> List<String> {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    var list = list_new(length)
    var i = 0
    while i < length {
        let size = sequence_length(rt_mem_load8(rt_mem_add(data, i)))
        list = list_add(list, text_of(rt_mem_add(data, i), size))
        i = rt_mem_add(i, size)
    }
    rt_mem_as_list(list)
}

// `String.join`: `parts` with `separator` between each two.
pub fn string_join(separator: String, parts: List<String>) -> String {
    let list = rt_mem_list(parts)
    let count = rt_mem_load64(rt_mem_add(list, 8))
    if count == 0 {
        return ""
    }
    let items = rt_mem_add(list, 24)
    if count == 1 {
        let only = rt_mem_load64(items)
        retain(only)
        return rt_mem_as_text(only)
    }
    let other = rt_mem_text(separator)
    let other_length = text_length(other)
    var total = other_length * (count - 1)
    var i = 0
    while i < count {
        total = total + text_length(rt_mem_load64(rt_mem_add(items, rt_mem_shl(i, 3))))
        i = rt_mem_add(i, 1)
    }
    let result = text_new(total)
    var out = text_data(result)
    i = 0
    while i < count {
        if i > 0 {
            copy_bytes(out, text_data(other), other_length)
            out = rt_mem_add(out, other_length)
        }
        let part = rt_mem_load64(rt_mem_add(items, rt_mem_shl(i, 3)))
        copy_bytes(out, text_data(part), text_length(part))
        out = rt_mem_add(out, text_length(part))
        i = rt_mem_add(i, 1)
    }
    rt_mem_as_text(result)
}

// ---- Lower case ------------------------------------------------------------
//
// `String.to_lowercase` maps each character on its own to its Unicode
// lower-case form, so it needs no context: U+0130 (capital I with dot) is
// "i" and U+0307, and every other character that has a lower case has one
// character. The table lists the characters that change, as records of 13
// hexadecimal digits in order: the first character (5 digits), how many
// (2), the step between them (1) and the distance to their lower case, plus
// 0x40000 (5). It is generated from Rust's `char::to_lowercase`, and a test
// (`native_text.rs`) checks it against that for every character.

fn lowercase_table() -> String {
    ""
}

// The number given by the `digits` hexadecimal digits at `at`.
fn hex_at(at: Int, digits: Int) -> Int {
    var value = 0
    var i = 0
    while i < digits {
        let b = rt_mem_load8(rt_mem_add(at, i))
        let digit = if b <= 57 { b - 48 } else { b - 87 }
        value = rt_mem_or(rt_mem_shl(value, 4), digit)
        i = rt_mem_add(i, 1)
    }
    value
}

// The lower case of the character `cp`, other than U+0130.
fn lower_of(cp: Int) -> Int {
    if cp < 128 {
        if cp >= 65 && cp <= 90 {
            return cp + 32
        }
        return cp
    }
    let object = rt_mem_text(lowercase_table())
    let data = text_data(object)
    // How many records start at or before `cp`.
    var low = 0
    var high = text_length(object) / 13
    while low < high {
        let middle = (low + high) / 2
        if hex_at(rt_mem_add(data, middle * 13), 5) <= cp {
            low = middle + 1
        } else {
            high = middle
        }
    }
    if low == 0 {
        return cp
    }
    let record = rt_mem_add(data, (low - 1) * 13)
    let offset = cp - hex_at(record, 5)
    let step = hex_at(rt_mem_add(record, 7), 1)
    if offset % step == 0 && offset / step < hex_at(rt_mem_add(record, 5), 2) {
        return cp + hex_at(rt_mem_add(record, 8), 5) - 262144
    }
    cp
}

// The length in bytes of the UTF-8 sequence that starts with `lead`.
fn sequence_length(lead: Int) -> Int {
    if lead < 128 {
        return 1
    }
    if lead < 224 {
        return 2
    }
    if lead < 240 {
        return 3
    }
    4
}

// The character whose UTF-8 sequence starts at `at`.
fn decode_at(at: Int) -> Int {
    let lead = rt_mem_load8(at)
    let size = sequence_length(lead)
    if size == 1 {
        return lead
    }
    var cp = rt_mem_and(lead, rt_mem_shr(127, size))
    var i = 1
    while i < size {
        let next = rt_mem_and(rt_mem_load8(rt_mem_add(at, i)), 63)
        cp = rt_mem_or(rt_mem_shl(cp, 6), next)
        i = rt_mem_add(i, 1)
    }
    cp
}

// The length in bytes of the UTF-8 sequence of the character `cp`.
fn encoded_length(cp: Int) -> Int {
    if cp < 128 {
        return 1
    }
    if cp < 2048 {
        return 2
    }
    if cp < 65536 {
        return 3
    }
    4
}

// Write the UTF-8 sequence of `cp` at `at`: its length.
fn encode_at(at: Int, cp: Int) -> Int {
    let size = encoded_length(cp)
    if size == 1 {
        rt_mem_store8(at, cp)
        return 1
    }
    // The lead byte holds the top bits after the marker 11..0, and each
    // continuation byte six bits after 10.
    var i = size - 1
    var rest = cp
    while i > 0 {
        rt_mem_store8(rt_mem_add(at, i), rt_mem_or(128, rt_mem_and(rest, 63)))
        rest = rt_mem_shr(rest, 6)
        i = i - 1
    }
    let marker = rt_mem_and(rt_mem_shl(255, 8 - size), 255)
    rt_mem_store8(at, rt_mem_or(marker, rest))
    size
}

// `String.to_lowercase`.
pub fn string_to_lowercase(text: String) -> String {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    var size = 0
    var changed = false
    var i = 0
    while i < length {
        let at = rt_mem_add(data, i)
        let cp = decode_at(at)
        let step = sequence_length(rt_mem_load8(at))
        if cp == 304 {
            size = size + 3
            changed = true
        } else {
            let lower = lower_of(cp)
            changed = changed || lower != cp
            size = size + encoded_length(lower)
        }
        i = i + step
    }
    if !changed {
        return text
    }
    let result = text_new(size)
    var out = text_data(result)
    i = 0
    while i < length {
        let at = rt_mem_add(data, i)
        let cp = decode_at(at)
        if cp == 304 {
            out = rt_mem_add(out, encode_at(out, 105))
            out = rt_mem_add(out, encode_at(out, 775))
        } else {
            out = rt_mem_add(out, encode_at(out, lower_of(cp)))
        }
        i = i + sequence_length(rt_mem_load8(at))
    }
    rt_mem_as_text(result)
}

// ---- Panics ----------------------------------------------------------------
//
// A panic writes its report to stderr as the interpreter's `oskac run`
// does, `path:line:col: error[P....]: message (bytes a..b)`, and exits
// with 101. The generated code resolves the location at compile time, so
// a report is static text with the values in its message filled in.

// Panic with the whole report `report`.
pub fn panic(report: String) {
    let _ = write_text(2, report)
    exit(101)
}

// Panic with the report `start`, the integer `a`, then `end`. An integer
// is read as unsigned when `unsigned`.
pub fn panic_unary(start: String, a: Int, end: String, unsigned: Bool) {
    let _ = write_text(2, start)
    let _ = write_text(2, int_text(a, unsigned))
    let _ = write_text(2, end)
    exit(101)
}

// Panic with the report `start`, the integer `a`, `mid`, the integer `b`,
// then `end`.
pub fn panic_binary(start: String, a: Int, mid: String, b: Int, end: String, unsigned: Bool) {
    let _ = write_text(2, start)
    let _ = write_text(2, int_text(a, unsigned))
    let _ = write_text(2, mid)
    let _ = write_text(2, int_text(b, unsigned))
    let _ = write_text(2, end)
    exit(101)
}

// ---- The stack -------------------------------------------------------------

// A new stack of `size` bytes, a multiple of 65536, with a guard region
// below it that no access may touch: its top. The generated code counts
// calls, so recursion panics (`P0021`) before it reaches the guard.
pub fn stack_new(size: Int) -> Int {
    let guard = 1048576
    let flags = rt_mem_or(private_anonymous(), no_reserve())
    let base = map(0, guard + size, 0, flags)
    // Over the guard's top, readable and writable, at a fixed address.
    let stack = map(rt_mem_add(base, guard), size, 3, rt_mem_or(flags, 16))
    rt_mem_add(stack, size)
}

// ---- Start-up and exit -----------------------------------------------------
//
// The native backend generates the entry point, `_start`. It gives
// `process_init` the stack pointer the kernel started the process with,
// calls `main` with its capabilities and then, if `main` returned
// `Err(e)`, calls `main_failed` with `e`'s `Display` text. Otherwise it
// calls `exit(0)`.

// Remember the program's arguments and environment: `sp` is the kernel's
// initial stack pointer, which points at argc, then the argv pointers
// and a null, then the envp pointers and a null.
pub fn process_init(sp: Int) {
    let argc = rt_mem_load64(sp)
    let argv = rt_mem_add(sp, 8)
    rt_mem_store64(global(10), argc)
    rt_mem_store64(global(11), argv)
    rt_mem_store64(global(12), rt_mem_add(argv, rt_mem_shl(argc + 1, 3)))
    // `std::env::args`, which the interpreter's `oskac` reads them with,
    // panics (exit 101) at the first argument that is not UTF-8.
    var i = 0
    while i < argc {
        if !cstr_valid(rt_mem_load64(rt_mem_add(argv, rt_mem_shl(i, 3)))) {
            let _ = write_text(2, "error: a command-line argument is not valid UTF-8\n")
            exit(101)
        }
        i = i + 1
    }
}

// Whether the C string at `at` is well-formed UTF-8.
fn cstr_valid(at: Int) -> Bool {
    var length = 0
    while rt_mem_load8(rt_mem_add(at, length)) != 0 {
        length = length + 1
    }
    utf8_valid(at, length)
}

// Ends the process with `status`, after writing what standard output
// still holds.
pub fn exit(status: Int) {
    let _ = flush_stdout()
    let _ = rt_sys_exit_group(status)
}

// `main` returned an error whose text is `message`: it goes to stderr on a
// line of its own, and the process exits with 1, as the interpreter does.
pub fn main_failed(message: String) {
    let _ = print_error_line(message)
    exit(1)
}

// ---- Standard output and error ---------------------------------------------
//
// Standard output is buffered: a line is appended to a 65536-byte buffer,
// which is written when it is full, when anything is written to stderr
// (so the two stay in order on a terminal), before a line is read from
// stdin, and at exit and panic. When stdout is a terminal each line is
// written as it is printed.

fn stdout_buffer_size() -> Int {
    65536
}

// The standard output buffer, mapped on first use, and how it is flushed.
fn stdout_buffer() -> Int {
    var buf = rt_mem_load64(global(13))
    if buf == 0 {
        buf = map(0, stdout_buffer_size(), 3, private_anonymous())
        rt_mem_store64(global(13), buf)
        // `ioctl(1, TCGETS, termios)` succeeds only on a terminal.
        let termios = alloc(64)
        let tty = rt_sys_ioctl(1, 21505, rt_mem_add(termios, 8))
        free(termios)
        rt_mem_store64(global(15), if tty == 0 { 2 } else { 1 })
    }
    buf
}

// Write the buffered output: 0, or the negative `errno` of the failed
// write. What the buffer held is gone either way.
pub fn flush_stdout() -> Int {
    let used = rt_mem_load64(global(14))
    if used == 0 {
        return 0
    }
    rt_mem_store64(global(14), 0)
    write_all(1, rt_mem_load64(global(13)), used)
}

// Append the text object at `object` and a newline to standard output:
// 0, or the negative `errno` of a write that failed.
fn stdout_put_line(object: Int) -> Int {
    let length = text_length(object)
    let data = text_data(object)
    let buf = stdout_buffer()
    var used = rt_mem_load64(global(14))
    if used + length + 1 > stdout_buffer_size() {
        let flushed = flush_stdout()
        if flushed < 0 {
            return flushed
        }
        used = 0
        if length + 1 > stdout_buffer_size() {
            // Too long to buffer: written as it is, then the newline.
            let body = write_all(1, data, length)
            if body < 0 {
                return body
            }
            rt_mem_store8(buf, 10)
            return write_all(1, buf, 1)
        }
    }
    copy_bytes(rt_mem_add(buf, used), data, length)
    rt_mem_store8(rt_mem_add(buf, used + length), 10)
    rt_mem_store64(global(14), used + length + 1)
    if rt_mem_load64(global(15)) == 2 {
        return flush_stdout()
    }
    0
}

// `Stdout.println`.
pub fn stdout_println(io: Stdout, line: String) -> Result<(), IoError> {
    let failed = stdout_put_line(rt_mem_text(line))
    if failed < 0 {
        return Err(io_error(-failed))
    }
    Ok(())
}

// `Stderr.println`: standard output first, then the line and its newline
// in one write.
pub fn stderr_println(io: Stderr, line: String) -> Result<(), IoError> {
    let failed = print_error_line(line)
    if failed < 0 {
        return Err(io_error(-failed))
    }
    Ok(())
}

// Write `line` and a newline to stderr, in one write, after flushing
// stdout: 0, or the negative `errno` of the write that failed.
fn print_error_line(line: String) -> Int {
    let _ = flush_stdout()
    let object = rt_mem_text(line)
    let length = text_length(object)
    let out = text_new(length + 1)
    copy_bytes(text_data(out), text_data(object), length)
    rt_mem_store8(rt_mem_add(text_data(out), length), 10)
    let result = write_all(2, text_data(out), length + 1)
    free(out)
    result
}

// Write all of `text` to `fd`: 0, or the negative `errno` of the write
// that failed. A write to stderr is preceded by stdout's.
fn write_text(fd: Int, text: String) -> Int {
    if fd == 2 {
        let _ = flush_stdout()
    }
    let object = rt_mem_text(text)
    write_all(fd, rt_mem_add(object, 16), rt_mem_load64(rt_mem_add(object, 8)))
}

// Write the `count` bytes at `buf` to `fd`, however many writes it takes:
// 0, or the negative `errno` of the write that failed.
fn write_all(fd: Int, buf: Int, count: Int) -> Int {
    var at = buf
    var left = count
    while left > 0 {
        let written = rt_sys_write(fd, at, left)
        if written == -4 {
            continue
        }
        if written < 0 {
            return written
        }
        at = rt_mem_add(at, written)
        left = rt_mem_sub(left, written)
    }
    0
}

// ---- I/O errors ------------------------------------------------------------

// The `IoError` for the system error `errno`, worded as Rust's standard
// library does: the C library's message, then `(os error N)`.
fn io_error(errno: Int) -> IoError {
    let what = errno_message(errno)
    let number = int_to_string(errno)
    io_error_text("{what} (os error {number})")
}

// An `IoError` with the message `message`.
fn io_error_text(message: String) -> IoError {
    let object = alloc(16)
    let text = rt_mem_text(message)
    retain(text)
    rt_mem_store64(rt_mem_add(object, 8), text)
    rt_mem_as_io_error(object)
}

// The C library's message for the system error `errno`, as Rust's
// `io::Error` words it: `Unknown error N` for a number with none.
fn errno_message(errno: Int) -> String {
    let object = rt_mem_text(errno_table())
    let data = text_data(object)
    let length = text_length(object)
    // The message for `errno` starts after `errno - 1` separators.
    var at = 0
    var n = 1
    while n < errno && at < length {
        if rt_mem_load8(rt_mem_add(data, at)) == 124 {
            n = n + 1
        }
        at = at + 1
    }
    var end = at
    while end < length && rt_mem_load8(rt_mem_add(data, end)) != 124 {
        end = end + 1
    }
    if errno < 1 || at >= length || end == at {
        return "Unknown error {errno}"
    }
    rt_mem_as_text(text_of(rt_mem_add(data, at), end - at))
}

// The messages of the system errors 1 to 133 (Linux's numbers), in order,
// separated by `|`; empty for a number with no message. Generated from
// Rust's `io::Error::from_raw_os_error`, and a test (`native_files.rs`)
// checks it against that for every number.
fn errno_table() -> String {
    "Operation not permitted|No such file or directory|No such process|Interrupted system call|Input/output error|No such device or address|Argument list too long|Exec format error|Bad file descriptor|No child processes|Resource temporarily unavailable|Cannot allocate memory|Permission denied|Bad address|Block device required|Device or resource busy|File exists|Invalid cross-device link|No such device|Not a directory|Is a directory|Invalid argument|Too many open files in system|Too many open files|Inappropriate ioctl for device|Text file busy|File too large|No space left on device|Illegal seek|Read-only file system|Too many links|Broken pipe|Numerical argument out of domain|Numerical result out of range|Resource deadlock avoided|File name too long|No locks available|Function not implemented|Directory not empty|Too many levels of symbolic links||No message of desired type|Identifier removed|Channel number out of range|Level 2 not synchronized|Level 3 halted|Level 3 reset|Link number out of range|Protocol driver not attached|No CSI structure available|Level 2 halted|Invalid exchange|Invalid request descriptor|Exchange full|No anode|Invalid request code|Invalid slot||Bad font file format|Device not a stream|No data available|Timer expired|Out of streams resources|Machine is not on the network|Package not installed|Object is remote|Link has been severed|Advertise error|Srmount error|Communication error on send|Protocol error|Multihop attempted|RFS specific error|Bad message|Value too large for defined data type|Name not unique on network|File descriptor in bad state|Remote address changed|Can not access a needed shared library|Accessing a corrupted shared library|.lib section in a.out corrupted|Attempting to link in too many shared libraries|Cannot exec a shared library directly|Invalid or incomplete multibyte or wide character|Interrupted system call should be restarted|Streams pipe error|Too many users|Socket operation on non-socket|Destination address required|Message too long|Protocol wrong type for socket|Protocol not available|Protocol not supported|Socket type not supported|Operation not supported|Protocol family not supported|Address family not supported by protocol|Address already in use|Cannot assign requested address|Network is down|Network is unreachable|Network dropped connection on reset|Software caused connection abort|Connection reset by peer|No buffer space available|Transport endpoint is already connected|Transport endpoint is not connected|Cannot send after transport endpoint shutdown|Too many references: cannot splice|Connection timed out|Connection refused|Host is down|No route to host|Operation already in progress|Operation now in progress|Stale file handle|Structure needs cleaning|Not a XENIX named type file|No XENIX semaphores available|Is a named type file|Remote I/O error|Disk quota exceeded|No medium found|Wrong medium type|Operation canceled|Required key not available|Key has expired|Key has been revoked|Key was rejected by service|Owner died|State not recoverable|Operation not possible due to RF-kill|Memory page has hardware error"
}

// ---- Standard input --------------------------------------------------------

// `Stdin.read_line`: the next line without its line break (`\n`, or
// `\r\n`), the last line even when it has none, or `None` at end of input.
// Standard output is written first, so a prompt shows before the wait.
pub fn stdin_read_line(io: Stdin) -> Result<Option<String>, IoError> {
    let _ = flush_stdout()
    if rt_mem_load64(global(16)) == 0 {
        rt_mem_store64(global(16), map(0, 65536, 3, private_anonymous()))
        rt_mem_store64(global(19), 65536)
    }
    // How many unread bytes have been looked at for a newline.
    var scanned = 0
    while true {
        let pos = rt_mem_load64(global(17))
        let end = rt_mem_load64(global(18))
        let buf = rt_mem_load64(global(16))
        var at = pos + scanned
        while at < end && rt_mem_load8(rt_mem_add(buf, at)) != 10 {
            at = at + 1
        }
        if at < end {
            var stop = at
            if stop > pos && rt_mem_load8(rt_mem_add(buf, stop - 1)) == 13 {
                stop = stop - 1
            }
            rt_mem_store64(global(17), at + 1)
            // The line is consumed even when it is not text.
            if !utf8_valid(rt_mem_add(buf, pos), at - pos) {
                return Err(invalid_utf8())
            }
            let line = text_from(rt_mem_add(buf, pos), stop - pos)
            return Ok(Some(line))
        }
        scanned = end - pos
        let read = stdin_fill()
        if read < 0 {
            return Err(io_error(-read))
        }
        if read == 0 {
            let rest = rt_mem_load64(global(18)) - rt_mem_load64(global(17))
            if rest == 0 {
                return Ok(None)
            }
            let start = rt_mem_add(rt_mem_load64(global(16)), rt_mem_load64(global(17)))
            rt_mem_store64(global(17), rt_mem_load64(global(18)))
            if !utf8_valid(start, rest) {
                return Err(invalid_utf8())
            }
            return Ok(Some(text_from(start, rest)))
        }
    }
    Ok(None)
}

// What Rust's `read_line` reports for a line that is not UTF-8.
fn invalid_utf8() -> IoError {
    io_error_text("stream did not contain valid UTF-8")
}

// Read more of standard input after the unread bytes, moving them to the
// buffer's start and growing the buffer when they fill it: the number of
// bytes read, 0 at end of input, or the negative `errno` of a failed read.
fn stdin_fill() -> Int {
    let pos = rt_mem_load64(global(17))
    var end = rt_mem_load64(global(18))
    var buf = rt_mem_load64(global(16))
    var capacity = rt_mem_load64(global(19))
    if pos > 0 {
        copy_bytes(buf, rt_mem_add(buf, pos), end - pos)
        end = end - pos
        rt_mem_store64(global(17), 0)
        rt_mem_store64(global(18), end)
    }
    if end == capacity {
        let bigger = map(0, capacity * 2, 3, private_anonymous())
        copy_bytes(bigger, buf, end)
        let _ = rt_sys_munmap(buf, capacity)
        buf = bigger
        capacity = capacity * 2
        rt_mem_store64(global(16), buf)
        rt_mem_store64(global(19), capacity)
    }
    var read = rt_sys_read(0, rt_mem_add(buf, end), capacity - end)
    while read == -4 {
        read = rt_sys_read(0, rt_mem_add(buf, end), capacity - end)
    }
    if read > 0 {
        rt_mem_store64(global(18), end + read)
    }
    read
}

// Whether the `length` bytes at `data` are well-formed UTF-8, as Rust's
// `str::from_utf8` decides: no stray continuation or lead byte, no
// overlong form, no surrogate, nothing above U+10FFFF. Every text the
// runtime makes from outside bytes goes through this, since the text
// routines decode lead bytes and rely on it.
fn utf8_valid(data: Int, length: Int) -> Bool {
    var i = 0
    while i < length {
        let b = rt_mem_load8(rt_mem_add(data, i))
        if b < 128 {
            i = i + 1
            continue
        }
        var need = 0
        var low = 128
        var high = 191
        if b >= 194 && b <= 223 {
            need = 1
        } else if b == 224 {
            need = 2
            low = 160
        } else if b >= 225 && b <= 239 {
            need = 2
            if b == 237 {
                high = 159
            }
        } else if b == 240 {
            need = 3
            low = 144
        } else if b >= 241 && b <= 243 {
            need = 3
        } else if b == 244 {
            need = 3
            high = 143
        } else {
            return false
        }
        if i + need >= length {
            return false
        }
        let first = rt_mem_load8(rt_mem_add(data, i + 1))
        if first < low || first > high {
            return false
        }
        var k = 2
        while k <= need {
            let next = rt_mem_load8(rt_mem_add(data, i + k))
            if next < 128 || next > 191 {
                return false
            }
            k = k + 1
        }
        i = i + need + 1
    }
    true
}

// A new text of the `count` bytes at `from`.
fn text_from(from: Int, count: Int) -> String {
    let object = text_new(count)
    copy_bytes(text_data(object), from, count)
    rt_mem_as_text(object)
}

// The text of the C string at `at`.
fn cstr_text(at: Int) -> String {
    var length = 0
    while rt_mem_load8(rt_mem_add(at, length)) != 0 {
        length = length + 1
    }
    text_from(at, length)
}

// ---- Arguments and environment ---------------------------------------------

// `Args.get`: argument `index` (the program at 0), or `None` past the end.
pub fn args_get(args: Args, index: Int) -> Option<String> {
    if index < 0 || index >= rt_mem_load64(global(10)) {
        return None
    }
    Some(cstr_text(rt_mem_load64(rt_mem_add(rt_mem_load64(global(11)), rt_mem_shl(index, 3)))))
}

// The address of the value of the environment variable `name`, a C
// string, or 0 when it is not set (or `name` could not be a variable's).
fn env_lookup(name: String) -> Int {
    let object = rt_mem_text(name)
    let length = text_length(object)
    let data = text_data(object)
    if length == 0 {
        return 0
    }
    var i = 0
    while i < length {
        let byte = rt_mem_load8(rt_mem_add(data, i))
        if byte == 61 || byte == 0 {
            return 0
        }
        i = i + 1
    }
    var entries = rt_mem_load64(global(12))
    while rt_mem_load64(entries) != 0 {
        let entry = rt_mem_load64(entries)
        var j = 0
        while j < length && rt_mem_load8(rt_mem_add(entry, j)) == rt_mem_load8(rt_mem_add(data, j)) {
            j = j + 1
        }
        if j == length && rt_mem_load8(rt_mem_add(entry, j)) == 61 {
            // `std::env::var` has no value for one that is not UTF-8.
            if cstr_valid(rt_mem_add(entry, length + 1)) {
                return rt_mem_add(entry, length + 1)
            }
            return 0
        }
        entries = rt_mem_add(entries, 8)
    }
    0
}

// `Env.get`.
pub fn env_get(env: Env, name: String) -> Option<String> {
    let found = env_lookup(name)
    if found == 0 {
        return None
    }
    Some(cstr_text(found))
}

// `Env.secret`: a `Secret` object (a count and the one field), or the
// word 0 when the variable is not set, for the generated code to panic
// (`P0020`).
pub fn env_secret(env: Env, name: String) -> Secret<String> {
    let found = env_lookup(name)
    if found == 0 {
        return rt_mem_as_secret(0)
    }
    let value = cstr_text(found)
    let object = alloc(16)
    let text = rt_mem_text(value)
    retain(text)
    rt_mem_store64(rt_mem_add(object, 8), text)
    rt_mem_as_secret(object)
}

// Panic (`P0020`): `start` and `end` are the report around the message.
pub fn panic_missing_secret(start: String, end: String, env: Env, name: String) {
    let _ = write_text(2, start)
    let _ = write_text(2, "the secret `")
    let _ = write_text(2, name)
    let _ = write_text(2, "` is not set in the environment")
    let _ = write_text(2, end)
    exit(101)
}

// `Secret.constant_time_eq`.
pub fn secret_constant_time_eq(secret: Secret<String>, other: String) -> Bool {
    let a = rt_mem_load64(rt_mem_add(rt_mem_secret(secret), 8))
    text_equal_constant(a, rt_mem_text(other))
}

// `Secret.constant_time_eq_secret`.
pub fn secret_constant_time_eq_secret(secret: Secret<String>, other: Secret<String>) -> Bool {
    let a = rt_mem_load64(rt_mem_add(rt_mem_secret(secret), 8))
    let b = rt_mem_load64(rt_mem_add(rt_mem_secret(other), 8))
    text_equal_constant(a, b)
}

// Whether the text objects `a` and `b` are equal, in time that depends on
// their lengths but not on where they first differ.
fn text_equal_constant(a: Int, b: Int) -> Bool {
    let length = text_length(a)
    let other = text_length(b)
    var diff = rt_mem_xor(length, other)
    let shorter = if length < other { length } else { other }
    var i = 0
    while i < shorter {
        let x = rt_mem_load8(rt_mem_add(text_data(a), i))
        let y = rt_mem_load8(rt_mem_add(text_data(b), i))
        diff = rt_mem_or(diff, rt_mem_xor(x, y))
        i = i + 1
    }
    diff == 0
}

// ---- Clock and randomness --------------------------------------------------

// `Clock.now_millis`: the realtime clock, in milliseconds.
pub fn clock_now_millis(clock: Clock) -> Int {
    let object = alloc(24)
    let _ = rt_sys_clock_gettime(0, rt_mem_add(object, 8))
    let seconds = rt_mem_load64(rt_mem_add(object, 8))
    let nanos = rt_mem_load64(rt_mem_add(object, 16))
    free(object)
    seconds * 1000 + nanos / 1000000
}

// `Random.next_int`: SplitMix64, as the interpreter's, seeded on first use
// from `getrandom` (from the clock if that fails). From 0 up to, but
// excluding, 2^63.
pub fn random_next_int(random: Random) -> Int {
    if rt_mem_load64(global(21)) == 0 {
        let object = alloc(24)
        let got = rt_sys_getrandom(rt_mem_add(object, 8), 8, 0)
        var seed = rt_mem_load64(rt_mem_add(object, 8))
        if got != 8 {
            let _ = rt_sys_clock_gettime(0, rt_mem_add(object, 8))
            let nanos = rt_mem_load64(rt_mem_add(object, 16))
            seed = rt_mem_xor(rt_mem_load64(rt_mem_add(object, 8)), rt_mem_shl(nanos, 20))
        }
        free(object)
        rt_mem_store64(global(20), seed)
        rt_mem_store64(global(21), 1)
    }
    let state = rt_mem_add(rt_mem_load64(global(20)), -7046029254386353131)
    rt_mem_store64(global(20), state)
    var z = state
    z = rt_mem_mul(rt_mem_xor(z, rt_mem_shr(z, 30)), -4658895280553007687)
    z = rt_mem_mul(rt_mem_xor(z, rt_mem_shr(z, 27)), -7723592293110705685)
    rt_mem_shr(rt_mem_xor(z, rt_mem_shr(z, 31)), 1)
}

// ---- Debugging -------------------------------------------------------------

// `dbg`'s line: standard output first, then `[dbg] `, `text` and a
// newline in one write. A failed write loses the line, not the program.
pub fn dbg_write(text: String) {
    let _ = print_error_line("[dbg] {text}")
}

// `dbg` of a `Bool`.
pub fn debug_bool(value: Bool) -> String {
    if value {
        return "true"
    }
    "false"
}

// `dbg` of an integer, read as unsigned when `unsigned` (a `U64`).
pub fn debug_int(value: Int, unsigned: Bool) -> String {
    int_text(value, unsigned)
}

// `a` and `b` as one new text.
pub fn debug_concat(a: String, b: String) -> String {
    let first = rt_mem_text(a)
    let second = rt_mem_text(b)
    let length = text_length(first) + text_length(second)
    let object = text_new(length)
    copy_bytes(text_data(object), text_data(first), text_length(first))
    copy_bytes(rt_mem_add(text_data(object), text_length(first)), text_data(second), text_length(second))
    rt_mem_as_text(object)
}

// `dbg` of a text: in double quotes, as Rust's `{:?}` writes a `str`, which
// is what the interpreter does: `"` and `\` escaped by a `\`, line feed,
// carriage return, tab and NUL as `\n`, `\r`, `\t` and `\0`, and every
// character in `escaped_table` as `\u{hex}`.
pub fn debug_string(text: String) -> String {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    let total = debug_pass(data, length, 0)
    let result = text_new(total)
    let _ = debug_pass(data, length, text_data(result))
    rt_mem_as_text(result)
}

// The characters `{:?}` writes as `\u{hex}`: the control characters other
// than the four with their own escapes, the characters that are not
// printable (unassigned, private use, separators, format characters) and
// the ones that extend the grapheme before them, as records of 12
// hexadecimal digits in order: the first character (6 digits) and the last
// (6). It is generated from Rust's `{:?}` and a test (`native_process.rs`)
// checks it against that for every character.
fn escaped_table() -> String {
    ""
}

// Whether `{:?}` writes the character `cp` as `\u{hex}`.
fn debug_escapes(cp: Int) -> Bool {
    if cp < 32 {
        return true
    }
    if cp < 127 {
        return false
    }
    let object = rt_mem_text(escaped_table())
    let data = text_data(object)
    // How many records start at or before `cp`.
    var low = 0
    var high = text_length(object) / 12
    while low < high {
        let middle = (low + high) / 2
        if hex_at(rt_mem_add(data, middle * 12), 6) <= cp {
            low = middle + 1
        } else {
            high = middle
        }
    }
    if low == 0 {
        return false
    }
    cp <= hex_at(rt_mem_add(data, (low - 1) * 12 + 6), 6)
}

// The bytes `debug_string` writes for the `length` bytes at `data`: written
// to `out` unless it is 0, which only counts them.
fn debug_pass(data: Int, length: Int, out: Int) -> Int {
    var n = put_byte(out, 0, 34)
    var i = 0
    while i < length {
        let size = sequence_length(rt_mem_load8(rt_mem_add(data, i)))
        n = debug_char(rt_mem_add(data, i), size, out, n)
        i = i + size
    }
    put_byte(out, n, 34)
}

// Write `{:?}`'s form of the character of `size` bytes at `at` at offset
// `n` of `out` (or only count it, when `out` is 0): the next offset.
fn debug_char(at: Int, size: Int, out: Int, n: Int) -> Int {
    let b = rt_mem_load8(at)
    if b == 34 || b == 92 {
        return put_byte(out, put_byte(out, n, 92), b)
    }
    if b == 10 {
        return put_byte(out, put_byte(out, n, 92), 110)
    }
    if b == 13 {
        return put_byte(out, put_byte(out, n, 92), 114)
    }
    if b == 9 {
        return put_byte(out, put_byte(out, n, 92), 116)
    }
    if b == 0 {
        return put_byte(out, put_byte(out, n, 92), 48)
    }
    if debug_escapes(decode_at(at)) {
        return put_unicode_escape(out, n, decode_at(at))
    }
    var next = n
    var k = 0
    while k < size {
        next = put_byte(out, next, rt_mem_load8(rt_mem_add(at, k)))
        k = k + 1
    }
    next
}

// Write `byte` at offset `at` of `out` unless `out` is 0: the next offset.
fn put_byte(out: Int, at: Int, byte: Int) -> Int {
    if out != 0 {
        rt_mem_store8(rt_mem_add(out, at), byte)
    }
    at + 1
}

// `\u{..}` for the code point `cp`, in lower-case hexadecimal.
fn put_unicode_escape(out: Int, at: Int, cp: Int) -> Int {
    var n = put_byte(out, at, 92)
    n = put_byte(out, n, 117)
    n = put_byte(out, n, 123)
    var shift = 20
    while shift > 0 && rt_mem_shr(cp, shift) == 0 {
        shift = shift - 4
    }
    while shift >= 0 {
        n = put_byte(out, n, hex_digit(rt_mem_and(rt_mem_shr(cp, shift), 15)))
        shift = shift - 4
    }
    put_byte(out, n, 125)
}

fn hex_digit(d: Int) -> Int {
    if d < 10 {
        return 48 + d
    }
    87 + d
}

// ---- Files -----------------------------------------------------------------
//
// Directory and file capabilities, confined as the interpreter confines
// them (`oska-run/src/confine.rs`, `host.rs`, `oska-sys`), with the same
// messages:
//
// - A capability is a `Root`: the handle of its directory (for a file
//   capability, of the file's parent, with the file's name), or, when it
//   could not be opened, no handle and the reason, which every operation
//   on it then fails with. `Fs`, `FsRead` and `FsWrite` hold nothing: they
//   only attenuate, and the type says which operations a capability has.
// - A path given to a capability becomes plain names, on the path as
//   written (`confine_names`): empty and absolute paths are refused, `.` is
//   dropped and `..` drops the name before it, refused when there is none.
// - The names are walked beneath the root's handle one at a time, each
//   opened relative to the one before with `openat` and `O_NOFOLLOW`, the
//   last included, so a symlink at any component, planted before or
//   swapped in during the walk, makes it fail. Only a root given as
//   trusted text follows symlinks, and never in its last component.
// - A regular file is read or emptied only after `fstat` on the open
//   handle shows it is one, with one link: a hard link planted beneath a
//   root could otherwise reach a file outside it.
// - Every handle opened is closed on every path, errors included; a
//   capability's own handle is closed with its last reference
//   (`root_drop`).

// A directory or file capability. `handle` is the directory's handle (a
// file capability's parent's), or -1 when `why` says why there is none;
// `path` is the directory's path, for messages; `file` is a file
// capability's file name.
struct Root { handle: Int, path: String, file: Option<String>, why: Option<String> }

// Release the capability at `object`, whose last reference is gone: its
// handle is closed, and the `Root` released as this function ends.
pub fn root_drop(object: Int) {
    let root = rt_mem_as_root(object)
    if root.handle >= 0 {
        close(root.handle)
    }
}

// Close `fd`. Like Rust's `OwnedFd`, never retried: the descriptor is gone
// either way.
fn close(fd: Int) {
    let _ = rt_sys_close(fd)
}

// `openat`'s flags on aarch64 Linux. A directory to walk beneath:
// `O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC`.
fn directory_flags() -> Int {
    573440
}

// A directory named by trusted text, following symlinks:
// `O_RDONLY | O_DIRECTORY | O_CLOEXEC`.
fn directory_following_flags() -> Int {
    540672
}

// A file to read: `O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK`, so a
// FIFO does not block the open (it is then refused as no regular file).
fn file_read_flags() -> Int {
    559104
}

// A file to write, created when missing but not truncated before it is
// known to be a regular file with one link:
// `O_WRONLY | O_CREAT | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK`.
fn file_write_flags() -> Int {
    559169
}

fn at_cwd() -> Int {
    -100
}

// Not an `errno`: what `open_name` gives, negated, for a name holding a
// NUL byte.
fn nul_in_name() -> Int {
    4096
}

// A NUL-terminated copy of `text`: a text object whose bytes are `text`'s
// then a 0, which the caller frees, or 0 when `text` holds a NUL byte.
fn c_string(text: String) -> Int {
    let object = rt_mem_text(text)
    let length = text_length(object)
    var i = 0
    while i < length {
        if rt_mem_load8(rt_mem_add(text_data(object), i)) == 0 {
            return 0
        }
        i = i + 1
    }
    let copy = text_new(length + 1)
    copy_bytes(text_data(copy), text_data(object), length)
    rt_mem_store8(rt_mem_add(text_data(copy), length), 0)
    copy
}

// `openat(dirfd, name, flags)`, with mode 0o666 for a file it creates,
// retried when a signal interrupts it: the new descriptor, or minus the
// `errno` (`nul_in_name` for a name holding a NUL byte).
fn open_name(dirfd: Int, name: String, flags: Int) -> Int {
    let path = c_string(name)
    if path == 0 {
        return 0 - nul_in_name()
    }
    var fd = rt_sys_openat(dirfd, text_data(path), flags, 438)
    while fd == -4 {
        fd = rt_sys_openat(dirfd, text_data(path), flags, 438)
    }
    free(path)
    fd
}

// The text of the error a system call gave as `errno`, as Rust's
// `io::Error` displays it.
fn os_error(errno: Int) -> String {
    if errno == nul_in_name() {
        return "a path holds a NUL byte, which no file name may"
    }
    let what = errno_message(errno)
    "{what} (os error {errno})"
}

// The error for opening `path` (the names walked so far, joined) as a
// directory when `directory`, else as a file, failing with `errno`: a
// symlink said plainly, since `openat` reports one met with `O_NOFOLLOW`
// as `ELOOP`, or as `ENOTDIR` when a directory was asked for.
fn refusal(errno: Int, path: String, directory: Bool) -> IoError {
    if errno == 40 {
        return io_error_text("`{path}` is a symlink, and confined access never follows one")
    }
    if errno == 20 && directory {
        return io_error_text("`{path}` is a symlink or not a directory, and confined access never follows a symlink")
    }
    let why = os_error(errno)
    io_error_text("`{path}`: {why}")
}

// ---- Paths as written ------------------------------------------------------

// The plain names `path` walks beneath a root, with `.` and `..` resolved
// as written, or why it is refused: it is empty, absolute, or climbs above
// the root. No names means the root itself.
fn confine_names(path: String) -> Result<List<String>, IoError> {
    if path == "" {
        return Err(io_error_text("an empty path names no file"))
    }
    if path.starts_with("/") {
        return Err(io_error_text("`{path}` is absolute; a directory capability takes paths relative to its root"))
    }
    var names: List<String> = []
    for part in path.split("/") {
        if part == "" || part == "." {
            continue
        }
        if part == ".." {
            if names.len() == 0 {
                return Err(io_error_text("`{path}` leads outside the capability's root"))
            }
            names = all_but_last(names)
            continue
        }
        names.push(part)
    }
    Ok(names)
}

// The names a write, `create_dir` or a file capability walks: as
// `confine_names` gives them, when `path` as written ends in a plain name,
// not in `/`, `.` or `..`, which would otherwise name the directory before
// them.
fn names_to_create(path: String) -> Result<List<String>, IoError> {
    let names = confine_names(path)?
    let parts = path.split("/")
    let last = parts.at(parts.len() - 1)
    if last == "" || last == "." || last == ".." {
        return Err(io_error_text("`{path}` does not end in a file name; a write, a new directory or a file needs one"))
    }
    Ok(names)
}

// The first `count` of `names`.
fn first_names(names: List<String>, count: Int) -> List<String> {
    var kept: List<String> = []
    var i = 0
    while i < count {
        kept.push(names.at(i))
        i = i + 1
    }
    kept
}

fn all_but_last(names: List<String>) -> List<String> {
    first_names(names, names.len() - 1)
}

// The first `count` of `names` joined with `/`, for messages.
fn joined(names: List<String>, count: Int) -> String {
    "/".join(first_names(names, count))
}

// The components of the trusted path `path`, as Rust's `Path::components`
// gives them on Unix: `/` first for an absolute path, `.` only as the
// first component of a relative one, then every name and `..`; empty
// components and every other `.` dropped.
fn components(path: String) -> List<String> {
    var parts: List<String> = []
    if path.starts_with("/") {
        parts.push("/")
    }
    var first = true
    for piece in path.split("/") {
        if piece == "." && first {
            parts.push(".")
        } else if piece != "" && piece != "." {
            parts.push(piece)
        }
        first = false
    }
    parts
}

// The first `count` of the components `parts` as one path again, as Rust
// collects them into a `PathBuf`.
fn path_of(parts: List<String>, count: Int) -> String {
    if count > 0 && parts.at(0) == "/" {
        var rest: List<String> = []
        var i = 1
        while i < count {
            rest.push(parts.at(i))
            i = i + 1
        }
        let tail = "/".join(rest)
        return "/{tail}"
    }
    joined(parts, count)
}

// The last of the components `parts`, when it is a name (not `/`, `.` or
// `..`): Rust's `Path::file_name`.
fn file_name(parts: List<String>) -> Option<String> {
    let last = parts.at(parts.len() - 1)
    if last == "/" || last == "." || last == ".." {
        return None
    }
    Some(last)
}

// `parent`, the leading part of a trusted path, or the current directory
// when it is empty.
fn or_here(parent: String) -> String {
    if parent == "" {
        return "."
    }
    parent
}

// `root`'s path joined with `names`, as Rust's `Path::join` joins them.
fn path_beneath(root: String, names: List<String>) -> String {
    let rest = "/".join(names)
    if root.ends_with("/") {
        return "{root}{rest}"
    }
    "{root}/{rest}"
}

// The text of `path`.
fn path_text(path: Path) -> String {
    let raw = rt_mem_load64(rt_mem_add(rt_mem_path(path), 8))
    retain(raw)
    rt_mem_as_text(raw)
}

// ---- Opening ---------------------------------------------------------------

// The directory at the trusted `path`, relative to the working directory
// when it is not absolute, following every symlink on the way: a new
// handle.
fn open_following(path: String) -> Result<Int, IoError> {
    let fd = open_name(at_cwd(), path, directory_following_flags())
    if fd < 0 {
        let why = os_error(0 - fd)
        return Err(io_error_text("`{path}`: {why}"))
    }
    Ok(fd)
}

// The canonical path of the directory open as `fd`, which the trusted
// `path` named, as Rust's `fs::canonicalize` gives it: what the kernel
// says `/proc/self/fd/N` links to, or `path` itself if it cannot say.
fn canonical(fd: Int, path: String) -> String {
    let link = c_string("/proc/self/fd/{fd}")
    let buffer = alloc(4104)
    let data = rt_mem_add(buffer, 8)
    let length = rt_sys_readlinkat(at_cwd(), text_data(link), data, 4096)
    free(link)
    var shown = path
    if length > 0 && length < 4096 && rt_mem_load8(data) == 47 && utf8_valid(data, length) {
        shown = text_from(data, length)
    }
    free(buffer)
    shown
}

// The directory reached by walking the first `count` of `names` beneath
// `root`, each a directory and none a symlink: a new handle, or `root`
// itself when `count` is 0.
fn walk(root: Int, names: List<String>, count: Int) -> Result<Int, IoError> {
    var at = root
    var i = 0
    while i < count {
        let fd = open_name(at, names.at(i), directory_flags())
        if at != root {
            close(at)
        }
        if fd < 0 {
            return Err(refusal(0 - fd, joined(names, i + 1), true))
        }
        at = fd
        i = i + 1
    }
    Ok(at)
}

// The directory reached by walking `names` beneath `root`, none a
// symlink: a new handle, a copy of `root`'s when there are no names.
fn open_dir(root: Int, names: List<String>) -> Result<Int, IoError> {
    let count = names.len()
    if count == 0 {
        // `F_DUPFD_CLOEXEC`, from 3 up, as Rust's `try_clone`.
        let fd = rt_sys_fcntl(root, 1030, 3)
        if fd < 0 {
            return Err(io_error(0 - fd))
        }
        return Ok(fd)
    }
    let parent = walk(root, names, count - 1)?
    let fd = open_name(parent, names.at(count - 1), directory_flags())
    if parent != root {
        close(parent)
    }
    if fd < 0 {
        return Err(refusal(0 - fd, joined(names, count), true))
    }
    Ok(fd)
}

// The regular file reached by walking `names` (one at least) beneath
// `root`, open with `flags`: every name before the last a directory, and
// none a symlink, the last included. The file has one link (`lone_file`).
fn open_file(root: Int, names: List<String>, flags: Int) -> Result<Int, IoError> {
    let count = names.len()
    let parent = walk(root, names, count - 1)?
    let fd = open_name(parent, names.at(count - 1), flags)
    if parent != root {
        close(parent)
    }
    if fd < 0 {
        return Err(refusal(0 - fd, joined(names, count), false))
    }
    match lone_file(fd, names) {
        Ok(_) => Ok(fd)
        Err(e) => {
            close(fd)
            Err(e)
        }
    }
}

// Whether the open `fd`, reached by `names`, is a regular file with only
// that one name. A file with another hard link may be one outside the
// directory the walk began in, so it is refused. The check is on the open
// handle, so the file cannot be swapped after it.
fn lone_file(fd: Int, names: List<String>) -> Result<(), IoError> {
    // A `struct stat`, 128 bytes on aarch64 Linux, after the object's count.
    let buffer = alloc(136)
    let stat = rt_mem_add(buffer, 8)
    let result = rt_sys_fstat(fd, stat)
    let mode = rt_mem_load32(rt_mem_add(stat, 16))
    let links = rt_mem_load32(rt_mem_add(stat, 20))
    free(buffer)
    if result < 0 {
        return Err(io_error(0 - result))
    }
    let path = joined(names, names.len())
    // `S_IFMT` and `S_IFREG`.
    if rt_mem_and(mode, 61440) != 32768 {
        return Err(io_error_text("`{path}` is not a regular file"))
    }
    if links > 1 {
        return Err(io_error_text("`{path}` has more than one hard link, and confined access never opens one"))
    }
    Ok(())
}

// ---- Reading and writing ---------------------------------------------------

// The text of the regular file reached by walking `names` beneath `root`.
fn read_beneath(root: Int, names: List<String>) -> Result<String, IoError> {
    let fd = open_file(root, names, file_read_flags())?
    let text = read_all(fd)
    close(fd)
    text
}

// Everything left to read from `fd`, as text, as Rust's `read_to_string`
// reads it: an error when it is not UTF-8.
fn read_all(fd: Int) -> Result<String, IoError> {
    // Room for the whole file, as `fstat` sizes it, and a little more.
    let buffer = alloc(136)
    var capacity = 64
    if rt_sys_fstat(fd, rt_mem_add(buffer, 8)) >= 0 {
        capacity = capacity + rt_mem_load64(rt_mem_add(buffer, 56))
    }
    free(buffer)
    var object = text_new(capacity)
    var length = 0
    while true {
        if length == capacity {
            let larger = text_new(capacity * 2)
            copy_bytes(text_data(larger), text_data(object), length)
            free(object)
            object = larger
            capacity = capacity * 2
        }
        let got = rt_sys_read(fd, rt_mem_add(text_data(object), length), capacity - length)
        if got == -4 {
            continue
        }
        if got < 0 {
            free(object)
            return Err(io_error(0 - got))
        }
        if got == 0 {
            break
        }
        length = length + got
    }
    if !utf8_valid(text_data(object), length) {
        free(object)
        return Err(io_error_text("stream did not contain valid UTF-8"))
    }
    rt_mem_store64(rt_mem_add(object, 8), length)
    Ok(rt_mem_as_text(object))
}

// Create the regular file reached by walking `names` beneath `root`, or
// replace what it holds, with `contents`. No name is a symlink, the last
// included, so nothing is created through one; a file already there is
// emptied only once it is known to be a regular one with one link.
fn write_beneath(root: Int, names: List<String>, contents: String) -> Result<(), IoError> {
    let fd = open_file(root, names, file_write_flags())?
    var emptied = rt_sys_ftruncate(fd, 0)
    while emptied == -4 {
        emptied = rt_sys_ftruncate(fd, 0)
    }
    if emptied < 0 {
        close(fd)
        return Err(io_error(0 - emptied))
    }
    let object = rt_mem_text(contents)
    let written = write_all(fd, text_data(object), text_length(object))
    close(fd)
    if written < 0 {
        return Err(io_error(0 - written))
    }
    Ok(())
}

// Create the directory reached by walking `names` (one at least) beneath
// `root`, with mode 0o777 less the umask. A directory already there is
// kept; anything else there, a symlink included, is an error.
fn create_dir_beneath(root: Int, names: List<String>) -> Result<(), IoError> {
    let parent = walk(root, names, names.len() - 1)?
    let made = make_dir(parent, names)
    if parent != root {
        close(parent)
    }
    made
}

// Make the last of `names` in the directory `parent`, the rest's.
fn make_dir(parent: Int, names: List<String>) -> Result<(), IoError> {
    let count = names.len()
    let name = names.at(count - 1)
    let path = c_string(name)
    if path == 0 {
        return Err(io_error_text(os_error(nul_in_name())))
    }
    var made = rt_sys_mkdirat(parent, text_data(path), 511)
    while made == -4 {
        made = rt_sys_mkdirat(parent, text_data(path), 511)
    }
    free(path)
    if made >= 0 {
        return Ok(())
    }
    if made != -17 {
        return Err(refusal(0 - made, joined(names, count), true))
    }
    // `mkdirat` never follows a symlink in the last component: one there,
    // dangling or not, makes it fail with `EEXIST`. What is there is kept
    // if it opens as a directory, not following a symlink.
    let fd = open_name(parent, name, directory_flags())
    if fd < 0 {
        return Err(refusal(0 - fd, joined(names, count), true))
    }
    close(fd)
    Ok(())
}

// ---- Listing ---------------------------------------------------------------

// The names of the entries of the directory `dir`, without `.` and `..`,
// sorted by their bytes; no entry is followed. Fails when a name is not
// UTF-8, naming the directory as `shown`.
fn entries(dir: Int, shown: String) -> Result<List<String>, IoError> {
    // A new open file description of the directory, so the listing starts
    // at its beginning and moves no other handle's offset.
    let fd = open_name(dir, ".", directory_flags())
    if fd < 0 {
        return Err(io_error(0 - fd))
    }
    let buffer = alloc(32768)
    let data = rt_mem_add(buffer, 8)
    var list = list_new(8)
    // The index of the first name that is not UTF-8, and the `errno` of a
    // failed read.
    var invalid = -1
    var failed = 0
    while true {
        var got = rt_sys_getdents64(fd, data, 32760)
        if got == -4 {
            continue
        }
        // The C library's `readdir` takes `ENOENT`, a directory removed
        // while it is read, as its end.
        if got == -2 {
            got = 0
        }
        if got < 0 {
            failed = 0 - got
            break
        }
        if got == 0 {
            break
        }
        var at = 0
        while at < got {
            // A `struct linux_dirent64`: the record's length at 16, the
            // NUL-terminated name at 19.
            let entry = rt_mem_add(data, at)
            let name = rt_mem_add(entry, 19)
            var length = 0
            while rt_mem_load8(rt_mem_add(name, length)) != 0 {
                length = length + 1
            }
            let dot = length == 1 && rt_mem_load8(name) == 46
            let dot_dot = length == 2 && rt_mem_load16(name) == 11822
            if !dot && !dot_dot {
                if invalid < 0 && !utf8_valid(name, length) {
                    invalid = rt_mem_load64(rt_mem_add(list, 8))
                }
                list = list_add(list, text_of(name, length))
            }
            at = at + rt_mem_load16(rt_mem_add(entry, 16))
        }
    }
    free(buffer)
    close(fd)
    if invalid < 0 {
        sort_texts(list)
    }
    let names = rt_mem_as_list(list)
    if failed != 0 {
        return Err(io_error(failed))
    }
    if invalid >= 0 {
        let name = os_debug(names.at(invalid))
        return Err(io_error_text("{name} in `{shown}` is not valid UTF-8"))
    }
    Ok(names)
}

// Sort the texts of the list object at `list` by their bytes, in place,
// with a merge sort, bottom up.
fn sort_texts(list: Int) {
    let count = rt_mem_load64(rt_mem_add(list, 8))
    if count < 2 {
        return
    }
    let items = rt_mem_add(list, 24)
    let scratch = alloc(rt_mem_shl(count, 3) + 8)
    var from = items
    var to = rt_mem_add(scratch, 8)
    var width = 1
    while width < count {
        var start = 0
        while start < count {
            var middle = start + width
            if middle > count {
                middle = count
            }
            var end = middle + width
            if end > count {
                end = count
            }
            merge(from, to, start, middle, end)
            start = end
        }
        let was = from
        from = to
        to = was
        width = width * 2
    }
    if from != items {
        copy_bytes(items, from, rt_mem_shl(count, 3))
    }
    free(scratch)
}

// Merge the sorted words `from[start..middle]` and `from[middle..end]`
// into `to[start..end]`, the left first among equals.
fn merge(from: Int, to: Int, start: Int, middle: Int, end: Int) {
    var left = start
    var right = middle
    var out = start
    while out < end {
        var take_left = right >= end
        if left < middle && right < end {
            take_left = !text_before(word_at(from, right), word_at(from, left))
        }
        if take_left {
            rt_mem_store64(rt_mem_add(to, rt_mem_shl(out, 3)), word_at(from, left))
            left = left + 1
        } else {
            rt_mem_store64(rt_mem_add(to, rt_mem_shl(out, 3)), word_at(from, right))
            right = right + 1
        }
        out = out + 1
    }
}

// Word `index` of the words at `words`.
fn word_at(words: Int, index: Int) -> Int {
    rt_mem_load64(rt_mem_add(words, rt_mem_shl(index, 3)))
}

// Whether the text object `a` sorts before `b`, by their bytes.
fn text_before(a: Int, b: Int) -> Bool {
    let a_length = text_length(a)
    let b_length = text_length(b)
    var i = 0
    while i < a_length && i < b_length {
        let x = rt_mem_load8(rt_mem_add(text_data(a), i))
        let y = rt_mem_load8(rt_mem_add(text_data(b), i))
        if x != y {
            return x < y
        }
        i = i + 1
    }
    a_length < b_length
}

// `name`, whose bytes may not be UTF-8, as Rust's `{:?}` writes an
// `OsStr`: as `debug_string` writes text, with each byte that starts no
// well-formed character as `\xHH`.
fn os_debug(name: String) -> String {
    let object = rt_mem_text(name)
    let data = text_data(object)
    let length = text_length(object)
    let total = os_debug_pass(data, length, 0)
    let result = text_new(total)
    let _ = os_debug_pass(data, length, text_data(result))
    rt_mem_as_text(result)
}

// The bytes `os_debug` writes for the `length` bytes at `data`: written to
// `out` unless it is 0, which only counts them.
fn os_debug_pass(data: Int, length: Int, out: Int) -> Int {
    var n = put_byte(out, 0, 34)
    var i = 0
    while i < length {
        let b = rt_mem_load8(rt_mem_add(data, i))
        var size = sequence_length(b)
        if size > length - i {
            size = length - i
        }
        if utf8_valid(rt_mem_add(data, i), size) {
            n = debug_char(rt_mem_add(data, i), size, out, n)
            i = i + size
        } else {
            n = put_byte(out, n, 92)
            n = put_byte(out, n, 120)
            n = put_byte(out, n, upper_hex_digit(rt_mem_shr(b, 4)))
            n = put_byte(out, n, upper_hex_digit(rt_mem_and(b, 15)))
            i = i + 1
        }
    }
    put_byte(out, n, 34)
}

fn upper_hex_digit(d: Int) -> Int {
    if d < 10 {
        return 48 + d
    }
    55 + d
}

// ---- Attenuation -------------------------------------------------------------

// A capability that reaches nothing: every operation on it fails because
// restricting to `at` failed with `message`. Callers pass an `IoError`'s
// message, which is the runtime's own wording around the program's path,
// as `assume_trusted` text: it only ever becomes another `IoError`.
fn nowhere(at: String, message: String) -> Root {
    Root(handle: -1, path: "", file: None, why: Some("cannot restrict to `{at}`: {message}"))
}

// The directory root at `handle`, whose path is `path`.
fn directory_root(handle: Int, path: String) -> Root {
    Root(handle: handle, path: path, file: None, why: None)
}

// `restrict_to(dir)` on `Fs`, `FsRead` and `FsWrite`: the directory
// capability for `dir`, trusted text, opened now. Attenuation never fails:
// a root that cannot be opened gives a capability that reaches nothing.
pub fn fs_restrict_to(fs: Int, dir: String) -> Root {
    if dir == "" {
        return nowhere(dir, "an empty path names no directory")
    }
    match open_root(dir) {
        Ok(root) => root
        Err(e) => nowhere(dir, e.message.assume_trusted())
    }
}

// The root at the trusted `dir`, a directory whose last component is not a
// symlink; earlier ones are followed.
fn open_root(dir: String) -> Result<Root, IoError> {
    // Without a trailing `/` or `.`, which would follow a symlink in the
    // last component.
    let parts = components(dir)
    let path = path_of(parts, parts.len())
    match file_name(parts) {
        Some(name) => {
            let parent = open_following(or_here(path_of(parts, parts.len() - 1)))?
            let fd = open_name(parent, name, directory_flags())
            close(parent)
            if fd < 0 {
                return Err(refusal(0 - fd, name, true))
            }
            Ok(directory_root(fd, canonical(fd, path)))
        }
        None => {
            // `/`, or a path ending in `..`: no symlink to refuse.
            let fd = open_following(path)?
            Ok(directory_root(fd, canonical(fd, path)))
        }
    }
}

// `restrict_to_file(file)` on `FsRead` and `FsWrite`: the file capability
// for the one file at `file`, trusted text. Its parent is opened now,
// following symlinks; the file itself only at each use.
pub fn fs_restrict_to_file(fs: Int, file: String) -> Root {
    if file == "" {
        return nowhere(file, "an empty path names no file")
    }
    let parts = components(file)
    match file_name(parts) {
        Some(name) => match open_following(or_here(path_of(parts, parts.len() - 1))) {
            Ok(fd) => Root(handle: fd, path: "", file: Some(name), why: None)
            Err(e) => nowhere(file, e.message.assume_trusted())
        }
        None => {
            let path = path_of(parts, parts.len())
            nowhere(file, "`{path}` does not end in a file name")
        }
    }
}

// `restrict_to(dir)` on `Dir`, `DirRead` and `DirWrite`: the capability
// narrowed to `dir`, a `Path` that may come from untrusted text, walked
// beneath the root like any path read there, so a narrowing never widens.
pub fn dir_restrict_to(root: Root, dir: Path) -> Root {
    if root.why.is_some() {
        return root
    }
    let raw = path_text(dir)
    match confine_names(raw) {
        Ok(names) => {
            if names.len() == 0 {
                return root
            }
            match open_dir(root.handle, names) {
                Ok(fd) => directory_root(fd, path_beneath(root.path, names))
                Err(e) => nowhere(raw, e.message.assume_trusted())
            }
        }
        Err(e) => nowhere(raw, e.message.assume_trusted())
    }
}

// `restrict_to_file(file)` on `DirRead` and `DirWrite`: the file
// capability for the file at `file` beneath the root, a `Path` that may
// come from untrusted text. The directory holding it is opened now.
pub fn dir_restrict_to_file(root: Root, file: Path) -> Root {
    if root.why.is_some() {
        return root
    }
    let raw = path_text(file)
    match names_to_create(raw) {
        Ok(names) => match open_dir(root.handle, all_but_last(names)) {
            Ok(fd) => Root(handle: fd, path: "", file: Some(names.at(names.len() - 1)), why: None)
            Err(e) => nowhere(raw, e.message.assume_trusted())
        }
        Err(e) => nowhere(raw, e.message.assume_trusted())
    }
}

// ---- Operations ------------------------------------------------------------

// Why `root` reaches nothing, as an error, if it does not.
fn usable(root: Root) -> Result<(), IoError> {
    match root.why {
        Some(why) => Err(io_error_text(why))
        None => Ok(())
    }
}

// A file capability's one name.
fn file_names(root: Root) -> List<String> {
    match root.file {
        Some(name) => [name]
        None => []
    }
}

// `DirRead.read_to_string(path)`.
pub fn dir_read_to_string(root: Root, path: Path) -> Result<String, IoError> {
    usable(root)?
    let raw = path_text(path)
    let names = confine_names(raw)?
    if names.len() == 0 {
        return Err(io_error_text("`{raw}` names the directory capability's root itself, not a file"))
    }
    read_beneath(root.handle, names)
}

// `DirRead.list_dir(path)`: `.` lists the root.
pub fn dir_list_dir(root: Root, path: Path) -> Result<List<String>, IoError> {
    usable(root)?
    let names = confine_names(path_text(path))?
    let fd = open_dir(root.handle, names)?
    let listed = entries(fd, path_beneath_or_at(root.path, names))
    close(fd)
    listed
}

// `root` joined with `names`, or `root` itself when there are none.
fn path_beneath_or_at(root: String, names: List<String>) -> String {
    if names.len() == 0 {
        return root
    }
    path_beneath(root, names)
}

// `DirWrite.write(path, contents)`.
pub fn dir_write(root: Root, path: Path, contents: String) -> Result<(), IoError> {
    usable(root)?
    let names = names_to_create(path_text(path))?
    write_beneath(root.handle, names, contents)
}

// `DirWrite.create_dir(path)`.
pub fn dir_create_dir(root: Root, path: Path) -> Result<(), IoError> {
    usable(root)?
    let names = names_to_create(path_text(path))?
    create_dir_beneath(root.handle, names)
}

// `FileRead.read_to_string()`.
pub fn file_read_to_string(root: Root) -> Result<String, IoError> {
    usable(root)?
    read_beneath(root.handle, file_names(root))
}

// `FileWrite.write(contents)`.
pub fn file_write(root: Root, contents: String) -> Result<(), IoError> {
    usable(root)?
    write_beneath(root.handle, file_names(root), contents)
}
