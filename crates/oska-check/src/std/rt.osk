// `std.rt`: the toolchain's own runtime module (ADR 0013). It is compiled
// into every native program and is the only source that may name a
// system-call or memory intrinsic. No user code can import it (`E0209`).
//
// An intrinsic is a body-less function whose name starts with `rt_sys_`
// (one call of the operating system, which the backend makes as the
// target platform's operating system has it made: on Linux, the system
// call of the target's number) or `rt_mem_` (one memory or word
// operation). Both prefixes are reserved: `scripts/intrinsic-guard/guard.sh`
// fails the build if any other `.osk` file names such an identifier, and
// the checker reports `E0209` for it. The interpreter has no
// implementation of them.
//
// Every argument and result is an `Int` (a 64-bit word). A system call
// returns the operating system's raw result: a negative value is `-errno`.

// ---- System calls ----------------------------------------------------------
//
// Most are the POSIX calls of their names, which every Unix Oska targets
// has. Where Linux's own call has no counterpart elsewhere, the intrinsic
// is named for what it does, and each operating system gives the call
// behind it (see "Platforms").

pub fn rt_sys_read(fd: Int, buf: Int, count: Int) -> Int
pub fn rt_sys_write(fd: Int, buf: Int, count: Int) -> Int
pub fn rt_sys_openat(dirfd: Int, path: Int, flags: Int, mode: Int) -> Int
pub fn rt_sys_close(fd: Int) -> Int
pub fn rt_sys_mkdirat(dirfd: Int, path: Int, mode: Int) -> Int
pub fn rt_sys_fstat(fd: Int, buf: Int) -> Int
pub fn rt_sys_ftruncate(fd: Int, length: Int) -> Int
pub fn rt_sys_readlinkat(dirfd: Int, path: Int, buf: Int, size: Int) -> Int
// Put the working directory's path, NUL-terminated, in the `size` bytes
// at `buf`: on success a result >= 0, which says nothing more.
pub fn rt_sys_getcwd(buf: Int, size: Int) -> Int
pub fn rt_sys_fcntl(fd: Int, command: Int, arg: Int) -> Int
pub fn rt_sys_mmap(addr: Int, length: Int, prot: Int, flags: Int, fd: Int, offset: Int) -> Int
pub fn rt_sys_munmap(addr: Int, length: Int) -> Int
pub fn rt_sys_clock_gettime(clock: Int, tp: Int) -> Int
pub fn rt_sys_ioctl(fd: Int, request: Int, arg: Int) -> Int
pub fn rt_sys_sigaltstack(stack: Int, old: Int) -> Int
pub fn rt_sys_getpid() -> Int
pub fn rt_sys_kill(pid: Int, signal: Int) -> Int
// A handle for listing the directory open at `fd`, which owns `fd` from
// then on: `rt_sys_close_dir` closes both. On Linux it is `fd` itself, and
// no call is made.
pub fn rt_sys_open_dir(fd: Int) -> Int
// Read the next entries of the directory handle `dir`, as records laid
// out as the platform's table says (`dirent_length`, `dirent_name`): 0 at
// the end, and otherwise a positive result that `dirent_one_at_a_time`
// says the meaning of. Linux's `getdents64(dir, buf, count)` puts records
// in the `count` bytes at `buf` and gives the bytes it put there.
pub fn rt_sys_read_dir(dir: Int, buf: Int, count: Int) -> Int
// Release the directory handle `dir` and the descriptor it owns. Linux's
// `close`.
pub fn rt_sys_close_dir(dir: Int) -> Int
// Fill all the `length` bytes (at most 256) at `buf` from the operating
// system's random source: on success a result >= 0, which says nothing
// more. Linux's `getrandom` with no flags.
pub fn rt_sys_random(buf: Int, length: Int) -> Int
// Make the `struct sigaction` at `action`, laid out as the platform's
// table says (`sigaction_bytes`, `sigaction_flags`), the action of
// `signal`. Linux's `rt_sigaction`, keeping no old action.
pub fn rt_sys_sigaction(signal: Int, action: Int) -> Int
// Ends the process with `status`; does not return. Linux's `exit_group`.
pub fn rt_sys_exit(status: Int) -> Int

// Windows' own calls (ADR 0020): one function of `kernel32.dll` each (or
// `bcryptprimitives.dll`'s `ProcessPrng`), with its own arguments in its
// order, out-parameters included. A failure is `-GetLastError()`. No
// other platform has them: there they make no call and fail, and `std.rt`
// never reaches them (`on_windows`). Nor does Windows have the calls
// above.
//
// `GetStdHandle(n)`.
pub fn rt_sys_get_std_handle(n: Int) -> Int
// `WriteFile(handle, buf, count, done, NULL)` and `ReadFile`: on success a
// result >= 0, with the bytes moved in the 32-bit word at `done`.
pub fn rt_sys_write_file(handle: Int, buf: Int, count: Int, done: Int) -> Int
pub fn rt_sys_read_file(handle: Int, buf: Int, count: Int, done: Int) -> Int
// `GetConsoleMode(handle, mode)`: succeeds only on a console.
pub fn rt_sys_get_console_mode(handle: Int, mode: Int) -> Int
// `WriteConsoleW(handle, units, count, done, NULL)`: UTF-16 units.
pub fn rt_sys_write_console(handle: Int, units: Int, count: Int, done: Int) -> Int
// `ReadConsoleW(handle, units, count, read, NULL)`: UTF-16 units.
pub fn rt_sys_read_console(handle: Int, units: Int, count: Int, read: Int) -> Int
// `CreateFileW(name, access, share, NULL, disposition, flags, NULL)`: a
// handle, opening a path as any open by path does (`name` is UTF-16,
// NUL-terminated).
pub fn rt_sys_create_file(name: Int, access: Int, share: Int, security: Int, disposition: Int, flags: Int, template: Int) -> Int
// `CloseHandle(handle)`.
pub fn rt_sys_close_handle(handle: Int) -> Int
// `GetFinalPathNameByHandleW(handle, units, count, flags)`: the units of
// the path written, or the units it needs when more than `count`.
pub fn rt_sys_final_path_name(handle: Int, units: Int, count: Int, flags: Int) -> Int
// `SetEndOfFile(handle)`.
pub fn rt_sys_set_end_of_file(handle: Int) -> Int
// `NtCreateFile(handle, access, attributes, status, NULL, file_attributes,
// share, disposition, options, NULL, 0)`: an `NTSTATUS`.
pub fn rt_sys_nt_create_file(handle: Int, access: Int, attributes: Int, status: Int, size: Int, file_attributes: Int, share: Int, disposition: Int, options: Int) -> Int
// `NtQueryInformationFile(handle, status, buf, length, class)`: an
// `NTSTATUS`.
pub fn rt_sys_nt_query_information_file(handle: Int, status: Int, buf: Int, length: Int, class: Int) -> Int
// `NtQueryDirectoryFile(handle, NULL, NULL, NULL, status, buf, length,
// class, single, NULL, restart)`: an `NTSTATUS`.
pub fn rt_sys_nt_query_directory_file(handle: Int, event: Int, apc: Int, context: Int, status: Int, buf: Int, length: Int, class: Int, single: Int, name: Int, restart: Int) -> Int
// `VirtualAlloc(addr, size, type, protect)`: the address.
pub fn rt_sys_virtual_alloc(addr: Int, size: Int, kind: Int, protect: Int) -> Int
// `VirtualFree(addr, 0, MEM_RELEASE)`: the whole mapping at `addr`.
pub fn rt_sys_virtual_free(addr: Int) -> Int
// `ExitProcess(code)`; does not return.
pub fn rt_sys_exit_process(code: Int) -> Int
// `GetCommandLineW()` and `GetEnvironmentStringsW()`: the addresses of the
// command line, NUL-terminated UTF-16, and the environment block.
pub fn rt_sys_command_line() -> Int
pub fn rt_sys_environment() -> Int
// `AddVectoredExceptionHandler(first, handler)`.
pub fn rt_sys_add_exception_handler(first: Int, handler: Int) -> Int
// `SetThreadStackGuarantee(size)`: `size` is the address of a 32-bit word.
pub fn rt_sys_stack_guarantee(size: Int) -> Int
// `GetSystemTimePreciseAsFileTime(time)`: 100-nanosecond intervals since
// 1601, in the word at `time`.
pub fn rt_sys_system_time(time: Int) -> Int
// `ProcessPrng(buf, length)`: fills all `length` bytes.
pub fn rt_sys_process_prng(buf: Int, length: Int) -> Int
// `GetNetworkParams(info, size)` of `iphlpapi.dll`: writes a `FIXED_INFO`
// with the system's DNS servers to `info`, whose size in bytes is the
// `ULONG` at `size`. The result is the Win32 error code itself: 0, or 111
// when `info` is too small, with the size needed written to `size` (ADR
// 0024).
pub fn rt_sys_get_network_params(info: Int, size: Int) -> Int

// Sockets (spec #228, ADR 0013). `rt_sys_socket(domain, type, protocol)`,
// `connect(fd, address, length)`, `bind`, `listen(fd, backlog)`,
// `accept(fd, 0, 0)` (a descriptor on every platform) and
// `getsockname(fd, address, lengthptr)`, `getsockopt` and `setsockopt`
// with `(fd, level, name, value, length)`, `send` and `recv` with
// `(fd, buf, count)` (no flags: on Linux `send` never raises `SIGPIPE`),
// and `poll(entries, count, timeout)`: Linux's `ppoll`, whose timeout is
// the address of a `struct timespec`, and everywhere else a count of
// milliseconds (see `poll_timespec`). Each gives the operating system's
// result, or minus its error.
pub fn rt_sys_socket(domain: Int, kind: Int, protocol: Int) -> Int
pub fn rt_sys_connect(fd: Int, address: Int, length: Int) -> Int
pub fn rt_sys_bind(fd: Int, address: Int, length: Int) -> Int
pub fn rt_sys_listen(fd: Int, backlog: Int) -> Int
pub fn rt_sys_accept(fd: Int, address: Int, length: Int) -> Int
pub fn rt_sys_getsockname(fd: Int, address: Int, length: Int) -> Int
pub fn rt_sys_getsockopt(fd: Int, level: Int, name: Int, value: Int, length: Int) -> Int
pub fn rt_sys_setsockopt(fd: Int, level: Int, name: Int, value: Int, length: Int) -> Int
pub fn rt_sys_send(fd: Int, buf: Int, count: Int) -> Int
pub fn rt_sys_recv(fd: Int, buf: Int, count: Int) -> Int
pub fn rt_sys_poll(entries: Int, count: Int, timeout: Int) -> Int

// Windows' own socket calls, `ws2_32.dll`'s (ADR 0020): `WSAStartup`, which
// every program that uses sockets calls first (as often as it likes),
// `closesocket` and `ioctlsocket`, which sets a socket's non-blocking mode.
pub fn rt_sys_wsa_startup(version: Int, data: Int) -> Int
pub fn rt_sys_close_socket(fd: Int) -> Int
pub fn rt_sys_ioctl_socket(fd: Int, command: Int, argument: Int) -> Int

// ---- Memory and words ------------------------------------------------------

// Loads of 8, 16, 32 and 64 bits at address `addr`, zero-extended into the
// `Int` (a 64-bit load is the whole word). Stores write the low 8, 16, 32 or
// 64 bits of `value` and ignore the rest.
pub fn rt_mem_load8(addr: Int) -> Int
pub fn rt_mem_load16(addr: Int) -> Int
pub fn rt_mem_load32(addr: Int) -> Int
pub fn rt_mem_store8(addr: Int, value: Int)
pub fn rt_mem_store16(addr: Int, value: Int)
pub fn rt_mem_store32(addr: Int, value: Int)
// The 64-bit word at address `addr`.
pub fn rt_mem_load64(addr: Int) -> Int
// Write `value` to the 64-bit word at address `addr`.
pub fn rt_mem_store64(addr: Int, value: Int)
// Bitwise operations on the 64-bit patterns; they never overflow-panic.
pub fn rt_mem_and(a: Int, b: Int) -> Int
pub fn rt_mem_or(a: Int, b: Int) -> Int
pub fn rt_mem_xor(a: Int, b: Int) -> Int
// Shifts by `n` (0 to 63): left, logical right, and arithmetic right.
pub fn rt_mem_shl(a: Int, n: Int) -> Int
pub fn rt_mem_shr(a: Int, n: Int) -> Int
pub fn rt_mem_sar(a: Int, n: Int) -> Int
// Wrapping addition and subtraction of 64-bit words, for addresses and
// sizes; they never overflow-panic.
pub fn rt_mem_add(a: Int, b: Int) -> Int
pub fn rt_mem_sub(a: Int, b: Int) -> Int
// Wrapping multiplication of 64-bit words (the low 64 bits of the product).
pub fn rt_mem_mul(a: Int, b: Int) -> Int
// `value` itself, marked secret: a byte of secret bytes. The native
// backend refuses to build code in which a branch or an address depends on
// it, or on anything computed from it (`oska-native`'s `constant_time.rs`).
pub fn rt_mem_conceal(value: Int) -> Int
// `value` itself, public whatever it was computed from: a secret exposure
// in the runtime, made only where the prelude gives a public result, such as
// the `Bool` of a constant-time comparison.
pub fn rt_mem_expose(value: Int) -> Int

// ---- Values ----------------------------------------------------------------
//
// A heap value is the address of an object whose first word is its
// reference count. A negative count marks a static object in read-only
// memory, which is never counted or freed. A text object continues with
// its length in bytes, then its UTF-8 bytes; a list object with its length,
// its capacity, then its items.

// The address of `text`'s object.
pub fn rt_mem_text(text: String) -> Int
// The text whose object is at `object`: the reference the caller holds
// to it passes to the result.
pub fn rt_mem_as_text(object: Int) -> String
// The address of `path`'s object, and the `Path` whose object is at
// `object` (the reference passes, as for text).
// The same for a `Secret<String>` and an `IoError` (an object of a count and
// its one field).
pub fn rt_mem_secret(secret: Secret<String>) -> Int
pub fn rt_mem_as_secret(object: Int) -> Secret<String>
// The `Secret<Bytes>` whose object is at `object`.
pub fn rt_mem_as_secret_bytes(object: Int) -> Secret<Bytes>
pub fn rt_mem_as_io_error(object: Int) -> IoError
pub fn rt_mem_path(path: Path) -> Int
pub fn rt_mem_as_path(object: Int) -> Path
// The address of `list`'s object, and the list of texts whose object is at
// `object` (the reference passes, as for text).
pub fn rt_mem_list(list: List<String>) -> Int
pub fn rt_mem_as_list(object: Int) -> List<String>
// The address of `bytes`' object, and the `Bytes` whose object is at
// `object` (the reference passes, as for text).
pub fn rt_mem_bytes(bytes: Bytes) -> Int
pub fn rt_mem_as_bytes(object: Int) -> Bytes
// The directory or file capability whose object is at `object`, as the
// runtime's `Root` (the reference passes, as for text).
pub fn rt_mem_as_root(object: Int) -> Root
// The address of the runtime's writable words, zero when the program
// starts: see `global`.
pub fn rt_mem_globals() -> Int
// How many more calls of the program may nest: the generated code counts
// it down at each call (`oska-native`'s `Inst::Enter`), from the most it
// allows, and up again as each returns. Indexes the call stack ("The call
// stack").
pub fn rt_mem_depth() -> Int
// Which host the process runs on: 0 the real OS, 1 the test host, 2 the
// real OS under an `#[integration]` test. Always 0 in a program's
// executable; in a test executable, word 32, which `test_begin` sets.
pub fn rt_mem_test_host() -> Int
// The table of the target platform the executable is built for (see
// "Platforms"): a constant, as `rt_mem_test_host` is, since the backend
// gives the table of the platform it compiles for.
pub fn rt_mem_platform() -> Platform

// ---- Platforms -------------------------------------------------------------
//
// Each operating system's numbers, flags and structure layouts that
// `std.rt` reads are in its table, and nowhere else: no function holds
// such a value, or asks which platform it runs on. Which call is behind
// each `rt_sys_` intrinsic (on Linux, the system call's number, and the
// arguments the kernel takes beyond the intrinsic's) is the backend's,
// which lowers it with the target's. Adding an operating system is adding
// its table here and its calls there; where its processors differ, as
// Linux's open flags and `struct stat` do, each processor has a table.
//
// Outside the tables are only the values every Unix Oska targets shares:
// `O_RDONLY`, `mmap`'s protections and `MAP_FIXED`, `SIG_IGN`, the size
// of `stack_t`, `CLOCK_REALTIME`, `S_IFMT` and the file types, the
// signals' numbers but `SIGBUS`, and the `errno` values `std.rt` tests for
// but `ELOOP`.

struct Platform {
    // `openat`'s flags `O_DIRECTORY` and `O_NOFOLLOW`, `O_WRONLY`,
    // `O_CREAT`, `O_NONBLOCK` and `O_CLOEXEC`, and `AT_FDCWD`.
    o_directory: Int,
    o_nofollow: Int,
    o_wronly: Int,
    o_creat: Int,
    o_nonblock: Int,
    o_cloexec: Int,
    at_fdcwd: Int,
    // `fcntl`'s `F_DUPFD_CLOEXEC`.
    f_dupfd_cloexec: Int,
    // The `ioctl` request that succeeds only on a terminal (Linux's
    // `TCGETS`), and the bytes of the `struct termios` it fills.
    tty_request: Int,
    termios_bytes: Int,
    // `mmap`'s flags `MAP_PRIVATE | MAP_ANONYMOUS`, and `MAP_NORESERVE`.
    map_private_anonymous: Int,
    map_noreserve: Int,
    // `struct stat`: its size in bytes, the offsets of `st_mode`,
    // `st_nlink` and `st_size`, and the widths in bits of `st_mode` and
    // `st_nlink` (`st_size` is 64).
    stat_bytes: Int,
    stat_mode: Int,
    stat_nlink: Int,
    stat_size: Int,
    stat_mode_bits: Int,
    stat_nlink_bits: Int,
    // The records `rt_sys_read_dir` gives: the offsets of the record's
    // length (16 bits) and of its NUL-terminated name. When
    // `dirent_one_at_a_time`, a positive result is the address of one
    // record; otherwise it is the bytes of records it put at `buf`.
    dirent_length: Int,
    dirent_name: Int,
    dirent_one_at_a_time: Bool,
    // The `struct sigaction` `rt_sys_sigaction` takes: its size in bytes
    // (a multiple of 8), the offset of its flags (whose low 32 bits are
    // written), and the flags of a fault signal's action. The handler is
    // at 0, and every other field is zero.
    sigaction_bytes: Int,
    sigaction_flags: Int,
    sa_fault_flags: Int,
    // `stack_t`, 24 bytes: the offsets of `ss_size` and `ss_flags`
    // (`ss_sp` is at 0). `handle_faults` writes both.
    ss_size_at: Int,
    ss_flags_at: Int,
    // `SIGBUS`'s number, and `ELOOP`'s.
    sigbus: Int,
    e_loop: Int,
    // Where the platform's system errors are worded in `system_errors`:
    // how many wordings come before its error 1, and how many it has.
    errors_at: Int,
    errors_count: Int,
    // Whether the platform is Windows, whose calls are its own (ADR
    // 0020): the one value an operating-system leaf function tests.
    windows: Bool,
    // The errors of an interrupted call, which is made again (0: there
    // is none), and of a write to a pipe whose reader has gone (and a
    // second one, or 0).
    e_intr: Int,
    e_pipe: Int,
    e_pipe_alt: Int,
    // Sockets: `AF_INET6`, and `SOL_SOCKET` with its options `SO_ERROR` and
    // `SO_REUSEADDR` (0: it is not set, as on Windows).
    af_inet6: Int,
    sol_socket: Int,
    so_error: Int,
    so_reuseaddr: Int,
    // `poll`'s `POLLIN` and `POLLOUT` (Windows' `POLLRDNORM` and
    // `POLLWRNORM`), whether its timeout is the address of a `struct
    // timespec` rather than milliseconds, and whether a `struct sockaddr`
    // starts with its length in one byte (macOS), its family then being one
    // byte too.
    poll_in: Int,
    poll_out: Int,
    poll_timespec: Bool,
    sockaddr_length_byte: Bool,
    // The errors of a socket call that say it would block, that a
    // non-blocking `connect` has begun, and the kinds `net_wording` words:
    // refused, reset, aborted, timed out, and a network or host that cannot
    // be reached.
    e_would_block: Int,
    e_in_progress: Int,
    e_refused: Int,
    e_reset: Int,
    e_aborted: Int,
    e_timed_out: Int,
    e_net_unreach: Int,
    e_host_unreach: Int,
}

// `linux-aarch64`: arm64's open flags and `struct stat`, and what every
// Linux processor shares.
fn linux_aarch64() -> Platform {
    Platform(
        o_directory: 16384,
        o_nofollow: 32768,
        o_wronly: 1,
        o_creat: 64,
        o_nonblock: 2048,
        o_cloexec: 524288,
        at_fdcwd: -100,
        f_dupfd_cloexec: 1030,
        tty_request: 21505,
        termios_bytes: 36,
        map_private_anonymous: 34,
        map_noreserve: 16384,
        stat_bytes: 128,
        stat_mode: 16,
        stat_nlink: 20,
        stat_size: 48,
        stat_mode_bits: 32,
        stat_nlink_bits: 32,
        dirent_length: 16,
        dirent_name: 19,
        dirent_one_at_a_time: false,
        sigaction_bytes: 32,
        sigaction_flags: 8,
        sa_fault_flags: 3422552064,
        ss_size_at: 16,
        ss_flags_at: 8,
        sigbus: 7,
        e_loop: 40,
        errors_at: 0,
        errors_count: 133,
        windows: false,
        e_intr: 4,
        e_pipe: 32,
        e_pipe_alt: 0,
        af_inet6: 10,
        sol_socket: 1,
        so_error: 4,
        so_reuseaddr: 2,
        poll_in: 1,
        poll_out: 4,
        poll_timespec: true,
        sockaddr_length_byte: false,
        e_would_block: 11,
        e_in_progress: 115,
        e_refused: 111,
        e_reset: 104,
        e_aborted: 103,
        e_timed_out: 110,
        e_net_unreach: 101,
        e_host_unreach: 113,
    )
}

// `linux-x86_64`: x86_64's open flags (the generic ones) and its own
// `struct stat`, which puts a 64-bit `st_nlink` before `st_mode`, and
// what every Linux processor shares.
fn linux_x86_64() -> Platform {
    Platform(
        o_directory: 65536,
        o_nofollow: 131072,
        o_wronly: 1,
        o_creat: 64,
        o_nonblock: 2048,
        o_cloexec: 524288,
        at_fdcwd: -100,
        f_dupfd_cloexec: 1030,
        tty_request: 21505,
        termios_bytes: 36,
        map_private_anonymous: 34,
        map_noreserve: 16384,
        stat_bytes: 144,
        stat_mode: 24,
        stat_nlink: 16,
        stat_size: 48,
        stat_mode_bits: 32,
        stat_nlink_bits: 64,
        dirent_length: 16,
        dirent_name: 19,
        dirent_one_at_a_time: false,
        sigaction_bytes: 32,
        sigaction_flags: 8,
        sa_fault_flags: 3422552064,
        ss_size_at: 16,
        ss_flags_at: 8,
        sigbus: 7,
        e_loop: 40,
        errors_at: 0,
        errors_count: 133,
        windows: false,
        e_intr: 4,
        e_pipe: 32,
        e_pipe_alt: 0,
        af_inet6: 10,
        sol_socket: 1,
        so_error: 4,
        so_reuseaddr: 2,
        poll_in: 1,
        poll_out: 4,
        poll_timespec: true,
        sockaddr_length_byte: false,
        e_would_block: 11,
        e_in_progress: 115,
        e_refused: 111,
        e_reset: 104,
        e_aborted: 103,
        e_timed_out: 110,
        e_net_unreach: 101,
        e_host_unreach: 113,
    )
}

// `macos-aarch64` and `macos-x86_64`: xnu's and Libc's values, which the
// two processors share (`sys/fcntl.h`, `sys/ttycom.h`, `sys/mman.h`,
// `sys/stat.h` and `dirent.h` with 64-bit inodes, `sys/signal.h`,
// `sys/errno.h`). `struct stat` has a 16-bit `st_mode` and `st_nlink`;
// `readdir` gives one record at a time; `sigaction` takes the user's
// 16-byte `struct sigaction` (handler, a 32-bit mask, `int` flags) and
// needs no restorer; the fault flags are `SA_ONSTACK | SA_RESETHAND |
// SA_NODEFER`.
fn macos() -> Platform {
    Platform(
        o_directory: 1048576,
        o_nofollow: 256,
        o_wronly: 1,
        o_creat: 512,
        o_nonblock: 4,
        o_cloexec: 16777216,
        at_fdcwd: -2,
        f_dupfd_cloexec: 67,
        tty_request: 1078490131,
        termios_bytes: 72,
        map_private_anonymous: 4098,
        map_noreserve: 64,
        stat_bytes: 144,
        stat_mode: 4,
        stat_nlink: 6,
        stat_size: 96,
        stat_mode_bits: 16,
        stat_nlink_bits: 16,
        dirent_length: 16,
        dirent_name: 21,
        dirent_one_at_a_time: true,
        sigaction_bytes: 16,
        sigaction_flags: 12,
        sa_fault_flags: 21,
        ss_size_at: 8,
        ss_flags_at: 16,
        sigbus: 10,
        e_loop: 62,
        errors_at: 133,
        errors_count: 106,
        windows: false,
        e_intr: 4,
        e_pipe: 32,
        e_pipe_alt: 0,
        af_inet6: 30,
        sol_socket: 65535,
        so_error: 4103,
        so_reuseaddr: 4,
        poll_in: 1,
        poll_out: 4,
        poll_timespec: false,
        sockaddr_length_byte: true,
        e_would_block: 35,
        e_in_progress: 36,
        e_refused: 61,
        e_reset: 54,
        e_aborted: 53,
        e_timed_out: 60,
        e_net_unreach: 51,
        e_host_unreach: 65,
    )
}

// `windows-x86_64`: none of the Unix values apply, since no POSIX call is
// made. No call is interrupted; a closed pipe is `ERROR_NO_DATA` (232) or
// `ERROR_BROKEN_PIPE` (109). Its errors are not worded yet: each is an
// `I/O error`.
fn windows_x86_64() -> Platform {
    Platform(
        o_directory: 0,
        o_nofollow: 0,
        o_wronly: 0,
        o_creat: 0,
        o_nonblock: 0,
        o_cloexec: 0,
        at_fdcwd: 0,
        f_dupfd_cloexec: 0,
        tty_request: 0,
        termios_bytes: 0,
        map_private_anonymous: 0,
        map_noreserve: 0,
        stat_bytes: 0,
        stat_mode: 0,
        stat_nlink: 0,
        stat_size: 0,
        stat_mode_bits: 0,
        stat_nlink_bits: 0,
        dirent_length: 0,
        dirent_name: 0,
        dirent_one_at_a_time: false,
        sigaction_bytes: 0,
        sigaction_flags: 0,
        sa_fault_flags: 0,
        ss_size_at: 0,
        ss_flags_at: 0,
        sigbus: 0,
        // No Win32 error: what `win_open_name` gives, negated, for a
        // reparse point, which is refused as Unix refuses a symlink.
        e_loop: 4097,
        errors_at: 0,
        errors_count: 0,
        windows: true,
        e_intr: 0,
        e_pipe: 232,
        e_pipe_alt: 109,
        af_inet6: 23,
        sol_socket: 65535,
        so_error: 4103,
        so_reuseaddr: 0,
        poll_in: 256,
        poll_out: 16,
        poll_timespec: false,
        sockaddr_length_byte: false,
        e_would_block: 10035,
        e_in_progress: 10035,
        e_refused: 10061,
        e_reset: 10054,
        e_aborted: 10053,
        e_timed_out: 10060,
        e_net_unreach: 10051,
        e_host_unreach: 10065,
    )
}

// Whether the target platform is Windows.
fn on_windows() -> Bool {
    rt_mem_platform().windows
}

// Whether a call's result `result` is the error of an interrupted call,
// which is made again.
fn interrupted(result: Int) -> Bool {
    let e = rt_mem_platform().e_intr
    e != 0 && result == 0 - e
}

// Whether a write's result `result` says the pipe's reader has gone.
fn broken_pipe(result: Int) -> Bool {
    let platform = rt_mem_platform()
    result == 0 - platform.e_pipe || (platform.e_pipe_alt != 0 && result == 0 - platform.e_pipe_alt)
}

// ---- Memory ----------------------------------------------------------------
//
// The runtime's writable words, by index:
//
//   0 to 7  the free lists of size classes 0 to 7 (8 to 12 are words
//           40 to 44; see `free_list`): a block of class c is 16 << c
//           bytes, header included;
//   8       the next free byte of the chunk blocks are carved from;
//   9       the end of that chunk;
//   10      argc, 11 argv (the address of the pointer array), 12 envp, as
//           the process started (`process_init`);
//   13      the stdout buffer (64 KiB, mapped on first use), 14 the bytes
//           in it, 15 how it is flushed (0 undecided, 1 if full, 2 after
//           every line, for a terminal);
//   16      the stdin buffer, 17 where the unread bytes start, 18 where
//           they end, 19 its capacity;
//   20      the state of `Random`'s generator, 21 whether it is seeded;
//   22      a freed large object's mapping kept for reuse, or 0;
//   23      that mapping's length;
//   24      the pending drops ("Deferred drops"), 25 how many, 26 room for
//           how many, 27 whether the outermost drop runs them;
//   28      the one-byte ASCII texts (`text_of`), made on first use;
//   29      the digits of a fault report's signal number (`on_fault`);
//   30      the default action's `struct sigaction`, which `on_fault` restores;
//   31      the bytes written to stdout and stderr, under `--max-output`
//           (`output_allows`);
//   32-38   the test host ("The test host"): 32 which host a test runs on,
//           33 its stderr prefix, 34 whether stderr is at a line's start,
//           35 the lines printed, 36 and 37 the fake files' paths and
//           contents, 38 the fake directories;
//   39      the bytes left under `--max-memory` ("Memory limit");
//   40-44   the free lists of size classes 8 to 12;
//   45-47   on Windows, the handles of standard input, output and error;
//   48      on Windows, the word a call puts its count in (`win_write`);
//   49      on Windows, the console area, or 0 (see "The Windows console");
//   50      the call stack ("The call stack");
//   51      the root budget's counters, made on first use ("Budgets");
//   52      in a test, `t.approver`'s answers still to give, 53 the
//           questions it was asked ("Approvals");
//   54      under `--max-steps` only, the steps left (`oska-native`'s
//           `STEPS_WORD`);
//   55      under `--max-memory` only, the report of its panic
//           ("Memory limit").
//
// Every object the allocator gives out is preceded by a header word: its
// block's size class, or for an object too large for any class, minus
// the length of its own mapping (plus 256 for a block `--max-memory`
// counted). Its first word is its reference count, which the generated
// code keeps; `free` is called when it drops to zero.

// The address of the runtime's writable word `index`.
fn global(index: Int) -> Int {
    rt_mem_add(rt_mem_globals(), rt_mem_shl(index, 3))
}

// The largest block, header included, a size class holds: 64 KiB, so
// texts and lists up to that size, which a program makes and frees by the
// thousand as it builds text, reuse blocks instead of mapping and
// unmapping memory, and faulting it in afresh, every time.
fn largest_block() -> Int {
    65536
}

// The address of the free list of size class `class`.
fn free_list(class: Int) -> Int {
    if class < 8 {
        return global(class)
    }
    global(rt_mem_add(class, 32))
}

// How many bytes the allocator maps at once to carve blocks from.
fn chunk_size() -> Int {
    1048576
}

// `mmap`'s flags: shared with no file, private, anonymous; and without
// reserving swap for it.
fn private_anonymous() -> Int {
    rt_mem_platform().map_private_anonymous
}

fn no_reserve() -> Int {
    rt_mem_platform().map_noreserve
}

// Map `length` bytes of fresh zeroed memory with protection `prot` and
// `mmap`'s `flags` (at `addr` when they say it is fixed): its address.
// Running out of memory ends the process.
fn map(addr: Int, length: Int, prot: Int, flags: Int) -> Int {
    let at = if on_windows() { win_alloc(length) } else { rt_sys_mmap(addr, length, prot, flags, -1, 0) }
    if at < 0 {
        out_of_memory()
    }
    at
}

// Fresh read-write memory of `length` bytes anywhere, on Windows: its
// address, or a negative error. Windows asks for no other mapping. (The
// functions that call the system keep its call in their own body, beside
// this one's, so that the optimizer never inlines them: a Windows branch
// must not make Linux's frames larger.)
fn win_alloc(length: Int) -> Int {
    // `MEM_COMMIT | MEM_RESERVE`, `PAGE_READWRITE`.
    rt_sys_virtual_alloc(0, length, 12288, 4)
}

fn out_of_memory() {
    let _ = write_text(report_fd(), "the native runtime is out of memory\n")
    exit(101)
}

// A new object of `size` bytes, a multiple of 8 that counts its reference
// count: its address. Its count is 1; the rest is not initialised.
pub fn alloc(size: Int) -> Int {
    let block = rt_mem_add(size, 8)
    var at = 0
    if block > largest_block() {
        var length = rt_mem_and(rt_mem_add(block, 65535), -65536)
        // The kept mapping, if it fits without wasting more than half.
        let kept = rt_mem_load64(global(22))
        let kept_length = rt_mem_load64(global(23))
        if kept != 0 && kept_length >= length && rt_mem_shr(kept_length, 1) <= length {
            rt_mem_store64(global(22), 0)
            at = kept
            length = kept_length
        } else {
            at = map(0, length, 3, private_anonymous())
        }
        rt_mem_store64(at, rt_mem_sub(0, length))
    } else {
        var class = 0
        var bytes = 16
        while bytes < block {
            bytes = rt_mem_shl(bytes, 1)
            class = rt_mem_add(class, 1)
        }
        let list = free_list(class)
        at = rt_mem_load64(list)
        if at != 0 {
            rt_mem_store64(list, rt_mem_load64(at))
        } else {
            at = carve(bytes)
        }
        rt_mem_store64(at, class)
    }
    let object = rt_mem_add(at, 8)
    rt_mem_store64(object, 1)
    object
}

// `alloc(size)`, or 0 when no memory holds it (or `size` is past any
// address space), where `alloc` would end the process: for a buffer whose
// size the outside world chose, such as a file's.
fn try_alloc(size: Int) -> Int {
    if size < 0 || size > 140737488355328 {
        return 0
    }
    let block = rt_mem_add(size, 8)
    if block <= largest_block() {
        return alloc(size)
    }
    let length = rt_mem_and(rt_mem_add(block, 65535), -65536)
    let at = if on_windows() { win_alloc(length) } else { rt_sys_mmap(0, length, 3, private_anonymous(), -1, 0) }
    if at < 0 {
        return 0
    }
    rt_mem_store64(at, rt_mem_sub(0, length))
    let object = rt_mem_add(at, 8)
    rt_mem_store64(object, 1)
    object
}

// A new block of `bytes`, carved from the current chunk or a new one.
fn carve(bytes: Int) -> Int {
    var next = rt_mem_load64(global(8))
    if next == 0 || rt_mem_add(next, bytes) > rt_mem_load64(global(9)) {
        next = map(0, chunk_size(), 3, private_anonymous())
        rt_mem_store64(global(9), rt_mem_add(next, chunk_size()))
    }
    rt_mem_store64(global(8), rt_mem_add(next, bytes))
    next
}

// Return the object at `object`, whose count has dropped to zero, to the
// allocator.
pub fn free(object: Int) {
    let at = rt_mem_sub(object, 8)
    let class = rt_mem_load64(at)
    if class < 0 {
        // The last large object freed keeps its mapping, for the next to
        // reuse: a program that makes one large text after another maps
        // and faults in fresh memory far less often.
        let kept = rt_mem_load64(global(22))
        if kept != 0 {
            if on_windows() {
                let _ = rt_sys_virtual_free(kept)
            } else {
                let _ = rt_sys_munmap(kept, rt_mem_load64(global(23)))
            }
        }
        rt_mem_store64(global(22), at)
        rt_mem_store64(global(23), rt_mem_sub(0, class))
        return
    }
    let list = free_list(class)
    rt_mem_store64(at, rt_mem_load64(list))
    rt_mem_store64(list, at)
}

// Copy the `count` bytes at `from` to `to`, which do not overlap, a word
// at a time; the last few bytes by one word, or smaller pieces, that ends
// where they do (it may write again bytes already written, with the same
// values), so no access reaches past either end.
fn copy_bytes(to: Int, from: Int, count: Int) {
    if count >= 8 {
        var i = 0
        // Four words at a time while they last, then one. Each word is
        // the address plus a constant, which the load or store encodes.
        while rt_mem_add(i, 32) <= count {
            let source = rt_mem_add(from, i)
            let target = rt_mem_add(to, i)
            let a = rt_mem_load64(source)
            let b = rt_mem_load64(rt_mem_add(source, 8))
            let c = rt_mem_load64(rt_mem_add(source, 16))
            let d = rt_mem_load64(rt_mem_add(source, 24))
            rt_mem_store64(target, a)
            rt_mem_store64(rt_mem_add(target, 8), b)
            rt_mem_store64(rt_mem_add(target, 16), c)
            rt_mem_store64(rt_mem_add(target, 24), d)
            i = rt_mem_add(i, 32)
        }
        while rt_mem_add(i, 8) <= count {
            rt_mem_store64(rt_mem_add(to, i), rt_mem_load64(rt_mem_add(from, i)))
            i = rt_mem_add(i, 8)
        }
        if i < count {
            let tail = rt_mem_sub(count, 8)
            rt_mem_store64(rt_mem_add(to, tail), rt_mem_load64(rt_mem_add(from, tail)))
        }
        return
    }
    if count >= 4 {
        rt_mem_store32(to, rt_mem_load32(from))
        let tail = rt_mem_sub(count, 4)
        rt_mem_store32(rt_mem_add(to, tail), rt_mem_load32(rt_mem_add(from, tail)))
        return
    }
    if count >= 2 {
        rt_mem_store16(to, rt_mem_load16(from))
        let tail = rt_mem_sub(count, 2)
        rt_mem_store16(rt_mem_add(to, tail), rt_mem_load16(rt_mem_add(from, tail)))
        return
    }
    if count == 1 {
        rt_mem_store8(to, rt_mem_load8(from))
    }
}

// Whether the `count` bytes at `a` and at `b` are the same: a word at a
// time, the last few bytes as `copy_bytes` copies them.
fn bytes_equal(a: Int, b: Int, count: Int) -> Bool {
    if count >= 8 {
        var i = 0
        while rt_mem_add(i, 8) <= count {
            if rt_mem_load64(rt_mem_add(a, i)) != rt_mem_load64(rt_mem_add(b, i)) {
                return false
            }
            i = rt_mem_add(i, 8)
        }
        if i == count {
            return true
        }
        let tail = rt_mem_sub(count, 8)
        return rt_mem_load64(rt_mem_add(a, tail)) == rt_mem_load64(rt_mem_add(b, tail))
    }
    if count >= 4 {
        let tail = rt_mem_sub(count, 4)
        return rt_mem_load32(a) == rt_mem_load32(b) && rt_mem_load32(rt_mem_add(a, tail)) == rt_mem_load32(rt_mem_add(b, tail))
    }
    if count >= 2 {
        let tail = rt_mem_sub(count, 2)
        return rt_mem_load16(a) == rt_mem_load16(b) && rt_mem_load16(rt_mem_add(a, tail)) == rt_mem_load16(rt_mem_add(b, tail))
    }
    count == 0 || rt_mem_load8(a) == rt_mem_load8(b)
}

// Count one more reference to the object at `object`, unless it is static.
fn retain(object: Int) {
    let count = rt_mem_load64(object)
    if count >= 0 {
        rt_mem_store64(object, rt_mem_add(count, 1))
    }
}

// ---- Deferred drops ----------------------------------------------------------
//
// A generated drop function never calls another: an object it lets go of
// that must be dropped in turn is put on a list of pending drops (pairs
// of the object and the drop function's code address, in words 24-26),
// and the outermost drop (the one that found word 27 at 0) runs them
// until none is left. So dropping a structure of any depth, such as a
// list of a million links, takes a bounded native stack.

// Put the drop of `object` by the code at `code` on the pending list.
pub fn drop_later(object: Int, code: Int) {
    let count = rt_mem_load64(global(25))
    let capacity = rt_mem_load64(global(26))
    var pending = rt_mem_load64(global(24))
    if count == capacity {
        var bigger = 4096
        if capacity != 0 {
            bigger = rt_mem_shl(capacity, 1)
        }
        let fresh = map(0, rt_mem_shl(bigger, 4), 3, private_anonymous())
        if pending != 0 {
            copy_bytes(fresh, pending, rt_mem_shl(count, 4))
            if on_windows() {
                let _ = rt_sys_virtual_free(pending)
            } else {
                let _ = rt_sys_munmap(pending, rt_mem_shl(capacity, 4))
            }
        }
        pending = fresh
        rt_mem_store64(global(24), fresh)
        rt_mem_store64(global(26), bigger)
    }
    let at = rt_mem_add(pending, rt_mem_shl(count, 4))
    rt_mem_store64(at, object)
    rt_mem_store64(rt_mem_add(at, 8), code)
    rt_mem_store64(global(25), rt_mem_add(count, 1))
}

// Whether the caller, a drop function that has done its own part, is the
// outermost and must run the pending drops (`drop_next` until 0).
pub fn drops_begin() -> Bool {
    if rt_mem_load64(global(27)) != 0 || rt_mem_load64(global(25)) == 0 {
        return false
    }
    rt_mem_store64(global(27), 1)
    true
}

// Take the last pending drop off the list: the address of its pair
// (object, code), good until the next `drop_later`; or 0 when none is
// left, which ends the outermost drop's run.
pub fn drop_next() -> Int {
    let count = rt_mem_load64(global(25))
    if count == 0 {
        rt_mem_store64(global(27), 0)
        return 0
    }
    let last = rt_mem_sub(count, 1)
    rt_mem_store64(global(25), last)
    rt_mem_add(rt_mem_load64(global(24)), rt_mem_shl(last, 4))
}

// ---- Text ------------------------------------------------------------------

// A new text object of `length` bytes, its bytes not written yet: its
// address.
pub fn text_new(length: Int) -> Int {
    let object = alloc(rt_mem_and(rt_mem_add(length, 23), -8))
    rt_mem_store64(rt_mem_add(object, 8), length)
    object
}

// `text_new(length)`, or 0 when no memory holds it (`try_alloc`).
fn text_try_new(length: Int) -> Int {
    if length < 0 {
        return 0
    }
    let object = try_alloc(rt_mem_and(rt_mem_add(length, 23), -8))
    if object != 0 {
        rt_mem_store64(rt_mem_add(object, 8), length)
    }
    object
}

// Copy `text`'s bytes into the text object at `object`, from its byte
// `at` on: the byte after them.
pub fn text_put(object: Int, at: Int, text: String) -> Int {
    let from = rt_mem_text(text)
    let length = rt_mem_load64(rt_mem_add(from, 8))
    copy_bytes(rt_mem_add(object, rt_mem_add(16, at)), rt_mem_add(from, 16), length)
    rt_mem_add(at, length)
}

// `Int.to_string`: the decimal text of `n`.
pub fn int_to_string(n: Int) -> String {
    int_text(n, false)
}

// The decimal text of the word `n`, read as unsigned when `unsigned` (a
// `U64` above `Int`'s range is a negative word).
fn int_text(n: Int, unsigned: Bool) -> String {
    if unsigned && n < 0 {
        // n / 10 and n % 10, unsigned: halve first, so it is positive.
        let tens = rt_mem_shr(n, 1) / 5
        let last = rt_mem_sub(n, rt_mem_add(rt_mem_shl(tens, 3), rt_mem_shl(tens, 1)))
        let length = digit_count(-tens) + 1
        let object = text_new(length)
        write_digits(object, length - 1, -tens)
        rt_mem_store8(rt_mem_add(object, 15 + length), 48 + last)
        return rt_mem_as_text(object)
    }
    // Digits come from the magnitude as a negative number, which every
    // `Int` has, `Int`'s most negative value included.
    let negative = n < 0
    let magnitude = if negative { n } else { -n }
    var length = digit_count(magnitude)
    if negative {
        length = length + 1
        let object = text_new(length)
        rt_mem_store8(rt_mem_add(object, 16), 45)
        write_digits(object, length, magnitude)
        return rt_mem_as_text(object)
    }
    let object = text_new(length)
    write_digits(object, length, magnitude)
    rt_mem_as_text(object)
}

// How many decimal digits `-magnitude` has, for `magnitude` <= 0: by
// comparisons, which cost far less than divisions, smallest first.
fn digit_count(magnitude: Int) -> Int {
    if magnitude > -10 {
        return 1
    }
    if magnitude > -100 {
        return 2
    }
    if magnitude > -1000 {
        return 3
    }
    if magnitude > -10000 {
        return 4
    }
    if magnitude > -100000 {
        return 5
    }
    if magnitude > -1000000 {
        return 6
    }
    if magnitude > -10000000 {
        return 7
    }
    if magnitude > -100000000 {
        return 8
    }
    if magnitude > -1000000000 {
        return 9
    }
    if magnitude > -10000000000 {
        return 10
    }
    if magnitude > -100000000000 {
        return 11
    }
    if magnitude > -1000000000000 {
        return 12
    }
    if magnitude > -10000000000000 {
        return 13
    }
    if magnitude > -100000000000000 {
        return 14
    }
    if magnitude > -1000000000000000 {
        return 15
    }
    if magnitude > -10000000000000000 {
        return 16
    }
    if magnitude > -100000000000000000 {
        return 17
    }
    if magnitude > -1000000000000000000 {
        return 18
    }
    19
}

// The length of `n`'s decimal text: an interpolation's `Int` hole, which
// `int_put` then writes in place.
pub fn int_length(n: Int) -> Int {
    if n >= 0 && n <= 4294967295 {
        return small_length(n)
    }
    if n < 0 {
        return rt_mem_add(digit_count(n), 1)
    }
    digit_count(rt_mem_sub(0, n))
}

// How many decimal digits `x` has, for `x` from 0 to 2^32 - 1: the common
// case of `int_length`, short enough for the backend to inline (it makes
// no call).
fn small_length(x: Int) -> Int {
    if x < 100000 {
        if x < 100 {
            if x < 10 {
                return 1
            }
            return 2
        }
        if x < 1000 {
            return 3
        }
        if x < 10000 {
            return 4
        }
        return 5
    }
    if x < 10000000 {
        if x < 1000000 {
            return 6
        }
        return 7
    }
    if x < 100000000 {
        return 8
    }
    if x < 1000000000 {
        return 9
    }
    10
}

// Write `n`'s decimal text, `length` bytes (`int_length(n)`), into the text
// object at `object` from its byte `at`: the byte after it.
pub fn int_put(object: Int, at: Int, n: Int, length: Int) -> Int {
    let end = rt_mem_add(at, length)
    if n >= 0 && n <= 4294967295 {
        write_small(rt_mem_add(object, rt_mem_add(16, end)), n)
        return end
    }
    if n < 0 {
        rt_mem_store8(rt_mem_add(object, rt_mem_add(16, at)), 45)
        write_digits(object, end, n)
    } else {
        write_digits(object, end, rt_mem_sub(0, n))
    }
    end
}

// Write the decimal digits of `-magnitude`, for `magnitude` <= 0, into the
// text object at `object`, ending before its byte `end`: two at a time,
// from a table of the hundred pairs. Above 2^32, by the 64-bit division;
// below, by `write_small`.
fn write_digits(object: Int, end: Int, magnitude: Int) {
    let pairs = digit_pairs()
    var at = rt_mem_add(object, rt_mem_add(16, end))
    var rest = magnitude
    while rest < -4294967295 {
        let next = rest / 100
        // The last two digits: next * 100 - rest, from 0 to 99.
        let pair = rt_mem_sub(rt_mem_mul(next, 100), rest)
        at = rt_mem_sub(at, 2)
        rt_mem_store16(at, rt_mem_load16(rt_mem_add(pairs, rt_mem_shl(pair, 1))))
        rest = next
    }
    write_small(at, rt_mem_sub(0, rest))
}

// The hundred two-digit pairs, "00" to "99", one after another.
fn digit_pairs() -> Int {
    text_data(rt_mem_text("00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"))
}

// Write the decimal digits of `x`, from 0 to 2^32 - 1, ending before the
// address `at`: four at a time while there are more than four, then two
// at a time, each pair from `digit_pairs`. A division by 10000 or 100 is
// a multiplication by its reciprocal and a shift (exact for every 32-bit
// value, and for every value below 10000), and the two pairs of a group
// of four do not wait on each other. It makes no call, so the backend
// inlines it.
fn write_small(end: Int, value: Int) {
    let pairs = digit_pairs()
    var at = end
    var x = value
    while x >= 10000 {
        let next = rt_mem_shr(rt_mem_mul(x, 3518437209), 45)
        let four = rt_mem_sub(x, rt_mem_mul(next, 10000))
        let high = rt_mem_shr(rt_mem_mul(four, 5243), 19)
        let low = rt_mem_sub(four, rt_mem_mul(high, 100))
        at = rt_mem_sub(at, 4)
        rt_mem_store16(at, rt_mem_load16(rt_mem_add(pairs, rt_mem_shl(high, 1))))
        rt_mem_store16(rt_mem_add(at, 2), rt_mem_load16(rt_mem_add(pairs, rt_mem_shl(low, 1))))
        x = next
    }
    while x >= 100 {
        let next = rt_mem_shr(rt_mem_mul(x, 1374389535), 37)
        let pair = rt_mem_sub(x, rt_mem_mul(next, 100))
        at = rt_mem_sub(at, 2)
        rt_mem_store16(at, rt_mem_load16(rt_mem_add(pairs, rt_mem_shl(pair, 1))))
        x = next
    }
    if x >= 10 {
        rt_mem_store16(rt_mem_sub(at, 2), rt_mem_load16(rt_mem_add(pairs, rt_mem_shl(x, 1))))
    } else {
        rt_mem_store8(rt_mem_sub(at, 1), rt_mem_add(48, x))
    }
}

// ---- String methods --------------------------------------------------------
//
// Text is UTF-8, and a character is a code point, as the interpreter
// counts it: every byte that is not a continuation byte (10xxxxxx) starts
// one. A function here that is a prelude intrinsic takes its arguments as
// the method does, the receiver first.

// The address of the bytes of the text object at `object`.
fn text_data(object: Int) -> Int {
    rt_mem_add(object, 16)
}

// The length in bytes of the text object at `object`.
fn text_length(object: Int) -> Int {
    rt_mem_load64(rt_mem_add(object, 8))
}

// The text of the bytes from `from` up to `to` of `text`, whose object is
// at `object`: `text` itself when they are all of it.
fn text_part(text: String, object: Int, from: Int, to: Int) -> String {
    if from == 0 && to == text_length(object) {
        return text
    }
    let part = text_new(to - from)
    copy_bytes(text_data(part), rt_mem_add(text_data(object), from), to - from)
    rt_mem_as_text(part)
}

// `String.byte_len`.
pub fn string_byte_len(text: String) -> Int {
    text_length(rt_mem_text(text))
}

// `String.len`: the number of characters.
pub fn string_len(text: String) -> Int {
    let object = rt_mem_text(text)
    chars_in(text_data(object), text_length(object))
}

// How many characters the `count` bytes at `at` hold, eight bytes at a
// time: the bytes that are not continuation bytes.
fn chars_in(at: Int, count: Int) -> Int {
    var chars = 0
    var i = 0
    // A continuation byte has bit 7 set and bit 6 clear. `marks` has a 1 in
    // the low bit of each such byte (0x0101010101010101 masks them), and the
    // sums add the eight bytes up in the lowest.
    let low_bits = 72340172838076673
    let all = -1
    let byte = 255
    while rt_mem_add(i, 8) <= count {
        let word = rt_mem_load64(rt_mem_add(at, i))
        let marks = rt_mem_and(rt_mem_and(rt_mem_shr(word, 7), rt_mem_xor(rt_mem_shr(word, 6), all)), low_bits)
        let sum2 = rt_mem_add(marks, rt_mem_shr(marks, 8))
        let sum4 = rt_mem_add(sum2, rt_mem_shr(sum2, 16))
        let sum8 = rt_mem_add(sum4, rt_mem_shr(sum4, 32))
        chars = rt_mem_add(chars, rt_mem_sub(8, rt_mem_and(sum8, byte)))
        i = rt_mem_add(i, 8)
    }
    if i < count && count >= 8 {
        // The last few bytes: the word that ends with them, shifted down
        // so the bytes already counted fall off (zeros are no marks).
        let left = rt_mem_sub(count, i)
        let word = rt_mem_shr(rt_mem_load64(rt_mem_add(at, rt_mem_sub(count, 8))), rt_mem_shl(rt_mem_sub(8, left), 3))
        let marks = rt_mem_and(rt_mem_and(rt_mem_shr(word, 7), rt_mem_xor(rt_mem_shr(word, 6), all)), low_bits)
        let sum2 = rt_mem_add(marks, rt_mem_shr(marks, 8))
        let sum4 = rt_mem_add(sum2, rt_mem_shr(sum2, 16))
        let sum8 = rt_mem_add(sum4, rt_mem_shr(sum4, 32))
        return rt_mem_add(chars, rt_mem_sub(left, rt_mem_and(sum8, byte)))
    }
    while i < count {
        if rt_mem_and(rt_mem_load8(rt_mem_add(at, i)), 192) != 128 {
            chars = rt_mem_add(chars, 1)
        }
        i = rt_mem_add(i, 1)
    }
    chars
}

// The byte offset of character `n` of the `count` bytes at `at`, which
// have at least `n` characters: `count` for the one past the last.
fn char_offset(at: Int, count: Int, n: Int) -> Int {
    var i = 0
    var seen = 0
    while seen < n && i < count {
        i = rt_mem_add(i, 1)
        while i < count && rt_mem_and(rt_mem_load8(rt_mem_add(at, i)), 192) == 128 {
            i = rt_mem_add(i, 1)
        }
        seen = rt_mem_add(seen, 1)
    }
    i
}

// The byte offset of the first occurrence of the `needle_length` bytes at
// `needle`, not before byte `from`, in the `length` bytes at `hay`, or -1.
// `needle_length` is not 0.
//
// Eight bytes at a time, it looks for the needle's first byte: a word with
// none is skipped whole, and in one with some it goes straight to the
// first, so only those bytes are compared with the needle.
fn find_bytes(hay: Int, length: Int, needle: Int, needle_length: Int, from: Int) -> Int {
    let first = rt_mem_load8(needle)
    // The first byte in all eight bytes of a word.
    let wide = rt_mem_or(first, rt_mem_shl(first, 8))
    let wider = rt_mem_or(wide, rt_mem_shl(wide, 16))
    let pattern = rt_mem_or(wider, rt_mem_shl(wider, 32))
    let ones = 72340172838076673
    let highs = -9187201950435737472
    let last = length - needle_length
    let all = -1
    // How a place that starts with the first byte is checked: a needle of
    // up to 8 bytes by two loads of `width` bytes that cover it (they may
    // overlap), a longer one by `bytes_equal`.
    let width = if needle_length > 8 {
        0
    } else if needle_length >= 4 {
        4
    } else if needle_length >= 2 {
        2
    } else {
        1
    }
    let tail_at = needle_length - width
    let head = if width == 4 { rt_mem_load32(needle) } else { rt_mem_load16(needle) }
    let tail = if width == 4 { rt_mem_load32(rt_mem_add(needle, tail_at)) } else { rt_mem_load16(rt_mem_add(needle, tail_at)) }
    var i = from
    while i <= last {
        if rt_mem_add(i, 8) <= length {
            // After the xor, a byte equal to the first byte is zero. The
            // lowest byte `zeros` marks (its top bit) is the first such;
            // higher marks may be false.
            let x = rt_mem_xor(rt_mem_load64(rt_mem_add(hay, i)), pattern)
            var zeros = rt_mem_and(rt_mem_and(rt_mem_sub(x, ones), rt_mem_xor(x, all)), highs)
            if zeros == 0 {
                i = rt_mem_add(i, 8)
                continue
            }
            // Skip to the lowest marked byte.
            if rt_mem_shl(zeros, 32) == 0 {
                zeros = rt_mem_shr(zeros, 32)
                i = rt_mem_add(i, 4)
            }
            if rt_mem_shl(zeros, 48) == 0 {
                zeros = rt_mem_shr(zeros, 16)
                i = rt_mem_add(i, 2)
            }
            if rt_mem_shl(zeros, 56) == 0 {
                i = rt_mem_add(i, 1)
            }
            if i > last {
                return -1
            }
        } else if rt_mem_load8(rt_mem_add(hay, i)) != first {
            i = rt_mem_add(i, 1)
            continue
        }
        let at = rt_mem_add(hay, i)
        if width == 4 {
            if rt_mem_load32(at) == head && rt_mem_load32(rt_mem_add(at, tail_at)) == tail {
                return i
            }
        } else if width == 2 {
            if rt_mem_load16(at) == head && rt_mem_load16(rt_mem_add(at, tail_at)) == tail {
                return i
            }
        } else if width == 1 || bytes_equal(at, needle, needle_length) {
            return i
        }
        i = rt_mem_add(i, 1)
    }
    -1
}

// `String.contains`.
pub fn string_contains(text: String, needle: String) -> Bool {
    let object = rt_mem_text(text)
    let other = rt_mem_text(needle)
    if text_length(other) == 0 {
        return true
    }
    find_bytes(text_data(object), text_length(object), text_data(other), text_length(other), 0) >= 0
}

// `String.starts_with`.
pub fn string_starts_with(text: String, prefix: String) -> Bool {
    let object = rt_mem_text(text)
    let other = rt_mem_text(prefix)
    let fits = text_length(other) <= text_length(object)
    fits && bytes_equal(text_data(object), text_data(other), text_length(other))
}

// `String.ends_with`.
pub fn string_ends_with(text: String, suffix: String) -> Bool {
    let object = rt_mem_text(text)
    let other = rt_mem_text(suffix)
    let skip = text_length(object) - text_length(other)
    skip >= 0 && bytes_equal(rt_mem_add(text_data(object), skip), text_data(other), text_length(other))
}

// `String == String`.
pub fn string_eq(a: String, b: String) -> Bool {
    let left = rt_mem_text(a)
    let right = rt_mem_text(b)
    if left == right {
        return true
    }
    let length = text_length(left)
    if length != text_length(right) {
        return false
    }
    if length <= 8 {
        // One word each: every text object has room for one after its
        // length, but the bytes past the text are not its own, so only
        // the low `length` bytes are compared.
        if length == 0 {
            return true
        }
        let differ = rt_mem_xor(rt_mem_load64(text_data(left)), rt_mem_load64(text_data(right)))
        return rt_mem_shl(differ, rt_mem_sub(64, rt_mem_shl(length, 3))) == 0
    }
    bytes_equal(text_data(left), text_data(right), length)
}

// `String.slice`: the characters from `start` up to `end`, or, when they
// are out of range, the word 0 in place of a text, for the generated code
// to panic (`P0035`).
pub fn string_slice(text: String, start: Int, end: Int) -> String {
    let object = rt_mem_text(text)
    let length = text_length(object)
    let data = text_data(object)
    let chars = chars_in(data, length)
    if start < 0 || end < start || end > chars {
        return rt_mem_as_text(0)
    }
    if chars == length {
        return text_part(text, object, start, end)
    }
    let from = char_offset(data, length, start)
    let to = rt_mem_add(from, char_offset(rt_mem_add(data, from), length - from, end - start))
    text_part(text, object, from, to)
}

// Panic (`P0035`): `start` and `end` are the report around the message.
pub fn panic_slice(start: String, end: String, text: String, from: Int, to: Int) {
    panic_message(start, end, slice_message("", text, from, to))
}

// `head`, then the message of `panic_slice`. Each `panic_*` function that
// a prelude function's call may end in has such a `*_message` function:
// the code of a function value made from that prelude function gives the
// report's message back to its caller, which names the call.
pub fn slice_message(head: String, text: String, from: Int, to: Int) -> String {
    let a = int_text(from, false)
    let b = int_text(to, false)
    let n = int_text(string_len(text), false)
    "{head}cannot slice characters {a}..{b} of a text of {n} characters"
}

// The longest text `String.repeat` builds, in bytes: 256 MiB.
fn max_repeated_bytes() -> Int {
    268435456
}

// `String.repeat`: the text `times` times over. For a negative `times`
// the word 0 in place of a text, and for a result that is too long the
// word -1, for the generated code to panic (`P0036`, `P0037`).
pub fn string_repeat(text: String, times: Int) -> String {
    if times < 0 {
        return rt_mem_as_text(0)
    }
    let object = rt_mem_text(text)
    let length = text_length(object)
    // An empty text repeats to an empty text however often.
    if length == 0 {
        return text
    }
    if times > max_repeated_bytes() / length {
        return rt_mem_as_text(-1)
    }
    if times == 1 {
        return text
    }
    let total = length * times
    let result = text_new(total)
    let data = text_data(result)
    copy_bytes(data, text_data(object), length)
    // Double what is written until it is all there.
    var done = length
    while done < total {
        let chunk = if done > total - done { total - done } else { done }
        copy_bytes(rt_mem_add(data, done), data, chunk)
        done = done + chunk
    }
    rt_mem_as_text(result)
}

// Panic (`P0036`): a negative count.
pub fn panic_repeat_negative(start: String, end: String, times: Int) {
    panic_message(start, end, repeat_negative_message("", times))
}

pub fn repeat_negative_message(head: String, times: Int) -> String {
    let n = int_text(times, false)
    "{head}cannot repeat a text {n} times"
}

// Panic (`P0037`): a result too long.
pub fn panic_repeat_long(start: String, end: String, text: String, times: Int) {
    panic_message(start, end, repeat_long_message("", text, times))
}

pub fn repeat_long_message(head: String, text: String, times: Int) -> String {
    let bytes = int_text(string_byte_len(text), false)
    let n = int_text(times, false)
    "{head}repeating a text of {bytes} bytes {n} times is too long"
}

// `String.replace`: every occurrence of `from`, left to right and without
// overlap, replaced by `to`. An empty `from` occurs nowhere. Each
// occurrence is found once: where they start is kept in a buffer of words,
// which doubles as it fills, until the result's length is known.
pub fn string_replace(text: String, from: String, to: String) -> String {
    let object = rt_mem_text(text)
    let old = rt_mem_text(from)
    let new = rt_mem_text(to)
    let length = text_length(object)
    let old_length = text_length(old)
    let new_length = text_length(new)
    if old_length == 0 {
        return text
    }
    let data = text_data(object)
    let old_data = text_data(old)
    var capacity = 16
    var positions = alloc(rt_mem_add(8, rt_mem_shl(capacity, 3)))
    var found = 0
    var at = find_bytes(data, length, old_data, old_length, 0)
    while at >= 0 {
        if found == capacity {
            let larger = alloc(rt_mem_add(8, rt_mem_shl(capacity, 4)))
            copy_bytes(rt_mem_add(larger, 8), rt_mem_add(positions, 8), rt_mem_shl(capacity, 3))
            free(positions)
            positions = larger
            capacity = rt_mem_shl(capacity, 1)
        }
        rt_mem_store64(rt_mem_add(positions, rt_mem_shl(rt_mem_add(found, 1), 3)), at)
        found = rt_mem_add(found, 1)
        at = find_bytes(data, length, old_data, old_length, rt_mem_add(at, old_length))
    }
    if found == 0 {
        free(positions)
        return text
    }
    let result = text_new(length + found * (new_length - old_length))
    let new_data = text_data(new)
    var out = text_data(result)
    var read = 0
    var k = 0
    while k < found {
        at = rt_mem_load64(rt_mem_add(positions, rt_mem_shl(rt_mem_add(k, 1), 3)))
        copy_bytes(out, rt_mem_add(data, read), rt_mem_sub(at, read))
        out = rt_mem_add(out, rt_mem_sub(at, read))
        copy_bytes(out, new_data, new_length)
        out = rt_mem_add(out, new_length)
        read = rt_mem_add(at, old_length)
        k = rt_mem_add(k, 1)
    }
    copy_bytes(out, rt_mem_add(data, read), rt_mem_sub(length, read))
    free(positions)
    rt_mem_as_text(result)
}

// The length in bytes of the whitespace character (Unicode's `White_Space`)
// that starts at byte `i` of the `length` bytes at `data`, or 0 if none does.
fn whitespace_at(data: Int, i: Int, length: Int) -> Int {
    let b0 = rt_mem_load8(rt_mem_add(data, i))
    if b0 == 32 || (b0 >= 9 && b0 <= 13) {
        return 1
    }
    if b0 < 128 {
        return 0
    }
    if b0 == 194 {
        // U+0085 and U+00A0.
        if i + 1 < length {
            let b1 = rt_mem_load8(rt_mem_add(data, i + 1))
            if b1 == 133 || b1 == 160 {
                return 2
            }
        }
        return 0
    }
    if i + 2 >= length {
        return 0
    }
    let b1 = rt_mem_load8(rt_mem_add(data, i + 1))
    let b2 = rt_mem_load8(rt_mem_add(data, i + 2))
    // U+1680.
    if b0 == 225 && b1 == 154 && b2 == 128 {
        return 3
    }
    // U+3000.
    if b0 == 227 && b1 == 128 && b2 == 128 {
        return 3
    }
    if b0 == 226 {
        // U+2000 to U+200A, U+2028, U+2029 and U+202F.
        if b1 == 128 && ((b2 <= 138 && b2 >= 128) || b2 == 168 || b2 == 169 || b2 == 175) {
            return 3
        }
        // U+205F.
        if b1 == 129 && b2 == 159 {
            return 3
        }
    }
    0
}

// The length in bytes of the whitespace character that ends before byte
// `end` of the bytes at `data`, and starts at or after byte `low`, or 0.
fn whitespace_before(data: Int, low: Int, end: Int) -> Int {
    var size = 1
    while size <= 3 {
        if end - size >= low && whitespace_at(data, end - size, end) == size {
            return size
        }
        size = size + 1
    }
    0
}

// `String.trim`: without leading and trailing whitespace.
pub fn string_trim(text: String) -> String {
    let object = rt_mem_text(text)
    let data = text_data(object)
    var from = 0
    var to = text_length(object)
    while from < to {
        let size = whitespace_at(data, from, to)
        if size == 0 {
            break
        }
        from = from + size
    }
    while to > from {
        let size = whitespace_before(data, from, to)
        if size == 0 {
            break
        }
        to = to - size
    }
    text_part(text, object, from, to)
}

// `String.parse_int`: the decimal `Int` the whole text spells, an optional
// `+` or `-` then at least one ASCII digit, or `None` when it spells none
// or one outside `Int`'s range, as the interpreter's `str::parse` decides.
pub fn string_parse_int(text: String) -> Option<Int> {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let end = text_length(object)
    var at = 0
    var negative = false
    if end > 0 {
        let sign = rt_mem_load8(data)
        if sign == 45 || sign == 43 {
            negative = sign == 45
            at = 1
        }
    }
    if at == end {
        return None
    }
    // Digits accumulate as a negative number, which every `Int` has,
    // `Int`'s most negative value included.
    var value = 0
    while at < end {
        let digit = rt_mem_load8(rt_mem_add(data, at)) - 48
        if digit < 0 || digit > 9 {
            return None
        }
        if value < -922337203685477580 || (value == -922337203685477580 && digit > 8) {
            return None
        }
        value = value * 10 - digit
        at = at + 1
    }
    if negative {
        return Some(value)
    }
    if value == -9223372036854775807 - 1 {
        return None
    }
    Some(-value)
}

// `Path.new` and `Path.from`: a `Path`, an object of a count and the one
// field, `raw`. Releasing the last reference to it releases `raw` too (the
// drop function the backend generates for `Path`).
pub fn path_new(raw: String) -> Path {
    let object = alloc(16)
    let text = rt_mem_text(raw)
    retain(text)
    rt_mem_store64(rt_mem_add(object, 8), text)
    rt_mem_as_path(object)
}

// `Path == Path`: their text is the same.
pub fn path_eq(a: Path, b: Path) -> Bool {
    let left = rt_mem_load64(rt_mem_add(rt_mem_path(a), 8))
    let right = rt_mem_load64(rt_mem_add(rt_mem_path(b), 8))
    // The texts are borrowed; the references `rt_mem_as_text` hands out
    // are released after the call.
    retain(left)
    retain(right)
    string_eq(rt_mem_as_text(left), rt_mem_as_text(right))
}

// ---- Lists -----------------------------------------------------------------
//
// A list object is `[count][length][capacity][item 0][item 1]...`: room for
// `capacity` items, the first `length` of them there, one word each. The
// generated code reads and adds items inline, and releases them, by their
// type, when the last reference to the list goes. Before it adds an item to
// a list that is shared or full, it calls `list_reserve`.

// A new, empty list object with room for `capacity` items: its address.
fn list_new(capacity: Int) -> Int {
    let object = alloc(rt_mem_add(24, rt_mem_shl(capacity, 3)))
    rt_mem_store64(rt_mem_add(object, 8), 0)
    rt_mem_store64(rt_mem_add(object, 16), capacity)
    object
}

// A list object with the items of the list at `list`, unshared (its count
// is 1) and with room for one more: `list` itself when it is that already.
// Otherwise a new one, twice as large when `list` is full. The items move
// to it from an unshared `list`, which is freed; from a shared or static
// one they are copied, each retained when `counted` (the items hold
// references), and `list` is counted once less.
pub fn list_reserve(list: Int, counted: Bool) -> Int {
    let count = rt_mem_load64(list)
    let length = rt_mem_load64(rt_mem_add(list, 8))
    let capacity = rt_mem_load64(rt_mem_add(list, 16))
    if count == 1 && length < capacity {
        return list
    }
    var larger = capacity
    if length == capacity {
        larger = rt_mem_shl(capacity, 1)
    }
    if larger < 4 {
        larger = 4
    }
    let copy = list_new(larger)
    copy_bytes(rt_mem_add(copy, 24), rt_mem_add(list, 24), rt_mem_shl(length, 3))
    rt_mem_store64(rt_mem_add(copy, 8), length)
    if count == 1 {
        free(list)
        return copy
    }
    if counted {
        var i = 0
        while i < length {
            retain(rt_mem_load64(rt_mem_add(list, rt_mem_add(24, rt_mem_shl(i, 3)))))
            i = rt_mem_add(i, 1)
        }
    }
    if count > 0 {
        rt_mem_store64(list, rt_mem_sub(count, 1))
    }
    copy
}

// Add the word `item` to the end of the list at `list`, which is unshared:
// the list's address afterwards, which moves when it grows.
fn list_add(list: Int, item: Int) -> Int {
    let target = list_reserve(list, false)
    let length = rt_mem_load64(rt_mem_add(target, 8))
    rt_mem_store64(rt_mem_add(target, rt_mem_add(24, rt_mem_shl(length, 3))), item)
    rt_mem_store64(rt_mem_add(target, 8), rt_mem_add(length, 1))
    target
}

// A text object holding the `count` bytes at `at`: its address, holding a
// reference for the caller. An empty one is the static "", and one ASCII
// byte a static one-byte text (`ascii_text`): `chars` and `split` make
// many, and these cost no allocation and no count.
fn text_of(at: Int, count: Int) -> Int {
    if count == 0 {
        return rt_mem_text("")
    }
    if count == 1 {
        let byte = rt_mem_load8(at)
        if byte < 128 {
            return ascii_text(byte)
        }
    }
    let object = text_new(count)
    copy_bytes(text_data(object), at, count)
    object
}

// The static text object of the one ASCII byte `byte`. The 128 of them
// are made on first use, in one block (global word 28), each with the
// count of a static object (-1), so nothing counts or frees them.
fn ascii_text(byte: Int) -> Int {
    rt_mem_add(ascii_table(), rt_mem_mul(byte, 24))
}

// The address of the first of the 128 static one-byte texts of
// `ascii_text`, the one of byte 0; the one of byte `b` is `24 * b` after it.
fn ascii_table() -> Int {
    var table = rt_mem_load64(global(28))
    if table == 0 {
        // 128 objects of three words: count, length 1, the byte.
        table = rt_mem_add(alloc(3080), 8)
        var i = 0
        while i < 128 {
            let object = rt_mem_add(table, rt_mem_mul(i, 24))
            rt_mem_store64(object, -1)
            rt_mem_store64(rt_mem_add(object, 8), 1)
            rt_mem_store64(rt_mem_add(object, 16), i)
            i = rt_mem_add(i, 1)
        }
        rt_mem_store64(global(28), table)
    }
    table
}

// `String.split`: the pieces between occurrences of `separator`, empty
// ones included. An empty separator occurs before and after every
// character, as Rust's `str::split` has it: "ab" splits into "", "a", "b"
// and "".
pub fn string_split(text: String, separator: String) -> List<String> {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    let other = rt_mem_text(separator)
    let other_data = text_data(other)
    let other_length = text_length(other)
    var list = list_new(4)
    if other_length == 0 {
        list = list_add(list, rt_mem_text(""))
        var i = 0
        while i < length {
            let size = sequence_length(rt_mem_load8(rt_mem_add(data, i)))
            list = list_add(list, text_of(rt_mem_add(data, i), size))
            i = rt_mem_add(i, size)
        }
        list = list_add(list, rt_mem_text(""))
        return rt_mem_as_list(list)
    }
    var at = find_bytes(data, length, other_data, other_length, 0)
    if at < 0 {
        // One piece, the whole text: the text itself.
        retain(object)
        return rt_mem_as_list(list_add(list, object))
    }
    var read = 0
    while at >= 0 {
        list = list_add(list, text_of(rt_mem_add(data, read), rt_mem_sub(at, read)))
        read = rt_mem_add(at, other_length)
        at = find_bytes(data, length, other_data, other_length, read)
    }
    list = list_add(list, text_of(rt_mem_add(data, read), rt_mem_sub(length, read)))
    rt_mem_as_list(list)
}

// `String.lines`: the lines, without their line endings, as Rust's
// `str::lines` has them. A line ends at a line feed, and a carriage return
// just before it goes too; the last line needs no ending, and an empty
// last line is no line.
pub fn string_lines(text: String) -> List<String> {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    let newline = text_data(rt_mem_text("\n"))
    var list = list_new(4)
    var start = 0
    while start < length {
        let found = find_bytes(data, length, newline, 1, start)
        var end = length
        var next = length
        if found >= 0 {
            end = found
            next = rt_mem_add(found, 1)
            if end > start && rt_mem_load8(rt_mem_add(data, rt_mem_sub(end, 1))) == 13 {
                end = rt_mem_sub(end, 1)
            }
        }
        list = list_add(list, text_of(rt_mem_add(data, start), rt_mem_sub(end, start)))
        start = next
    }
    rt_mem_as_list(list)
}

// The character of `text` that starts at its byte `at`, as a text of its
// own holding a reference for the caller: what `for c in text.chars()`
// binds, one character at a time, with no list made (`lower/lists.rs`).
// Its byte length is how far the loop moves on.
pub fn char_text(text: String, at: Int) -> Int {
    let data = rt_mem_add(text_data(rt_mem_text(text)), at)
    let lead = rt_mem_load8(data)
    if lead < 128 {
        return ascii_text(lead)
    }
    text_of(data, sequence_length(lead))
}

// `String.chars`: each character as a text of its own.
pub fn string_chars(text: String) -> List<String> {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    // Room for one item per byte, at least one per character: the items
    // go straight in, with no `list_add` growing it.
    let list = list_new(length)
    let ascii = ascii_table()
    var count = 0
    var i = 0
    while i < length {
        let lead = rt_mem_load8(rt_mem_add(data, i))
        let item = rt_mem_add(list, rt_mem_add(24, rt_mem_shl(count, 3)))
        if lead < 128 {
            // Most characters: the static text of the byte, in line.
            rt_mem_store64(item, rt_mem_add(ascii, rt_mem_mul(lead, 24)))
            i = rt_mem_add(i, 1)
        } else {
            let size = sequence_length(lead)
            rt_mem_store64(item, text_of(rt_mem_add(data, i), size))
            i = rt_mem_add(i, size)
        }
        count = rt_mem_add(count, 1)
    }
    rt_mem_store64(rt_mem_add(list, 8), count)
    rt_mem_as_list(list)
}

// `String.join`: `parts` with `separator` between each two.
pub fn string_join(separator: String, parts: List<String>) -> String {
    let list = rt_mem_list(parts)
    let count = rt_mem_load64(rt_mem_add(list, 8))
    if count == 0 {
        return ""
    }
    let items = rt_mem_add(list, 24)
    if count == 1 {
        let only = rt_mem_load64(items)
        retain(only)
        return rt_mem_as_text(only)
    }
    let other = rt_mem_text(separator)
    let other_length = text_length(other)
    var total = other_length * (count - 1)
    var i = 0
    while i < count {
        total = total + text_length(rt_mem_load64(rt_mem_add(items, rt_mem_shl(i, 3))))
        i = rt_mem_add(i, 1)
    }
    let result = text_new(total)
    var out = text_data(result)
    i = 0
    while i < count {
        if i > 0 {
            copy_bytes(out, text_data(other), other_length)
            out = rt_mem_add(out, other_length)
        }
        let part = rt_mem_load64(rt_mem_add(items, rt_mem_shl(i, 3)))
        copy_bytes(out, text_data(part), text_length(part))
        out = rt_mem_add(out, text_length(part))
        i = rt_mem_add(i, 1)
    }
    rt_mem_as_text(result)
}

// ---- Bytes -----------------------------------------------------------------
//
// A `Bytes` object is `[count][length][capacity][bytes...]`: room for
// `capacity` bytes, a multiple of 8, the first `length` of them there. It
// is a value: a method that changes one goes through `bytes_reserve`,
// which writes in place only when the object is unshared (its count is 1)
// and has room, and otherwise gives a copy of its own, so every other
// holder keeps the old bytes. Each such method takes the object's address
// and the place's reference to it, and gives back the address the place
// holds afterwards, or the word 0, changing nothing, when the call is a
// bug, for the generated code to panic.

// The longest `Bytes`, in bytes: 256 MiB, as for text (`max_repeated_bytes`).
fn max_bytes() -> Int {
    268435456
}

fn bytes_data(object: Int) -> Int {
    rt_mem_add(object, 24)
}

fn bytes_length(object: Int) -> Int {
    rt_mem_load64(rt_mem_add(object, 8))
}

// A new bytes object with room for at least `capacity` bytes, and none
// there yet: its address.
//
// The functions here that the generated code calls do checked arithmetic
// (`+`), never only `rt_mem_*` operations, so that the optimizer does not
// inline them, with `alloc`, into the program's own functions: every
// temporary inlined there takes a slot in their frames, and the stack is
// reserved for the deepest calls of the largest frame.
fn bytes_alloc(capacity: Int) -> Int {
    let room = bytes_room(capacity)
    bytes_init(alloc(24 + room), room)
}

// The room a bytes object has for `capacity` bytes: `capacity` rounded up
// to a multiple of 8.
fn bytes_room(capacity: Int) -> Int {
    rt_mem_and(capacity + 7, -8)
}

// The new object at `object`, with `room` for bytes and none there yet,
// made a bytes object: its address.
fn bytes_init(object: Int, room: Int) -> Int {
    rt_mem_store64(rt_mem_add(object, 8), 0)
    rt_mem_store64(rt_mem_add(object, 16), room)
    object
}

// A new bytes object holding the `count` bytes at `from`: its address.
fn bytes_copy_of(from: Int, count: Int) -> Int {
    let object = bytes_alloc(count)
    copy_bytes(bytes_data(object), from, count)
    rt_mem_store64(rt_mem_add(object, 8), count)
    object
}

// `Bytes.new`: an empty buffer.
pub fn bytes_new() -> Bytes {
    rt_mem_as_bytes(bytes_alloc(0))
}

// `Bytes.zeroed`: `length` zero bytes; for a negative length the word 0,
// and for one past `max_bytes` the word -1, in place of a buffer, for the
// generated code to panic (`P0042`, `P0043`).
pub fn bytes_zeroed(length: Int) -> Bytes {
    if length < 0 {
        return rt_mem_as_bytes(0)
    }
    if length > max_bytes() {
        return rt_mem_as_bytes(-1)
    }
    let room = bytes_room(length)
    let size = 24 + room
    var object = 0
    if size + 8 > largest_block() {
        // A mapping of its own, fresh and so already zero: its pages are
        // touched only as they are written.
        object = try_alloc(size)
        if object == 0 {
            out_of_memory()
        }
        object = bytes_init(object, room)
    } else {
        // A block of a size class may have been used before: zero it.
        object = bytes_alloc(length)
        let data = bytes_data(object)
        var i = 0
        while i < room {
            rt_mem_store64(rt_mem_add(data, i), 0)
            i = i + 8
        }
    }
    rt_mem_store64(rt_mem_add(object, 8), length)
    rt_mem_as_bytes(object)
}

// The value of the hexadecimal digit `c`, in either case, or -1.
fn hex_value(c: Int) -> Int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    -1
}

// `Bytes.from_hex`: the bytes two hexadecimal digits each spell, or `None`.
pub fn bytes_from_hex(text: String) -> Option<Bytes> {
    let source = rt_mem_text(text)
    let length = text_length(source)
    if rt_mem_and(length, 1) != 0 {
        return None
    }
    let digits = text_data(source)
    let count = rt_mem_shr(length, 1)
    let object = bytes_alloc(count)
    let data = bytes_data(object)
    var i = 0
    while i < count {
        let high = hex_value(rt_mem_load8(rt_mem_add(digits, rt_mem_shl(i, 1))))
        let low = hex_value(rt_mem_load8(rt_mem_add(digits, rt_mem_add(rt_mem_shl(i, 1), 1))))
        if high < 0 || low < 0 {
            free(object)
            return None
        }
        rt_mem_store8(rt_mem_add(data, i), rt_mem_or(rt_mem_shl(high, 4), low))
        i = i + 1
    }
    rt_mem_store64(rt_mem_add(object, 8), count)
    Some(rt_mem_as_bytes(object))
}

// `Bytes.len`.
pub fn bytes_len(bytes: Bytes) -> Int {
    bytes_length(rt_mem_bytes(bytes))
}

// `Bytes.get`: the byte at `index` (an `Option<U8>`, which is laid out as
// an `Option<Int>` is), or `None`.
pub fn bytes_get(bytes: Bytes, index: Int) -> Option<Int> {
    let object = rt_mem_bytes(bytes)
    if index < 0 || index >= bytes_length(object) {
        return None
    }
    Some(rt_mem_load8(rt_mem_add(bytes_data(object), index)))
}

// Whether the `width` bytes at `offset` all lie inside `bytes`: the
// generated code panics when they do not, before `bytes_read`.
pub fn bytes_readable(bytes: Bytes, offset: Int, width: Int) -> Bool {
    let length = bytes_length(rt_mem_bytes(bytes))
    offset >= 0 && offset <= length && length - offset >= width
}

// The unsigned integer the `width` bytes at `offset` store, most
// significant byte first when `big`: `Bytes.at` and the endian reads. The
// generated code has panicked already when `bytes_readable` said the
// bytes do not all lie inside `bytes`; this checks again, and gives 0
// without reading, so that no call of it reads past the buffer.
pub fn bytes_read(bytes: Bytes, offset: Int, width: Int, big: Bool) -> Int {
    if !bytes_readable(bytes, offset, width) {
        return 0
    }
    let at = rt_mem_add(bytes_data(rt_mem_bytes(bytes)), offset)
    var n = 0
    var i = 0
    while i < width {
        let k = if big { i } else { rt_mem_sub(rt_mem_sub(width, 1), i) }
        n = rt_mem_or(rt_mem_shl(n, 8), rt_mem_load8(rt_mem_add(at, k)))
        i = i + 1
    }
    n
}

// `bytes_read` for `Secret<Bytes>`'s `at` and endian reads: each byte it
// reads is marked secret, so the native backend refuses to build code in
// which a branch or an address depends on what it gives. It repeats
// `bytes_read`'s body rather than share it: the backend's guard follows
// a mark through a function whatever its arguments, so a shared body
// with a flag for the mark would make every public read secret too.
pub fn bytes_read_secret(bytes: Bytes, offset: Int, width: Int, big: Bool) -> Int {
    if !bytes_readable(bytes, offset, width) {
        return 0
    }
    let at = rt_mem_add(bytes_data(rt_mem_bytes(bytes)), offset)
    var n = 0
    var i = 0
    while i < width {
        let k = if big { i } else { rt_mem_sub(rt_mem_sub(width, 1), i) }
        n = rt_mem_or(rt_mem_shl(n, 8), rt_mem_conceal(rt_mem_load8(rt_mem_add(at, k))))
        i = i + 1
    }
    n
}

// Panic (`P0002`): `index` out of bounds in `Bytes.at` or `Bytes.set`.
pub fn panic_bytes_index(start: String, end: String, object: Int, index: Int) {
    panic_message(start, end, bytes_index_message("", object, index))
}

pub fn bytes_index_message(head: String, object: Int, index: Int) -> String {
    let i = int_text(index, false)
    let n = int_text(bytes_length(object), false)
    "{head}index {i} is out of bounds for bytes of length {n}"
}

// Panic (`P0042`): an endian read past the end.
pub fn panic_bytes_read(start: String, end: String, object: Int, offset: Int, width: Int) {
    panic_message(start, end, bytes_read_message("", object, offset, width))
}

pub fn bytes_read_message(head: String, object: Int, offset: Int, width: Int) -> String {
    let w = int_text(width, false)
    let o = int_text(offset, false)
    let n = int_text(bytes_length(object), false)
    "{head}cannot read {w} bytes at offset {o} of a buffer of {n} bytes"
}

// `Bytes.slice`: the bytes from `start` up to `end`, or, when they are out
// of range, the word 0 in place of a buffer, for the generated code to
// panic (`P0042`).
pub fn bytes_slice(bytes: Bytes, start: Int, end: Int) -> Bytes {
    let object = rt_mem_bytes(bytes)
    if start < 0 || end < start || end > bytes_length(object) {
        return rt_mem_as_bytes(0)
    }
    rt_mem_as_bytes(bytes_copy_of(rt_mem_add(bytes_data(object), start), end - start))
}

// Panic (`P0042`): a slice out of range.
pub fn panic_bytes_slice(start: String, end: String, object: Int, from: Int, to: Int) {
    panic_message(start, end, bytes_slice_message("", object, from, to))
}

pub fn bytes_slice_message(head: String, object: Int, from: Int, to: Int) -> String {
    let a = int_text(from, false)
    let b = int_text(to, false)
    let n = int_text(bytes_length(object), false)
    "{head}cannot slice bytes {a}..{b} of a buffer of {n} bytes"
}

// Panic (`P0042`): `Bytes.zeroed` of a negative length.
pub fn panic_bytes_negative(start: String, end: String, length: Int) {
    panic_message(start, end, bytes_negative_message("", length))
}

pub fn bytes_negative_message(head: String, length: Int) -> String {
    let n = int_text(length, false)
    "{head}cannot make a buffer of {n} bytes"
}

// Panic (`P0043`): `Bytes.zeroed` of a length past `max_bytes`.
pub fn panic_bytes_long(start: String, end: String, length: Int) {
    panic_message(start, end, bytes_long_message("", length))
}

pub fn bytes_long_message(head: String, length: Int) -> String {
    let n = int_text(length, false)
    "{head}a buffer of {n} bytes is too long"
}

// Panic (`P0043`): adding `extra` bytes to the buffer at `object` would
// take it past `max_bytes`.
pub fn panic_bytes_grow(start: String, end: String, object: Int, extra: Int) {
    panic_message(start, end, bytes_grow_message("", object, extra))
}

pub fn bytes_grow_message(head: String, object: Int, extra: Int) -> String {
    bytes_long_message(head, rt_mem_add(bytes_length(object), extra))
}

// Panic (`P0043`): appending the buffer at `other` would take the one at
// `object` past `max_bytes`.
pub fn panic_bytes_append(start: String, end: String, object: Int, other: Int) {
    panic_message(start, end, bytes_append_message("", object, other))
}

pub fn bytes_append_message(head: String, object: Int, other: Int) -> String {
    bytes_grow_message(head, object, bytes_length(other))
}

// `Bytes.to_hex`: two lower-case hexadecimal digits a byte.
pub fn bytes_to_hex(bytes: Bytes) -> String {
    let object = rt_mem_bytes(bytes)
    let length = bytes_length(object)
    let out = text_new(length * 2)
    put_hex(text_data(out), bytes_data(object), length)
    rt_mem_as_text(out)
}

// Write the `length` bytes at `data` as two lower-case hexadecimal digits
// each, from `to` on.
fn put_hex(to: Int, data: Int, length: Int) {
    var i = 0
    while i < length {
        let b = rt_mem_load8(rt_mem_add(data, i))
        let at = rt_mem_add(to, rt_mem_shl(i, 1))
        rt_mem_store8(at, hex_digit(rt_mem_shr(b, 4)))
        rt_mem_store8(rt_mem_add(at, 1), hex_digit(rt_mem_and(b, 15)))
        i = rt_mem_add(i, 1)
    }
}

// `dbg` of a `Bytes`: `Bytes(` and its hexadecimal digits, then `)`.
pub fn debug_bytes(bytes: Bytes) -> String {
    let object = rt_mem_bytes(bytes)
    let length = bytes_length(object)
    let out = text_new(length * 2 + 7)
    let at = text_put(out, 0, "Bytes(")
    let digits = text_data(out)
    put_hex(rt_mem_add(digits, at), bytes_data(object), length)
    rt_mem_store8(rt_mem_add(digits, at + length * 2), 41)
    rt_mem_as_text(out)
}

// `Bytes.to_text`: the text the bytes encode in UTF-8, or `None`.
pub fn bytes_to_text(bytes: Bytes) -> Option<String> {
    let object = rt_mem_bytes(bytes)
    let length = bytes_length(object)
    if !utf8_valid(bytes_data(object), length) {
        return None
    }
    Some(text_from(bytes_data(object), length))
}

// `String.to_bytes`: the text's UTF-8 encoding.
pub fn string_to_bytes(text: String) -> Bytes {
    let object = rt_mem_text(text)
    rt_mem_as_bytes(bytes_copy_of(text_data(object), text_length(object)))
}

// `Bytes.eq`: the same bytes.
pub fn bytes_eq(a: Bytes, b: Bytes) -> Bool {
    let left = rt_mem_bytes(a)
    let right = rt_mem_bytes(b)
    let length = bytes_length(left)
    length == bytes_length(right) && bytes_equal(bytes_data(left), bytes_data(right), length)
}

// `Secret<Bytes>`'s `constant_time_eq` and `constant_time_eq_secret`, on
// the bytes inside: whether they are equal, every byte compared whatever
// the first difference, in time that depends on their lengths only.
pub fn bytes_constant_time_eq(a: Bytes, b: Bytes) -> Bool {
    let left = rt_mem_bytes(a)
    let right = rt_mem_bytes(b)
    equal_constant(bytes_data(left), bytes_length(left), bytes_data(right), bytes_length(right))
}

// `ct_select` between two `Secret<Bytes>`: a new buffer of `a`'s bytes
// when `pick` is 1 and `b`'s when it is 0, each byte taken through a mask
// from both; or, when their lengths differ, the word 0 in place of a
// buffer, for the generated code to panic (`P0042`).
pub fn bytes_select(pick: Int, a: Bytes, b: Bytes) -> Bytes {
    let left = rt_mem_bytes(a)
    let right = rt_mem_bytes(b)
    let length = bytes_length(left)
    if length != bytes_length(right) {
        return rt_mem_as_bytes(0)
    }
    let mask = rt_mem_sub(0, pick)
    let object = bytes_alloc(length)
    var i = 0
    while i < length {
        let x = rt_mem_conceal(rt_mem_load8(rt_mem_add(bytes_data(left), i)))
        let y = rt_mem_conceal(rt_mem_load8(rt_mem_add(bytes_data(right), i)))
        let byte = rt_mem_xor(y, rt_mem_and(rt_mem_xor(x, y), mask))
        rt_mem_store8(rt_mem_add(bytes_data(object), i), byte)
        i = i + 1
    }
    rt_mem_store64(rt_mem_add(object, 8), length)
    rt_mem_as_bytes(object)
}

// Panic (`P0042`): `ct_select` between buffers of different lengths.
pub fn panic_bytes_select(start: String, end: String, pick: Int, a: Bytes, b: Bytes) {
    panic_message(start, end, bytes_select_message("", pick, a, b))
}

pub fn bytes_select_message(head: String, pick: Int, a: Bytes, b: Bytes) -> String {
    let m = int_text(bytes_length(rt_mem_bytes(a)), false)
    let n = int_text(bytes_length(rt_mem_bytes(b)), false)
    "{head}cannot pick between buffers of {m} and {n} bytes without revealing which"
}

// `Bytes.hash`: the 64-bit FNV-1a hash of the bytes.
pub fn bytes_hash(bytes: Bytes) -> Int {
    let object = rt_mem_bytes(bytes)
    let length = bytes_length(object)
    let data = bytes_data(object)
    // FNV-1a's offset basis, 0xcbf29ce484222325, as a signed word.
    var h = -3750763034362895579
    var i = 0
    while i < length {
        h = rt_mem_mul(rt_mem_xor(h, rt_mem_load8(rt_mem_add(data, i))), 1099511628211)
        i = i + 1
    }
    h
}

// The bytes object at `object`, which a place holds a reference to,
// unshared and with room for `extra` more bytes: `object` itself when it is
// that already. Otherwise a new one, at least twice as large when `object`
// has no room. The bytes move to it from an unshared `object`, which is
// freed; from a shared or static one they are copied, and `object` is
// counted once less. The word 0, changing nothing, when the buffer would
// grow past `max_bytes`.
fn bytes_reserve(object: Int, extra: Int) -> Int {
    let count = rt_mem_load64(object)
    let length = bytes_length(object)
    let capacity = rt_mem_load64(rt_mem_add(object, 16))
    let needed = length + extra
    if needed > max_bytes() {
        return 0
    }
    if count == 1 && needed <= capacity {
        return object
    }
    var larger = capacity
    if needed > capacity {
        larger = rt_mem_shl(capacity, 1)
        if larger < needed {
            larger = needed
        }
        if larger < 8 {
            larger = 8
        }
    }
    let copy = bytes_alloc(larger)
    copy_bytes(bytes_data(copy), bytes_data(object), length)
    rt_mem_store64(rt_mem_add(copy, 8), length)
    if count == 1 {
        free(object)
    } else if count > 0 {
        rt_mem_store64(object, rt_mem_sub(count, 1))
    }
    copy
}

// `Bytes.push`: the byte `byte` added at the end of the buffer at `object`.
pub fn bytes_push(object: Int, byte: Int) -> Int {
    bytes_push_int(object, byte, 1, false)
}

// `Bytes.append`: the bytes of the buffer at `other` added at the end of
// the one at `object`. `other` may be `object` itself, shared, so it is
// copied from after the reserve, which leaves it in place.
pub fn bytes_append(object: Int, other: Int) -> Int {
    let extra = bytes_length(other)
    let target = bytes_reserve(object, extra)
    if target == 0 {
        return 0
    }
    let length = bytes_length(target)
    copy_bytes(rt_mem_add(bytes_data(target), length), bytes_data(other), extra)
    rt_mem_store64(rt_mem_add(target, 8), length + extra)
    target
}

// `Bytes.set`: the byte at `index` of the buffer at `object` replaced by
// `byte`; the word 0 when `index` is out of bounds (`P0002`).
pub fn bytes_set(object: Int, index: Int, byte: Int) -> Int {
    if index < 0 || index >= bytes_length(object) {
        return 0
    }
    let target = bytes_reserve(object, 0)
    rt_mem_store8(rt_mem_add(bytes_data(target), index), byte)
    target
}

// The low `width` bytes of `value` added at the end of the buffer at
// `object`, most significant first when `big`.
fn bytes_push_int(object: Int, value: Int, width: Int, big: Bool) -> Int {
    let target = bytes_reserve(object, width)
    if target == 0 {
        return 0
    }
    let length = bytes_length(target)
    let at = rt_mem_add(bytes_data(target), length)
    var i = 0
    while i < width {
        let k = if big { rt_mem_sub(rt_mem_sub(width, 1), i) } else { i }
        rt_mem_store8(rt_mem_add(at, k), rt_mem_shr(value, rt_mem_shl(i, 3)))
        i = i + 1
    }
    rt_mem_store64(rt_mem_add(target, 8), rt_mem_add(length, width))
    target
}

pub fn bytes_push_u16_be(object: Int, value: Int) -> Int {
    bytes_push_int(object, value, 2, true)
}

pub fn bytes_push_u16_le(object: Int, value: Int) -> Int {
    bytes_push_int(object, value, 2, false)
}

pub fn bytes_push_u32_be(object: Int, value: Int) -> Int {
    bytes_push_int(object, value, 4, true)
}

pub fn bytes_push_u32_le(object: Int, value: Int) -> Int {
    bytes_push_int(object, value, 4, false)
}

pub fn bytes_push_u64_be(object: Int, value: Int) -> Int {
    bytes_push_int(object, value, 8, true)
}

pub fn bytes_push_u64_le(object: Int, value: Int) -> Int {
    bytes_push_int(object, value, 8, false)
}

// ---- Lower case ------------------------------------------------------------
//
// `String.to_lowercase` maps each character on its own to its Unicode
// lower-case form, so it needs no context: U+0130 (capital I with dot) is
// "i" and U+0307, and every other character that has a lower case has one
// character. The table lists the characters that change, as records of 13
// hexadecimal digits in order: the first character (5 digits), how many
// (2), the step between them (1) and the distance to their lower case, plus
// 0x40000 (5). It is generated from the `char::to_lowercase` of the Rust in
// `rust-toolchain.toml`, and a test (`native_text.rs`) checks it against
// that for every character; a Rust upgrade with a Unicode update fails it.

fn lowercase_table() -> String {
    ""
}

// The number given by the `digits` hexadecimal digits at `at`.
fn hex_at(at: Int, digits: Int) -> Int {
    var value = 0
    var i = 0
    while i < digits {
        let b = rt_mem_load8(rt_mem_add(at, i))
        let digit = if b <= 57 { b - 48 } else { b - 87 }
        value = rt_mem_or(rt_mem_shl(value, 4), digit)
        i = rt_mem_add(i, 1)
    }
    value
}

// The lower case of the character `cp`, other than U+0130.
fn lower_of(cp: Int) -> Int {
    if cp < 128 {
        if cp >= 65 && cp <= 90 {
            return cp + 32
        }
        return cp
    }
    let object = rt_mem_text(lowercase_table())
    let data = text_data(object)
    // How many records start at or before `cp`.
    var low = 0
    var high = text_length(object) / 13
    while low < high {
        let middle = (low + high) / 2
        if hex_at(rt_mem_add(data, middle * 13), 5) <= cp {
            low = middle + 1
        } else {
            high = middle
        }
    }
    if low == 0 {
        return cp
    }
    let record = rt_mem_add(data, (low - 1) * 13)
    let offset = cp - hex_at(record, 5)
    let step = hex_at(rt_mem_add(record, 7), 1)
    if offset % step == 0 && offset / step < hex_at(rt_mem_add(record, 5), 2) {
        return cp + hex_at(rt_mem_add(record, 8), 5) - 262144
    }
    cp
}

// The length in bytes of the UTF-8 sequence that starts with `lead`.
fn sequence_length(lead: Int) -> Int {
    if lead < 128 {
        return 1
    }
    if lead < 224 {
        return 2
    }
    if lead < 240 {
        return 3
    }
    4
}

// The character whose UTF-8 sequence starts at `at`.
fn decode_at(at: Int) -> Int {
    let lead = rt_mem_load8(at)
    let size = sequence_length(lead)
    if size == 1 {
        return lead
    }
    var cp = rt_mem_and(lead, rt_mem_shr(127, size))
    var i = 1
    while i < size {
        let next = rt_mem_and(rt_mem_load8(rt_mem_add(at, i)), 63)
        cp = rt_mem_or(rt_mem_shl(cp, 6), next)
        i = rt_mem_add(i, 1)
    }
    cp
}

// The length in bytes of the UTF-8 sequence of the character `cp`.
fn encoded_length(cp: Int) -> Int {
    if cp < 128 {
        return 1
    }
    if cp < 2048 {
        return 2
    }
    if cp < 65536 {
        return 3
    }
    4
}

// Write the UTF-8 sequence of `cp` at `at`: its length.
fn encode_at(at: Int, cp: Int) -> Int {
    let size = encoded_length(cp)
    if size == 1 {
        rt_mem_store8(at, cp)
        return 1
    }
    // The lead byte holds the top bits after the marker 11..0, and each
    // continuation byte six bits after 10.
    var i = size - 1
    var rest = cp
    while i > 0 {
        rt_mem_store8(rt_mem_add(at, i), rt_mem_or(128, rt_mem_and(rest, 63)))
        rest = rt_mem_shr(rest, 6)
        i = i - 1
    }
    let marker = rt_mem_and(rt_mem_shl(255, 8 - size), 255)
    rt_mem_store8(at, rt_mem_or(marker, rest))
    size
}

// `String.to_lowercase`.
pub fn string_to_lowercase(text: String) -> String {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    var size = 0
    var changed = false
    var i = 0
    while i < length {
        let at = rt_mem_add(data, i)
        let cp = decode_at(at)
        let step = sequence_length(rt_mem_load8(at))
        if cp == 304 {
            size = size + 3
            changed = true
        } else {
            let lower = lower_of(cp)
            changed = changed || lower != cp
            size = size + encoded_length(lower)
        }
        i = i + step
    }
    if !changed {
        return text
    }
    let result = text_new(size)
    var out = text_data(result)
    i = 0
    while i < length {
        let at = rt_mem_add(data, i)
        let cp = decode_at(at)
        if cp == 304 {
            out = rt_mem_add(out, encode_at(out, 105))
            out = rt_mem_add(out, encode_at(out, 775))
        } else {
            out = rt_mem_add(out, encode_at(out, lower_of(cp)))
        }
        i = i + sequence_length(rt_mem_load8(at))
    }
    rt_mem_as_text(result)
}

// ---- Panics ----------------------------------------------------------------
//
// A panic writes its report to stderr as the interpreter's `oskac run`
// does, `path:line:col: error[P....]: message (bytes a..b)`, and exits
// with 101. The generated code resolves the location at compile time, so
// a report is static text with the values in its message filled in.

// Where a panic's report goes: stderr, or in a test executable stdout,
// which only the report is written to, for `oskac` to read it back.
fn report_fd() -> Int {
    if testing() {
        return 1
    }
    2
}

// Panic with the whole report `report`.
pub fn panic(report: String) {
    let _ = write_text(report_fd(), report)
    panic_end()
}

// ---- The call stack --------------------------------------------------------
//
// A panic's report lists the calls that led to it. The generated code
// gives each call of the program's functions a record, the static text of
// its frame (the function it is made from and its span, as the report
// shows it), stored at the call stack's slot for its depth as the call
// starts (`rt_mem_depth`, after it is counted). Every slot from the
// current depth up to the one the program started at is a running call,
// innermost first; the one above it is never written, so it is 0. The
// innermost frame, the one the panic happened in, is the end of the
// report's static text.
//
// Word 50 holds the call stack's address. Its words, by index:
//
//   0       the text that ends a report, after the frames;
//   1, 2    the texts before and after the count of the frames left out;
//   3       the most records a report lists;
//   4 to 6  room for the digits of that count, so nothing is allocated;
//   7 on    the records, by depth.

// Map the call stack for calls that nest up to `depth` deep, with the
// texts a report's frames end with (`end`, `more_before`, `more_after`)
// and the most records it lists, `most`.
pub fn frames_init(depth: Int, end: String, more_before: String, more_after: String, most: Int) {
    let flags = rt_mem_or(private_anonymous(), no_reserve())
    let stack = map(0, rt_mem_shl(depth + 8, 3), 3, flags)
    rt_mem_store64(stack, rt_mem_text(end))
    rt_mem_store64(rt_mem_add(stack, 8), rt_mem_text(more_before))
    rt_mem_store64(rt_mem_add(stack, 16), rt_mem_text(more_after))
    rt_mem_store64(rt_mem_add(stack, 24), most)
    rt_mem_store64(global(50), stack)
}

// The address of word `index` of the call stack.
fn frames_word(index: Int) -> Int {
    rt_mem_add(rt_mem_load64(global(50)), rt_mem_shl(index, 3))
}

// End a panic's report: the frames of the running calls, as many as it
// lists and a count of the rest, then the end; and exit with 101.
fn panic_end() {
    if rt_mem_load64(global(50)) != 0 {
        let fd = report_fd()
        write_frames(fd)
        let _ = write_text(fd, rt_mem_as_text(rt_mem_load64(frames_word(0))))
    }
    exit(101)
}

// Write the frames of the running calls to `fd`, as many as a report
// lists, then a count of the rest; the call stack is mapped.
fn write_frames(fd: Int) {
    let most = rt_mem_load64(frames_word(3))
    var at = rt_mem_depth()
    var listed = 0
    var left = 0
    var record = rt_mem_load64(frames_word(at + 7))
    while record != 0 {
        if listed < most {
            let _ = write_text(fd, rt_mem_as_text(record))
            listed = listed + 1
        } else {
            left = left + 1
        }
        at = at + 1
        record = rt_mem_load64(frames_word(at + 7))
    }
    if left > 0 {
        let _ = write_text(fd, rt_mem_as_text(rt_mem_load64(frames_word(1))))
        let _ = write_count(fd, left)
        let _ = write_text(fd, rt_mem_as_text(rt_mem_load64(frames_word(2))))
    }
}

// End a report whose static text names its one frame, and exit with 101:
// the memory limit's, which no call can be blamed for.
fn panic_end_alone() {
    if rt_mem_load64(global(50)) != 0 {
        let _ = write_text(report_fd(), rt_mem_as_text(rt_mem_load64(frames_word(0))))
    }
    exit(101)
}

// Write `n`, positive, in decimal to `fd`, through the call stack's room
// for digits, so that nothing is allocated.
fn write_count(fd: Int, n: Int) -> Int {
    let room = frames_word(4)
    var digits = 0
    var m = n
    while m > 0 {
        digits = digits + 1
        m = m / 10
    }
    var i = digits
    m = n
    while i > 0 {
        i = i - 1
        rt_mem_store8(rt_mem_add(room, i), 48 + m - (m / 10) * 10)
        m = m / 10
    }
    write_all(fd, room, digits)
}

// Panic with the report `start`, the integer `a`, then `end`. An integer
// is read as unsigned when `unsigned`.
pub fn panic_unary(start: String, a: Int, end: String, unsigned: Bool) {
    panic(unary_message(start, a, end, unsigned))
}

pub fn unary_message(start: String, a: Int, end: String, unsigned: Bool) -> String {
    let n = int_text(a, unsigned)
    "{start}{n}{end}"
}

// Panic with the report `start`, the integer `a`, `mid`, the integer `b`,
// then `end`.
pub fn panic_binary(start: String, a: Int, mid: String, b: Int, end: String, unsigned: Bool) {
    panic(binary_message(start, a, mid, b, end, unsigned))
}

pub fn binary_message(start: String, a: Int, mid: String, b: Int, end: String, unsigned: Bool) -> String {
    let m = int_text(a, unsigned)
    let n = int_text(b, unsigned)
    "{start}{m}{mid}{n}{end}"
}

// Panic with the report `start`, the text `message`, then `end`: for a
// message only known at run time, such as the `requires` clause a call
// through a function value broke.
pub fn panic_message(start: String, end: String, message: String) {
    let _ = write_text(report_fd(), start)
    let _ = write_text(report_fd(), message)
    let _ = write_text(report_fd(), end)
    panic_end()
}

pub fn message_message(head: String, message: String) -> String {
    "{head}{message}"
}

// ---- The stack -------------------------------------------------------------

// A new stack of `size` bytes, a multiple of 65536, with a guard region
// below it that no access may touch: its top. The generated code counts
// calls, so recursion panics (`P0021`) before it reaches the guard.
pub fn stack_new(size: Int) -> Int {
    let guard = 1048576
    let flags = rt_mem_or(private_anonymous(), no_reserve())
    let base = map(0, guard + size, 0, flags)
    // Over the guard's top, readable and writable, at a fixed address.
    let stack = map(rt_mem_add(base, guard), size, 3, rt_mem_or(flags, 16))
    rt_mem_add(stack, size)
}

// ---- Start-up and exit -----------------------------------------------------
//
// The native backend generates the entry point, `_start`. It gives
// `process_init` the program's argument count and argument vector, as
// the operating system started the process with them, and the address
// of `on_fault`'s code, calls `main` with its
// capabilities and then, if `main` returned `Err(e)`, calls `main_failed`
// with `e`'s `Display` text. Otherwise it calls `exit(0)`.

// Remember the program's arguments and environment: `argv` points at
// `argc` argument pointers and a null, then the envp pointers and a
// null. Ignore SIGPIPE, as
// Rust's runtime does for the interpreter: a write to a pipe whose reader
// has gone fails with EPIPE instead of killing the process. On stdout
// that ends the program quietly with 0 (`write_stdout`); elsewhere it is
// an `IoError` the program sees ("broken pipe"). And make
// `on_fault`, the code at `handler`, the handler of every fault signal.
pub fn process_init(argc: Int, argv: Int, handler: Int) {
    if on_windows() {
        win_process_init(handler)
        return
    }
    // `SIG_IGN` (1), with no flags.
    set_action(sigpipe(), 1, 0)
    handle_faults(handler)
    rt_mem_store64(global(10), argc)
    rt_mem_store64(global(11), argv)
    rt_mem_store64(global(12), rt_mem_add(argv, rt_mem_shl(argc + 1, 3)))
    // `std::env::args`, which the interpreter's `oskac` reads them with,
    // panics (exit 101) at the first argument that is not UTF-8.
    var i = 0
    while i < argc {
        if !cstr_valid(rt_mem_load64(rt_mem_add(argv, rt_mem_shl(i, 3)))) {
            let _ = write_text(report_fd(), "error: a command-line argument is not valid UTF-8\n")
            exit(101)
        }
        i = i + 1
    }
}

// ---- Faults ----------------------------------------------------------------
//
// A fault signal (SIGILL, SIGTRAP, SIGABRT, SIGBUS, SIGFPE, SIGSEGV) means
// a bug in the native backend: no program is meant to raise one. It would
// kill the process with what standard output still holds unwritten, just
// when that output is needed to find the bug. So `on_fault` handles them:
// it writes the buffer and a report naming the signal, then lets the
// signal kill the process as it would have, so the exit status (and
// `oskac`'s `E0392`) is the same. It runs on a stack of its own, so a
// fault from overflowing the program's stack is handled too.

// Signal numbers, the same on every Unix Oska targets but `SIGBUS`'s,
// which is the platform's.
fn sigill() -> Int {
    4
}

fn sigtrap() -> Int {
    5
}

fn sigabrt() -> Int {
    6
}

fn sigbus() -> Int {
    rt_mem_platform().sigbus
}

fn sigfpe() -> Int {
    8
}

fn sigsegv() -> Int {
    11
}

fn sigpipe() -> Int {
    13
}

// The signals `on_fault` handles.
fn fault_signals() -> List<Int> {
    [sigill(), sigtrap(), sigabrt(), sigbus(), sigfpe(), sigsegv()]
}

// Make the code at `handler` (or `SIG_IGN`, 1) the action of `signal`,
// with the flags `flags`, through a `struct sigaction` laid out as the
// platform's table says: every field zero but the handler and the flags.
fn set_action(signal: Int, handler: Int, flags: Int) {
    let platform = rt_mem_platform()
    let object = alloc(rt_mem_add(platform.sigaction_bytes, 8))
    let action = rt_mem_add(object, 8)
    var at = 0
    while at < platform.sigaction_bytes {
        rt_mem_store64(rt_mem_add(action, at), 0)
        at = at + 8
    }
    rt_mem_store64(action, handler)
    rt_mem_store32(rt_mem_add(action, platform.sigaction_flags), flags)
    let _ = rt_sys_sigaction(signal, action)
    free(object)
}

// Make the code at `handler`, `on_fault`, the handler of every fault
// signal, on a stack of its own. The table's flags for it: the handler
// runs on the alternate stack; the default action is restored as it
// starts, so a fault within it kills the process; the signal is not
// blocked while it runs, so it can raise it again; and, on Linux, a
// restorer is given, without which x86_64 will not run a handler. Since
// `on_fault` never returns, the restorer, the address it would return
// to, is never used: 0.
fn handle_faults(handler: Int) {
    // stack_t, 24 bytes: the stack's lowest address at 0, and its size and
    // its flags, 0, in the words the table says.
    let size = 65536
    let platform = rt_mem_platform()
    let object = alloc(32)
    let stack = rt_mem_add(object, 8)
    rt_mem_store64(stack, map(0, size, 3, private_anonymous()))
    rt_mem_store64(rt_mem_add(stack, platform.ss_flags_at), 0)
    rt_mem_store64(rt_mem_add(stack, platform.ss_size_at), size)
    let _ = rt_sys_sigaltstack(stack, 0)
    free(object)
    rt_mem_store64(global(30), default_action())
    for signal in fault_signals() {
        set_action(signal, handler, rt_mem_platform().sa_fault_flags)
    }
}

// A `struct sigaction`, laid out as the platform's table says, of the
// default action (`SIG_DFL`, 0) with no flags, which is never freed: what
// `on_fault` restores without allocating.
fn default_action() -> Int {
    let platform = rt_mem_platform()
    let action = rt_mem_add(alloc(rt_mem_add(platform.sigaction_bytes, 8)), 8)
    var at = 0
    while at < platform.sigaction_bytes {
        rt_mem_store64(rt_mem_add(action, at), 0)
        at = at + 8
    }
    action
}

// The handler of the fault signal `signal`, which the kernel calls on the
// stack `handle_faults` gave it. It allocates nothing, since the fault may
// have struck inside the allocator: it writes what standard output holds
// (a write that fails is ignored, a closed pipe included, so the signal
// still decides the exit status) and the static report, restores the
// signal's default action, then raises the signal again. `SA_RESETHAND`
// restored it already on Linux, but macOS ignores that flag for SIGILL and
// SIGTRAP, which would run this handler again for ever.
pub fn on_fault(signal: Int) {
    let used = rt_mem_load64(global(14))
    if used > 0 {
        rt_mem_store64(global(14), 0)
        let _ = write_all(1, rt_mem_load64(global(13)), used)
    }
    let _ = write_text(2, "error: the native program faulted with signal ")
    let _ = write_signal_number(signal)
    let _ = write_text(2, fault_name(signal))
    let _ = rt_sys_sigaction(signal, rt_mem_load64(global(30)))
    let _ = rt_sys_kill(rt_sys_getpid(), signal)
    let _ = rt_sys_exit(128 + signal)
}

// Write the number of the fault signal `signal`, from 1 to 99, to stderr
// in decimal, through the runtime's writable word 29, so that nothing is
// allocated.
fn write_signal_number(signal: Int) -> Int {
    let at = global(29)
    if signal < 10 {
        rt_mem_store8(at, 48 + signal)
        return write_all(2, at, 1)
    }
    let tens = signal / 10
    rt_mem_store8(at, 48 + tens)
    rt_mem_store8(rt_mem_add(at, 1), 48 + signal - tens * 10)
    write_all(2, at, 2)
}

// The end of the report of the fault signal `signal`, after its number:
// static text, so writing it allocates nothing.
fn fault_name(signal: Int) -> String {
    if signal == sigill() {
        return " (SIGILL)\n"
    }
    if signal == sigtrap() {
        return " (SIGTRAP)\n"
    }
    if signal == sigabrt() {
        return " (SIGABRT)\n"
    }
    if signal == sigbus() {
        return " (SIGBUS)\n"
    }
    if signal == sigfpe() {
        return " (SIGFPE)\n"
    }
    " (SIGSEGV)\n"
}

// Whether the C string at `at` is well-formed UTF-8.
fn cstr_valid(at: Int) -> Bool {
    var length = 0
    while rt_mem_load8(rt_mem_add(at, length)) != 0 {
        length = length + 1
    }
    utf8_valid(at, length)
}

// Ends the process with `status`, after writing what standard output
// still holds. A write of it that fails (other than into a closed pipe,
// which ends the process quietly with 0) is reported as the interpreter's
// unbuffered write would have been: the `IoError`'s message on stderr,
// and the process ends with 1 rather than 0.
pub fn exit(status: Int) {
    var code = status
    let flushed = flush_stdout()
    if flushed < 0 {
        let _ = print_error_line(os_error(-flushed))
        if status == 0 {
            code = 1
        }
    }
    if on_windows() {
        let _ = rt_sys_exit_process(code)
    }
    let _ = rt_sys_exit(code)
}

// `main` returned an error whose text is `message`: it goes to stderr on a
// line of its own, and the process exits with 1, as the interpreter does.
pub fn main_failed(message: String) {
    let _ = print_error_line(message)
    exit(1)
}

// ---- Standard output and error ---------------------------------------------
//
// Standard output is buffered: a line is appended to a 65536-byte buffer,
// which is written when it is full, when anything is written to stderr
// (so the two stay in order on a terminal), before a line is read from
// stdin, and at exit, a panic and a fault (`on_fault`). When stdout is a
// terminal each line is written as it is printed.
//
// A write that finds stdout's reader gone (EPIPE, since SIGPIPE is
// ignored) ends the process quietly with 0, wherever it happens, as the
// interpreter does: the program has nobody left to tell anything.

// Write the `count` bytes at `buf` to stdout: 0, or the negative `errno`
// of the write that failed. A closed pipe does not return.
fn write_stdout(buf: Int, count: Int) -> Int {
    let written = write_all(1, buf, count)
    if broken_pipe(written) {
        if on_windows() {
            let _ = rt_sys_exit_process(0)
        }
        let _ = rt_sys_exit(0)
    }
    written
}

fn stdout_buffer_size() -> Int {
    65536
}

// The standard output buffer, mapped on first use, and how it is flushed.
fn stdout_buffer() -> Int {
    var buf = rt_mem_load64(global(13))
    if buf == 0 {
        buf = map(0, stdout_buffer_size(), 3, private_anonymous())
        rt_mem_store64(global(13), buf)
        if on_windows() {
            rt_mem_store64(global(15), if win_console(1) { 2 } else { 1 })
            return buf
        }
        // `ioctl(1, TCGETS, termios)` succeeds only on a terminal. The
        // `struct termios` it fills, after the object's count.
        let platform = rt_mem_platform()
        let termios = alloc(rt_mem_add(platform.termios_bytes, 8))
        let tty = rt_sys_ioctl(1, platform.tty_request, rt_mem_add(termios, 8))
        free(termios)
        rt_mem_store64(global(15), if tty == 0 { 2 } else { 1 })
    }
    buf
}

// Write the buffered output: 0, or the negative `errno` of the failed
// write. What the buffer held is gone either way.
pub fn flush_stdout() -> Int {
    let used = rt_mem_load64(global(14))
    if used == 0 {
        return 0
    }
    rt_mem_store64(global(14), 0)
    write_stdout(rt_mem_load64(global(13)), used)
}

// Append the text object at `object` and a newline to standard output:
// 0, or the negative `errno` of a write that failed.
fn stdout_put_line(object: Int) -> Int {
    let length = text_length(object)
    let data = text_data(object)
    let buf = stdout_buffer()
    var used = rt_mem_load64(global(14))
    if used + length + 1 > stdout_buffer_size() {
        let flushed = flush_stdout()
        if flushed < 0 {
            return flushed
        }
        used = 0
        if length + 1 > stdout_buffer_size() {
            // Too long to buffer: written as it is, then the newline.
            let body = write_stdout(data, length)
            if body < 0 {
                return body
            }
            rt_mem_store8(buf, 10)
            return write_stdout(buf, 1)
        }
    }
    copy_bytes(rt_mem_add(buf, used), data, length)
    rt_mem_store8(rt_mem_add(buf, used + length), 10)
    rt_mem_store64(global(14), used + length + 1)
    if rt_mem_load64(global(15)) == 2 {
        return flush_stdout()
    }
    0
}

// ---- Run limits ------------------------------------------------------------
//
// `oskac run --max-output=<limit>` builds the program so that each write
// it makes to stdout or stderr (`println`, `dbg`, `main`'s error) first
// asks `output_allows`. A program built without the flag never calls it.

// Whether the program may write `text` and `extra` bytes more without
// taking its output past `limit` bytes: if so they are counted, and if
// not nothing is, for the generated code to panic (`P0041`) before the
// write.
pub fn output_allows(text: String, extra: Int, limit: Int) -> Bool {
    let wanted = text_length(rt_mem_text(text)) + extra
    let written = rt_mem_load64(global(31))
    if wanted > limit - written {
        return false
    }
    rt_mem_store64(global(31), written + wanted)
    true
}

// `text`, program-made text a panic report quotes, cut to the bytes
// `--max-output=limit` has left: all of it when it fits, else as many of
// its first bytes as fit, ending where a character ends, then `...`. The
// interpreter cuts alike (`oska_check::limits::cut_quoted`).
fn cut_quoted(text: String, limit: Int) -> String {
    let left = limit - rt_mem_load64(global(31))
    let object = rt_mem_text(text)
    if text_length(object) <= left {
        return text
    }
    var end = left
    // A continuation byte (10xxxxxx) is inside a character.
    while end > 0 && rt_mem_and(rt_mem_load8(rt_mem_add(text_data(object), end)), 192) == 128 {
        end = end - 1
    }
    let cut = text_part(text, object, 0, end)
    "{cut}..."
}

// `Stdout.println`.
pub fn stdout_println(io: Stdout, line: String) -> Result<(), IoError> {
    if testing() {
        test_record(line)
        return Ok(())
    }
    let failed = stdout_put_line(rt_mem_text(line))
    if failed < 0 {
        return Err(io_error(-failed))
    }
    Ok(())
}

// `Stderr.println`: standard output first, then the line and its newline
// in one write.
pub fn stderr_println(io: Stderr, line: String) -> Result<(), IoError> {
    let failed = print_error_line(line)
    if failed < 0 {
        return Err(io_error(-failed))
    }
    Ok(())
}

// Write `line` and a newline to stderr, in one write, after flushing
// stdout: 0, or the negative `errno` of the write that failed.
fn print_error_line(line: String) -> Int {
    let _ = flush_stdout()
    let object = rt_mem_text(line)
    let length = text_length(object)
    let out = text_new(length + 1)
    copy_bytes(text_data(out), text_data(object), length)
    rt_mem_store8(rt_mem_add(text_data(out), length), 10)
    var result = 0
    if testing() {
        result = test_stderr(text_data(out), length + 1)
    } else {
        result = write_all(2, text_data(out), length + 1)
    }
    free(out)
    result
}

// Write all of `text` to `fd`: 0, or the negative `errno` of the write
// that failed. A write to stderr is preceded by stdout's.
fn write_text(fd: Int, text: String) -> Int {
    if fd == 2 {
        let _ = flush_stdout()
    }
    let object = rt_mem_text(text)
    write_all(fd, rt_mem_add(object, 16), rt_mem_load64(rt_mem_add(object, 8)))
}

// At most the bytes one `read` or `write` moves: `count`, or Linux's own
// limit (`MAX_RW_COUNT`) when it is more. macOS refuses a count over
// `INT_MAX` with `EINVAL` rather than moving less, as Linux does, so every
// platform asks for no more than Linux would move.
fn io_count(count: Int) -> Int {
    if count > 2147479552 {
        return 2147479552
    }
    count
}

// Write the `count` bytes at `buf` to `fd`, however many writes it takes:
// 0, or the negative `errno` of the write that failed.
fn write_all(fd: Int, buf: Int, count: Int) -> Int {
    var at = buf
    var left = count
    while left > 0 {
        let written = if on_windows() { win_write(fd, at, io_count(left)) } else { rt_sys_write(fd, at, io_count(left)) }
        if interrupted(written) {
            continue
        }
        if written < 0 {
            return written
        }
        at = rt_mem_add(at, written)
        left = rt_mem_sub(left, written)
    }
    0
}

// `write` on Windows: one `WriteFile` of the `count` bytes at `buf` to
// `fd`, where 0, 1 and 2 are the standard handles and any other is a
// handle. The bytes written, or a negative error.
fn win_write(fd: Int, buf: Int, count: Int) -> Int {
    if win_console(fd) {
        return win_console_write(fd, buf, count)
    }
    let done = global(48)
    rt_mem_store64(done, 0)
    let ok = rt_sys_write_file(win_handle(fd), buf, count, done)
    if ok < 0 {
        return ok
    }
    rt_mem_load32(done)
}

// `read` on Windows: one `ReadFile` into the `count` bytes at `buf` from
// `fd`. The bytes read, 0 at the end, or a negative error; a pipe whose
// writer has gone (`ERROR_BROKEN_PIPE`) is the end.
fn win_read(fd: Int, buf: Int, count: Int) -> Int {
    if win_console(fd) {
        return win_console_read(buf, count)
    }
    let done = global(48)
    rt_mem_store64(done, 0)
    let ok = rt_sys_read_file(win_handle(fd), buf, count, done)
    if ok == -109 {
        return 0
    }
    if ok < 0 {
        return ok
    }
    rt_mem_load32(done)
}

// ---- The Windows console ---------------------------------------------------
//
// A console takes UTF-16, so text to and from one is converted here, and
// files and pipes get the bytes as they are (ADR 0020; Q6 of its research). Word 49 is 0
// when no standard stream is a console, and otherwise the console area,
// mapped at start-up:
//
// - word 0: which of stdin (1), stdout (2) and stderr (4) are consoles;
// - words 1 and 2: for stdout and stderr, the start of a character a
//   write split, kept until the next write (its bytes, then their count
//   in the word's last byte);
// - words 3 and 4: where the converted input not yet read starts and
//   ends, within the input bytes;
// - at 64, the bytes of one write, at most `console_chunk()` and a
//   held start; then their UTF-16 units; then the UTF-16 units of one
//   read, and their UTF-8 bytes, the input bytes.

// Where the unread converted input starts and ends: words 3 and 4.
fn console_in_start() -> Int {
    24
}

fn console_in_end() -> Int {
    32
}

fn console_chunk() -> Int {
    8192
}

fn console_bytes() -> Int {
    64
}

fn console_units() -> Int {
    8264
}

fn console_in_units() -> Int {
    24664
}

fn console_in_bytes() -> Int {
    32856
}

// The most UTF-16 units one console read asks for, one fewer than the
// input units hold, for the second half of a pair a read cut: their UTF-8
// fits the input bytes, at 3 bytes a unit.
fn console_read_units() -> Int {
    4095
}

// Whether the standard stream `fd` is a console.
fn win_console(fd: Int) -> Bool {
    let area = rt_mem_load64(global(49))
    if area == 0 || fd < 0 || fd > 2 {
        return false
    }
    rt_mem_and(rt_mem_load64(area), rt_mem_shl(1, fd)) != 0
}

// Find which standard streams are consoles, and map the console area if
// any is.
fn win_find_consoles() {
    var which = 0
    var fd = 0
    while fd <= 2 {
        if rt_sys_get_console_mode(win_handle(fd), global(48)) > 0 {
            which = rt_mem_or(which, rt_mem_shl(1, fd))
        }
        fd = fd + 1
    }
    if which == 0 {
        rt_mem_store64(global(49), 0)
        return
    }
    let area = map(0, 65536, 3, 0)
    rt_mem_store64(area, which)
    rt_mem_store64(global(49), area)
}

// The length of the UTF-8 sequence whose first byte is `b`: 1 for a byte
// that cannot start one, which becomes U+FFFD.
fn utf8_sequence_length(b: Int) -> Int {
    if b >= 240 && b < 248 {
        return 4
    }
    if b >= 224 && b < 240 {
        return 3
    }
    if b >= 194 && b < 224 {
        return 2
    }
    1
}

// Write the `count` bytes at `buf` to the console `fd` (1 or 2) as UTF-16
// with `WriteConsoleW`: `count`, or a negative error. A character the
// bytes end in the middle of is held for the next write.
fn win_console_write(fd: Int, buf: Int, count: Int) -> Int {
    let area = rt_mem_load64(global(49))
    let held = rt_mem_add(area, rt_mem_shl(fd, 3))
    let bytes = rt_mem_add(area, console_bytes())
    let units = rt_mem_add(area, console_units())
    var from = 0
    while from < count {
        // The held start, then the next chunk of `buf`.
        var size = rt_mem_load8(rt_mem_add(held, 7))
        var k = 0
        while k < size {
            rt_mem_store8(rt_mem_add(bytes, k), rt_mem_load8(rt_mem_add(held, k)))
            k = k + 1
        }
        var take = count - from
        if take > console_chunk() {
            take = console_chunk()
        }
        copy_bytes(rt_mem_add(bytes, size), rt_mem_add(buf, from), take)
        from = from + take
        size = size + take
        // Convert every whole character; hold a last one cut short.
        var at = 0
        var n = 0
        rt_mem_store8(rt_mem_add(held, 7), 0)
        while at < size {
            let b = rt_mem_load8(rt_mem_add(bytes, at))
            let length = utf8_sequence_length(b)
            if at + length > size {
                var h = 0
                while at + h < size {
                    rt_mem_store8(rt_mem_add(held, h), rt_mem_load8(rt_mem_add(bytes, at + h)))
                    h = h + 1
                }
                rt_mem_store8(rt_mem_add(held, 7), h)
                break
            }
            var cp = b
            if length == 1 && b >= 128 {
                cp = 65533
            } else if length > 1 {
                cp = rt_mem_and(b, rt_mem_shr(127, length))
                var c = 1
                while c < length {
                    cp = rt_mem_or(rt_mem_shl(cp, 6), rt_mem_and(rt_mem_load8(rt_mem_add(bytes, at + c)), 63))
                    c = c + 1
                }
            }
            if cp >= 65536 {
                let rest = cp - 65536
                rt_mem_store16(rt_mem_add(units, rt_mem_shl(n, 1)), 55296 + rt_mem_shr(rest, 10))
                rt_mem_store16(rt_mem_add(units, rt_mem_shl(n + 1, 1)), 56320 + rt_mem_and(rest, 1023))
                n = n + 2
            } else {
                rt_mem_store16(rt_mem_add(units, rt_mem_shl(n, 1)), cp)
                n = n + 1
            }
            at = at + length
        }
        var written = 0
        while written < n {
            let done = global(48)
            rt_mem_store64(done, 0)
            let ok = rt_sys_write_console(win_handle(fd), rt_mem_add(units, rt_mem_shl(written, 1)), n - written, done)
            if ok < 0 {
                return ok
            }
            let wrote = rt_mem_load32(done)
            if wrote == 0 {
                // `ERROR_WRITE_FAULT`: the console took nothing.
                return -29
            }
            written = written + wrote
        }
    }
    count
}

// Read from the console stdin into the `count` bytes at `buf`, as UTF-8
// converted from what `ReadConsoleW` gives: the bytes read, 0 at the end
// (a line that starts with Ctrl+Z, as Rust's standard library reads it),
// or a negative error.
fn win_console_read(buf: Int, count: Int) -> Int {
    let area = rt_mem_load64(global(49))
    let input = rt_mem_add(area, console_in_bytes())
    var start = rt_mem_load64(rt_mem_add(area, console_in_start()))
    var end = rt_mem_load64(rt_mem_add(area, console_in_end()))
    if start == end {
        let units = rt_mem_add(area, console_in_units())
        let done = global(48)
        rt_mem_store64(done, 0)
        let ok = rt_sys_read_console(win_handle(0), units, console_read_units(), done)
        if ok < 0 {
            return ok
        }
        var n = rt_mem_load32(done)
        if n == 0 || rt_mem_load16(units) == 26 {
            return 0
        }
        // A pair the read cut after its first half: read its second.
        let last = rt_mem_load16(rt_mem_add(units, rt_mem_shl(n - 1, 1)))
        if last >= 55296 && last < 56320 {
            rt_mem_store64(done, 0)
            let more = rt_sys_read_console(win_handle(0), rt_mem_add(units, rt_mem_shl(n, 1)), 1, done)
            if more < 0 {
                return more
            }
            n = n + rt_mem_load32(done)
        }
        start = 0
        end = utf16_to_utf8(input, units, n)
    }
    var take = end - start
    if take > count {
        take = count
    }
    copy_bytes(buf, rt_mem_add(input, start), take)
    rt_mem_store64(rt_mem_add(area, console_in_start()), start + take)
    rt_mem_store64(rt_mem_add(area, console_in_end()), end)
    take
}

// The Windows handle behind the descriptor `fd`.
fn win_handle(fd: Int) -> Int {
    if fd >= 0 && fd <= 2 {
        return rt_mem_load64(global(45 + fd))
    }
    fd
}

// ---- I/O errors ------------------------------------------------------------

// The `IoError` for the system error `errno`, in Oska's own words for the
// kind of failure it is (`errno_message`), with no error number.
fn io_error(errno: Int) -> IoError {
    io_error_text(errno_message(errno))
}

// An `IoError` with the message `message`.
fn io_error_text(message: String) -> IoError {
    let object = alloc(16)
    let text = rt_mem_text(message)
    retain(text)
    rt_mem_store64(rt_mem_add(object, 8), text)
    rt_mem_as_io_error(object)
}

// Oska's wording for the kind of failure the system error `errno` is:
// `I/O error` for a number whose kind has no wording of its own.
fn errno_message(errno: Int) -> String {
    if on_windows() {
        return windows_error_message(errno)
    }
    let platform = rt_mem_platform()
    if errno < 1 || errno > platform.errors_count {
        return "I/O error"
    }
    let object = rt_mem_text(system_errors())
    let data = text_data(object)
    let length = text_length(object)
    // The wording for `errno` starts after `errors_at + errno - 1`
    // separators.
    let skip = platform.errors_at + errno
    var at = 0
    var n = 1
    while n < skip && at < length {
        if rt_mem_load8(rt_mem_add(data, at)) == 124 {
            n = n + 1
        }
        at = at + 1
    }
    var end = at
    while end < length && rt_mem_load8(rt_mem_add(data, end)) != 124 {
        end = end + 1
    }
    if at >= length || end == at {
        return "I/O error"
    }
    rt_mem_as_text(text_of(rt_mem_add(data, at), end - at))
}

// The wording of the kinds of every platform's system errors, in order,
// separated by `|`; empty for a number whose kind has no wording of its
// own. First Linux's errors 1 to 133, then macOS's 1 to 106 (`ELAST`):
// `oska-sys`'s tables (`LINUX_ERRORS`, `MACOS_ERRORS`) worded by their
// kinds (`IO_KINDS`). Each platform's table says where its part is
// (`errors_at`, `errors_count`), and a test (`oskac`'s
// `std_rt_errors.rs`) checks every number of every part against
// `oska-sys`.
fn system_errors() -> String {
    "permission denied|not found||interrupted|||||||would block|out of memory|permission denied|||resource busy|already exists|cannot move across devices||not a directory|is a directory|invalid input|||||file too large|no space left on device|not seekable|read-only file system|too many links|broken pipe||||invalid file name||not supported|directory not empty||||||||||||||||||||||||||||||||||||||||||||||||||||||||not supported|||||||||||||||timed out||||||||||||quota exceeded||||||||||||permission denied|not found||interrupted||||||||out of memory|permission denied|||resource busy|already exists|cannot move across devices||not a directory|is a directory|invalid input|||||file too large|no space left on device|not seekable|read-only file system|too many links|broken pipe|||would block||||||||||not supported|||||||||||||||timed out|||invalid file name|||directory not empty|||quota exceeded|||||||||not supported||||||||||||||||||||||||not supported||||"
}

// Oska's wording for the kind of the Win32 error `code`, or `I/O error`.
// Win32 codes run to 1460, so Windows' part is sparse: `code=wording`
// pairs separated by `|`, from `oska-sys`'s `WINDOWS_ERRORS` worded by
// their kinds, which `oskac`'s `std_rt_errors.rs` checks.
fn windows_error_message(code: Int) -> String {
    let object = rt_mem_text(windows_errors())
    let data = text_data(object)
    let length = text_length(object)
    var at = 0
    while at < length {
        var n = 0
        while rt_mem_load8(rt_mem_add(data, at)) != 61 {
            n = n * 10 + rt_mem_load8(rt_mem_add(data, at)) - 48
            at = at + 1
        }
        at = at + 1
        var end = at
        while end < length && rt_mem_load8(rt_mem_add(data, end)) != 124 {
            end = end + 1
        }
        if n == code {
            return rt_mem_as_text(text_of(rt_mem_add(data, at), end - at))
        }
        at = end + 1
    }
    "I/O error"
}

// Windows' system errors with a wording of their own, as
// `windows_error_message` reads them.
fn windows_errors() -> String {
    "2=not found|3=not found|5=permission denied|8=out of memory|14=out of memory|15=not found|17=cannot move across devices|19=read-only file system|39=no space left on device|53=not found|67=not found|80=already exists|87=invalid input|109=broken pipe|112=no space left on device|120=not supported|121=timed out|123=invalid file name|132=not seekable|145=directory not empty|161=invalid file name|170=resource busy|183=already exists|206=invalid file name|223=file too large|232=broken pipe|258=timed out|267=not a directory|336=is a directory|1142=too many links|1295=quota exceeded|1460=timed out"
}

// ---- Standard input --------------------------------------------------------

// `Stdin.read_line`: the next line without its line break (`\n`, or
// `\r\n`), the last line even when it has none, or `None` at end of input.
// Standard output is written first, so a prompt shows before the wait.
pub fn stdin_read_line(io: Stdin) -> Result<Option<String>, IoError> {
    read_stdin_line()
}

// The next line of standard input, as `Stdin.read_line` gives it.
fn read_stdin_line() -> Result<Option<String>, IoError> {
    let _ = flush_stdout()
    if rt_mem_load64(global(16)) == 0 {
        rt_mem_store64(global(16), map(0, 65536, 3, private_anonymous()))
        rt_mem_store64(global(19), 65536)
    }
    // How many unread bytes have been looked at for a newline.
    var scanned = 0
    while true {
        let pos = rt_mem_load64(global(17))
        let end = rt_mem_load64(global(18))
        let buf = rt_mem_load64(global(16))
        var at = pos + scanned
        while at < end && rt_mem_load8(rt_mem_add(buf, at)) != 10 {
            at = at + 1
        }
        if at < end {
            var stop = at
            if stop > pos && rt_mem_load8(rt_mem_add(buf, stop - 1)) == 13 {
                stop = stop - 1
            }
            rt_mem_store64(global(17), at + 1)
            // The line is consumed even when it is not text.
            if !utf8_valid(rt_mem_add(buf, pos), at - pos) {
                return Err(invalid_utf8())
            }
            let line = text_from(rt_mem_add(buf, pos), stop - pos)
            return Ok(Some(line))
        }
        scanned = end - pos
        let read = stdin_fill()
        if read < 0 {
            return Err(io_error(-read))
        }
        if read == 0 {
            let rest = rt_mem_load64(global(18)) - rt_mem_load64(global(17))
            if rest == 0 {
                return Ok(None)
            }
            let start = rt_mem_add(rt_mem_load64(global(16)), rt_mem_load64(global(17)))
            rt_mem_store64(global(17), rt_mem_load64(global(18)))
            if !utf8_valid(start, rest) {
                return Err(invalid_utf8())
            }
            return Ok(Some(text_from(start, rest)))
        }
    }
    Ok(None)
}

// What Rust's `read_line` reports for a line that is not UTF-8.
fn invalid_utf8() -> IoError {
    io_error_text("stream did not contain valid UTF-8")
}

// Read more of standard input after the unread bytes, moving them to the
// buffer's start and growing the buffer when they fill it: the number of
// bytes read, 0 at end of input, or the negative `errno` of a failed read.
fn stdin_fill() -> Int {
    let pos = rt_mem_load64(global(17))
    var end = rt_mem_load64(global(18))
    var buf = rt_mem_load64(global(16))
    var capacity = rt_mem_load64(global(19))
    if pos > 0 {
        copy_bytes(buf, rt_mem_add(buf, pos), end - pos)
        end = end - pos
        rt_mem_store64(global(17), 0)
        rt_mem_store64(global(18), end)
    }
    if end == capacity {
        let bigger = map(0, capacity * 2, 3, private_anonymous())
        copy_bytes(bigger, buf, end)
        if on_windows() {
            let _ = rt_sys_virtual_free(buf)
        } else {
            let _ = rt_sys_munmap(buf, capacity)
        }
        buf = bigger
        capacity = capacity * 2
        rt_mem_store64(global(16), buf)
        rt_mem_store64(global(19), capacity)
    }
    var read = if on_windows() { win_read(0, rt_mem_add(buf, end), capacity - end) } else { rt_sys_read(0, rt_mem_add(buf, end), capacity - end) }
    while interrupted(read) {
        read = if on_windows() { win_read(0, rt_mem_add(buf, end), capacity - end) } else { rt_sys_read(0, rt_mem_add(buf, end), capacity - end) }
    }
    if read > 0 {
        rt_mem_store64(global(18), end + read)
    }
    read
}

// Whether the `length` bytes at `data` are well-formed UTF-8, as Rust's
// `str::from_utf8` decides: no stray continuation or lead byte, no
// overlong form, no surrogate, nothing above U+10FFFF. Every text the
// runtime makes from outside bytes goes through this, since the text
// routines decode lead bytes and rely on it.
fn utf8_valid(data: Int, length: Int) -> Bool {
    var i = 0
    while i < length {
        let b = rt_mem_load8(rt_mem_add(data, i))
        if b < 128 {
            i = i + 1
            continue
        }
        var need = 0
        var low = 128
        var high = 191
        if b >= 194 && b <= 223 {
            need = 1
        } else if b == 224 {
            need = 2
            low = 160
        } else if b >= 225 && b <= 239 {
            need = 2
            if b == 237 {
                high = 159
            }
        } else if b == 240 {
            need = 3
            low = 144
        } else if b >= 241 && b <= 243 {
            need = 3
        } else if b == 244 {
            need = 3
            high = 143
        } else {
            return false
        }
        if i + need >= length {
            return false
        }
        let first = rt_mem_load8(rt_mem_add(data, i + 1))
        if first < low || first > high {
            return false
        }
        var k = 2
        while k <= need {
            let next = rt_mem_load8(rt_mem_add(data, i + k))
            if next < 128 || next > 191 {
                return false
            }
            k = k + 1
        }
        i = i + need + 1
    }
    true
}

// A new text of the `count` bytes at `from`.
fn text_from(from: Int, count: Int) -> String {
    let object = text_new(count)
    copy_bytes(text_data(object), from, count)
    rt_mem_as_text(object)
}

// The text of the C string at `at`.
fn cstr_text(at: Int) -> String {
    var length = 0
    while rt_mem_load8(rt_mem_add(at, length)) != 0 {
        length = length + 1
    }
    text_from(at, length)
}

// ---- Arguments and environment ---------------------------------------------

// `Args.get`: argument `index` (the program at 0), or `None` past the end.
pub fn args_get(args: Args, index: Int) -> Option<String> {
    if index < 0 || index >= rt_mem_load64(global(10)) {
        return None
    }
    Some(cstr_text(rt_mem_load64(rt_mem_add(rt_mem_load64(global(11)), rt_mem_shl(index, 3)))))
}

// The address of the value of the environment variable `name`, a C
// string, or 0 when it is not set (or `name` could not be a variable's).
fn env_lookup(name: String) -> Int {
    let object = rt_mem_text(name)
    let length = text_length(object)
    let data = text_data(object)
    if length == 0 {
        return 0
    }
    var i = 0
    while i < length {
        let byte = rt_mem_load8(rt_mem_add(data, i))
        if byte == 61 || byte == 0 {
            return 0
        }
        i = i + 1
    }
    // Windows' names ignore case, as `std::env::var` does there; here only
    // ASCII letters' case, which covers the names programs use.
    let fold = on_windows()
    var entries = rt_mem_load64(global(12))
    while rt_mem_load64(entries) != 0 {
        let entry = rt_mem_load64(entries)
        var j = 0
        while j < length && name_byte(rt_mem_load8(rt_mem_add(entry, j)), fold) == name_byte(rt_mem_load8(rt_mem_add(data, j)), fold) {
            j = j + 1
        }
        if j == length && rt_mem_load8(rt_mem_add(entry, j)) == 61 {
            // `std::env::var` has no value for one that is not UTF-8.
            if cstr_valid(rt_mem_add(entry, length + 1)) {
                return rt_mem_add(entry, length + 1)
            }
            return 0
        }
        entries = rt_mem_add(entries, 8)
    }
    0
}

// The byte `b` of a variable's name, as `env_lookup` compares it: an
// ASCII capital as its small letter when `fold`.
fn name_byte(b: Int, fold: Bool) -> Int {
    if fold && b >= 65 && b <= 90 {
        return b + 32
    }
    b
}

// `Env.get`.
pub fn env_get(env: Env, name: String) -> Option<String> {
    let found = env_lookup(name)
    if found == 0 {
        return None
    }
    Some(cstr_text(found))
}

// `Env.secret`: a `Secret` object (a count and the one field), or the
// word 0 when the variable is not set, for the generated code to panic
// (`P0020`).
pub fn env_secret(env: Env, name: String) -> Secret<String> {
    let found = env_lookup(name)
    if found == 0 {
        return rt_mem_as_secret(0)
    }
    let value = cstr_text(found)
    let object = alloc(16)
    let text = rt_mem_text(value)
    retain(text)
    rt_mem_store64(rt_mem_add(object, 8), text)
    rt_mem_as_secret(object)
}

// Panic (`P0020`): `start` and `end` are the report around the message.
pub fn panic_missing_secret(start: String, end: String, env: Env, name: String) {
    panic_message(start, end, missing_secret_message("", env, name))
}

pub fn missing_secret_message(head: String, env: Env, name: String) -> String {
    "{head}the secret `{name}` is not set in the environment"
}

// Panic (`P0020`) under `--max-output=limit`: the name cut to what the
// limit has left (`cut_quoted`).
pub fn panic_missing_secret_cut(start: String, end: String, env: Env, name: String, limit: Int) {
    panic_message(start, end, missing_secret_cut_message("", env, name, limit))
}

pub fn missing_secret_cut_message(head: String, env: Env, name: String, limit: Int) -> String {
    let shown = cut_quoted(name, limit)
    "{head}the secret `{shown}` is not set in the environment"
}

// `Secret.constant_time_eq`.
pub fn secret_constant_time_eq(secret: Secret<String>, other: String) -> Bool {
    let a = rt_mem_load64(rt_mem_add(rt_mem_secret(secret), 8))
    text_equal_constant(a, rt_mem_text(other))
}

// `Secret.constant_time_eq_secret`.
pub fn secret_constant_time_eq_secret(secret: Secret<String>, other: Secret<String>) -> Bool {
    let a = rt_mem_load64(rt_mem_add(rt_mem_secret(secret), 8))
    let b = rt_mem_load64(rt_mem_add(rt_mem_secret(other), 8))
    text_equal_constant(a, b)
}

// Whether the text objects `a` and `b` are equal, in time that depends on
// their lengths but not on where they first differ.
fn text_equal_constant(a: Int, b: Int) -> Bool {
    equal_constant(text_data(a), text_length(a), text_data(b), text_length(b))
}

// Whether the `length` bytes at `left` equal the `other` bytes at
// `right`: every byte of the shorter compared, each marked secret,
// whatever the first difference, in time that depends on the lengths
// only. `Secret<Bytes>`'s and `Secret<String>`'s constant-time
// comparisons share it.
fn equal_constant(left: Int, length: Int, right: Int, other: Int) -> Bool {
    var diff = rt_mem_xor(length, other)
    let shorter = if length < other { length } else { other }
    var i = 0
    while i < shorter {
        let x = rt_mem_conceal(rt_mem_load8(rt_mem_add(left, i)))
        let y = rt_mem_conceal(rt_mem_load8(rt_mem_add(right, i)))
        diff = rt_mem_or(diff, rt_mem_xor(x, y))
        i = i + 1
    }
    rt_mem_expose(diff) == 0
}

// ---- Clock and randomness --------------------------------------------------

// `Clock.now_millis`: the realtime clock, in milliseconds.
pub fn clock_now_millis(clock: Clock) -> Int {
    if faking() {
        return 0
    }
    if on_windows() {
        return win_now_millis()
    }
    let object = alloc(24)
    let _ = rt_sys_clock_gettime(0, rt_mem_add(object, 8))
    let seconds = rt_mem_load64(rt_mem_add(object, 8))
    let nanos = rt_mem_load64(rt_mem_add(object, 16))
    free(object)
    seconds * 1000 + nanos / 1000000
}

// The next 64 bits of the generator: SplitMix64, as the interpreter's,
// seeded on first use from the operating system's random source (from the
// clock if that fails).
fn random_next_word() -> Int {
    if rt_mem_load64(global(21)) == 0 {
        let object = alloc(24)
        var got = 0
        if on_windows() {
            got = rt_sys_process_prng(rt_mem_add(object, 8), 8)
        } else {
            got = rt_sys_random(rt_mem_add(object, 8), 8)
        }
        var seed = rt_mem_load64(rt_mem_add(object, 8))
        if got < 0 && !on_windows() {
            let _ = rt_sys_clock_gettime(0, rt_mem_add(object, 8))
            let nanos = rt_mem_load64(rt_mem_add(object, 16))
            seed = rt_mem_xor(rt_mem_load64(rt_mem_add(object, 8)), rt_mem_shl(nanos, 20))
        }
        free(object)
        rt_mem_store64(global(20), seed)
        rt_mem_store64(global(21), 1)
    }
    let state = rt_mem_add(rt_mem_load64(global(20)), -7046029254386353131)
    rt_mem_store64(global(20), state)
    var z = state
    z = rt_mem_mul(rt_mem_xor(z, rt_mem_shr(z, 30)), -4658895280553007687)
    z = rt_mem_mul(rt_mem_xor(z, rt_mem_shr(z, 27)), -7723592293110705685)
    rt_mem_xor(z, rt_mem_shr(z, 31))
}

// `Random.next_int`: from 0 up to, but excluding, 2^63.
pub fn random_next_int(random: Random) -> Int {
    rt_mem_shr(random_next_word(), 1)
}

// `Random.secure_bytes`: `length` bytes of the operating system's secure
// random source, in a `Secret<Bytes>`; on the test host the generator's
// words, little-endian, as the interpreter's. The word 0 says a negative
// length and -1 one past `max_bytes`. No secure source ends the program:
// there is no guessable fallback.
pub fn random_secure_bytes(random: Random, length: Int) -> Secret<Bytes> {
    if length < 0 {
        return rt_mem_as_secret_bytes(0)
    }
    if length > max_bytes() {
        return rt_mem_as_secret_bytes(-1)
    }
    let bytes = bytes_zeroed(length)
    let data = bytes_data(rt_mem_bytes(bytes))
    if faking() {
        var word = 0
        var i = 0
        while i < length {
            let shift = rt_mem_shl(rt_mem_and(i, 7), 3)
            if shift == 0 {
                word = random_next_word()
            }
            rt_mem_store8(rt_mem_add(data, i), rt_mem_and(rt_mem_shr(word, shift), 255))
            i = i + 1
        }
    } else {
        var done = 0
        while done < length {
            var chunk = length - done
            if chunk > 256 {
                chunk = 256
            }
            var got = 0
            if on_windows() {
                got = rt_sys_process_prng(rt_mem_add(data, done), chunk)
            } else {
                got = rt_sys_random(rt_mem_add(data, done), chunk)
            }
            // `ProcessPrng` always returns TRUE and fills every byte (the
            // backend's `Fails::Never`), so Windows has no result to check.
            if got < 0 && !on_windows() {
                let _ = write_text(report_fd(), "the operating system has no secure random source\n")
                exit(101)
            }
            done = done + chunk
        }
    }
    let object = alloc(16)
    let held = rt_mem_bytes(bytes)
    retain(held)
    rt_mem_store64(rt_mem_add(object, 8), held)
    rt_mem_as_secret_bytes(object)
}

// ---- Name servers ----------------------------------------------------------

// `NetConnect.system_name_servers`: the DNS servers Windows lists, in
// order, as IPv4 literals, from `GetNetworkParams` (ADR 0024). Every other
// platform keeps them in `resolv.conf`, which `std.dns` reads itself, so
// they have none to give; and the test host lists none.
pub fn net_system_name_servers(net: NetConnect) -> Result<List<String>, IoError> {
    var servers: List<String> = []
    if !on_windows() || faking() {
        return Ok(servers)
    }
    let cell = alloc(8)
    rt_mem_store64(cell, 0)
    // A first call with no buffer says how big the buffer must be.
    let first = rt_sys_get_network_params(0, cell)
    let size = rt_mem_load32(cell)
    if first != 111 || size < 320 || size > 65536 {
        return Err(io_error_text("the system's DNS servers cannot be read"))
    }
    let info = alloc(size + 8)
    let second = rt_sys_get_network_params(info, cell)
    if second != 0 {
        return Err(io_error_text("the system's DNS servers cannot be read"))
    }
    // `FIXED_INFO`: `HostName[132]`, `DomainName[132]`, `CurrentDnsServer`
    // (a pointer, at 264), and at 272 `DnsServerList`, an
    // `IP_ADDR_STRING`: `Next` (a pointer), `IpAddress[16]` (a C string),
    // `IpMask[16]` and `Context`, 48 bytes. The list's other nodes follow
    // the structure in the same buffer. A link that leaves the buffer ends
    // the list, as it does in the interpreter.
    var node = rt_mem_add(info, 272)
    var seen = 0
    while seen < 16 {
        let address = rt_mem_add(node, 8)
        var length = 0
        while length < 16 && rt_mem_load8(rt_mem_add(address, length)) != 0 {
            length = length + 1
        }
        if length > 0 {
            servers.push(text_from(address, length))
        }
        let next = rt_mem_load64(node)
        let offset = rt_mem_sub(next, info)
        if next == 0 || offset < 0 || offset > size - 48 {
            seen = 16
        } else {
            node = next
            seen = seen + 1
        }
    }
    Ok(servers)
}

// ---- Budgets ---------------------------------------------------------------
//
// A `Budget` is a word: 0 for the root, `main`'s or a test's `t.budget`,
// and otherwise the address of its node. A node is
// `[count][parent][tokens' limit][calls' limit][tokens spent][calls spent]
// [tokens reserved][calls reserved]`, its parent's node or 0 for the
// root's, and a limit of -1 for none. The root's node is made on first use
// (word 51): unlimited in a program, 100000 tokens and 100 calls in a test
// executable, as the interpreter's (`oska-run`'s `budget.rs`). Copies of a
// budget share its node, so they draw from the same counters. Nodes are
// never freed: a budget is a capability, which the generated code does
// not count.
//
// A `Reservation` is the object `Hold`, `[count][node][tokens][open]`, laid
// out as the prelude's `Reservation { handle, tokens, open }`, whose
// private fields only `std.rt` reads (`oska-native`'s test
// `a_reservation_is_laid_out_as_std_rt_s_hold` keeps the two alike).
// `open` is written in place, so every copy sees it settled.

struct Hold {
    node: Int,
    tokens: Int,
    open: Bool,
}

// The node of the budget `budget`.
fn budget_node(budget: Int) -> Int {
    if budget != 0 {
        return budget
    }
    let root = rt_mem_load64(global(51))
    if root != 0 {
        return root
    }
    var tokens = -1
    var calls = -1
    if rt_mem_test_host() != 0 {
        tokens = 100000
        calls = 100
    }
    let node = budget_new(0, tokens, calls)
    rt_mem_store64(global(51), node)
    node
}

// A new node under `parent`, with the limits `tokens` and `calls`.
fn budget_new(parent: Int, tokens: Int, calls: Int) -> Int {
    let node = alloc(64)
    rt_mem_store64(rt_mem_add(node, 8), parent)
    rt_mem_store64(rt_mem_add(node, 16), tokens)
    rt_mem_store64(rt_mem_add(node, 24), calls)
    var at = 32
    while at < 64 {
        rt_mem_store64(rt_mem_add(node, at), 0)
        at = at + 8
    }
    node
}

fn budget_word(node: Int, offset: Int) -> Int {
    rt_mem_load64(rt_mem_add(node, offset))
}

// Add `n`, at least 0, to the word at `offset`, stopping at the largest
// `Int`.
fn budget_add(node: Int, offset: Int, n: Int) {
    let was = budget_word(node, offset)
    var sum = 9223372036854775807
    if was <= sum - n {
        sum = was + n
    }
    rt_mem_store64(rt_mem_add(node, offset), sum)
}

// Take `n`, at least 0, from the word at `offset`, stopping at 0: an
// unlimited budget's reservations stop at the largest `Int`, so they may
// add up to less than is returned.
fn budget_take(node: Int, offset: Int, n: Int) {
    let was = budget_word(node, offset)
    var rest = 0
    if was > n {
        rest = was - n
    }
    rt_mem_store64(rt_mem_add(node, offset), rest)
}

// What `node` itself has left of the amount whose limit is at `limit`
// (16 tokens, 24 calls; spent 16 bytes on, reserved 32): -1 for no limit,
// and never below 0.
fn budget_own_left(node: Int, limit: Int) -> Int {
    let most = budget_word(node, limit)
    if most < 0 {
        return -1
    }
    let left = most - budget_word(node, limit + 16)
    if left <= 0 {
        return 0
    }
    let rest = left - budget_word(node, limit + 32)
    if rest < 0 {
        return 0
    }
    rest
}

// The least that `node` or any node above it has left of the amount at
// `limit`: -1 when none has a limit.
fn budget_left(node: Int, limit: Int) -> Int {
    var least = -1
    var at = node
    while at != 0 {
        let left = budget_own_left(at, limit)
        if left >= 0 && (least < 0 || left < least) {
            least = left
        }
        at = budget_word(at, 8)
    }
    least
}

// `asked`, at least 0, and no more than `left` unless that is -1.
fn budget_clamp(asked: Int, left: Int) -> Int {
    var n = asked
    if n < 0 {
        n = 0
    }
    if left >= 0 && left < n {
        n = left
    }
    n
}

fn budget_amount(n: Int) -> Option<Int> {
    if n < 0 {
        return None
    }
    Some(n)
}

fn budget_allowance(node: Int) -> Allowance {
    let tokens = budget_amount(budget_left(node, 16))
    let calls = budget_amount(budget_left(node, 24))
    Allowance(tokens: tokens, calls: calls)
}

// `Budget.limit`: a child node, clamped to what `budget` has left.
pub fn budget_limit(budget: Int, tokens: Int, calls: Int) -> Int {
    let node = budget_node(budget)
    budget_new(node, budget_clamp(tokens, budget_left(node, 16)), budget_clamp(calls, budget_left(node, 24)))
}

// `Budget.remaining`.
pub fn budget_remaining(budget: Int) -> Allowance {
    budget_allowance(budget_node(budget))
}

// `Budget.spent`.
pub fn budget_spent(budget: Int) -> Spending {
    let node = budget_node(budget)
    Spending(tokens: budget_word(node, 32), calls: budget_word(node, 40))
}

// `Budget.reserve`: `tokens` and one call reserved on `budget`'s node and
// every node above it, or `OverBudget` when any has less left.
pub fn budget_reserve(budget: Int, tokens: Int) -> Result<Hold, OverBudget> {
    let node = budget_node(budget)
    let asked = budget_clamp(tokens, -1)
    let tokens_left = budget_left(node, 16)
    let calls_left = budget_left(node, 24)
    // A budget with no tokens left refuses even a reservation of none:
    // otherwise every call could overshoot it again.
    if (tokens_left >= 0 && (tokens_left < asked || tokens_left == 0)) || calls_left == 0 {
        return Err(OverBudget(asked: asked, left: budget_allowance(node)))
    }
    var at = node
    while at != 0 {
        budget_add(at, 48, asked)
        budget_add(at, 56, 1)
        at = budget_word(at, 8)
    }
    Ok(Hold(node: node, tokens: asked, open: true))
}

// `Reservation.debit`: every count, each at least 0, spent as tokens,
// stopping at the largest `Int`.
pub fn reservation_debit(hold: Int, input: Int, output: Int, cache_creation: Int, cache_read: Int) {
    var used = budget_sum(budget_clamp(input, -1), budget_clamp(output, -1))
    used = budget_sum(used, budget_clamp(cache_creation, -1))
    used = budget_sum(used, budget_clamp(cache_read, -1))
    budget_settle(hold, used, true)
}

// `a + b`, both at least 0, stopping at the largest `Int`.
fn budget_sum(a: Int, b: Int) -> Int {
    let most = 9223372036854775807
    if a > most - b {
        return most
    }
    a + b
}

// `Reservation.release`.
pub fn reservation_release(hold: Int) {
    budget_settle(hold, 0, false)
}

// Settle the reservation `hold`, once: return what it reserved and, when
// `spend`, spend `used` tokens and the call, on its node and every node
// above it.
fn budget_settle(hold: Int, used: Int, spend: Bool) {
    if budget_word(hold, 24) == 0 {
        return
    }
    rt_mem_store64(rt_mem_add(hold, 24), 0)
    let reserved = budget_word(hold, 16)
    var at = budget_word(hold, 8)
    while at != 0 {
        budget_take(at, 48, reserved)
        budget_take(at, 56, 1)
        if spend {
            budget_add(at, 32, used)
            budget_add(at, 40, 1)
        }
        at = budget_word(at, 8)
    }
}

fn budget_amount_text(n: Option<Int>) -> String {
    match n {
        Some(n) => "{n}"
        None => "unlimited"
    }
}

// `OverBudget.to_string`, as the interpreter's.
pub fn over_budget_to_string(e: OverBudget) -> String {
    let asked = e.asked
    let tokens = budget_amount_text(e.left.tokens)
    let calls = budget_amount_text(e.left.calls)
    "over budget: asked for {asked} tokens and 1 call, with {tokens} tokens and {calls} calls left"
}

// ---- Debugging -------------------------------------------------------------

// `dbg`'s line: standard output first, then `[dbg] `, `text` and a
// newline in one write. A failed write loses the line, not the program.
pub fn dbg_write(text: String) {
    let _ = print_error_line("[dbg] {text}")
}

// `dbg` of a `Bool`.
pub fn debug_bool(value: Bool) -> String {
    if value {
        return "true"
    }
    "false"
}

// `dbg` of an integer, read as unsigned when `unsigned` (a `U64`).
pub fn debug_int(value: Int, unsigned: Bool) -> String {
    int_text(value, unsigned)
}

// `a` and `b` as one new text.
// `dbg` of the arguments: `Args["a", "b"]`, each as `debug_string` shows it.
pub fn debug_args(args: Args) -> String {
    let count = rt_mem_load64(global(10))
    var text = "Args["
    var i = 0
    while i < count {
        if i > 0 {
            text = debug_concat(text, ", ")
        }
        let arg = cstr_text(rt_mem_load64(rt_mem_add(rt_mem_load64(global(11)), rt_mem_shl(i, 3))))
        text = debug_concat(text, debug_string(arg))
        i = i + 1
    }
    debug_concat(text, "]")
}

pub fn debug_concat(a: String, b: String) -> String {
    let first = rt_mem_text(a)
    let second = rt_mem_text(b)
    let length = text_length(first) + text_length(second)
    let object = text_new(length)
    copy_bytes(text_data(object), text_data(first), text_length(first))
    copy_bytes(rt_mem_add(text_data(object), text_length(first)), text_data(second), text_length(second))
    rt_mem_as_text(object)
}

// `dbg` of a text: in double quotes, as Rust's `{:?}` writes a `str`, which
// is what the interpreter does: `"` and `\` escaped by a `\`, line feed,
// carriage return, tab and NUL as `\n`, `\r`, `\t` and `\0`, and every
// character in `escaped_table` as `\u{hex}`.
pub fn debug_string(text: String) -> String {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    let total = debug_pass(data, length, 0)
    let result = text_new(total)
    let _ = debug_pass(data, length, text_data(result))
    rt_mem_as_text(result)
}

// The characters `{:?}` writes as `\u{hex}`: the control characters other
// than the four with their own escapes, the characters that are not
// printable (unassigned, private use, separators, format characters) and
// the ones that extend the grapheme before them, as records of 12
// hexadecimal digits in order: the first character (6 digits) and the last
// (6). The interpreter's `dbg` reads this same table
// (`oska_check::debug_escapes`), so both backends escape alike whatever Rust
// built them. It follows the Unicode of the Rust in `rust-toolchain.toml`;
// a test (`native_process.rs`) checks it against that Rust's `{:?}` for every
// character and, on a Rust upgrade, prints the table to paste here.
fn escaped_table() -> String {
    ""
}

// Whether `{:?}` writes the character `cp` as `\u{hex}`.
fn debug_escapes(cp: Int) -> Bool {
    if cp < 32 {
        return true
    }
    if cp < 127 {
        return false
    }
    let object = rt_mem_text(escaped_table())
    let data = text_data(object)
    // How many records start at or before `cp`.
    var low = 0
    var high = text_length(object) / 12
    while low < high {
        let middle = (low + high) / 2
        if hex_at(rt_mem_add(data, middle * 12), 6) <= cp {
            low = middle + 1
        } else {
            high = middle
        }
    }
    if low == 0 {
        return false
    }
    cp <= hex_at(rt_mem_add(data, (low - 1) * 12 + 6), 6)
}

// The bytes `debug_string` writes for the `length` bytes at `data`: written
// to `out` unless it is 0, which only counts them.
fn debug_pass(data: Int, length: Int, out: Int) -> Int {
    var n = put_byte(out, 0, 34)
    var i = 0
    while i < length {
        let size = sequence_length(rt_mem_load8(rt_mem_add(data, i)))
        n = debug_char(rt_mem_add(data, i), size, out, n)
        i = i + size
    }
    put_byte(out, n, 34)
}

// Write `{:?}`'s form of the character of `size` bytes at `at` at offset
// `n` of `out` (or only count it, when `out` is 0): the next offset.
fn debug_char(at: Int, size: Int, out: Int, n: Int) -> Int {
    let b = rt_mem_load8(at)
    if b == 34 || b == 92 {
        return put_byte(out, put_byte(out, n, 92), b)
    }
    if b == 10 {
        return put_byte(out, put_byte(out, n, 92), 110)
    }
    if b == 13 {
        return put_byte(out, put_byte(out, n, 92), 114)
    }
    if b == 9 {
        return put_byte(out, put_byte(out, n, 92), 116)
    }
    if b == 0 {
        return put_byte(out, put_byte(out, n, 92), 48)
    }
    if debug_escapes(decode_at(at)) {
        return put_unicode_escape(out, n, decode_at(at))
    }
    var next = n
    var k = 0
    while k < size {
        next = put_byte(out, next, rt_mem_load8(rt_mem_add(at, k)))
        k = k + 1
    }
    next
}

// Write `byte` at offset `at` of `out` unless `out` is 0: the next offset.
fn put_byte(out: Int, at: Int, byte: Int) -> Int {
    if out != 0 {
        rt_mem_store8(rt_mem_add(out, at), byte)
    }
    at + 1
}

// `\u{..}` for the code point `cp`, in lower-case hexadecimal.
fn put_unicode_escape(out: Int, at: Int, cp: Int) -> Int {
    var n = put_byte(out, at, 92)
    n = put_byte(out, n, 117)
    n = put_byte(out, n, 123)
    var shift = 20
    while shift > 0 && rt_mem_shr(cp, shift) == 0 {
        shift = shift - 4
    }
    while shift >= 0 {
        n = put_byte(out, n, hex_digit(rt_mem_and(rt_mem_shr(cp, shift), 15)))
        shift = shift - 4
    }
    put_byte(out, n, 125)
}

fn hex_digit(d: Int) -> Int {
    if d < 10 {
        return 48 + d
    }
    87 + d
}

// ---- std.html --------------------------------------------------------------

// The bytes `html_escape` replaces, and what it writes for each: `&`, `<`,
// `>`, `"` and `'`. They are ASCII, so no byte of a longer UTF-8
// sequence is ever one of them.
fn escaped_length(byte: Int) -> Int {
    if byte == 38 {
        return 5
    }
    if byte == 60 || byte == 62 {
        return 4
    }
    if byte == 34 {
        return 6
    }
    if byte == 39 {
        return 5
    }
    1
}

// Write the replacement of `byte` (see `escaped_length`) at `at` of
// `out`: the byte after it.
fn put_escaped(out: Int, at: Int, byte: Int) -> Int {
    if byte == 38 {
        // &amp;
        var n = put_byte(out, at, 38)
        n = put_byte(out, n, 97)
        n = put_byte(out, n, 109)
        n = put_byte(out, n, 112)
        return put_byte(out, n, 59)
    }
    if byte == 60 || byte == 62 {
        // &lt; and &gt;
        var n = put_byte(out, at, 38)
        n = put_byte(out, n, if byte == 60 { 108 } else { 103 })
        n = put_byte(out, n, 116)
        return put_byte(out, n, 59)
    }
    if byte == 34 {
        // &quot;
        var n = put_byte(out, at, 38)
        n = put_byte(out, n, 113)
        n = put_byte(out, n, 117)
        n = put_byte(out, n, 111)
        n = put_byte(out, n, 116)
        return put_byte(out, n, 59)
    }
    if byte == 39 {
        // &#39;
        var n = put_byte(out, at, 38)
        n = put_byte(out, n, 35)
        n = put_byte(out, n, 51)
        n = put_byte(out, n, 57)
        return put_byte(out, n, 59)
    }
    put_byte(out, at, byte)
}

// `std.html`'s `text`: `text` escaped for HTML. The text itself when
// nothing needs escaping.
pub fn html_escape(text: String) -> String {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    var size = 0
    var i = 0
    while i < length {
        size = size + escaped_length(rt_mem_load8(rt_mem_add(data, i)))
        i = i + 1
    }
    if size == length {
        return text
    }
    let result = text_new(size)
    let out = text_data(result)
    var at = 0
    i = 0
    while i < length {
        at = put_escaped(out, at, rt_mem_load8(rt_mem_add(data, i)))
        i = i + 1
    }
    rt_mem_as_text(result)
}

// `Html.concat`: the markup of `a`, then of `b`.
pub fn html_concat(a: String, b: String) -> String {
    debug_concat(a, b)
}

// ---- Scopes and tasks ------------------------------------------------------
//
// A scope object is `[count][closed][head][tail]`, `closed` 0 while its
// block runs; `head` and `tail` are the queue of the tasks spawned and not
// yet started, oldest first, linked through their `next`. A task object is
// `[count][scope][runner][code][result][state][next]` (`lower/tasks.rs`):
// `runner` is the address of the function that runs it, `code` the function
// value to call (0 once it has run), `state` 0 until it has run.

// A new scope, open, with no tasks: its address.
pub fn scope_new() -> Int {
    let object = alloc(32)
    rt_mem_store64(rt_mem_add(object, 8), 0)
    rt_mem_store64(rt_mem_add(object, 16), 0)
    rt_mem_store64(rt_mem_add(object, 24), 0)
    object
}

// A new task of `queue` that runs `code` by `runner`, queued at the end of
// the queue's queue. It has two references: the caller's, and the queue's.
// It holds one to `queue` and takes over the caller's to `code`.
pub fn task_new(queue: Int, runner: Int, code: Int) -> Int {
    let task = alloc(56)
    rt_mem_store64(task, 2)
    rt_mem_store64(queue, rt_mem_add(rt_mem_load64(queue), 1))
    rt_mem_store64(rt_mem_add(task, 8), queue)
    rt_mem_store64(rt_mem_add(task, 16), runner)
    rt_mem_store64(rt_mem_add(task, 24), code)
    rt_mem_store64(rt_mem_add(task, 32), 0)
    rt_mem_store64(rt_mem_add(task, 40), 0)
    rt_mem_store64(rt_mem_add(task, 48), 0)
    let tail = rt_mem_load64(rt_mem_add(queue, 24))
    if tail == 0 {
        rt_mem_store64(rt_mem_add(queue, 16), task)
    } else {
        rt_mem_store64(rt_mem_add(tail, 48), task)
    }
    rt_mem_store64(rt_mem_add(queue, 24), task)
    task
}

// Take the oldest task of `queue` that has not started off its queue: its
// address, with the queue's reference, or 0 when there is none.
pub fn scope_pop(queue: Int) -> Int {
    let head = rt_mem_load64(rt_mem_add(queue, 16))
    if head == 0 {
        return 0
    }
    let next = rt_mem_load64(rt_mem_add(head, 48))
    rt_mem_store64(rt_mem_add(queue, 16), next)
    if next == 0 {
        rt_mem_store64(rt_mem_add(queue, 24), 0)
    }
    head
}

// ---- Files -----------------------------------------------------------------
//
// Directory and file capabilities, confined as the interpreter confines
// them (`oska-run/src/confine.rs`, `host.rs`, `oska-sys`), with the same
// messages:
//
// - A capability is a `Root`: the handle of its directory (for a file
//   capability, of the file's parent, with the file's name), or, when it
//   could not be opened, no handle and the reason, which every operation
//   on it then fails with. `Fs`, `FsRead` and `FsWrite` hold nothing: they
//   only attenuate, and the type says which operations a capability has.
// - A path given to a capability becomes plain names, on the path as
//   written (`confine_names`): empty and absolute paths are refused, `.` is
//   dropped and `..` drops the name before it, refused when there is none.
// - The names are walked beneath the root's handle one at a time, each
//   opened relative to the one before with `openat` and `O_NOFOLLOW`, the
//   last included, so a symlink at any component, planted before or
//   swapped in during the walk, makes it fail. Only a root given as
//   trusted text follows symlinks, and never in its last component.
// - A regular file is read or emptied only after `fstat` on the open
//   handle shows it is one, with one link: a hard link planted beneath a
//   root could otherwise reach a file outside it.
// - Every handle opened is closed on every path, errors included; a
//   capability's own handle is closed with its last reference
//   (`root_drop`).

// A directory or file capability. `handle` is the directory's handle (a
// file capability's parent's), or -1 when `why` says why there is none;
// `path` is the directory's path, for messages; `file` is a file
// capability's file name.
struct Root { handle: Int, path: String, file: Option<String>, why: Option<String> }

// Release the capability at `object`, whose last reference is gone: its
// handle is closed, and the `Root` released as this function ends.
pub fn root_drop(object: Int) {
    let root = rt_mem_as_root(object)
    if root.handle >= 0 {
        close(root.handle)
    }
}

// Close `fd`. Like Rust's `OwnedFd`, never retried: the descriptor is gone
// either way.
fn close(fd: Int) {
    if on_windows() {
        let _ = rt_sys_close_handle(fd)
        return
    }
    let _ = rt_sys_close(fd)
}

// `openat`'s flags, the platform's. `O_RDONLY` is 0.
fn o_wronly() -> Int {
    rt_mem_platform().o_wronly
}

fn o_creat() -> Int {
    rt_mem_platform().o_creat
}

// The system errors `refusal` and `realpath` name: `ELOOP`, whose number
// is the platform's, and the rest, which every Unix Oska targets shares.
fn eloop() -> Int {
    rt_mem_platform().e_loop
}

fn enotdir() -> Int {
    if on_windows() {
        // No Win32 error: what `win_open_name` gives, negated, for a name
        // opened as a directory that is none.
        return 4098
    }
    20
}

fn o_nonblock() -> Int {
    rt_mem_platform().o_nonblock
}

fn o_cloexec() -> Int {
    rt_mem_platform().o_cloexec
}

// A directory to walk beneath: `O_RDONLY | O_DIRECTORY | O_NOFOLLOW |
// O_CLOEXEC`.
fn directory_flags() -> Int {
    if on_windows() {
        return win_directory()
    }
    let platform = rt_mem_platform()
    rt_mem_or(rt_mem_or(platform.o_directory, platform.o_nofollow), o_cloexec())
}

// A directory named by trusted text, following symlinks:
// `O_RDONLY | O_DIRECTORY | O_CLOEXEC`.
fn directory_following_flags() -> Int {
    if on_windows() {
        return win_following()
    }
    rt_mem_or(rt_mem_platform().o_directory, o_cloexec())
}

// A file to read: `O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK`, so a
// FIFO does not block the open (it is then refused as no regular file).
fn file_read_flags() -> Int {
    if on_windows() {
        return win_file_read()
    }
    rt_mem_or(rt_mem_platform().o_nofollow, rt_mem_or(o_cloexec(), o_nonblock()))
}

// A file to write, created when missing but not truncated before it is
// known to be a regular file with one link:
// `O_WRONLY | O_CREAT | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK`.
fn file_write_flags() -> Int {
    if on_windows() {
        return win_file_write()
    }
    rt_mem_or(rt_mem_or(o_wronly(), o_creat()), file_read_flags())
}

fn at_cwd() -> Int {
    rt_mem_platform().at_fdcwd
}

// Not an `errno`: what `open_name` gives, negated, for a name holding a
// NUL byte.
fn nul_in_name() -> Int {
    4096
}

// A NUL-terminated copy of `text`: a text object whose bytes are `text`'s
// then a 0, which the caller frees, or 0 when `text` holds a NUL byte.
fn c_string(text: String) -> Int {
    let object = rt_mem_text(text)
    let length = text_length(object)
    var i = 0
    while i < length {
        if rt_mem_load8(rt_mem_add(text_data(object), i)) == 0 {
            return 0
        }
        i = i + 1
    }
    let copy = text_new(length + 1)
    copy_bytes(text_data(copy), text_data(object), length)
    rt_mem_store8(rt_mem_add(text_data(copy), length), 0)
    copy
}

// `openat(dirfd, name, flags)`, with mode 0o666 for a file it creates,
// retried when a signal interrupts it: the new descriptor, or minus the
// `errno` (`nul_in_name` for a name holding a NUL byte).
fn open_name(dirfd: Int, name: String, flags: Int) -> Int {
    if on_windows() {
        return win_open_name(dirfd, name, flags)
    }
    let path = c_string(name)
    if path == 0 {
        return 0 - nul_in_name()
    }
    var fd = rt_sys_openat(dirfd, text_data(path), flags, 438)
    while interrupted(fd) {
        fd = rt_sys_openat(dirfd, text_data(path), flags, 438)
    }
    free(path)
    fd
}

// The text of the error a system call gave as `errno`, in Oska's words.
fn os_error(errno: Int) -> String {
    if errno == nul_in_name() {
        // On Windows only a root's trusted path meets it: Rust's own
        // words, which the interpreter's `OpenOptions::open` gives.
        if on_windows() {
            return "strings passed to WinAPI cannot contain NULs"
        }
        return "a path holds a NUL byte, which no file name may"
    }
    errno_message(errno)
}

// The error for opening `path` (the names walked so far, joined) as a
// directory when `directory`, else as a file, failing with `errno`: a
// symlink said plainly, since `openat` reports one met with `O_NOFOLLOW`
// as `ELOOP`, or as `ENOTDIR` when a directory was asked for.
fn refusal(errno: Int, path: String, directory: Bool) -> IoError {
    if errno == not_single_name() {
        let name = last_name(path)
        return io_error_text("`{name}` is not a single file name")
    }
    if errno == name_too_long() {
        return io_error_text("`{path}`: a file name is too long")
    }
    if errno == eloop() {
        return io_error_text("`{path}` is a symlink, and confined access never follows one")
    }
    if errno == enotdir() && directory {
        return io_error_text("`{path}` is a symlink or not a directory, and confined access never follows a symlink")
    }
    let why = os_error(errno)
    io_error_text("`{path}`: {why}")
}

// ---- Paths as written ------------------------------------------------------

// The plain names `path` walks beneath a root, with `.` and `..` resolved
// as written, or why it is refused: it is empty, absolute, or climbs above
// the root. No names means the root itself.
fn confine_names(path: String) -> Result<List<String>, IoError> {
    if path == "" {
        return Err(io_error_text("an empty path names no file"))
    }
    if on_windows() {
        return win_confine_names(path)
    }
    if path.starts_with("/") {
        return Err(io_error_text("`{path}` is absolute; a directory capability takes paths relative to its root"))
    }
    var names: List<String> = []
    for part in path.split("/") {
        if part == "" || part == "." {
            continue
        }
        if part == ".." {
            if names.len() == 0 {
                return Err(io_error_text("`{path}` leads outside the capability's root"))
            }
            names = all_but_last(names)
            continue
        }
        names.push(part)
    }
    Ok(names)
}

// The names a write, `create_dir` or a file capability walks: as
// `confine_names` gives them, when `path` as written ends in a plain name,
// not in `/`, `.` or `..`, which would otherwise name the directory before
// them.
fn names_to_create(path: String) -> Result<List<String>, IoError> {
    let names = confine_names(path)?
    if on_windows() {
        if !win_ends_in_a_name(path) {
            return Err(io_error_text("`{path}` does not end in a file name; a write, a new directory or a file needs one"))
        }
        return Ok(names)
    }
    let parts = path.split("/")
    let last = parts.at(parts.len() - 1)
    if last == "" || last == "." || last == ".." {
        return Err(io_error_text("`{path}` does not end in a file name; a write, a new directory or a file needs one"))
    }
    Ok(names)
}

// The first `count` of `names`.
fn first_names(names: List<String>, count: Int) -> List<String> {
    var kept: List<String> = []
    var i = 0
    while i < count {
        kept.push(names.at(i))
        i = i + 1
    }
    kept
}

fn all_but_last(names: List<String>) -> List<String> {
    first_names(names, names.len() - 1)
}

// The first `count` of `names` joined with `/`, for messages.
fn joined(names: List<String>, count: Int) -> String {
    "/".join(first_names(names, count))
}

// The components of the trusted path `path`, as Rust's `Path::components`
// gives them on Unix: `/` first for an absolute path, `.` only as the
// first component of a relative one, then every name and `..`; empty
// components and every other `.` dropped.
fn components(path: String) -> List<String> {
    var parts: List<String> = []
    if path.starts_with("/") {
        parts.push("/")
    }
    var first = true
    for piece in path.split("/") {
        if piece == "." && first {
            parts.push(".")
        } else if piece != "" && piece != "." {
            parts.push(piece)
        }
        first = false
    }
    parts
}

// The components of a root's trusted `path`: on Windows as Rust's
// `Path::components` gives them there (`win_components`), elsewhere as on
// Unix (`components`).
fn root_components(path: String) -> List<String> {
    if on_windows() {
        return win_components(path)
    }
    components(path)
}

// The components of the trusted path `path` as Rust's `Path::components`
// gives them on Windows, where `/` separates as `\` does: a prefix first
// (`C:`, `\\server\share` or `\\?\C:`), then `\` when the path is
// absolute, `.` only as the first component of a relative one, then every
// name and `..`; empty components and every other `.` dropped.
fn win_components(path: String) -> List<String> {
    let text = win_backslashed(path)
    let length = text_length(rt_mem_text(text))
    var parts: List<String> = []
    var at = 0
    if length >= 2 && byte_at(text, 0) == 92 && byte_at(text, 1) == 92 {
        // A UNC or verbatim prefix: `\\` and the two pieces after it.
        at = 2
        var pieces = 0
        while at < length {
            if byte_at(text, at) == 92 {
                pieces = pieces + 1
                if pieces == 2 {
                    break
                }
            }
            at = at + 1
        }
        parts.push(bytes_of(text, 0, at))
        parts.push("\\")
    } else if length >= 2 && byte_at(text, 1) == 58 && ascii_letter(byte_at(text, 0)) {
        parts.push(bytes_of(text, 0, 2))
        at = 2
        if at < length && byte_at(text, at) == 92 {
            parts.push("\\")
        }
    } else if length >= 1 && byte_at(text, 0) == 92 {
        parts.push("\\")
    }
    var first = parts.len() == 0
    for piece in bytes_of(text, at, length).split("\\") {
        if piece == "." && first {
            parts.push(".")
        } else if piece != "" && piece != "." {
            parts.push(piece)
        }
        first = false
    }
    parts
}

// `confine_names` on Windows, where Rust's `Path::components` reads a
// path: `\\` separates as `/` does, and a path starting with a prefix
// (`C:`, `\\server\share`) or `\\` is absolute.
fn win_confine_names(path: String) -> Result<List<String>, IoError> {
    let parts = win_components(path)
    if parts.len() > 0 && (parts.at(0) == "\\" || win_prefix(parts.at(0))) {
        return Err(io_error_text("`{path}` is absolute; a directory capability takes paths relative to its root"))
    }
    var names: List<String> = []
    for part in parts {
        if part == "." {
            continue
        }
        if part == ".." {
            if names.len() == 0 {
                return Err(io_error_text("`{path}` leads outside the capability's root"))
            }
            names = all_but_last(names)
            continue
        }
        names.push(part)
    }
    Ok(names)
}

// Whether `path` as written ends in a plain name on Windows: not in `/`
// or `\\`, `.` or `..`, and not in a name Rust reads as a drive (`a:b`).
fn win_ends_in_a_name(path: String) -> Bool {
    let pieces = win_backslashed(path).split("\\")
    let last = pieces.at(pieces.len() - 1)
    let length = text_length(rt_mem_text(last))
    let drive = length >= 2 && byte_at(last, 1) == 58 && ascii_letter(byte_at(last, 0))
    !(last == "" || last == "." || last == ".." || drive)
}

// Whether `byte` is an ASCII letter, as a drive letter is.
fn ascii_letter(byte: Int) -> Bool {
    byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122
}

// Whether the component `part` is a Windows prefix: a drive (`C:`), or a
// UNC or verbatim one (`\\...`).
fn win_prefix(part: String) -> Bool {
    let length = text_length(rt_mem_text(part))
    length == 2 && byte_at(part, 1) == 58 || length > 2 && byte_at(part, 0) == 92 && byte_at(part, 1) == 92
}

// `path`, of the components `parts`, as a message shows it: on Windows
// with `/` for `\\` unless it starts with a prefix, which is shown as it
// is (the interpreter's `shown`).
fn shown_root(parts: List<String>, path: String) -> String {
    if on_windows() && !(parts.len() > 0 && win_prefix(parts.at(0))) {
        return byte_swapped(path, 92, 47)
    }
    path
}

// The first `count` of the Windows components `parts` as one path again,
// as Rust collects them into a `PathBuf` there.
fn win_path_of(parts: List<String>, count: Int) -> String {
    var out = ""
    var apart = false
    var i = 0
    while i < count {
        let part = parts.at(i)
        if part == "\\" {
            out = "{out}\\"
            apart = false
        } else if i == 0 && win_prefix(part) {
            out = part
        } else {
            out = if apart { "{out}\\{part}" } else { "{out}{part}" }
            apart = true
        }
        i = i + 1
    }
    out
}

// The first `count` of the components `parts` as one path again, as Rust
// collects them into a `PathBuf`.
fn path_of(parts: List<String>, count: Int) -> String {
    if on_windows() {
        return win_path_of(parts, count)
    }
    if count > 0 && parts.at(0) == "/" {
        var rest: List<String> = []
        var i = 1
        while i < count {
            rest.push(parts.at(i))
            i = i + 1
        }
        let tail = "/".join(rest)
        return "/{tail}"
    }
    joined(parts, count)
}

// The last of the components `parts`, when it is a name (not `/`, `.` or
// `..`): Rust's `Path::file_name`.
fn file_name(parts: List<String>) -> Option<String> {
    let last = parts.at(parts.len() - 1)
    if last == "/" || last == "." || last == ".." {
        return None
    }
    if on_windows() && (last == "\\" || parts.len() == 1 && win_prefix(last)) {
        return None
    }
    Some(last)
}

// `parent`, the leading part of a trusted path, or the current directory
// when it is empty.
fn or_here(parent: String) -> String {
    if parent == "" {
        return "."
    }
    parent
}

// `root`'s path joined with `names`, as Rust's `Path::join` joins them.
fn path_beneath(root: String, names: List<String>) -> String {
    // A real Windows root (`\\?\C:\...`) is joined as Rust's `Path::join`
    // joins it there, with `\`.
    if on_windows() && !root.starts_with("/") {
        let rest = "\\".join(names)
        if root.ends_with("\\") {
            return "{root}{rest}"
        }
        return "{root}\\{rest}"
    }
    let rest = "/".join(names)
    if root.ends_with("/") {
        return "{root}{rest}"
    }
    "{root}/{rest}"
}

// The text of `path`.
fn path_text(path: Path) -> String {
    let raw = rt_mem_load64(rt_mem_add(rt_mem_path(path), 8))
    retain(raw)
    rt_mem_as_text(raw)
}

// ---- Opening ---------------------------------------------------------------

// The directory at the trusted `path`, relative to the working directory
// when it is not absolute, following every symlink on the way: a new
// handle.
fn open_following(path: String) -> Result<Int, IoError> {
    let fd = open_name(at_cwd(), path, directory_following_flags())
    if fd < 0 {
        let why = os_error(0 - fd)
        let shown = if on_windows() { win_backslashed(path) } else { path }
        return Err(io_error_text("`{shown}`: {why}"))
    }
    Ok(fd)
}

// The canonical path of the trusted `path` as the interpreter names a root
// by it: Rust's `fs::canonicalize`, which is the C library's `realpath`
// (`real_path`), shown as Rust's `Path::display` shows it, with each
// ill-formed UTF-8 sequence replaced by U+FFFD (`utf8_lossy`).
fn canonical(path: String) -> Result<String, IoError> {
    match real_path(path) {
        Ok(raw) => Ok(utf8_lossy(raw))
        Err(errno) => Err(io_error(errno))
    }
}

// The root directory open as `fd`, which the trusted `path` named, named by
// its canonical path; or, when that cannot be found, the error, with `fd`
// closed.
fn named_root(fd: Int, path: String) -> Result<Root, IoError> {
    if on_windows() {
        // Rust's `fs::canonicalize` on Windows is the final path of the
        // open handle; the last component was opened not following.
        return match win_final_path(fd) {
            Ok(shown) => Ok(directory_root(fd, shown))
            Err(e) => {
                close(fd)
                Err(e)
            }
        }
    }
    match canonical(path) {
        Ok(shown) => Ok(directory_root(fd, shown))
        Err(e) => {
            close(fd)
            Err(e)
        }
    }
}

// The bytes `from..to` of `text`, as a text that need not be UTF-8.
fn bytes_of(text: String, from: Int, to: Int) -> String {
    text_from(rt_mem_add(text_data(rt_mem_text(text)), from), to - from)
}

// The byte at `at` of `text`.
fn byte_at(text: String, at: Int) -> Int {
    rt_mem_load8(rt_mem_add(text_data(rt_mem_text(text)), at))
}

// The working directory, from the kernel, or an errno.
fn working_directory() -> Result<String, Int> {
    let buffer = alloc(4104)
    let data = rt_mem_add(buffer, 8)
    let got = rt_sys_getcwd(data, 4096)
    if got < 0 {
        free(buffer)
        return Err(0 - got)
    }
    // A path that does not start with `/` names a directory outside this
    // process's root: the C library's `getcwd` fails with `ENOENT` for it.
    if rt_mem_load8(data) != 47 {
        free(buffer)
        return Err(2)
    }
    var length = 1
    while rt_mem_load8(rt_mem_add(data, length)) != 0 {
        length = length + 1
    }
    let cwd = text_from(data, length)
    free(buffer)
    Ok(cwd)
}

// The target of the symlink at the absolute path `path`, or an errno:
// `EINVAL` for anything that is not a symlink.
fn link_target(path: String) -> Result<String, Int> {
    let name = c_string(path)
    let buffer = alloc(4104)
    let data = rt_mem_add(buffer, 8)
    let length = rt_sys_readlinkat(at_cwd(), text_data(name), data, 4096)
    free(name)
    if length < 0 {
        free(buffer)
        return Err(0 - length)
    }
    let target = text_from(data, length)
    free(buffer)
    Ok(target)
}

// The trusted `path` made absolute, with every symlink on the way replaced
// by its target and `.` and `..` resolved, as the C library's `realpath` does:
// component by component from the working directory (or `/`), each
// appended and read as a link; a link's target is spliced in front of what
// is left (from `/` again when it is absolute), at most 40 times
// (`ELOOP`); `..` drops the last component. The bytes need not be UTF-8.
// Fails with an errno, as `realpath` does, except that it does not check
// that a name followed by `/..` is a directory: every caller has just
// opened the path as one.
fn real_path(path: String) -> Result<String, Int> {
    if path == "" {
        return Err(2)
    }
    var dest = "/"
    if byte_at(path, 0) != 47 {
        dest = working_directory()?
    }
    var rest = path
    var at = 0
    var links = 0
    while true {
        let length = text_length(rt_mem_text(rest))
        while at < length && byte_at(rest, at) == 47 {
            at = at + 1
        }
        if at >= length {
            break
        }
        var end = at
        while end < length && byte_at(rest, end) != 47 {
            end = end + 1
        }
        let name = bytes_of(rest, at, end)
        if name == ".." {
            dest = parent_path(dest)
        } else if name != "." {
            var candidate = "{dest}/{name}"
            if dest == "/" {
                candidate = "/{name}"
            }
            match link_target(candidate) {
                Ok(target) => {
                    links = links + 1
                    if links > 40 {
                        return Err(eloop())
                    }
                    let left = bytes_of(rest, end, length)
                    rest = "{target}{left}"
                    end = 0
                    if byte_at(target, 0) == 47 {
                        dest = "/"
                    }
                }
                Err(errno) => {
                    if errno != 22 {
                        return Err(errno)
                    }
                    dest = candidate
                }
            }
        }
        at = end
    }
    Ok(dest)
}

// The absolute `path`, a canonical one, without its last component: `/`
// stays `/`.
fn parent_path(path: String) -> String {
    var last = text_length(rt_mem_text(path)) - 1
    while last > 0 && byte_at(path, last) != 47 {
        last = last - 1
    }
    if last == 0 {
        return "/"
    }
    bytes_of(path, 0, last)
}

// `text`, whose bytes need not be UTF-8, as Rust's `String::from_utf8_lossy`
// makes it: each maximal ill-formed subpart (a lead byte and as many of its
// continuation bytes as are valid so far, or one stray byte) replaced by
// U+FFFD.
fn utf8_lossy(text: String) -> String {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    if utf8_valid(data, length) {
        return text
    }
    // At most three bytes out for each byte in.
    let buffer = alloc(8 + 3 * length)
    let out = rt_mem_add(buffer, 8)
    var written = 0
    var i = 0
    while i < length {
        let b = rt_mem_load8(rt_mem_add(data, i))
        var take = 1
        var valid = b < 128
        if !valid {
            var need = 0
            var low = 128
            var high = 191
            if b >= 194 && b <= 223 {
                need = 1
            } else if b == 224 {
                need = 2
                low = 160
            } else if b >= 225 && b <= 239 {
                need = 2
                if b == 237 {
                    high = 159
                }
            } else if b == 240 {
                need = 3
                low = 144
            } else if b >= 241 && b <= 243 {
                need = 3
            } else if b == 244 {
                need = 3
                high = 143
            }
            var good = need > 0
            var k = 1
            while good && k <= need {
                if i + k >= length {
                    good = false
                } else {
                    let next = rt_mem_load8(rt_mem_add(data, i + k))
                    var top = 191
                    var bottom = 128
                    if k == 1 {
                        bottom = low
                        top = high
                    }
                    if next < bottom || next > top {
                        good = false
                    } else {
                        k = k + 1
                    }
                }
            }
            take = k
            valid = good
        }
        if valid {
            copy_bytes(rt_mem_add(out, written), rt_mem_add(data, i), take)
            written = written + take
        } else {
            // U+FFFD in UTF-8.
            rt_mem_store8(rt_mem_add(out, written), 239)
            rt_mem_store8(rt_mem_add(out, written + 1), 191)
            rt_mem_store8(rt_mem_add(out, written + 2), 189)
            written = written + 3
        }
        i = i + take
    }
    let result = text_from(out, written)
    free(buffer)
    result
}

// The directory reached by walking the first `count` of `names` beneath
// `root`, each a directory and none a symlink: a new handle, or `root`
// itself when `count` is 0.
fn walk(root: Int, names: List<String>, count: Int) -> Result<Int, IoError> {
    var at = root
    var i = 0
    while i < count {
        let fd = open_name(at, names.at(i), directory_flags())
        if at != root {
            close(at)
        }
        if fd < 0 {
            return Err(refusal(0 - fd, joined(names, i + 1), true))
        }
        at = fd
        i = i + 1
    }
    Ok(at)
}

// The directory reached by walking `names` beneath `root`, none a
// symlink: a new handle, a copy of `root`'s when there are no names.
fn open_dir(root: Int, names: List<String>) -> Result<Int, IoError> {
    let count = names.len()
    if count == 0 && on_windows() {
        let fd = win_open_name(root, ".", win_directory())
        if fd < 0 {
            return Err(io_error(0 - fd))
        }
        return Ok(fd)
    }
    if count == 0 {
        // `F_DUPFD_CLOEXEC`, from 3 up, as Rust's `try_clone`.
        let fd = rt_sys_fcntl(root, rt_mem_platform().f_dupfd_cloexec, 3)
        if fd < 0 {
            return Err(io_error(0 - fd))
        }
        return Ok(fd)
    }
    let parent = walk(root, names, count - 1)?
    let fd = open_name(parent, names.at(count - 1), directory_flags())
    if parent != root {
        close(parent)
    }
    if fd < 0 {
        return Err(refusal(0 - fd, joined(names, count), true))
    }
    Ok(fd)
}

// The regular file reached by walking `names` (one at least) beneath
// `root`, open with `flags`: every name before the last a directory, and
// none a symlink, the last included. The file has one link (`lone_file`).
fn open_file(root: Int, names: List<String>, flags: Int) -> Result<Int, IoError> {
    let count = names.len()
    let parent = walk(root, names, count - 1)?
    let fd = open_name(parent, names.at(count - 1), flags)
    if parent != root {
        close(parent)
    }
    if fd < 0 {
        return Err(refusal(0 - fd, joined(names, count), false))
    }
    match lone_file(fd, names) {
        Ok(_) => Ok(fd)
        Err(e) => {
            close(fd)
            Err(e)
        }
    }
}

// The unsigned field of `bits` bits (16, 32 or 64) at `at`, such as a
// `struct stat` field whose width the platform's table gives.
fn load_bits(at: Int, bits: Int) -> Int {
    if bits == 16 {
        return rt_mem_load16(at)
    }
    if bits == 32 {
        return rt_mem_load32(at)
    }
    rt_mem_load64(at)
}

// Whether the open `fd`, reached by `names`, is a regular file with only
// that one name. A file with another hard link may be one outside the
// directory the walk began in, so it is refused. The check is on the open
// handle, so the file cannot be swapped after it.
fn lone_file(fd: Int, names: List<String>) -> Result<(), IoError> {
    if on_windows() {
        return win_lone_file(fd, names)
    }
    // A `struct stat`, after the object's count.
    let platform = rt_mem_platform()
    let buffer = alloc(rt_mem_add(platform.stat_bytes, 8))
    let stat = rt_mem_add(buffer, 8)
    let result = rt_sys_fstat(fd, stat)
    let mode = load_bits(rt_mem_add(stat, platform.stat_mode), platform.stat_mode_bits)
    let links = load_bits(rt_mem_add(stat, platform.stat_nlink), platform.stat_nlink_bits)
    free(buffer)
    if result < 0 {
        return Err(io_error(0 - result))
    }
    let path = joined(names, names.len())
    // `S_IFMT` and `S_IFREG`.
    if rt_mem_and(mode, 61440) != 32768 {
        return Err(io_error_text("`{path}` is not a regular file"))
    }
    if links > 1 {
        return Err(io_error_text("`{path}` has more than one hard link, and confined access never opens one"))
    }
    Ok(())
}

// ---- Reading and writing ---------------------------------------------------

// An object holding the bytes of the regular file reached by walking
// `names` beneath `root`: its address. It is a bytes object when `bytes`,
// and otherwise a text object not yet known to be UTF-8.
fn read_raw_beneath(root: Int, names: List<String>, bytes: Bool) -> Result<Int, IoError> {
    let fd = open_file(root, names, file_read_flags())?
    let object = read_all(fd, bytes)
    close(fd)
    object
}

// The text the object at `object`, read from outside, holds, or an error,
// as Rust's `read_to_string` words it, when it is not UTF-8.
fn text_checked(object: Int) -> Result<String, IoError> {
    if !utf8_valid(text_data(object), text_length(object)) {
        free(object)
        return Err(io_error_text("stream did not contain valid UTF-8"))
    }
    Ok(rt_mem_as_text(object))
}

// A new object with room for `capacity` bytes, a bytes object when
// `bytes` and a text object otherwise, or 0 when no memory holds it
// (`try_alloc`): its address. Either keeps its length at offset 8.
fn raw_try_new(capacity: Int, bytes: Bool) -> Int {
    if !bytes {
        return text_try_new(capacity)
    }
    let room = bytes_room(capacity)
    let object = try_alloc(rt_mem_add(24, room))
    if object == 0 {
        return 0
    }
    bytes_init(object, room)
}

// Where the bytes of the object `raw_try_new` made at `object` begin.
fn raw_data(object: Int, bytes: Bool) -> Int {
    if bytes { bytes_data(object) } else { text_data(object) }
}

// Everything left to read from `fd`, in a new object, a bytes object when
// `bytes` and otherwise a text object that may not be UTF-8: its address.
// The bytes are read into it once, never copied whole into another.
fn read_all(fd: Int, bytes: Bool) -> Result<Int, IoError> {
    // Room for the whole file, as `fstat` sizes it, and a little more.
    // Rust reserves it fallibly: a buffer no memory holds (a sparse file of
    // a terabyte) is an `IoError`, "out of memory", not the end of the
    // process.
    var capacity = 64
    if on_windows() {
        let size = win_file_size(fd)
        if size > 0 {
            capacity = rt_mem_add(capacity, size)
        }
    } else {
        let platform = rt_mem_platform()
        let buffer = alloc(rt_mem_add(platform.stat_bytes, 8))
        if rt_sys_fstat(fd, rt_mem_add(buffer, 8)) >= 0 {
            let size = rt_mem_add(buffer, rt_mem_add(platform.stat_size, 8))
            capacity = rt_mem_add(capacity, rt_mem_load64(size))
        }
        free(buffer)
    }
    var object = raw_try_new(capacity, bytes)
    if object == 0 {
        return Err(io_error_text("out of memory"))
    }
    var length = 0
    while true {
        if length == capacity {
            let larger = raw_try_new(rt_mem_shl(capacity, 1), bytes)
            if larger == 0 {
                free(object)
                return Err(io_error_text("out of memory"))
            }
            copy_bytes(raw_data(larger, bytes), raw_data(object, bytes), length)
            free(object)
            object = larger
            capacity = rt_mem_shl(capacity, 1)
        }
        let into = rt_mem_add(raw_data(object, bytes), length)
        let got = if on_windows() { win_read(fd, into, io_count(capacity - length)) } else { rt_sys_read(fd, into, io_count(capacity - length)) }
        if interrupted(got) {
            continue
        }
        if got < 0 {
            free(object)
            return Err(io_error(0 - got))
        }
        if got == 0 {
            break
        }
        length = length + got
    }
    rt_mem_store64(rt_mem_add(object, 8), length)
    Ok(object)
}

// Create the regular file reached by walking `names` beneath `root`, or
// replace what it holds, with `contents`. No name is a symlink, the last
// included, so nothing is created through one; a file already there is
// emptied only once it is known to be a regular one with one link.
fn write_beneath(root: Int, names: List<String>, contents: String) -> Result<(), IoError> {
    let object = rt_mem_text(contents)
    write_raw_beneath(root, names, text_data(object), text_length(object))
}

// `write_beneath` with bytes.
fn write_bytes_beneath(root: Int, names: List<String>, contents: Bytes) -> Result<(), IoError> {
    let object = rt_mem_bytes(contents)
    write_raw_beneath(root, names, bytes_data(object), bytes_length(object))
}

// `write_beneath` with the `count` bytes at `data`.
fn write_raw_beneath(root: Int, names: List<String>, data: Int, count: Int) -> Result<(), IoError> {
    let fd = open_file(root, names, file_write_flags())?
    // On Windows the handle is at the file's start: it ends there.
    var emptied = if on_windows() { rt_sys_set_end_of_file(fd) } else { rt_sys_ftruncate(fd, 0) }
    while interrupted(emptied) {
        emptied = rt_sys_ftruncate(fd, 0)
    }
    if emptied < 0 {
        close(fd)
        return Err(io_error(0 - emptied))
    }
    let written = write_all(fd, data, count)
    close(fd)
    if written < 0 {
        return Err(io_error(0 - written))
    }
    Ok(())
}

// Create the directory reached by walking `names` (one at least) beneath
// `root`, with mode 0o777 less the umask. A directory already there is
// kept; anything else there, a symlink included, is an error.
fn create_dir_beneath(root: Int, names: List<String>) -> Result<(), IoError> {
    let parent = walk(root, names, names.len() - 1)?
    let made = make_dir(parent, names)
    if parent != root {
        close(parent)
    }
    made
}

// Make the last of `names` in the directory `parent`, the rest's.
fn make_dir(parent: Int, names: List<String>) -> Result<(), IoError> {
    if on_windows() {
        return win_make_dir(parent, names)
    }
    let count = names.len()
    let name = names.at(count - 1)
    let path = c_string(name)
    if path == 0 {
        return Err(io_error_text(os_error(nul_in_name())))
    }
    var made = rt_sys_mkdirat(parent, text_data(path), 511)
    while interrupted(made) {
        made = rt_sys_mkdirat(parent, text_data(path), 511)
    }
    free(path)
    if made >= 0 {
        return Ok(())
    }
    if made != -17 {
        return Err(refusal(0 - made, joined(names, count), true))
    }
    // `mkdirat` never follows a symlink in the last component: one there,
    // dangling or not, makes it fail with `EEXIST`. What is there is kept
    // if it opens as a directory, not following a symlink.
    let fd = open_name(parent, name, directory_flags())
    if fd < 0 {
        return Err(refusal(0 - fd, joined(names, count), true))
    }
    close(fd)
    Ok(())
}

// ---- Listing ---------------------------------------------------------------

// The names of the entries of the directory `dir`, without `.` and `..`,
// sorted by their bytes; no entry is followed. Fails when a name is not
// UTF-8, naming the directory as `shown`.
fn entries(dir: Int, shown: String) -> Result<List<String>, IoError> {
    if on_windows() {
        return win_entries(dir, shown)
    }
    // A new open file description of the directory, so the listing starts
    // at its beginning and moves no other handle's offset.
    let fd = open_name(dir, ".", directory_flags())
    if fd < 0 {
        return Err(io_error(0 - fd))
    }
    // The handle owns `fd` from here, if there is one.
    let handle = rt_sys_open_dir(fd)
    if handle < 0 {
        close(fd)
        return Err(io_error(0 - handle))
    }
    let buffer = alloc(32768)
    let data = rt_mem_add(buffer, 8)
    var list = list_new(8)
    let platform = rt_mem_platform()
    // The index of the first name that is not UTF-8, and the `errno` of a
    // failed read.
    var invalid = -1
    var failed = 0
    while true {
        var got = rt_sys_read_dir(handle, data, 32760)
        if interrupted(got) {
            continue
        }
        // The C library's `readdir` takes `ENOENT`, a directory removed
        // while it is read, as its end.
        if got == -2 {
            got = 0
        }
        if got < 0 {
            failed = 0 - got
            break
        }
        if got == 0 {
            break
        }
        // The records read: one at the address `got`, or `got` bytes of
        // them at `data`.
        var at = data
        var end = rt_mem_add(data, got)
        if platform.dirent_one_at_a_time {
            at = got
            end = rt_mem_add(got, rt_mem_load16(rt_mem_add(got, platform.dirent_length)))
        }
        while at < end {
            // A record: its length and NUL-terminated name where the
            // platform's table says.
            let name = rt_mem_add(at, platform.dirent_name)
            var length = 0
            while rt_mem_load8(rt_mem_add(name, length)) != 0 {
                length = length + 1
            }
            let dot = length == 1 && rt_mem_load8(name) == 46
            let dot_dot = length == 2 && rt_mem_load16(name) == 11822
            if !dot && !dot_dot {
                if invalid < 0 && !utf8_valid(name, length) {
                    invalid = rt_mem_load64(rt_mem_add(list, 8))
                }
                list = list_add(list, text_of(name, length))
            }
            at = rt_mem_add(at, rt_mem_load16(rt_mem_add(at, platform.dirent_length)))
        }
    }
    free(buffer)
    let _ = rt_sys_close_dir(handle)
    if invalid < 0 {
        sort_texts(list)
    }
    let names = rt_mem_as_list(list)
    if failed != 0 {
        return Err(io_error(failed))
    }
    if invalid >= 0 {
        let name = os_debug(names.at(invalid))
        return Err(io_error_text("{name} in `{shown}` is not valid UTF-8"))
    }
    Ok(names)
}

// Sort the texts of the list object at `list` by their bytes, in place,
// with a merge sort, bottom up.
fn sort_texts(list: Int) {
    let count = rt_mem_load64(rt_mem_add(list, 8))
    if count < 2 {
        return
    }
    let items = rt_mem_add(list, 24)
    let scratch = alloc(rt_mem_shl(count, 3) + 8)
    var from = items
    var to = rt_mem_add(scratch, 8)
    var width = 1
    while width < count {
        var start = 0
        while start < count {
            var middle = start + width
            if middle > count {
                middle = count
            }
            var end = middle + width
            if end > count {
                end = count
            }
            merge(from, to, start, middle, end)
            start = end
        }
        let was = from
        from = to
        to = was
        width = width * 2
    }
    if from != items {
        copy_bytes(items, from, rt_mem_shl(count, 3))
    }
    free(scratch)
}

// Merge the sorted words `from[start..middle]` and `from[middle..end]`
// into `to[start..end]`, the left first among equals.
fn merge(from: Int, to: Int, start: Int, middle: Int, end: Int) {
    var left = start
    var right = middle
    var out = start
    while out < end {
        var take_left = right >= end
        if left < middle && right < end {
            take_left = !text_before(word_at(from, right), word_at(from, left))
        }
        if take_left {
            rt_mem_store64(rt_mem_add(to, rt_mem_shl(out, 3)), word_at(from, left))
            left = left + 1
        } else {
            rt_mem_store64(rt_mem_add(to, rt_mem_shl(out, 3)), word_at(from, right))
            right = right + 1
        }
        out = out + 1
    }
}

// Word `index` of the words at `words`.
fn word_at(words: Int, index: Int) -> Int {
    rt_mem_load64(rt_mem_add(words, rt_mem_shl(index, 3)))
}

// Whether the text object `a` sorts before `b`, by their bytes.
fn text_before(a: Int, b: Int) -> Bool {
    let a_length = text_length(a)
    let b_length = text_length(b)
    var i = 0
    while i < a_length && i < b_length {
        let x = rt_mem_load8(rt_mem_add(text_data(a), i))
        let y = rt_mem_load8(rt_mem_add(text_data(b), i))
        if x != y {
            return x < y
        }
        i = i + 1
    }
    a_length < b_length
}

// `name`, whose bytes may not be UTF-8, as Rust's `{:?}` writes an
// `OsStr`: as `debug_string` writes text, with each byte that starts no
// well-formed character as `\xHH`.
fn os_debug(name: String) -> String {
    let object = rt_mem_text(name)
    let data = text_data(object)
    let length = text_length(object)
    let total = os_debug_pass(data, length, 0)
    let result = text_new(total)
    let _ = os_debug_pass(data, length, text_data(result))
    rt_mem_as_text(result)
}

// The bytes `os_debug` writes for the `length` bytes at `data`: written to
// `out` unless it is 0, which only counts them.
fn os_debug_pass(data: Int, length: Int, out: Int) -> Int {
    var n = put_byte(out, 0, 34)
    var i = 0
    while i < length {
        let b = rt_mem_load8(rt_mem_add(data, i))
        var size = sequence_length(b)
        if size > length - i {
            size = length - i
        }
        if utf8_valid(rt_mem_add(data, i), size) {
            n = debug_char(rt_mem_add(data, i), size, out, n)
            i = i + size
        } else {
            n = put_byte(out, n, 92)
            n = put_byte(out, n, 120)
            n = put_byte(out, n, upper_hex_digit(rt_mem_shr(b, 4)))
            n = put_byte(out, n, upper_hex_digit(rt_mem_and(b, 15)))
            i = i + 1
        }
    }
    put_byte(out, n, 34)
}

fn upper_hex_digit(d: Int) -> Int {
    if d < 10 {
        return 48 + d
    }
    55 + d
}

// ---- Attenuation -------------------------------------------------------------

// A capability that reaches nothing: every operation on it fails because
// restricting to `at` failed with `message`. Callers pass an `IoError`'s
// message, which is the runtime's own wording around the program's path,
// as `assume_trusted` text: it only ever becomes another `IoError`.
fn nowhere(at: String, message: String) -> Root {
    Root(handle: -1, path: "", file: None, why: Some("cannot restrict to `{at}`: {message}"))
}

// The directory root at `handle`, whose path is `path`.
fn directory_root(handle: Int, path: String) -> Root {
    Root(handle: handle, path: path, file: None, why: None)
}

// `restrict_to(dir)` on `Fs`, `FsRead` and `FsWrite`: the directory
// capability for `dir`, trusted text, opened now. Attenuation never fails:
// a root that cannot be opened gives a capability that reaches nothing.
pub fn fs_restrict_to(fs: Int, dir: String) -> Root {
    if dir == "" {
        return nowhere(dir, "an empty path names no directory")
    }
    if faking() {
        return fake_restrict_to(dir)
    }
    match open_root(dir) {
        Ok(root) => root
        Err(e) => nowhere(dir, e.message.assume_trusted())
    }
}

// The root at the trusted `dir`, a directory whose last component is not a
// symlink; earlier ones are followed.
fn open_root(dir: String) -> Result<Root, IoError> {
    // Without a trailing `/` or `.`, which would follow a symlink in the
    // last component.
    let parts = root_components(dir)
    let path = path_of(parts, parts.len())
    match file_name(parts) {
        Some(name) => {
            let parent = open_following(or_here(path_of(parts, parts.len() - 1)))?
            let fd = open_name(parent, name, directory_flags())
            close(parent)
            if fd < 0 {
                return Err(refusal(0 - fd, name, true))
            }
            named_root(fd, path)
        }
        None => {
            // `/`, or a path ending in `..`: no symlink to refuse.
            let fd = open_following(path)?
            named_root(fd, path)
        }
    }
}

// `restrict_to_file(file)` on `FsRead` and `FsWrite`: the file capability
// for the one file at `file`, trusted text. Its parent is opened now,
// following symlinks; the file itself only at each use.
pub fn fs_restrict_to_file(fs: Int, file: String) -> Root {
    if file == "" {
        return nowhere(file, "an empty path names no file")
    }
    if faking() {
        return fake_restrict_to_file(file)
    }
    let parts = root_components(file)
    match file_name(parts) {
        Some(name) => match open_following(or_here(path_of(parts, parts.len() - 1))) {
            Ok(fd) => Root(handle: fd, path: "", file: Some(name), why: None)
            Err(e) => nowhere(file, e.message.assume_trusted())
        }
        None => {
            let path = shown_root(parts, path_of(parts, parts.len()))
            nowhere(file, "`{path}` does not end in a file name")
        }
    }
}

// `restrict_to(dir)` on `Dir`, `DirRead` and `DirWrite`: the capability
// narrowed to `dir`, a `Path` that may come from untrusted text, walked
// beneath the root like any path read there, so a narrowing never widens.
pub fn dir_restrict_to(root: Root, dir: Path) -> Root {
    if root.why.is_some() {
        return root
    }
    let raw = path_text(dir)
    match confine_names(raw) {
        Ok(names) => {
            if names.len() == 0 {
                return root
            }
            if faking() {
                return fake_restrict_beneath(root, raw, names)
            }
            match win_check_names(names) {
                Ok(_) => match open_dir(root.handle, names) {
                    Ok(fd) => directory_root(fd, path_beneath(root.path, names))
                    Err(e) => nowhere(raw, e.message.assume_trusted())
                }
                Err(e) => nowhere(raw, e.message.assume_trusted())
            }
        }
        Err(e) => nowhere(raw, e.message.assume_trusted())
    }
}

// `restrict_to_file(file)` on `DirRead` and `DirWrite`: the file
// capability for the file at `file` beneath the root, a `Path` that may
// come from untrusted text. The directory holding it is opened now.
pub fn dir_restrict_to_file(root: Root, file: Path) -> Root {
    if root.why.is_some() {
        return root
    }
    let raw = path_text(file)
    match names_to_create(raw) {
        Ok(names) if faking() => fake_restrict_to_file_beneath(root, raw, names)
        Ok(names) => match win_check_names(names) {
            Ok(_) => match open_dir(root.handle, all_but_last(names)) {
                Ok(fd) => Root(handle: fd, path: "", file: Some(names.at(names.len() - 1)), why: None)
                Err(e) => nowhere(raw, e.message.assume_trusted())
            }
            Err(e) => nowhere(raw, e.message.assume_trusted())
        }
        Err(e) => nowhere(raw, e.message.assume_trusted())
    }
}

// ---- Operations ------------------------------------------------------------

// Why `root` reaches nothing, as an error, if it does not.
fn usable(root: Root) -> Result<(), IoError> {
    match root.why {
        Some(why) => Err(io_error_text(why))
        None => Ok(())
    }
}

// A file capability's one name.
fn file_names(root: Root) -> List<String> {
    match root.file {
        Some(name) => [name]
        None => []
    }
}

// `DirRead.read_to_string(path)`.
pub fn dir_read_to_string(root: Root, path: Path) -> Result<String, IoError> {
    let object = dir_read_raw(root, path, false)?
    text_checked(object)
}

// `DirRead.read_bytes(path)`.
pub fn dir_read_bytes(root: Root, path: Path) -> Result<Bytes, IoError> {
    let object = dir_read_raw(root, path, true)?
    Ok(rt_mem_as_bytes(object))
}

// An object holding the bytes of the file a `DirRead` reaches at `path`,
// as `read_raw_beneath` makes one: its address.
fn dir_read_raw(root: Root, path: Path, bytes: Bool) -> Result<Int, IoError> {
    usable(root)?
    let raw = path_text(path)
    let names = confine_names(raw)?
    if names.len() == 0 {
        return Err(io_error_text("`{raw}` names the directory capability's root itself, not a file"))
    }
    if faking() {
        return fake_read(fake_walk(root.path, names)?, bytes)
    }
    win_check_names(names)?
    read_raw_beneath(root.handle, names, bytes)
}

// `DirRead.list_dir(path)`: `.` lists the root.
pub fn dir_list_dir(root: Root, path: Path) -> Result<List<String>, IoError> {
    usable(root)?
    let names = confine_names(path_text(path))?
    if faking() {
        return fake_entries(fake_walk(root.path, names)?)
    }
    win_check_names(names)?
    let fd = open_dir(root.handle, names)?
    let listed = entries(fd, path_beneath_or_at(root.path, names))
    close(fd)
    listed
}

// `root` joined with `names`, or `root` itself when there are none.
fn path_beneath_or_at(root: String, names: List<String>) -> String {
    if names.len() == 0 {
        return root
    }
    path_beneath(root, names)
}

// `DirWrite.write(path, contents)`.
pub fn dir_write(root: Root, path: Path, contents: String) -> Result<(), IoError> {
    usable(root)?
    let names = names_to_create(path_text(path))?
    if faking() {
        return fake_put_file(fake_walk(root.path, names)?, contents)
    }
    win_check_names(names)?
    write_beneath(root.handle, names, contents)
}

// `DirWrite.write_bytes(path, contents)`.
pub fn dir_write_bytes(root: Root, path: Path, contents: Bytes) -> Result<(), IoError> {
    usable(root)?
    let names = names_to_create(path_text(path))?
    if faking() {
        return fake_put_file(fake_walk(root.path, names)?, raw_text_of(contents))
    }
    win_check_names(names)?
    write_bytes_beneath(root.handle, names, contents)
}

// `DirWrite.create_dir(path)`.
pub fn dir_create_dir(root: Root, path: Path) -> Result<(), IoError> {
    usable(root)?
    let names = names_to_create(path_text(path))?
    if faking() {
        return fake_put_dir(fake_walk(root.path, names)?)
    }
    win_check_names(names)?
    create_dir_beneath(root.handle, names)
}

// `FileRead.read_to_string()`.
pub fn file_read_to_string(root: Root) -> Result<String, IoError> {
    let object = file_read_raw(root, false)?
    text_checked(object)
}

// `FileRead.read_bytes()`.
pub fn file_read_bytes(root: Root) -> Result<Bytes, IoError> {
    let object = file_read_raw(root, true)?
    Ok(rt_mem_as_bytes(object))
}

// An object holding the bytes of a `FileRead`'s file, as
// `read_raw_beneath` makes one: its address.
fn file_read_raw(root: Root, bytes: Bool) -> Result<Int, IoError> {
    usable(root)?
    if faking() {
        return fake_read(root.path, bytes)
    }
    read_raw_beneath(root.handle, file_names(root), bytes)
}

// `FileWrite.write(contents)`.
pub fn file_write(root: Root, contents: String) -> Result<(), IoError> {
    usable(root)?
    if faking() {
        return fake_put_file(root.path, contents)
    }
    write_beneath(root.handle, file_names(root), contents)
}

// `FileWrite.write_bytes(contents)`.
pub fn file_write_bytes(root: Root, contents: Bytes) -> Result<(), IoError> {
    usable(root)?
    if faking() {
        return fake_put_file(root.path, raw_text_of(contents))
    }
    write_bytes_beneath(root.handle, file_names(root), contents)
}

// The test host keeps a file's bytes in a text object, UTF-8 or not: the
// one for `contents`.
fn raw_text_of(contents: Bytes) -> String {
    let object = rt_mem_bytes(contents)
    text_from(bytes_data(object), bytes_length(object))
}

// ---- Sockets ---------------------------------------------------------------
//
// The network capabilities (ADR 0023), connecting and listening as the
// interpreter does (`oska-run/src/net.rs`, `oska-sys/src/net.rs`), with the
// same messages on every platform:
//
// - A `HostConnect` and a `LoopbackListen` are a `Sock`, `[count][handle]
//   [host][port][why]`: the handle of the socket, or -1 when there is none
//   (a `HostConnect` holds none, and a closed connection's is -1); the host
//   (a text object) and port; and `why`, the text of why a listener could
//   not listen, which every `accept` on it then fails with, or "". The
//   backend releases one with `sock_drop`, which closes the socket. A
//   `Connection` is `[count][sock]`: the one field `host` of the prelude's
//   struct, a `Sock` whose handle is the open socket, as the interpreter's
//   `Connection` holds its `HostCap` with the stream in it.
// - Every socket is non-blocking. A call that would block waits with `poll`
//   instead, for at most 10 seconds to connect and 30 to send, receive or
//   accept, and fails with `timed out`.
// - Name resolution is not here yet: the Oska stub resolver is a later
//   ticket of spec #228. A host is an IPv4 or IPv6 literal, or `localhost`
//   (::1, then 127.0.0.1); any other well-formed name is `host not found`.
// - A failure's words are `net_wording`'s, from the error's kind, never the
//   system's own text.
//
// No function holds a `Sock` or a `Connection` as a typed value: they are
// words, read and written at their offsets, so that no local is released
// without `sock_drop` closing its socket.

// How long to wait to connect, and to send, receive or accept, in
// milliseconds: `CONNECT_TIMEOUT` and `READ_TIMEOUT` of `oska-sys`.
fn connect_wait() -> Int {
    10000
}

fn read_wait() -> Int {
    30000
}

// The most bytes one `receive` returns: 64 KiB, as the interpreter's.
fn receive_chunk() -> Int {
    65536
}

// The message of an operation a plain test refuses: the interpreter's
// `no_network`, the same on every platform.
fn no_network() -> String {
    "network access is not available here: a plain test is offline"
}

// ---- Sock objects

// A new `Sock`: its address, whose count is 1.
fn sock_new(handle: Int, host: String, port: Int, why: String) -> Int {
    let object = alloc(40)
    let host_object = rt_mem_text(host)
    retain(host_object)
    let why_object = rt_mem_text(why)
    retain(why_object)
    rt_mem_store64(rt_mem_add(object, 8), handle)
    rt_mem_store64(rt_mem_add(object, 16), host_object)
    rt_mem_store64(rt_mem_add(object, 24), port)
    rt_mem_store64(rt_mem_add(object, 32), why_object)
    object
}

fn sock_handle(sock: Int) -> Int {
    rt_mem_load64(rt_mem_add(sock, 8))
}

fn sock_port(sock: Int) -> Int {
    rt_mem_load64(rt_mem_add(sock, 24))
}

// A new reference to the text at word `at` of `sock`.
fn sock_text(sock: Int, at: Int) -> String {
    let object = rt_mem_load64(rt_mem_add(sock, at))
    retain(object)
    rt_mem_as_text(object)
}

// A new `Connection` holding `sock`, whose reference passes to it: its
// address.
fn link_new(sock: Int) -> Int {
    let object = alloc(16)
    rt_mem_store64(rt_mem_add(object, 8), sock)
    object
}

// Release the `HostConnect` or `LoopbackListen` at `object`, whose last
// reference is gone: its socket is closed, and the object is freed. The
// two texts it held are released as this function ends, by the locals that
// take over the references.
pub fn sock_drop(object: Int) {
    let handle = sock_handle(object)
    if handle >= 0 {
        close_socket(handle)
    }
    let host = rt_mem_as_text(rt_mem_load64(rt_mem_add(object, 16)))
    let why = rt_mem_as_text(rt_mem_load64(rt_mem_add(object, 32)))
    free(object)
}

// Close the socket `fd`: never retried, as `close`.
fn close_socket(fd: Int) {
    if on_windows() {
        let _ = rt_sys_close_socket(fd)
        return
    }
    let _ = rt_sys_close(fd)
}

// ---- Wording

// Oska's wording for the kind of failure the socket error `code` (an
// `errno`, or Windows' Winsock error) is, as `oska-sys`'s `describe` words
// it: the same on every platform.
fn net_wording(code: Int) -> String {
    let platform = rt_mem_platform()
    if code == platform.e_refused {
        return "connection refused"
    }
    if code == platform.e_reset || code == platform.e_aborted || code == platform.e_pipe {
        return "connection reset"
    }
    if platform.e_pipe_alt != 0 && code == platform.e_pipe_alt {
        return "connection reset"
    }
    if code == platform.e_timed_out || code == platform.e_would_block {
        return "timed out"
    }
    if code == platform.e_net_unreach {
        return "network unreachable"
    }
    if code == platform.e_host_unreach {
        return "host unreachable"
    }
    "I/O error"
}

// `host:port`, with an IPv6 literal in brackets.
fn shown_address(host: String, port: Int) -> String {
    if host.contains(":") {
        return "[{host}]:{port}"
    }
    "{host}:{port}"
}

// ---- IP addresses
//
// Parsed as Rust's `IpAddr::from_str` does (`std::net::parser`): an IPv4
// address is four decimal numbers of one to three digits, none above 255
// or with a leading zero, and an IPv6 address is up to eight groups of one
// to four hexadecimal digits, with one `::` standing for zeros and an IPv4
// address allowed at the end. No scope, no brackets, no spaces.

// The value of the byte `b` as a digit of `radix`, or -1.
fn ip_digit(b: Int, radix: Int) -> Int {
    var digit = -1
    if b >= 48 && b <= 57 {
        digit = b - 48
    }
    if b >= 97 && b <= 102 {
        digit = b - 87
    }
    if b >= 65 && b <= 70 {
        digit = b - 55
    }
    if digit >= radix {
        return -1
    }
    digit
}

// Read a number of `radix` at byte `at` of the `length` bytes at `data`,
// of at most `max_digits` digits, no more than `largest`, and with no
// leading zero unless `zero_prefix`: the position after it, with its value
// stored at `cell`, or -1.
fn ip_number(data: Int, length: Int, at: Int, radix: Int, max_digits: Int, zero_prefix: Bool, largest: Int, cell: Int) -> Int {
    var value = 0
    var count = 0
    var i = at
    while i < length {
        let digit = ip_digit(rt_mem_load8(rt_mem_add(data, i)), radix)
        if digit < 0 {
            break
        }
        value = value * radix + digit
        count = count + 1
        if count > max_digits {
            return -1
        }
        i = i + 1
    }
    if count == 0 {
        return -1
    }
    if !zero_prefix && count > 1 && rt_mem_load8(rt_mem_add(data, at)) == 48 {
        return -1
    }
    if value > largest {
        return -1
    }
    rt_mem_store64(cell, value)
    i
}

// Read an IPv4 address at byte `at`, its four bytes written to `out`: the
// position after it, or -1.
fn ip4_read(data: Int, length: Int, at: Int, out: Int, cell: Int) -> Int {
    var pos = at
    var i = 0
    while i < 4 {
        if i > 0 {
            if pos >= length || rt_mem_load8(rt_mem_add(data, pos)) != 46 {
                return -1
            }
            pos = pos + 1
        }
        pos = ip_number(data, length, pos, 10, 3, false, 255, cell)
        if pos < 0 {
            return -1
        }
        rt_mem_store8(rt_mem_add(out, i), rt_mem_load64(cell))
        i = i + 1
    }
    pos
}

// Read up to `limit` groups of an IPv6 address from byte `at`, each after
// the first behind a `:`, their bytes written to `out`, an IPv4 address at
// the end counting as two groups. What it gives is `32 * position + 2 *
// groups + 1 if an IPv4 address ended them`: `cell` and the four bytes
// after it are scratch.
fn ip6_groups(data: Int, length: Int, at: Int, out: Int, limit: Int, cell: Int) -> Int {
    var pos = at
    var i = 0
    while i < limit {
        var start = pos
        var separated = true
        if i > 0 {
            if pos < length && rt_mem_load8(rt_mem_add(data, pos)) == 58 {
                start = pos + 1
            } else {
                separated = false
            }
        }
        if !separated {
            return pos * 32 + i * 2
        }
        if i < limit - 1 {
            let tmp = rt_mem_add(cell, 8)
            let end = ip4_read(data, length, start, tmp, cell)
            if end >= 0 {
                let to = rt_mem_add(out, i * 2)
                var k = 0
                while k < 4 {
                    rt_mem_store8(rt_mem_add(to, k), rt_mem_load8(rt_mem_add(tmp, k)))
                    k = k + 1
                }
                return end * 32 + (i + 2) * 2 + 1
            }
        }
        let end = ip_number(data, length, start, 16, 4, true, 65535, cell)
        if end < 0 {
            return pos * 32 + i * 2
        }
        let group = rt_mem_load64(cell)
        rt_mem_store8(rt_mem_add(out, i * 2), rt_mem_shr(group, 8))
        rt_mem_store8(rt_mem_add(out, i * 2 + 1), rt_mem_and(group, 255))
        pos = end
        i = i + 1
    }
    pos * 32 + limit * 2
}

// Whether the `length` bytes at `data` are an IPv6 address, its 16 bytes
// written to `out` (zeroed), with `tail` (16 bytes) and `cell` (16 bytes)
// as scratch.
fn ip6_read(data: Int, length: Int, out: Int, tail: Int, cell: Int) -> Bool {
    let first = ip6_groups(data, length, 0, out, 8, cell)
    var pos = first / 32
    let head = (first % 32) / 2
    if head == 8 {
        return pos == length
    }
    // An IPv4 address may not come before `::`.
    if first % 2 == 1 {
        return false
    }
    if pos + 2 > length {
        return false
    }
    if rt_mem_load8(rt_mem_add(data, pos)) != 58 || rt_mem_load8(rt_mem_add(data, pos + 1)) != 58 {
        return false
    }
    pos = pos + 2
    let second = ip6_groups(data, length, pos, tail, 8 - (head + 1), cell)
    pos = second / 32
    let count = (second % 32) / 2
    var k = 0
    while k < count * 2 {
        rt_mem_store8(rt_mem_add(out, (8 - count) * 2 + k), rt_mem_load8(rt_mem_add(tail, k)))
        k = k + 1
    }
    pos == length
}

// Whether `host` is an IP address: 4 for an IPv4 address, 16 for an IPv6
// one, and 0 for anything else. The address's bytes are written to `out`,
// 16 bytes of which are its own, and the next 24 scratch.
fn ip_parse(host: String, out: Int) -> Int {
    let object = rt_mem_text(host)
    let data = text_data(object)
    let length = text_length(object)
    var i = 0
    while i < 5 {
        rt_mem_store64(rt_mem_add(out, i * 8), 0)
        i = i + 1
    }
    let cell = rt_mem_add(out, 32)
    let end = ip4_read(data, length, 0, out, cell)
    if end >= 0 && end == length {
        return 4
    }
    rt_mem_store64(out, 0)
    let tail = rt_mem_add(out, 16)
    if ip6_read(data, length, out, tail, cell) {
        return 16
    }
    0
}

// Whether `host` is a DNS name: dot-separated labels of letters, digits,
// `-` and `_`, none empty or over 63 bytes, with an optional final dot, in
// at most 253 bytes.
fn is_dns_name(host: String) -> Bool {
    let object = rt_mem_text(host)
    let data = text_data(object)
    var length = text_length(object)
    if length > 0 && rt_mem_load8(rt_mem_add(data, length - 1)) == 46 {
        length = length - 1
    }
    if length == 0 || length > 253 {
        return false
    }
    var label = 0
    var i = 0
    while i < length {
        let b = rt_mem_load8(rt_mem_add(data, i))
        if b == 46 {
            if label == 0 {
                return false
            }
            label = 0
        } else {
            let letter = (b >= 97 && b <= 122) || (b >= 65 && b <= 90)
            let digit = b >= 48 && b <= 57
            if !letter && !digit && b != 45 && b != 95 {
                return false
            }
            label = label + 1
            if label > 63 {
                return false
            }
        }
        i = i + 1
    }
    label > 0
}

// ---- Socket addresses

// The bytes of a `struct sockaddr_in` (16) or `sockaddr_in6` (28) for the
// IPv4 or IPv6 address at `ip` and `port`, in a new object: its address,
// which the caller frees. The bytes start 8 after it.
fn sockaddr_new(v6: Bool, ip: Int, port: Int) -> Int {
    let platform = rt_mem_platform()
    let object = alloc(40)
    let at = rt_mem_add(object, 8)
    var i = 0
    while i < 4 {
        rt_mem_store64(rt_mem_add(at, i * 8), 0)
        i = i + 1
    }
    var family = 2
    var size = 16
    var address = 4
    if v6 {
        family = platform.af_inet6
        size = 28
        address = 8
    }
    if platform.sockaddr_length_byte {
        rt_mem_store8(at, size)
        rt_mem_store8(rt_mem_add(at, 1), family)
    } else {
        rt_mem_store16(at, family)
    }
    rt_mem_store8(rt_mem_add(at, 2), rt_mem_shr(port, 8))
    rt_mem_store8(rt_mem_add(at, 3), rt_mem_and(port, 255))
    var n = 4
    if v6 {
        n = 16
    }
    var k = 0
    while k < n {
        rt_mem_store8(rt_mem_add(at, address + k), rt_mem_load8(rt_mem_add(ip, k)))
        k = k + 1
    }
    object
}

fn sockaddr_size(v6: Bool) -> Int {
    if v6 {
        return 28
    }
    16
}

// ---- Waiting

// Start Winsock on Windows, which every use of a socket needs first; it
// counts its callers, and the process never lets go.
fn socket_start() {
    if on_windows() {
        let object = alloc(512)
        let _ = rt_sys_wsa_startup(514, rt_mem_add(object, 8))
        free(object)
    }
}

// Wait until the socket `fd` has one of `events`, or `ms` milliseconds
// have passed: 1 when it does, 0 when they have, and minus the error when
// the wait fails.
fn wait_ready(fd: Int, events: Int, ms: Int) -> Int {
    let platform = rt_mem_platform()
    let object = alloc(48)
    let entry = rt_mem_add(object, 8)
    rt_mem_store64(entry, 0)
    rt_mem_store64(rt_mem_add(entry, 8), 0)
    if on_windows() {
        rt_mem_store64(entry, fd)
        rt_mem_store16(rt_mem_add(entry, 8), events)
    } else {
        rt_mem_store32(entry, fd)
        rt_mem_store16(rt_mem_add(entry, 4), events)
    }
    var wait = ms
    if platform.poll_timespec {
        let spec = rt_mem_add(object, 24)
        rt_mem_store64(spec, ms / 1000)
        rt_mem_store64(rt_mem_add(spec, 8), (ms % 1000) * 1000000)
        wait = spec
    }
    var ready = rt_sys_poll(entry, 1, wait)
    while interrupted(ready) {
        ready = rt_sys_poll(entry, 1, wait)
    }
    free(object)
    ready
}

// A new non-blocking socket of the IPv4 or IPv6 family: its descriptor, or
// minus the error.
fn socket_open(v6: Bool) -> Int {
    let platform = rt_mem_platform()
    socket_start()
    var domain = 2
    if v6 {
        domain = platform.af_inet6
    }
    let fd = rt_sys_socket(domain, 1, 0)
    if fd < 0 {
        return fd
    }
    var result = 0
    if on_windows() {
        let object = alloc(16)
        rt_mem_store32(rt_mem_add(object, 8), 1)
        // `FIONBIO`.
        result = rt_sys_ioctl_socket(fd, 2147772030, rt_mem_add(object, 8))
        free(object)
    } else {
        result = rt_sys_fcntl(fd, 4, platform.o_nonblock)
    }
    if result < 0 {
        close_socket(fd)
        return result
    }
    fd
}

// Make the accepted socket `fd` non-blocking, as every socket is: 0, or
// minus the error.
fn socket_nonblocking(fd: Int) -> Int {
    if on_windows() {
        let object = alloc(16)
        rt_mem_store32(rt_mem_add(object, 8), 1)
        let result = rt_sys_ioctl_socket(fd, 2147772030, rt_mem_add(object, 8))
        free(object)
        return result
    }
    rt_sys_fcntl(fd, 4, rt_mem_platform().o_nonblock)
}

// The pending error of the socket `fd` (`SO_ERROR`): the error's number, 0
// for none, or minus the error of asking.
fn socket_error(fd: Int) -> Int {
    let platform = rt_mem_platform()
    let object = alloc(24)
    rt_mem_store64(rt_mem_add(object, 8), 0)
    rt_mem_store32(rt_mem_add(object, 16), 4)
    let result = rt_sys_getsockopt(fd, platform.sol_socket, platform.so_error, rt_mem_add(object, 8), rt_mem_add(object, 16))
    let code = rt_mem_load32(rt_mem_add(object, 8))
    free(object)
    if result < 0 {
        return result
    }
    code
}

// ---- Connecting

// A socket connected to the IPv4 or IPv6 address at `ip`, at `port`,
// waiting at most `connect_wait` for it to answer: its descriptor, or minus
// the error.
fn connect_to(v6: Bool, ip: Int, port: Int) -> Int {
    let platform = rt_mem_platform()
    let fd = socket_open(v6)
    if fd < 0 {
        return fd
    }
    let address = sockaddr_new(v6, ip, port)
    let result = rt_sys_connect(fd, rt_mem_add(address, 8), sockaddr_size(v6))
    free(address)
    if result >= 0 {
        return fd
    }
    if result != 0 - platform.e_in_progress && !interrupted(result) {
        close_socket(fd)
        return result
    }
    let ready = wait_ready(fd, platform.poll_out, connect_wait())
    if ready < 0 {
        close_socket(fd)
        return ready
    }
    if ready == 0 {
        close_socket(fd)
        return 0 - platform.e_timed_out
    }
    let code = socket_error(fd)
    if code != 0 {
        close_socket(fd)
        if code > 0 {
            return 0 - code
        }
        return code
    }
    fd
}

// `localhost`, in any case, which the system's hosts file gives as ::1 and
// 127.0.0.1, in that order on every platform Oska targets.
fn is_localhost(host: String) -> Bool {
    string_to_lowercase(host) == "localhost"
}

// Connect to `host` at `port`, as `NetStream::connect`: the socket's
// descriptor, or the text of the error.
fn net_connect(host: String, port: Int) -> Result<Int, String> {
    if port < 1 || port > 65535 {
        return Err("port {port} is out of range: use 1 to 65535")
    }
    let object = alloc(72)
    let ip = rt_mem_add(object, 8)
    let kind = ip_parse(host, ip)
    let shown = shown_address(host, port)
    if kind == 0 && !is_dns_name(host) {
        free(object)
        let name = os_debug(host)
        return Err("invalid host {name}: it is not a DNS name or an IP address")
    }
    var fd = 0
    if kind != 0 {
        fd = connect_to(kind == 16, ip, port)
    } else if is_localhost(host) {
        rt_mem_store8(rt_mem_add(ip, 15), 1)
        fd = connect_to(true, ip, port)
        if fd < 0 {
            rt_mem_store8(rt_mem_add(ip, 15), 0)
            rt_mem_store8(ip, 127)
            rt_mem_store8(rt_mem_add(ip, 3), 1)
            fd = connect_to(false, ip, port)
        }
    } else {
        free(object)
        return Err("cannot connect to {shown}: host not found")
    }
    free(object)
    if fd < 0 {
        let why = net_wording(0 - fd)
        return Err("cannot connect to {shown}: {why}")
    }
    Ok(fd)
}

// ---- Attenuation

// `Net.restrict_to(host, port)` and `NetConnect.restrict_to(host, port)`: the
// host capability. Attenuation never fails.
pub fn net_restrict_to(net: Int, host: String, port: Int) -> Int {
    sock_new(-1, host, port, "")
}

// `HostConnect.name`.
pub fn host_name(host: Int) -> String {
    sock_text(host, 16)
}

// `HostConnect.port`.
pub fn host_port(host: Int) -> Int {
    sock_port(host)
}

// `HostConnect.connect`.
pub fn host_connect(host: Int) -> Result<Int, IoError> {
    let name = sock_text(host, 16)
    let port = sock_port(host)
    if faking() {
        return Err(io_error_text(no_network()))
    }
    match net_connect(name, port) {
        Ok(fd) => Ok(link_new(sock_new(fd, name, port, "")))
        Err(message) => Err(io_error_text(message))
    }
}

// ---- Listening

// A socket listening on the loopback address of the IPv4 or IPv6 family at
// `port`: its descriptor, or minus the error.
fn listen_on(v6: Bool, port: Int) -> Int {
    let platform = rt_mem_platform()
    let fd = socket_open(v6)
    if fd < 0 {
        return fd
    }
    if platform.so_reuseaddr != 0 {
        let object = alloc(16)
        rt_mem_store32(rt_mem_add(object, 8), 1)
        let _ = rt_sys_setsockopt(fd, platform.sol_socket, platform.so_reuseaddr, rt_mem_add(object, 8), 4)
        free(object)
    }
    let ip = alloc(24)
    rt_mem_store64(rt_mem_add(ip, 8), 0)
    rt_mem_store64(rt_mem_add(ip, 16), 0)
    if v6 {
        rt_mem_store8(rt_mem_add(ip, 23), 1)
    } else {
        rt_mem_store8(rt_mem_add(ip, 8), 127)
        rt_mem_store8(rt_mem_add(ip, 11), 1)
    }
    let address = sockaddr_new(v6, rt_mem_add(ip, 8), port)
    free(ip)
    var result = rt_sys_bind(fd, rt_mem_add(address, 8), sockaddr_size(v6))
    free(address)
    if result >= 0 {
        result = rt_sys_listen(fd, 128)
    }
    if result < 0 {
        close_socket(fd)
        return result
    }
    fd
}

// The port the socket `fd` is bound to, or 0.
fn socket_port(fd: Int) -> Int {
    let object = alloc(48)
    let address = rt_mem_add(object, 8)
    rt_mem_store32(rt_mem_add(object, 40), 32)
    let result = rt_sys_getsockname(fd, address, rt_mem_add(object, 40))
    var port = 0
    if result >= 0 {
        port = rt_mem_or(rt_mem_shl(rt_mem_load8(rt_mem_add(address, 2)), 8), rt_mem_load8(rt_mem_add(address, 3)))
    }
    free(object)
    port
}

// `NetListen.restrict_to_loopback(port)`: the listener, which listens now.
// A port that cannot be listened on leaves one whose `accept` fails with
// the reason.
pub fn net_restrict_to_loopback(net: Int, port: Int) -> Int {
    if port < 0 || port > 65535 {
        return sock_new(-1, "loopback", 0, "port {port} is out of range: use 0 to 65535")
    }
    if faking() {
        return sock_new(-1, "loopback", 0, no_network())
    }
    var fd = listen_on(false, port)
    if fd < 0 {
        fd = listen_on(true, port)
    }
    if fd < 0 {
        let why = net_wording(0 - fd)
        return sock_new(-1, "loopback", 0, "listen failed: {why}")
    }
    sock_new(fd, "loopback", socket_port(fd), "")
}

// `LoopbackListen.port`: the port, or 0 when it could not listen.
pub fn loopback_port(listener: Int) -> Int {
    sock_port(listener)
}

// `LoopbackListen.accept`: the next connection, waiting at most 30 seconds.
pub fn loopback_accept(listener: Int) -> Result<Int, IoError> {
    let why = sock_text(listener, 32)
    if why != "" {
        return Err(io_error_text(why))
    }
    let platform = rt_mem_platform()
    let fd = sock_handle(listener)
    while true {
        let ready = wait_ready(fd, platform.poll_in, read_wait())
        if ready < 0 {
            let words = net_wording(0 - ready)
            return Err(io_error_text("accept failed: {words}"))
        }
        if ready == 0 {
            let words = net_wording(platform.e_timed_out)
            return Err(io_error_text("accept failed: {words}"))
        }
        let accepted = rt_sys_accept(fd, 0, 0)
        if accepted == 0 - platform.e_would_block || interrupted(accepted) {
            continue
        }
        if accepted < 0 {
            let words = net_wording(0 - accepted)
            return Err(io_error_text("accept failed: {words}"))
        }
        let blocking = socket_nonblocking(accepted)
        if blocking < 0 {
            close_socket(accepted)
            let words = net_wording(0 - blocking)
            return Err(io_error_text("accept failed: {words}"))
        }
        return Ok(link_new(sock_new(accepted, "loopback", sock_port(listener), "")))
    }
    Err(io_error_text("accept failed: I/O error"))
}

// ---- Connections

// The socket of the `Connection` at `link`.
fn link_sock(link: Int) -> Int {
    rt_mem_load64(rt_mem_add(link, 8))
}

// The error for a connection that `close` ended.
fn closed_error() -> IoError {
    io_error_text("the connection is closed")
}

// `Connection.host`.
pub fn connection_host(link: Int) -> String {
    sock_text(link_sock(link), 16)
}

// `Connection.close`: the socket is closed now, and every later use fails.
pub fn connection_close(link: Int) {
    let sock = link_sock(link)
    let handle = sock_handle(sock)
    if handle >= 0 {
        close_socket(handle)
        rt_mem_store64(rt_mem_add(sock, 8), -1)
    }
}

// Send the `count` bytes at `buf` on the socket `fd`, however many sends it
// takes: 0, or minus the error.
fn socket_send_all(fd: Int, buf: Int, count: Int) -> Int {
    let platform = rt_mem_platform()
    var at = buf
    var left = count
    while left > 0 {
        let wrote = rt_sys_send(fd, at, io_count(left))
        if interrupted(wrote) {
            continue
        }
        if wrote == 0 - platform.e_would_block {
            let ready = wait_ready(fd, platform.poll_out, read_wait())
            if ready < 0 {
                return ready
            }
            if ready == 0 {
                return 0 - platform.e_timed_out
            }
            continue
        }
        if wrote < 0 {
            return wrote
        }
        if wrote == 0 {
            return -5
        }
        at = rt_mem_add(at, wrote)
        left = rt_mem_sub(left, wrote)
    }
    0
}

// Send the `count` bytes at `buf` on the `Connection` at `link`.
fn connection_send_raw(link: Int, buf: Int, count: Int) -> Result<(), IoError> {
    let handle = sock_handle(link_sock(link))
    if handle < 0 {
        return Err(closed_error())
    }
    let result = socket_send_all(handle, buf, count)
    if result < 0 {
        let why = net_wording(0 - result)
        return Err(io_error_text("send failed: {why}"))
    }
    Ok(())
}

// `Connection.send`.
pub fn connection_send(link: Int, body: String) -> Result<(), IoError> {
    let object = rt_mem_text(body)
    connection_send_raw(link, text_data(object), text_length(object))
}

// `Connection.send_bytes`.
pub fn connection_send_bytes(link: Int, body: Bytes) -> Result<(), IoError> {
    let object = rt_mem_bytes(body)
    connection_send_raw(link, bytes_data(object), bytes_length(object))
}

// The next bytes that arrive on the `Connection` at `link`, at most
// `receive_chunk` of them, in a new buffer that the caller frees: the count
// is its word 0 and the bytes follow. No bytes means the other side ended
// the stream.
fn connection_receive_raw(link: Int) -> Result<Int, IoError> {
    let platform = rt_mem_platform()
    let handle = sock_handle(link_sock(link))
    if handle < 0 {
        return Err(closed_error())
    }
    let buffer = alloc(receive_chunk() + 8)
    var got = 0
    while true {
        let ready = wait_ready(handle, platform.poll_in, read_wait())
        if ready < 0 {
            got = ready
            break
        }
        if ready == 0 {
            got = 0 - platform.e_timed_out
            break
        }
        got = rt_sys_recv(handle, rt_mem_add(buffer, 8), receive_chunk())
        if interrupted(got) || got == 0 - platform.e_would_block {
            continue
        }
        break
    }
    if got < 0 {
        free(buffer)
        let why = net_wording(0 - got)
        return Err(io_error_text("receive failed: {why}"))
    }
    rt_mem_store64(buffer, got)
    Ok(buffer)
}

// `Connection.receive`: what arrived, as text, or an error when it is not
// UTF-8.
pub fn connection_receive(link: Int) -> Result<String, IoError> {
    let buffer = connection_receive_raw(link)?
    let got = rt_mem_load64(buffer)
    let text = text_new(got)
    copy_bytes(text_data(text), rt_mem_add(buffer, 8), got)
    free(buffer)
    text_checked(text)
}

// `Connection.receive_bytes`: what arrived, as bytes.
pub fn connection_receive_bytes(link: Int) -> Result<Bytes, IoError> {
    let buffer = connection_receive_raw(link)?
    let got = rt_mem_load64(buffer)
    let bytes = bytes_copy_of(rt_mem_add(buffer, 8), got)
    free(buffer)
    Ok(rt_mem_as_bytes(bytes))
}

// ---- The test host ---------------------------------------------------------
//
// A test executable runs one `test` block per process, the one its only
// argument names (`test_selected`), on the host `test_begin` records
// (`rt_mem_test_host`, which is the constant 0 in a program's
// executable):
//
// - 1, the test host, for a plain test, the interpreter's `FakeHost`: an
//   empty filesystem in memory, a clock fixed at the Unix epoch, and
//   `Random` from the interpreter's fixed seed (`FAKE_SEED`);
// - 2, the real OS, for an `#[integration]` test.
//
// Either way, as the interpreter's `TestHost` does, stdout is recorded for
// `t.printed()`, never written, and every line written to stderr starts
// with the test's name, `[name] `. A panic's report goes to stdout
// (`report_fd`), unlocated, for `oskac` to read back.
//
// The fake filesystem confines as `FakeHost` does: a path given as trusted
// text is resolved against `/` as written; a path given to a directory
// capability becomes plain names (`confine_names`, shared with the real
// OS) walked beneath the root one at a time, each before the last a
// directory. `FakeHost`'s symlinks never exist here: a test's filesystem
// starts empty and no operation makes one, so its symlink refusals cannot
// be met. Its messages are `FakeHost`'s.

// Which host the process runs on: see `rt_mem_test_host`.
fn testing() -> Bool {
    rt_mem_test_host() != 0
}

// Whether the process runs a plain test, on the test host.
fn faking() -> Bool {
    rt_mem_test_host() == 1
}

// The number of the test to run, from the executable's argument, which
// must name one of the `count` tests. Anything else is a usage error.
pub fn test_selected(count: Int) -> Int {
    if rt_mem_load64(global(10)) == 2 {
        let arg = cstr_text(rt_mem_load64(rt_mem_add(rt_mem_load64(global(11)), 8)))
        match arg.parse_int() {
            Some(n) => {
                if n >= 0 && n < count && !arg.starts_with("+") {
                    return n
                }
            }
            None => {}
        }
    }
    let _ = write_text(2, "error: a test executable takes one argument, the number of the test to run, from 0 up to its number of tests\n")
    exit(2)
    0
}

// Start a test: on the host `host` (1 the test host, 2 the real OS), with
// `prefix` before each line it writes to stderr.
pub fn test_begin(host: Int, prefix: String) {
    rt_mem_store64(global(32), host)
    let object = rt_mem_text(prefix)
    retain(object)
    rt_mem_store64(global(33), object)
    rt_mem_store64(global(34), 1)
    let none: List<String> = []
    rt_mem_store64(global(35), rt_mem_list(none))
    rt_mem_store64(global(36), rt_mem_list(none))
    rt_mem_store64(global(37), rt_mem_list(none))
    rt_mem_store64(global(38), rt_mem_list(none))
    put_word_text(52, "")
    rt_mem_store64(global(53), rt_mem_list(none))
    if host == 1 {
        // `FAKE_SEED`, 0x05EE_D0F0_5CA0.
        rt_mem_store64(global(20), 6523265768608)
        rt_mem_store64(global(21), 1)
    }
}

// The list of texts in the runtime's word `index`: a reference of its own.
fn word_list(index: Int) -> List<String> {
    let object = rt_mem_load64(global(index))
    retain(object)
    rt_mem_as_list(object)
}

// The list of texts in the runtime's word `index`, whose reference passes
// to the caller, who gives a list back with `put_word_list`.
fn take_word_list(index: Int) -> List<String> {
    rt_mem_as_list(rt_mem_load64(global(index)))
}

// Keep `list` in the runtime's word `index`.
fn put_word_list(index: Int, list: List<String>) {
    let object = rt_mem_list(list)
    retain(object)
    rt_mem_store64(global(index), object)
}

// A line `Stdout.println` printed: recorded, without its line break.
fn test_record(line: String) {
    var lines = take_word_list(35)
    lines.push(line)
    put_word_list(35, lines)
}

// `TestContext.printed`: every line printed so far.
pub fn test_printed(t: TestContext) -> List<String> {
    word_list(35)
}

// ---- Approvals -------------------------------------------------------------
//
// An `Approval` is the object `Grant`, `[count][summary][details][used]`,
// the prelude's three private fields: only `approver_confirm` makes one,
// and only `approval_consume` writes `used`, in place, so every copy of it
// sees it used, as every copy of the interpreter's has the same number
// (`oska-run`'s `approval.rs`). An `Approver` holds two stateless
// capabilities, so it is `Asker`, `[count][0][0]`, and the runtime decides
// who answers: in a program, the person at the terminal; in a test
// executable, where the only approver is `t.approver`, the test's script,
// in word 52 (the answers still to give, `y` or `n` each), and word 53
// records the questions it was asked.

struct Grant {
    summary: String,
    details: List<String>,
    used: Int,
}

struct Asker {
    stdin: Int,
    stderr: Int,
}

// `Approver.terminal`.
pub fn approver_terminal(stdin: Int, stderr: Int) -> Asker {
    Asker(stdin: stdin, stderr: stderr)
}

// `Approver.confirm`'s question for `summary` and `details`, each line
// with its line break, as the interpreter's `prompt` writes it.
pub fn approval_prompt(summary: String, details: List<String>) -> String {
    let heading = debug_string(summary)
    var text = "approval needed: {heading}\n"
    for detail in details {
        let shown = debug_string(detail)
        text = "{text}  {shown}\n"
    }
    "{text}approve? [y/N]\n"
}

// `Approver.confirm`: `question` is `approval_prompt`'s, which the
// generated code counted under `--max-output`. An approval only on a yes.
pub fn approver_confirm(approver: Int, summary: String, details: List<String>, question: String) -> Option<Grant> {
    if !approval_answer(summary, details, question) {
        return None
    }
    Some(Grant(summary: summary, details: details, used: 0))
}

// Ask `question`, for `summary` and `details`: whether the answer is a
// yes.
fn approval_answer(summary: String, details: List<String>, question: String) -> Bool {
    if testing() {
        // Each question as its summary, how many details it has, and the
        // details (`test_approvals_asked`).
        var asked = take_word_list(53)
        asked.push(summary)
        asked.push(int_text(details.len(), false))
        for detail in details {
            asked.push(detail)
        }
        put_word_list(53, asked)
        let answers = take_word_text(52)
        if answers == "" {
            put_word_text(52, answers)
            return false
        }
        put_word_text(52, answers.slice(1, answers.len()))
        return answers.starts_with("y")
    }
    for line in question.lines() {
        if print_error_line(line) < 0 {
            return false
        }
    }
    match read_stdin_line() {
        Ok(Some(answer)) => {
            let word = answer.trim().to_lowercase()
            word == "y" || word == "yes"
        }
        Ok(None) => false
        Err(_) => false
    }
}

// The approval at `approval`'s summary and details, borrowed.
fn approval_for(approval: Int, summary: String, details: List<String>) -> Bool {
    let approved = rt_mem_load64(rt_mem_add(approval, 8))
    let listed = rt_mem_load64(rt_mem_add(approval, 16))
    // The references `rt_mem_as_text` and `rt_mem_as_list` hand out are
    // released after the use.
    retain(approved)
    retain(listed)
    let text = rt_mem_as_text(approved)
    let list = rt_mem_as_list(listed)
    if text != summary || list.len() != details.len() {
        return false
    }
    var i = 0
    while i < list.len() {
        if list.at(i) != details.at(i) {
            return false
        }
        i = i + 1
    }
    true
}

// `Approval.matches`.
pub fn approval_matches(approval: Int, summary: String, details: List<String>) -> Bool {
    rt_mem_load64(rt_mem_add(approval, 24)) == 0 && approval_for(approval, summary, details)
}

// `Approval.consume`: `Ok` once, marking it used in place.
pub fn approval_consume(approval: Int, summary: String, details: List<String>) -> Result<(), ApprovalError> {
    if rt_mem_load64(rt_mem_add(approval, 24)) != 0 {
        return Err(ApprovalError.Used)
    }
    if !approval_for(approval, summary, details) {
        return Err(ApprovalError.Mismatch)
    }
    rt_mem_store64(rt_mem_add(approval, 24), 1)
    Ok(())
}

// `ApprovalError.to_string`, as the interpreter's.
pub fn approval_error_to_string(e: ApprovalError) -> String {
    match e {
        ApprovalError.Used => "approval already used: one approval covers one action"
        ApprovalError.Mismatch => "approval does not match: it was given for a different action"
    }
}

// `TestContext.answer_approval`: `t.approver`'s next answer. In a
// program, which can build a `TestContext` by hand but whose approvers
// all ask the terminal, it does nothing, as on the interpreter.
pub fn test_answer_approval(t: TestContext, yes: Bool) {
    if !testing() {
        return
    }
    let answers = take_word_text(52)
    var next = "n"
    if yes {
        next = "y"
    }
    put_word_text(52, "{answers}{next}")
}

// What `TestContext.approvals_asked` gives: `ApprovalRequest`'s layout.
struct Asked {
    summary: String,
    details: List<String>,
}

// `TestContext.approvals_asked`: every question `t.approver` was asked.
pub fn test_approvals_asked(t: TestContext) -> List<Asked> {
    var requests: List<Asked> = []
    if !testing() {
        return requests
    }
    let asked = word_list(53)
    var at = 0
    while at < asked.len() {
        let summary = asked.at(at)
        let count = asked.at(at + 1).parse_int().unwrap_or(0)
        var details: List<String> = []
        var k = 0
        while k < count {
            details.push(asked.at(at + 2 + k))
            k = k + 1
        }
        requests.push(Asked(summary: summary, details: details))
        at = at + 2 + count
    }
    requests
}

// The text in the runtime's word `index`, whose reference passes to the
// caller, who gives a text back with `put_word_text`.
fn take_word_text(index: Int) -> String {
    rt_mem_as_text(rt_mem_load64(global(index)))
}

// Keep `text` in the runtime's word `index`.
fn put_word_text(index: Int, text: String) {
    let object = rt_mem_text(text)
    retain(object)
    rt_mem_store64(global(index), object)
}

// `TestContext.assert_snapshot`: the value's `dbg` text, `value`, goes to
// stdout for `oskac` to compare with its snapshot, after `head` (`\x0e`
// and the assertion's span, `start..end `), its length in bytes and a
// line break. Then the call stack, as a panic at the assertion would
// report it: `site`, the frame running now, the running calls, and a line
// break.
pub fn test_snapshot(head: String, value: String, site: String) {
    let length = int_text(text_length(rt_mem_text(value)), false)
    let _ = write_text(1, "{head}{length}\n")
    let _ = write_text(1, value)
    let _ = write_text(1, site)
    if rt_mem_load64(global(50)) != 0 {
        write_frames(1)
    }
    let _ = write_text(1, "\n")
}

// Write the `count` bytes at `data` to stderr, each line after the
// test's prefix: 0, or the negative `errno` of the write that failed.
fn test_stderr(data: Int, count: Int) -> Int {
    let prefix = rt_mem_load64(global(33))
    var at = 0
    while at < count {
        if rt_mem_load64(global(34)) == 1 {
            let failed = write_all(2, text_data(prefix), text_length(prefix))
            if failed < 0 {
                return failed
            }
        }
        var end = at
        while end < count && rt_mem_load8(rt_mem_add(data, end)) != 10 {
            end = end + 1
        }
        if end < count {
            end = end + 1
            rt_mem_store64(global(34), 1)
        } else {
            rt_mem_store64(global(34), 0)
        }
        let failed = write_all(2, rt_mem_add(data, at), end - at)
        if failed < 0 {
            return failed
        }
        at = end
    }
    0
}

// Panic (`P0011`): `start` and `end` are the report around the message.
pub fn panic_assert_eq(start: String, end: String, actual: String, expected: String) {
    let _ = write_text(report_fd(), start)
    let _ = write_text(report_fd(), "assertion failed: `actual == expected`: actual ")
    let _ = write_text(report_fd(), actual)
    let _ = write_text(report_fd(), ", expected ")
    let _ = write_text(report_fd(), expected)
    let _ = write_text(report_fd(), end)
    panic_end()
}

// Panic (`P0012`): `start` and `end` are the report around the message.
pub fn panic_assert_ne(start: String, end: String, both: String) {
    let _ = write_text(report_fd(), start)
    let _ = write_text(report_fd(), "assertion failed: `actual != other`: both are ")
    let _ = write_text(report_fd(), both)
    let _ = write_text(report_fd(), end)
    panic_end()
}

// ---- The test host's filesystem ----------------------------------------------
//
// A file is its path, absolute and resolved, and its contents: words 36
// and 37 hold the paths and the contents, in step. A directory exists when
// it is `/`, holds a file, or was made (word 38).

// The names of the trusted `path`, against `/`, with `.` and `..`
// resolved by hand on the path as written (`FakeHost`'s `normalize`).
fn fake_names(path: String) -> List<String> {
    var names: List<String> = []
    for part in components(path) {
        if part == ".." {
            if names.len() > 0 {
                names = all_but_last(names)
            }
        } else if part != "/" && part != "." {
            names.push(part)
        }
    }
    names
}

// The path of `names` beneath `/`.
fn fake_path(names: List<String>) -> String {
    let rest = "/".join(names)
    "/{rest}"
}

// `dir` joined with `name`.
fn fake_join(dir: String, name: String) -> String {
    if dir == "/" {
        return "/{name}"
    }
    "{dir}/{name}"
}

// The directory holding `path`, which is not `/`.
fn fake_parent(path: String) -> String {
    fake_path(all_but_last(fake_names(path)))
}

// Where the file at `path` is in the files, or -1.
fn fake_file(path: String) -> Int {
    var i = 0
    for file in word_list(36) {
        if file == path {
            return i
        }
        i = i + 1
    }
    -1
}

// Whether there is a directory at `path`.
fn fake_is_dir(path: String) -> Bool {
    if path == "/" {
        return true
    }
    let inside = "{path}/"
    for dir in word_list(38) {
        if dir == path || dir.starts_with(inside) {
            return true
        }
    }
    for file in word_list(36) {
        if file.starts_with(inside) {
            return true
        }
    }
    false
}

fn fake_not_found(path: String) -> IoError {
    io_error_text("no such file or directory: {path}")
}

// The directory root at `path`.
fn fake_root_at(path: String) -> Result<Root, IoError> {
    if fake_file(path) >= 0 {
        return Err(io_error_text("`{path}` is not a directory"))
    }
    if !fake_is_dir(path) {
        return Err(fake_not_found(path))
    }
    Ok(Root(handle: -1, path: path, file: None, why: None))
}

// The root of the file at `path`, whose parent must be a directory.
fn fake_file_root_at(path: String) -> Result<Root, IoError> {
    let names = fake_names(path)
    let _ = fake_root_at(fake_parent(path))?
    Ok(Root(handle: -1, path: path, file: Some(names.at(names.len() - 1)), why: None))
}

// The path `names` reach beneath the directory `root`, each name before
// the last a directory.
fn fake_walk(root: String, names: List<String>) -> Result<String, IoError> {
    var path = root
    var i = 0
    while i < names.len() {
        path = fake_join(path, names.at(i))
        if i + 1 < names.len() && !fake_is_dir(path) {
            return Err(fake_not_found(path))
        }
        i = i + 1
    }
    Ok(path)
}

// `restrict_to(dir)` on `Fs`, `FsRead` and `FsWrite`, `dir` not empty.
fn fake_restrict_to(dir: String) -> Root {
    match fake_root_at(fake_path(fake_names(dir))) {
        Ok(root) => root
        Err(e) => nowhere(dir, e.message.assume_trusted())
    }
}

// `restrict_to_file(file)` on `FsRead` and `FsWrite`, `file` not empty.
fn fake_restrict_to_file(file: String) -> Root {
    let names = fake_names(file)
    if names.len() == 0 {
        return nowhere(file, "`/` does not end in a file name")
    }
    match fake_file_root_at(fake_path(names)) {
        Ok(root) => root
        Err(e) => nowhere(file, e.message.assume_trusted())
    }
}

// `restrict_to(dir)` on a directory capability, `dir` as written being
// `raw` and giving `names`, one at least.
fn fake_restrict_beneath(root: Root, raw: String, names: List<String>) -> Root {
    let opened = match fake_walk(root.path, names) {
        Ok(path) => fake_root_at(path)
        Err(e) => Err(e)
    }
    match opened {
        Ok(narrowed) => narrowed
        Err(e) => nowhere(raw, e.message.assume_trusted())
    }
}

// `restrict_to_file(file)` on a directory capability, `file` as written
// being `raw` and giving `names`, one at least.
fn fake_restrict_to_file_beneath(root: Root, raw: String, names: List<String>) -> Root {
    let opened = match fake_walk(root.path, all_but_last(names)) {
        Ok(parent) => fake_file_root_at(fake_join(parent, names.at(names.len() - 1)))
        Err(e) => Err(e)
    }
    match opened {
        Ok(file) => file
        Err(e) => nowhere(raw, e.message.assume_trusted())
    }
}

// A new object holding the bytes of the file at `path`, as
// `read_raw_beneath` makes one: its address.
fn fake_read(path: String, bytes: Bool) -> Result<Int, IoError> {
    let at = fake_file(path)
    if at < 0 {
        return Err(fake_not_found(path))
    }
    let object = rt_mem_text(word_list(37).at(at))
    let length = text_length(object)
    let copy = raw_try_new(length, bytes)
    if copy == 0 {
        return Err(io_error_text("out of memory"))
    }
    copy_bytes(raw_data(copy, bytes), text_data(object), length)
    rt_mem_store64(rt_mem_add(copy, 8), length)
    Ok(copy)
}

// Write `contents` to the file at `path`, created if need be in its
// parent directory, which must exist.
fn fake_put_file(path: String, contents: String) -> Result<(), IoError> {
    if !fake_is_dir(fake_parent(path)) || fake_is_dir(path) {
        return Err(fake_not_found(path))
    }
    let at = fake_file(path)
    var texts = take_word_list(37)
    if at < 0 {
        var paths = take_word_list(36)
        paths.push(path)
        put_word_list(36, paths)
        texts.push(contents)
        put_word_list(37, texts)
        return Ok(())
    }
    var kept: List<String> = []
    var i = 0
    for text in texts {
        if i == at {
            kept.push(contents)
        } else {
            kept.push(text)
        }
        i = i + 1
    }
    put_word_list(37, kept)
    Ok(())
}

// Create the directory at `path` in its parent directory, which must
// exist. A directory already there is kept; a file there is an error.
fn fake_put_dir(path: String) -> Result<(), IoError> {
    if fake_file(path) >= 0 {
        return Err(io_error_text("a file is already at {path}"))
    }
    if fake_is_dir(path) {
        return Ok(())
    }
    if !fake_is_dir(fake_parent(path)) {
        return Err(fake_not_found(path))
    }
    var dirs = take_word_list(38)
    dirs.push(path)
    put_word_list(38, dirs)
    Ok(())
}

// The names of the entries of the directory at `path`, sorted by their
// bytes: the first name beneath it of every file and directory.
fn fake_entries(path: String) -> Result<List<String>, IoError> {
    if !fake_is_dir(path) {
        return Err(io_error_text("not a directory: {path}"))
    }
    var inside = "{path}/"
    if path == "/" {
        inside = "/"
    }
    var found: List<String> = []
    for entry in word_list(36) {
        if entry.starts_with(inside) {
            found.push(entry.slice(inside.len(), entry.len()).split("/").at(0))
        }
    }
    for entry in word_list(38) {
        if entry.starts_with(inside) {
            found.push(entry.slice(inside.len(), entry.len()).split("/").at(0))
        }
    }
    sort_texts(rt_mem_list(found))
    var names: List<String> = []
    var last = ""
    for name in found {
        if names.len() == 0 || name != last {
            names.push(name)
        }
        last = name
    }
    Ok(names)
}

// ---- Windows ---------------------------------------------------------------
//
// What Windows does differently (ADR 0020). The process has no `argc` and
// `argv`: `win_process_init` makes them, and `envp`, from the command line
// and the environment block, converted from UTF-16 to UTF-8 here, so that
// the rest of `std.rt` reads them as on Linux. Faults reach `on_exception`
// through a vectored exception handler; there is no signal.

// Start-up on Windows: the standard handles, the fault handler at
// `handler` (the backend's entry to `on_exception`), stack for it after a
// stack overflow, and the arguments and environment. An argument that is
// not valid Unicode is refused as on Linux.
fn win_process_init(handler: Int) {
    rt_mem_store64(global(45), win_std_handle(-10))
    rt_mem_store64(global(46), win_std_handle(-11))
    rt_mem_store64(global(47), win_std_handle(-12))
    win_find_consoles()
    let _ = rt_sys_add_exception_handler(1, handler)
    rt_mem_store64(global(48), 65536)
    let _ = rt_sys_stack_guarantee(global(48))
    let argc = win_arguments()
    let argv = rt_mem_load64(global(11))
    win_environment()
    var i = 0
    while i < argc {
        if !cstr_valid(rt_mem_load64(rt_mem_add(argv, rt_mem_shl(i, 3)))) {
            let _ = write_text(report_fd(), "error: a command-line argument is not valid UTF-8\n")
            exit(101)
        }
        i = i + 1
    }
}

// The standard handle `n`, or 0 when there is none: a write to it fails.
fn win_std_handle(n: Int) -> Int {
    let handle = rt_sys_get_std_handle(n)
    if handle < 0 {
        return 0
    }
    handle
}

// The number of UTF-16 units before the NUL at `at`.
fn utf16_length(at: Int) -> Int {
    var n = 0
    while rt_mem_load16(rt_mem_add(at, rt_mem_shl(n, 1))) != 0 {
        n = n + 1
    }
    n
}

// Write the `count` UTF-16 units at `from` as UTF-8 at `to`, which has room
// for 3 bytes a unit: the bytes written. An unpaired surrogate becomes the
// byte 255, which no UTF-8 text has, so the text is refused as invalid.
fn utf16_to_utf8(to: Int, from: Int, count: Int) -> Int {
    var i = 0
    var at = 0
    while i < count {
        let unit = rt_mem_load16(rt_mem_add(from, rt_mem_shl(i, 1)))
        i = i + 1
        if unit >= 55296 && unit < 57344 {
            var paired = false
            if unit < 56320 && i < count {
                let low = rt_mem_load16(rt_mem_add(from, rt_mem_shl(i, 1)))
                if low >= 56320 && low < 57344 {
                    let cp = 65536 + rt_mem_shl(unit - 55296, 10) + (low - 56320)
                    at = at + encode_at(rt_mem_add(to, at), cp)
                    i = i + 1
                    paired = true
                }
            }
            if !paired {
                rt_mem_store8(rt_mem_add(to, at), 255)
                at = at + 1
            }
        } else {
            at = at + encode_at(rt_mem_add(to, at), unit)
        }
    }
    at
}

// Split the command line into `argv` as Microsoft's C runtime does
// ("Parsing C command-line arguments"): the program's name up to a space
// or tab, or between quotes; then arguments between spaces and tabs, where
// quotes group, `""` inside quotes is a quote, and backslashes are literal
// but before a quote, where each pair is one backslash and an odd one
// makes the quote literal. It sets words 10 and 11, as Linux's start does:
// the count.
fn win_arguments() -> Int {
    let line = rt_sys_command_line()
    let units = utf16_length(line)
    let text = map(0, rt_mem_add(rt_mem_mul(units, 3), 8), 3, 0)
    let length = utf16_to_utf8(text, line, units)
    // Each argument and its NUL fits in the text and one more byte per
    // argument; there are at most `length / 2 + 2` of them.
    let out = map(0, rt_mem_add(rt_mem_shl(length, 1), 8), 3, 0)
    let argv = map(0, rt_mem_shl(length + 3, 3), 3, 0)
    var argc = 0
    var o = 0
    var i = 0
    // The program's name.
    rt_mem_store64(argv, out)
    var quoted = false
    while i < length {
        let c = rt_mem_load8(rt_mem_add(text, i))
        if c == 34 {
            quoted = !quoted
        } else if !quoted && (c == 32 || c == 9) {
            break
        } else {
            rt_mem_store8(rt_mem_add(out, o), c)
            o = o + 1
        }
        i = i + 1
    }
    rt_mem_store8(rt_mem_add(out, o), 0)
    o = o + 1
    argc = 1
    while true {
        while i < length && (rt_mem_load8(rt_mem_add(text, i)) == 32 || rt_mem_load8(rt_mem_add(text, i)) == 9) {
            i = i + 1
        }
        if i >= length {
            break
        }
        rt_mem_store64(rt_mem_add(argv, rt_mem_shl(argc, 3)), rt_mem_add(out, o))
        argc = argc + 1
        quoted = false
        while i < length {
            let c = rt_mem_load8(rt_mem_add(text, i))
            if !quoted && (c == 32 || c == 9) {
                break
            }
            if c == 92 {
                var slashes = 0
                while i < length && rt_mem_load8(rt_mem_add(text, i)) == 92 {
                    slashes = slashes + 1
                    i = i + 1
                }
                let before_quote = i < length && rt_mem_load8(rt_mem_add(text, i)) == 34
                var put = slashes
                if before_quote {
                    put = slashes / 2
                }
                var k = 0
                while k < put {
                    rt_mem_store8(rt_mem_add(out, o), 92)
                    o = o + 1
                    k = k + 1
                }
                if before_quote && slashes % 2 == 1 {
                    rt_mem_store8(rt_mem_add(out, o), 34)
                    o = o + 1
                    i = i + 1
                }
                continue
            }
            if c == 34 {
                if quoted && i + 1 < length && rt_mem_load8(rt_mem_add(text, i + 1)) == 34 {
                    rt_mem_store8(rt_mem_add(out, o), 34)
                    o = o + 1
                    i = i + 2
                    continue
                }
                quoted = !quoted
                i = i + 1
                continue
            }
            rt_mem_store8(rt_mem_add(out, o), c)
            o = o + 1
            i = i + 1
        }
        rt_mem_store8(rt_mem_add(out, o), 0)
        o = o + 1
    }
    rt_mem_store64(rt_mem_add(argv, rt_mem_shl(argc, 3)), 0)
    rt_mem_store64(global(10), argc)
    rt_mem_store64(global(11), argv)
    argc
}

// Make `envp` (word 12) from the environment block: its strings, each
// `NAME=value` and NUL-terminated, after the last an empty one.
fn win_environment() {
    let block = rt_sys_environment()
    var count = 0
    var units = 0
    if block > 0 {
        var at = block
        while rt_mem_load16(at) != 0 {
            let n = utf16_length(at)
            count = count + 1
            units = units + n + 1
            at = rt_mem_add(at, rt_mem_shl(n + 1, 1))
        }
    }
    let envp = map(0, rt_mem_shl(count + 1, 3), 3, 0)
    let out = map(0, rt_mem_add(rt_mem_mul(units, 3), 8), 3, 0)
    var o = 0
    var at = block
    var k = 0
    while k < count {
        let n = utf16_length(at)
        rt_mem_store64(rt_mem_add(envp, rt_mem_shl(k, 3)), rt_mem_add(out, o))
        o = o + utf16_to_utf8(rt_mem_add(out, o), at, n)
        rt_mem_store8(rt_mem_add(out, o), 0)
        o = o + 1
        at = rt_mem_add(at, rt_mem_shl(n + 1, 1))
        k = k + 1
    }
    rt_mem_store64(rt_mem_add(envp, rt_mem_shl(count, 3)), 0)
    rt_mem_store64(global(12), envp)
}

// The realtime clock in milliseconds since 1970, from Windows' time in
// 100-nanosecond intervals since 1601.
fn win_now_millis() -> Int {
    let at = global(48)
    let _ = rt_sys_system_time(at)
    (rt_mem_load64(at) - 116444736000000000) / 10000
}

// ---- Windows files ---------------------------------------------------------
//
// Confinement on Windows, as `oska-sys/src/windows.rs` does it for the
// interpreter, with the same refusals: each name is opened beneath its
// parent's handle with `NtCreateFile` and `FILE_OPEN_REPARSE_POINT`, so a
// reparse point (a symlink, a junction, a mount point) is opened itself and
// then refused, in the words Unix uses for a symlink. A file with more
// than one link is refused too. `open_name`'s `flags` are one of the kinds
// below on Windows, and its negative results Win32 errors, or
// `eloop()` (a reparse point), `enotdir()` (no directory) or
// `not_single_name()`.

// The kinds of open: a directory beneath a handle; a directory by trusted
// path, following; a file to read; a file to write, created when missing.
fn win_directory() -> Int {
    1
}

fn win_following() -> Int {
    2
}

fn win_file_read() -> Int {
    3
}

fn win_file_write() -> Int {
    4
}

// No Win32 error: what `win_open_name` gives, negated, for a name that is
// not one plain component (empty, `.`, `..`, or holding `/`, `\`, `:` or
// NUL), which Windows refuses before any call.
fn not_single_name() -> Int {
    4099
}

// No Win32 error: what `win_nt_open` gives, negated, for a name whose
// UTF-16 bytes do not fit a `UNICODE_STRING`'s 16-bit length.
fn name_too_long() -> Int {
    4100
}

// The last component of the names `path` joins.
fn last_name(path: String) -> String {
    let length = text_length(rt_mem_text(path))
    var at = length
    while at > 0 && byte_at(path, at - 1) != 47 {
        at = at - 1
    }
    bytes_of(path, at, length)
}

// `text` with each `/` a `\`, as a trusted path is opened on Windows.
fn win_backslashed(text: String) -> String {
    byte_swapped(text, 47, 92)
}

// `text` with each byte `from` made `to`.
fn byte_swapped(text: String, from: Int, to: Int) -> String {
    let object = rt_mem_text(text)
    let length = text_length(object)
    let copy = text_new(length)
    copy_bytes(text_data(copy), text_data(object), length)
    var i = 0
    while i < length {
        if rt_mem_load8(rt_mem_add(text_data(copy), i)) == from {
            rt_mem_store8(rt_mem_add(text_data(copy), i), to)
        }
        i = i + 1
    }
    rt_mem_as_text(copy)
}

// `text` in UTF-16, NUL-terminated: an object that the caller frees, its
// number of units (without the NUL) at 8 and the units from 16.
fn win_wide(text: String) -> Int {
    let object = rt_mem_text(text)
    let data = text_data(object)
    let length = text_length(object)
    // At most one unit a byte, and the NUL.
    let wide = alloc(rt_mem_and(rt_mem_add(rt_mem_shl(length, 1), 25), -8))
    let units = rt_mem_add(wide, 16)
    var at = 0
    var n = 0
    while at < length {
        let lead = rt_mem_add(data, at)
        let cp = decode_at(lead)
        at = at + sequence_length(rt_mem_load8(lead))
        if cp >= 65536 {
            let rest = cp - 65536
            rt_mem_store16(rt_mem_add(units, rt_mem_shl(n, 1)), 55296 + rt_mem_shr(rest, 10))
            rt_mem_store16(rt_mem_add(units, rt_mem_shl(n + 1, 1)), 56320 + rt_mem_and(rest, 1023))
            n = n + 2
        } else {
            rt_mem_store16(rt_mem_add(units, rt_mem_shl(n, 1)), cp)
            n = n + 1
        }
    }
    rt_mem_store16(rt_mem_add(units, rt_mem_shl(n, 1)), 0)
    rt_mem_store64(rt_mem_add(wide, 8), n)
    wide
}

// The Win32 error for the `NTSTATUS` `status`, negated.

// `NtCreateFile` of the `bytes` bytes of UTF-16 at `units` beneath the
// directory `parent` (the empty name opens `parent` again), with `access`,
// `disposition` and `options`, never following a reparse point, for
// synchronous I/O, names matched as Windows matches them: the handle, or a
// Win32 error, negated.
fn win_nt_open(parent: Int, units: Int, bytes: Int, access: Int, disposition: Int, options: Int) -> Int {
    if bytes > 65535 {
        return 0 - name_too_long()
    }
    // The new handle (8 bytes), an `IO_STATUS_BLOCK` (16), a
    // `UNICODE_STRING` (16) and an `OBJECT_ATTRIBUTES` (48).
    let block = alloc(96)
    let handle = rt_mem_add(block, 8)
    let status = rt_mem_add(block, 16)
    let name = rt_mem_add(block, 32)
    let attributes = rt_mem_add(block, 48)
    rt_mem_store64(handle, 0)
    rt_mem_store16(name, bytes)
    rt_mem_store16(rt_mem_add(name, 2), bytes)
    rt_mem_store32(rt_mem_add(name, 4), 0)
    rt_mem_store64(rt_mem_add(name, 8), if bytes == 0 { 0 } else { units })
    rt_mem_store64(attributes, 48)
    rt_mem_store64(rt_mem_add(attributes, 8), parent)
    rt_mem_store64(rt_mem_add(attributes, 16), name)
    // `OBJ_CASE_INSENSITIVE`.
    rt_mem_store64(rt_mem_add(attributes, 24), 64)
    rt_mem_store64(rt_mem_add(attributes, 32), 0)
    rt_mem_store64(rt_mem_add(attributes, 40), 0)
    // `FILE_ATTRIBUTE_NORMAL`, share read, write and delete, and the
    // options with `FILE_SYNCHRONOUS_IO_NONALERT | FILE_OPEN_REPARSE_POINT`.
    let result = rt_sys_nt_create_file(handle, access, attributes, status, 0, 128, 7, disposition, rt_mem_or(options, 2097184))
    let opened = rt_mem_load64(handle)
    free(block)
    if result < 0 {
        return result
    }
    opened
}

// The attributes of what `handle` opened in the low 32 bits and its number
// of links above them, or a Win32 error, negated.
fn win_info(handle: Int) -> Int {
    // An `IO_STATUS_BLOCK` (16 bytes), `FILE_BASIC_INFORMATION` (40) and
    // `FILE_STANDARD_INFORMATION` (24).
    let block = alloc(88)
    let status = rt_mem_add(block, 8)
    let basic = rt_mem_add(block, 24)
    let standard = rt_mem_add(block, 64)
    var result = rt_sys_nt_query_information_file(handle, status, basic, 40, 4)
    if result >= 0 {
        result = rt_sys_nt_query_information_file(handle, status, standard, 24, 5)
    }
    let attributes = rt_mem_load32(rt_mem_add(basic, 32))
    let links = rt_mem_load32(rt_mem_add(standard, 16))
    free(block)
    if result < 0 {
        return result
    }
    rt_mem_or(attributes, rt_mem_shl(links, 32))
}

// Whether `info` (`win_info`) is a reparse point's, or a directory's.
fn win_reparse_point(info: Int) -> Bool {
    rt_mem_and(info, 1024) != 0
}

fn win_is_dir(info: Int) -> Bool {
    rt_mem_and(info, 16) != 0
}

// The size of the file `handle` opened, or -1.
fn win_file_size(handle: Int) -> Int {
    let block = alloc(48)
    let status = rt_mem_add(block, 8)
    let standard = rt_mem_add(block, 24)
    let result = rt_sys_nt_query_information_file(handle, status, standard, 24, 5)
    let size = rt_mem_load64(rt_mem_add(standard, 8))
    free(block)
    if result < 0 {
        return -1
    }
    size
}

// Whether `name` is one plain component.
fn win_single_name(name: String) -> Bool {
    let object = rt_mem_text(name)
    let length = text_length(object)
    if length == 0 || name == "." || name == ".." {
        return false
    }
    var i = 0
    while i < length {
        let b = rt_mem_load8(rt_mem_add(text_data(object), i))
        if b == 0 || b == 47 || b == 92 || b == 58 {
            return false
        }
        i = i + 1
    }
    true
}

// Whether a reparse point is at the `bytes` bytes of UTF-16 at `units`
// beneath `parent`: an open that asks for more than to look at it may
// fail for its own reasons, so what is there is said plainly.
fn win_reparse_point_at(parent: Int, units: Int, bytes: Int) -> Bool {
    // Read attributes and synchronize; an existing name.
    let there = win_nt_open(parent, units, bytes, 1048704, 1, 0)
    if there < 0 {
        return false
    }
    let info = win_info(there)
    close(there)
    info >= 0 && win_reparse_point(info)
}

// `open_name` on Windows: `name` beneath `dirfd` as the kind `kind` asks,
// or, for `win_following`, the trusted path `name`. `.` opens `dirfd`
// again. A reparse point is refused, and a name opened as a directory
// that is none.
fn win_open_name(dirfd: Int, name: String, kind: Int) -> Int {
    if kind == win_following() {
        return win_open_following(name)
    }
    var access = 1048737
    var disposition = 1
    if kind == win_file_read() {
        // `FILE_GENERIC_READ`.
        access = 1179785
    } else if kind == win_file_write() {
        // `FILE_GENERIC_WRITE | FILE_READ_ATTRIBUTES`, `FILE_OPEN_IF`.
        access = 1180054
        disposition = 3
    }
    var handle = 0
    if name == "." {
        handle = win_nt_open(dirfd, 0, 0, access, disposition, 0)
    } else {
        if !win_single_name(name) {
            return 0 - not_single_name()
        }
        let wide = win_wide(name)
        let units = rt_mem_add(wide, 16)
        let bytes = rt_mem_shl(rt_mem_load64(rt_mem_add(wide, 8)), 1)
        handle = win_nt_open(dirfd, units, bytes, access, disposition, 0)
        if handle < 0 && win_reparse_point_at(dirfd, units, bytes) {
            handle = 0 - eloop()
        }
        free(wide)
        if handle < 0 {
            return handle
        }
    }
    if handle < 0 {
        return handle
    }
    let info = win_info(handle)
    if info < 0 {
        close(handle)
        return info
    }
    if win_reparse_point(info) {
        close(handle)
        return 0 - eloop()
    }
    if kind == win_directory() && !win_is_dir(info) {
        close(handle)
        return 0 - enotdir()
    }
    handle
}

// The directory at the trusted `path`, relative to the working directory
// when it is not absolute, opened as any open by path opens it, following
// reparse points: `CreateFileW` with `FILE_FLAG_BACKUP_SEMANTICS`. Its
// handle, or a Win32 error, negated: `ERROR_DIRECTORY` for anything else.
fn win_open_following(path: String) -> Int {
    if c_string_free(path) {
        return 0 - nul_in_name()
    }
    let wide = win_wide(win_backslashed(path))
    // List, traverse, read attributes and synchronize; share read, write
    // and delete; `OPEN_EXISTING`.
    let handle = rt_sys_create_file(rt_mem_add(wide, 16), 1048737, 7, 0, 3, 33554432, 0)
    free(wide)
    if handle < 0 {
        return handle
    }
    let info = win_info(handle)
    if info < 0 {
        close(handle)
        return info
    }
    if !win_is_dir(info) {
        close(handle)
        return -267
    }
    handle
}

// Whether `text` holds a NUL byte.
fn c_string_free(text: String) -> Bool {
    let object = rt_mem_text(text)
    let length = text_length(object)
    var i = 0
    while i < length {
        if rt_mem_load8(rt_mem_add(text_data(object), i)) == 0 {
            return true
        }
        i = i + 1
    }
    false
}

// The path of what `handle` opened, as Rust's `fs::canonicalize` gives it
// on Windows (`\\?\C:\...`): `GetFinalPathNameByHandleW`, shown lossily.
fn win_final_path(handle: Int) -> Result<String, IoError> {
    // 32767 units, the longest path Windows has, and the NUL.
    let buffer = alloc(65552)
    let units = rt_mem_add(buffer, 8)
    let n = rt_sys_final_path_name(handle, units, 32768, 0)
    if n < 0 {
        free(buffer)
        return Err(io_error(0 - n))
    }
    if n > 32767 {
        free(buffer)
        // `ERROR_FILENAME_EXCED_RANGE`.
        return Err(io_error(206))
    }
    let out = alloc(rt_mem_and(rt_mem_add(rt_mem_mul(n, 3), 15), -8))
    let length = utf16_to_utf8(rt_mem_add(out, 8), units, n)
    let text = text_from(rt_mem_add(out, 8), length)
    free(out)
    free(buffer)
    Ok(utf8_lossy(text))
}

// `lone_file` on Windows: the open `handle`, reached by `names`, is a file
// that is not a directory, with only that one name.
fn win_lone_file(handle: Int, names: List<String>) -> Result<(), IoError> {
    let info = win_info(handle)
    if info < 0 {
        return Err(io_error(0 - info))
    }
    let path = joined(names, names.len())
    if win_is_dir(info) {
        return Err(io_error_text("`{path}` is not a regular file"))
    }
    if rt_mem_shr(info, 32) > 1 {
        return Err(io_error_text("`{path}` has more than one hard link, and confined access never opens one"))
    }
    Ok(())
}

// `make_dir` on Windows: `FILE_CREATE` never follows a reparse point at
// the name; one there, dangling or not, makes it fail as a name taken.
// What is there is kept if it is a directory and not a reparse point.
fn win_make_dir(parent: Int, names: List<String>) -> Result<(), IoError> {
    let count = names.len()
    let name = names.at(count - 1)
    let path = joined(names, count)
    if !win_single_name(name) {
        return Err(refusal(not_single_name(), path, true))
    }
    let wide = win_wide(name)
    let units = rt_mem_add(wide, 16)
    let bytes = rt_mem_shl(rt_mem_load64(rt_mem_add(wide, 8)), 1)
    // `FILE_CREATE`, `FILE_DIRECTORY_FILE`.
    let made = win_nt_open(parent, units, bytes, 1048737, 2, 1)
    var there = false
    if made < 0 && made != -183 && made != -80 {
        there = win_reparse_point_at(parent, units, bytes)
    }
    free(wide)
    if made >= 0 {
        close(made)
        return Ok(())
    }
    // `ERROR_ALREADY_EXISTS`, `ERROR_FILE_EXISTS`.
    if made == -183 || made == -80 {
        let fd = win_open_name(parent, name, win_directory())
        if fd < 0 {
            return Err(refusal(0 - fd, path, true))
        }
        close(fd)
        return Ok(())
    }
    if there {
        return Err(refusal(eloop(), path, true))
    }
    Err(refusal(0 - made, path, true))
}

// `entries` on Windows: `NtQueryDirectoryFile` of a new handle of `dir`,
// so the listing starts at its beginning, with `FileNamesInformation`.
fn win_entries(dir: Int, shown: String) -> Result<List<String>, IoError> {
    let fd = win_open_name(dir, ".", win_directory())
    if fd < 0 {
        return Err(io_error(0 - fd))
    }
    // The entries a call writes, and an `IO_STATUS_BLOCK`.
    let buffer = alloc(65560)
    let status = rt_mem_add(buffer, 8)
    let data = rt_mem_add(buffer, 24)
    var list = list_new(8)
    var invalid = -1
    var failed = 0
    var restart = 1
    while true {
        let result = rt_sys_nt_query_directory_file(fd, 0, 0, 0, status, data, 65536, 12, 0, 0, restart)
        restart = 0
        // `STATUS_NO_MORE_FILES` and `STATUS_NO_SUCH_FILE`, as Win32
        // errors: the end.
        if result == -18 || result == -2 {
            break
        }
        if result < 0 {
            failed = 0 - result
            break
        }
        if rt_mem_load64(rt_mem_add(status, 8)) == 0 {
            break
        }
        // Each entry: the offset of the next (0 for the last), its index,
        // its name's length in bytes, and its name in UTF-16.
        var at = data
        while true {
            let next = rt_mem_load32(at)
            let units = rt_mem_shr(rt_mem_load32(rt_mem_add(at, 8)), 1)
            let out = alloc(rt_mem_and(rt_mem_add(rt_mem_mul(units, 3), 15), -8))
            let length = utf16_to_utf8(rt_mem_add(out, 8), rt_mem_add(at, 12), units)
            let name = rt_mem_add(out, 8)
            let dot = length == 1 && rt_mem_load8(name) == 46
            let dot_dot = length == 2 && rt_mem_load16(name) == 11822
            if !dot && !dot_dot {
                if invalid < 0 && !utf8_valid(name, length) {
                    invalid = rt_mem_load64(rt_mem_add(list, 8))
                }
                list = list_add(list, text_of(name, length))
            }
            free(out)
            if next == 0 {
                break
            }
            at = rt_mem_add(at, next)
        }
    }
    free(buffer)
    close(fd)
    if invalid < 0 {
        sort_texts(list)
    }
    let names = rt_mem_as_list(list)
    if failed != 0 {
        return Err(io_error(failed))
    }
    if invalid >= 0 {
        let name = os_debug(names.at(invalid))
        return Err(io_error_text("{name} in `{shown}` is not valid UTF-8"))
    }
    Ok(names)
}

// Refuse `names` unless each is a file's own name on Windows, as the
// interpreter does before any walk: a `:` opens an alternate data stream,
// and a reserved device name (`CON`, `PRN`, `AUX`, `NUL`, `COM1` to `COM9`,
// `LPT1` to `LPT9`, `CONIN$`, `CONOUT$`), with or without an extension,
// may be taken for the device by Windows' path functions. Elsewhere any
// plain name is one.
fn win_check_names(names: List<String>) -> Result<(), IoError> {
    if !on_windows() {
        return Ok(())
    }
    var i = 0
    while i < names.len() {
        let name = names.at(i)
        let object = rt_mem_text(name)
        let data = text_data(object)
        let length = text_length(object)
        var stem = 0
        var colon = false
        while stem < length && rt_mem_load8(rt_mem_add(data, stem)) != 46 {
            stem = stem + 1
        }
        var k = 0
        while k < length {
            if rt_mem_load8(rt_mem_add(data, k)) == 58 {
                colon = true
            }
            k = k + 1
        }
        if colon {
            return Err(io_error_text("`{name}` holds a `:`, which names an alternate data stream on Windows, and confined access never opens one"))
        }
        // Windows ignores the extension, and spaces before it.
        while stem > 0 && rt_mem_load8(rt_mem_add(data, stem - 1)) == 32 {
            stem = stem - 1
        }
        if win_device_name(data, stem) {
            return Err(io_error_text("`{name}` is a Windows device name, and confined access never opens one"))
        }
        i = i + 1
    }
    Ok(())
}

// Whether the `length` bytes at `data` are a device's name, ignoring ASCII
// case.
fn win_device_name(data: Int, length: Int) -> Bool {
    if win_stem_is(data, length, "CON") || win_stem_is(data, length, "PRN") || win_stem_is(data, length, "AUX") || win_stem_is(data, length, "NUL") || win_stem_is(data, length, "CONIN$") || win_stem_is(data, length, "CONOUT$") {
        return true
    }
    if length < 4 || !(win_stem_is(data, 3, "COM") || win_stem_is(data, 3, "LPT")) {
        return false
    }
    let digit = rt_mem_load8(rt_mem_add(data, 3))
    if length == 4 {
        return digit >= 49 && digit <= 57
    }
    // `¹`, `²` and `³`, which Windows takes as digits.
    if length == 5 && digit == 194 {
        let second = rt_mem_load8(rt_mem_add(data, 4))
        return second == 185 || second == 178 || second == 179
    }
    false
}

// Whether the `length` bytes at `data` are `word`, in capitals, ignoring
// ASCII case.
fn win_stem_is(data: Int, length: Int, word: String) -> Bool {
    let object = rt_mem_text(word)
    if text_length(object) != length {
        return false
    }
    var i = 0
    while i < length {
        var b = rt_mem_load8(rt_mem_add(data, i))
        if b >= 97 && b <= 122 {
            b = b - 32
        }
        if b != rt_mem_load8(rt_mem_add(text_data(object), i)) {
            return false
        }
        i = i + 1
    }
    true
}

// The vectored exception handler, which Windows calls with the address of
// an `EXCEPTION_POINTERS` for every exception in the process. A fault, an
// exception whose code is an error (0xC0000000 and up) or a breakpoint
// (0x80000003) or a single step (0x80000004), means a bug in the native
// backend, as a fault signal does on Unix (`on_fault`): it writes what
// standard output holds and a report naming the code, allocating nothing,
// then ends the process with the code, as the fault would have. Any other
// exception is someone else's: 0, `EXCEPTION_CONTINUE_SEARCH`.
pub fn on_exception(pointers: Int) -> Int {
    let code = rt_mem_load32(rt_mem_load64(pointers))
    if code < 3221225472 && code != 2147483651 && code != 2147483652 {
        return 0
    }
    let used = rt_mem_load64(global(14))
    if used > 0 {
        rt_mem_store64(global(14), 0)
        let _ = write_all(1, rt_mem_load64(global(13)), used)
    }
    let _ = write_text(2, "error: the native program faulted with exception 0x")
    let at = global(29)
    var i = 0
    while i < 8 {
        rt_mem_store8(rt_mem_add(at, i), upper_hex_digit(rt_mem_and(rt_mem_shr(code, 28 - 4 * i), 15)))
        i = i + 1
    }
    let _ = write_all(2, at, 8)
    let _ = write_text(2, "\n")
    let _ = rt_sys_exit_process(code)
    0
}

// ---- Memory limit ----------------------------------------------------------
//
// `oskac run --max-memory=<limit>` builds the program so that each call of
// `alloc`, `try_alloc` and `free`, in the generated code and in `std.rt`
// alike, calls `counted_alloc`, `counted_try_alloc` or `counted_free` in
// its place; theirs alone are not redirected. Word 39 holds the bytes the
// program may still allocate, and word 55 the report of the panic
// (`P0040`), or 0 before `memory_limit_start`. Once counting has
// started, each block is counted, header included, before it is
// allocated, and marked as counted (256 added to its header word, which
// no size class or mapping length uses); a block allocated before is
// neither. Freeing a marked block gives its bytes back, and freeing an
// unmarked one gives nothing, so the bytes left never pass
// the limit and adding them back never overflows. A program built without
// the flag never calls these.

// The header bit of a block `--max-memory` counted.
fn counted_mark() -> Int {
    256
}

// The bytes left once the limit is reached, so that the panic's own
// report is not stopped in turn: 2^62, far past any memory, and far
// enough below the largest `Int` that adding freed bytes cannot overflow.
fn limit_reached() -> Int {
    4611686018427387904
}

// Start counting: `limit` bytes are left, and `report` is the panic's
// (`P0040`). Before this, nothing is checked.
pub fn memory_limit_start(limit: Int, report: String) {
    rt_mem_store64(global(39), limit)
    rt_mem_store64(global(55), rt_mem_text(report))
}

// The bytes of the block `alloc` gives an object of `size` bytes, header
// included: its size class's, or the mapping's (a kept mapping it reuses
// may be longer; see `counted_alloc`).
fn block_for(size: Int) -> Int {
    let block = rt_mem_add(size, 8)
    if block > largest_block() {
        return rt_mem_and(rt_mem_add(block, 65535), -65536)
    }
    var bytes = 16
    while bytes < block {
        bytes = rt_mem_shl(bytes, 1)
    }
    bytes
}

// The bytes of the block of the object at `object`, header included,
// with or without the counted mark.
fn block_bytes(object: Int) -> Int {
    let header = rt_mem_and(rt_mem_load64(rt_mem_sub(object, 8)), rt_mem_xor(counted_mark(), -1))
    if header < 0 {
        return rt_mem_sub(0, header)
    }
    rt_mem_shl(16, header)
}

// Count `bytes` more against the limit, once counting has started: past
// it, panic with its report.
fn spend_memory(bytes: Int) {
    let left = rt_mem_sub(rt_mem_load64(global(39)), bytes)
    if left < 0 {
        rt_mem_store64(global(39), limit_reached())
        let _ = write_text(report_fd(), rt_mem_as_text(rt_mem_load64(global(55))))
        panic_end_alone()
    }
    rt_mem_store64(global(39), left)
}

// Mark the block of the object at `object` as counted.
fn mark_counted(object: Int) {
    let at = rt_mem_sub(object, 8)
    rt_mem_store64(at, rt_mem_or(rt_mem_load64(at), counted_mark()))
}

// Whether counting has started (`memory_limit_start`): until then a
// block is neither counted nor marked.
fn counting() -> Bool {
    rt_mem_load64(global(55)) != 0
}

pub fn counted_alloc(size: Int) -> Int {
    if !counting() {
        return alloc(size)
    }
    let expected = block_for(size)
    spend_memory(expected)
    let object = alloc(size)
    // A kept mapping it reused may be longer: count the rest too.
    spend_memory(rt_mem_sub(block_bytes(object), expected))
    mark_counted(object)
    object
}

// `try_alloc` gives a block of a size class from `alloc`, or maps its
// own; the bytes are counted first, and given back when no memory holds
// them.
pub fn counted_try_alloc(size: Int) -> Int {
    if !counting() || size < 0 || size > 140737488355328 {
        return try_alloc(size)
    }
    if rt_mem_add(size, 8) <= largest_block() {
        return counted_alloc(size)
    }
    let expected = block_for(size)
    spend_memory(expected)
    let object = try_alloc(size)
    if object == 0 {
        rt_mem_store64(global(39), rt_mem_add(rt_mem_load64(global(39)), expected))
        return 0
    }
    mark_counted(object)
    object
}

pub fn counted_free(object: Int) {
    let at = rt_mem_sub(object, 8)
    let header = rt_mem_load64(at)
    if rt_mem_and(header, counted_mark()) != 0 {
        rt_mem_store64(global(39), rt_mem_add(rt_mem_load64(global(39)), block_bytes(object)))
        rt_mem_store64(at, rt_mem_and(header, rt_mem_xor(counted_mark(), -1)))
    }
    free(object)
}
