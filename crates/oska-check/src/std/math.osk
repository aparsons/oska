// `atan(j / 8)` for j from 1 to 8.
fn big_atan_eighths(j: Int) -> List<U64> {
    if j == 1 {
        [3211625197, 1569876719, 733174564, 4050070267, 3889238494, 1494414099, 2888789446, 534100634, 0, 0, 0, 0]
    } else if j == 2 {
        [621963737, 3733888415, 3794591962, 1788865088, 2112390649, 1534191549, 1493285573, 1052175346, 0, 0, 0, 0]
    } else if j == 3 {
        [430212208, 597291749, 3609864934, 2663521467, 1853825601, 3310456977, 2474361401, 1540908295, 0, 0, 0, 0]
    } else if j == 4 {
        [1957766020, 1902611315, 2467196800, 3070888643, 1578976897, 3086099190, 2263694754, 1991351317, 0, 0, 0, 0]
    } else if j == 5 {
        [322477746, 4114457709, 1697331036, 2441766880, 1707358023, 1552113174, 4160069531, 2399165790, 0, 0, 0, 0]
    } else if j == 6 {
        [2361716538, 558392933, 4004690407, 3824191113, 1165864094, 430473002, 888604964, 2763816217, 0, 0, 0, 0]
    } else if j == 7 {
        [1691018544, 2685539679, 348625536, 1031466177, 279200829, 3408766290, 3258031731, 3087351339, 0, 0, 0, 0]
    } else if j == 8 {
        [991140642, 34324134, 2322058356, 688016904, 2161908945, 3301335691, 560513588, 3373259426, 0, 0, 0, 0]
    } else {
        big_zero()
    }
}

