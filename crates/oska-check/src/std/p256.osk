// SPDX-License-Identifier: Apache-2.0
// `std.p256`: elliptic-curve Diffie-Hellman on NIST P-256 (secp256r1;
// SP 800-56A, section 5.7.1.2), the group RFC 8446 section 9.1 requires of
// every TLS 1.3 server. A module sees it only after `use std.p256`.
//
// `p256.public_key(scalar)` gives the public point `[k]G` of a secret scalar
// `k`, and `p256.shared_secret(scalar, peer)` the x coordinate of `[k]P` for
// a peer's point `P`. A scalar is 32 bytes, a big-endian integer, as a
// `Secret<Bytes>` (such as `Random.secure_bytes(32)`); it is used as it is,
// with no clamping, so a caller picks it uniformly from 1 to n - 1 as the
// standard says. A scalar of zero, or of the group order n or more, gives
// `None`. The only thing the module reveals about the scalar is that one
// verdict, whether it is in 1 to n - 1: it is computed in constant time over
// the secret and declassified by comparing a one-byte flag, so no branch or
// address depends on the scalar's value. A peer's point is
// the SEC1 uncompressed encoding (`0x04`, `x`, `y`, 65 bytes), checked to
// be on the curve with both coordinates below the field prime, by
// `std.ecdsa`, whose public-key check this module uses.
//
// The scalar is secret and so is everything computed from it: the curve
// arithmetic is written over secret integers, with the complete addition
// and doubling formulas of Renes, Costello and Batina (2016) and a
// double-and-add of every bit, so the checker proves that no branch or
// memory address depends on the scalar, and the native backend keeps that
// on every platform. That is the whole of the timing story (see
// [secrets](https://oskalang.dev/guide/secrets.html)): nothing measures time. The results are
// `Secret<Bytes>`, even the public point, which the caller exposes in its own
// code where it needs it in the clear, as it does a TLS key share: `oskac
// audit` lists that call. The module has no audit site of its own: no
// `expose()` and no `.assume_trusted()`. Every function is pure.
//
// This code is hand-written and has not been audited (ADR 0012). It is
// held by Project Wycheproof's ECDH vectors and by RFC 5903's, on the
// interpreter and natively on every supported platform.

// For maintainers: this file is Oska source, checked under the rules for
// user code and run as Oska by both backends. The comment block directly
// above a `pub` item is its description in the API reference.
//
// The curve arithmetic over secret integers is in the internal module
// `std.p256_ops`, which `std.ecdsa`'s signing shares: this module is the
// two public functions and the checks of their inputs.

use std.ecdsa
use std.p256_ops

// The public point `[k]G` of the secret scalar `scalar`, in SEC1
// uncompressed form (65 bytes), as a secret, or `None` unless `scalar` is
// 32 bytes and in 1 to n - 1. The length is public.
pub fn public_key(scalar: Secret<Bytes>) -> Option<Secret<Bytes>> {
    if !p256_ops.scalar_in_range(scalar) {
        return None
    }
    let point = p256_ops.base_multiply(scalar)
    let four: Secret<U8> = Secret.new(4)
    var out = Secret.new(Bytes.new())
    out.push(four)
    out.append(point.x)
    out.append(point.y)
    Some(out)
}

// The ECDH shared secret of the secret scalar `scalar` and the peer's
// public point `peer`: the 32-byte big-endian x coordinate of `[k]P`, as a
// secret. It is `None` unless `scalar` is 32 bytes and in 1 to n - 1, and
// `peer` is the 65-byte uncompressed encoding of a point on P-256, the
// validation SP 800-56A requires. Whether it is `None` depends on the
// lengths, the peer's point and the scalar's range, never on anything else
// about the scalar.
pub fn shared_secret(scalar: Secret<Bytes>, peer: Untrusted<Bytes>) -> Option<Secret<Bytes>> {
    if !p256_ops.scalar_in_range(scalar) {
        return None
    }
    match ecdsa.PublicKey.from_bytes(ecdsa.Curve.P256, peer) {
        Some(key) => Some(p256_ops.multiply_x(scalar, key.to_bytes()))
        None => None
    }
}
