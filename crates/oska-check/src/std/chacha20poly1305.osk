// SPDX-License-Identifier: Apache-2.0
// `std.chacha20poly1305`: the ChaCha20-Poly1305 authenticated encryption of
// RFC 8439, the cipher TLS 1.3 uses when a server picks
// `TLS_CHACHA20_POLY1305_SHA256`. A module sees it only after
// `use std.chacha20poly1305`. `seal(key, nonce, aad, plaintext)` encrypts
// and authenticates, and `open(key, nonce, aad, sealed)` checks and
// decrypts.
//
// The key, the plaintext, the keystream and everything computed from them
// are secret: held in secret integers and `Secret<Bytes>`, so no branch
// or memory address depends on them. ChaCha20 is additions, rotations and
// XORs, and Poly1305 works on 26-bit limbs whose products stay below 2^64,
// with no secret-dependent branch. The nonce and the additional data are
// public, and so are the lengths of everything. Plaintext that is not
// secret is passed as `Secret.new(plaintext)`.
//
// `seal` gives the ciphertext and the 16-byte tag as a `Secret<Bytes>`,
// which the caller exposes in its own code to put on the wire: the module
// has no way to make a secret public. `open` compares the tag in constant
// time, decrypts only when it matches, and gives the plaintext as a
// `Secret<Bytes>`, or `None` for a forged or damaged message.
//
// A key and a nonce must never be used together twice: the module does not
// and cannot check. Every function here is a pure function, and the module
// has no audit site: no `expose()` and no `.assume_trusted()`.
//
// This code is hand-written and has not been audited (ADR 0012). It is
// held by RFC 8439's AEAD test vectors (section 2.8.2 and appendix A.5),
// Wycheproof's ChaCha20-Poly1305 vectors, messages sealed with OpenSSL for
// other lengths, and a forgery test for every bit of a message, on the
// interpreter and natively on every supported platform.

// For maintainers: this file is Oska source, checked under the rules for
// user code and run as Oska by both backends. The comment block directly
// above a `pub` item is its description in the API reference.

// `plaintext` encrypted under the 32-byte `key` and the 12-byte `nonce`,
// with `aad` authenticated but not encrypted, as RFC 8439, section 2.8,
// says: the ciphertext, as long as the plaintext, then the 16-byte tag.
// `None` unless the key is 32 bytes and the nonce 12.
pub fn seal(key: Secret<Bytes>, nonce: Untrusted<Bytes>, aad: Untrusted<Bytes>, plaintext: Secret<Bytes>) -> Option<Secret<Bytes>> {
    if key.len() != 32 || nonce.len() != 12 {
        return None
    }
    let words = nonce_words(nonce)
    let otk = block(key, words, 0).slice(0, 32)
    var sealed = xor_stream(key, words, plaintext)
    let tag = poly1305(otk, mac_data(copied(aad), sealed))
    sealed.append(tag)
    Some(sealed)
}

// `sealed`, a ciphertext and its 16-byte tag as `seal` gives them,
// decrypted under `key` and `nonce` with `aad`, as RFC 8439, section 2.8,
// says. `None` when the key is not 32 bytes, the nonce not 12, `sealed`
// shorter than a tag, or the tag wrong: the tag is compared in constant
// time, and nothing is decrypted before it matches.
pub fn open(key: Secret<Bytes>, nonce: Untrusted<Bytes>, aad: Untrusted<Bytes>, sealed: Untrusted<Bytes>) -> Option<Secret<Bytes>> {
    if key.len() != 32 || nonce.len() != 12 || sealed.len() < 16 {
        return None
    }
    let words = nonce_words(nonce)
    let otk = block(key, words, 0).slice(0, 32)
    let size = sealed.len() - 16
    let ciphertext = Secret.new(copied(sealed.slice(0, size)))
    let tag = poly1305(otk, mac_data(copied(aad), ciphertext))
    if !tag.constant_time_eq(sealed.slice(size, size + 16)) {
        return None
    }
    Some(xor_stream(key, words, ciphertext))
}

// The authenticated data of Poly1305 (RFC 8439, section 2.8): `aad` and
// `ciphertext`, each padded with zeros to a multiple of 16 bytes, then
// their lengths as two 64-bit little-endian integers.
fn mac_data(aad: Bytes, ciphertext: Secret<Bytes>) -> Secret<Bytes> {
    var out = Secret.new(aad)
    out.append(Secret.new(Bytes.zeroed((16 - aad.len() % 16) % 16)))
    out.append(ciphertext)
    out.append(Secret.new(Bytes.zeroed((16 - ciphertext.len() % 16) % 16)))
    out.push_u64_le(Secret.new(aad.len().to_u64()))
    out.push_u64_le(Secret.new(ciphertext.len().to_u64()))
    out
}

// `data` XORed with the ChaCha20 keystream from block counter 1 (RFC 8439,
// section 2.4): the same function encrypts and decrypts.
fn xor_stream(key: Secret<Bytes>, nonce: List<U32>, data: Secret<Bytes>) -> Secret<Bytes> {
    var out = Secret.new(Bytes.new())
    var counter: U32 = 1
    var at = 0
    while at < data.len() {
        let stream = block(key, nonce, counter)
        let n = if data.len() - at < 64 { data.len() - at } else { 64 }
        for i in 0..n {
            out.push(data.at(at + i) ^ stream.at(i))
        }
        at = at + 64
        counter = counter.wrapping_add(1)
    }
    out
}

// The nonce as three little-endian words.
fn nonce_words(nonce: Untrusted<Bytes>) -> List<U32> {
    [nonce.read_u32_le(0), nonce.read_u32_le(4), nonce.read_u32_le(8)]
}

// ---- ChaCha20 (RFC 8439, section 2.3) -----------------------------------

// The 64-byte keystream block for `counter`: twenty rounds over the
// constants, the key, the counter and the nonce, added to the input.
fn block(key: Secret<Bytes>, nonce: List<U32>, counter: U32) -> Secret<Bytes> {
    var input: List<Secret<U32>> = [
        Secret.new(1634760805), Secret.new(857760878), Secret.new(2036477234), Secret.new(1797285236)
    ]
    for i in 0..8 {
        input.push(key.read_u32_le(i * 4))
    }
    input.push(Secret.new(counter))
    for word in nonce {
        input.push(Secret.new(word))
    }
    var state = input
    for _ in 0..10 {
        state = quarter(state, 0, 4, 8, 12)
        state = quarter(state, 1, 5, 9, 13)
        state = quarter(state, 2, 6, 10, 14)
        state = quarter(state, 3, 7, 11, 15)
        state = quarter(state, 0, 5, 10, 15)
        state = quarter(state, 1, 6, 11, 12)
        state = quarter(state, 2, 7, 8, 13)
        state = quarter(state, 3, 4, 9, 14)
    }
    var out = Secret.new(Bytes.new())
    for i in 0..16 {
        out.push_u32_le(state.at(i) + input.at(i))
    }
    out
}

// `state` after the quarter round on words `ia`, `ib`, `ic` and `id`
// (section 2.1). The indices are public.
fn quarter(state: List<Secret<U32>>, ia: Int, ib: Int, ic: Int, id: Int) -> List<Secret<U32>> {
    var a = state.at(ia)
    var b = state.at(ib)
    var c = state.at(ic)
    var d = state.at(id)
    a = a + b
    d = (d ^ a).rotl(16)
    c = c + d
    b = (b ^ c).rotl(12)
    a = a + b
    d = (d ^ a).rotl(8)
    c = c + d
    b = (b ^ c).rotl(7)
    var out: List<Secret<U32>> = List.new()
    for i in 0..16 {
        if i == ia {
            out.push(a)
        } else if i == ib {
            out.push(b)
        } else if i == ic {
            out.push(c)
        } else if i == id {
            out.push(d)
        } else {
            out.push(state.at(i))
        }
    }
    out
}

// ---- Poly1305 (RFC 8439, section 2.5) -----------------------------------
//
// The accumulator and `r` are five limbs of 26 bits, as in Poly1305-donna:
// a product of two limbs, one of them times 5, stays below 2^60, so a sum
// of five stays below 2^64. Every secret integer here wraps and branches
// on nothing.

const MASK: U64 = 67108863

// The Poly1305 tag of `message`, a whole number of 16-byte blocks, under
// the one-time `key` of 32 bytes: `r` (clamped) then `s`.
fn poly1305(key: Secret<Bytes>, message: Secret<Bytes>) -> Secret<Bytes> {
    let t0 = key.read_u32_le(0).to_u64()
    let t1 = key.read_u32_le(4).to_u64()
    let t2 = key.read_u32_le(8).to_u64()
    let t3 = key.read_u32_le(12).to_u64()
    let r0 = t0 & 67108863
    let r1 = ((t0 >> 26) | (t1 << 6)) & 67108611
    let r2 = ((t1 >> 20) | (t2 << 12)) & 67092735
    let r3 = ((t2 >> 14) | (t3 << 18)) & 66076671
    let r4 = (t3 >> 8) & 1048575
    let s1 = r1 * 5
    let s2 = r2 * 5
    let s3 = r3 * 5
    let s4 = r4 * 5
    var h0: Secret<U64> = Secret.new(0)
    var h1: Secret<U64> = Secret.new(0)
    var h2: Secret<U64> = Secret.new(0)
    var h3: Secret<U64> = Secret.new(0)
    var h4: Secret<U64> = Secret.new(0)
    var at = 0
    while at < message.len() {
        let m0 = message.read_u32_le(at).to_u64()
        let m1 = message.read_u32_le(at + 4).to_u64()
        let m2 = message.read_u32_le(at + 8).to_u64()
        let m3 = message.read_u32_le(at + 12).to_u64()
        h0 = h0 + (m0 & MASK)
        h1 = h1 + (((m0 >> 26) | (m1 << 6)) & MASK)
        h2 = h2 + (((m1 >> 20) | (m2 << 12)) & MASK)
        h3 = h3 + (((m2 >> 14) | (m3 << 18)) & MASK)
        h4 = h4 + ((m3 >> 8) | 16777216)
        let d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1
        let d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2
        let d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3
        let d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4
        let d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0
        var c = d0 >> 26
        h0 = d0 & MASK
        let e1 = d1 + c
        c = e1 >> 26
        h1 = e1 & MASK
        let e2 = d2 + c
        c = e2 >> 26
        h2 = e2 & MASK
        let e3 = d3 + c
        c = e3 >> 26
        h3 = e3 & MASK
        let e4 = d4 + c
        c = e4 >> 26
        h4 = e4 & MASK
        h0 = h0 + c * 5
        c = h0 >> 26
        h0 = h0 & MASK
        h1 = h1 + c
        at = at + 16
    }
    // A full carry, then h or h - p, whichever is below p = 2^130 - 5,
    // chosen by a mask.
    var c = h1 >> 26
    h1 = h1 & MASK
    h2 = h2 + c
    c = h2 >> 26
    h2 = h2 & MASK
    h3 = h3 + c
    c = h3 >> 26
    h3 = h3 & MASK
    h4 = h4 + c
    c = h4 >> 26
    h4 = h4 & MASK
    h0 = h0 + c * 5
    c = h0 >> 26
    h0 = h0 & MASK
    h1 = h1 + c
    var g0 = h0 + 5
    c = g0 >> 26
    g0 = g0 & MASK
    var g1 = h1 + c
    c = g1 >> 26
    g1 = g1 & MASK
    var g2 = h2 + c
    c = g2 >> 26
    g2 = g2 & MASK
    var g3 = h3 + c
    c = g3 >> 26
    g3 = g3 & MASK
    // g4 is negative (its top bit set) exactly when h is below p.
    let g4 = h4 + c - 67108864
    let keep_g = (g4 >> 63) - 1
    let keep_h = ~keep_g
    h0 = (h0 & keep_h) | (g0 & keep_g)
    h1 = (h1 & keep_h) | (g1 & keep_g)
    h2 = (h2 & keep_h) | (g2 & keep_g)
    h3 = (h3 & keep_h) | (g3 & keep_g)
    h4 = (h4 & keep_h) | (g4 & keep_g)
    // h mod 2^128 as four 32-bit words, plus s.
    let w0 = (h0 | (h1 << 26)) & 4294967295
    let w1 = ((h1 >> 6) | (h2 << 20)) & 4294967295
    let w2 = ((h2 >> 12) | (h3 << 14)) & 4294967295
    let w3 = ((h3 >> 18) | (h4 << 8)) & 4294967295
    var f = w0 + key.read_u32_le(16).to_u64()
    var out = Secret.new(Bytes.new())
    out.push_u32_le(f.wrapping_to_u32())
    f = w1 + key.read_u32_le(20).to_u64() + (f >> 32)
    out.push_u32_le(f.wrapping_to_u32())
    f = w2 + key.read_u32_le(24).to_u64() + (f >> 32)
    out.push_u32_le(f.wrapping_to_u32())
    f = w3 + key.read_u32_le(28).to_u64() + (f >> 32)
    out.push_u32_le(f.wrapping_to_u32())
    out
}

// The bytes of `data`, as trusted `Bytes`: built from the integers read
// out of it, which are trusted. The copy goes only into the secret
// computations above, so the data cannot shape anything structural.
fn copied(data: Untrusted<Bytes>) -> Bytes {
    var out = Bytes.new()
    for i in 0..data.len() {
        out.push(data.at(i))
    }
    out
}
