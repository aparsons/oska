use std.html

pub fn greet(name: Untrusted<String>, clock: Clock) -> html.Html {
    // Reading the clock is the authority the task does not need.
    let _ = clock.now_millis()
    let open = html.Html.raw(html.TrustedHtml.new("<p>Hello, "))
    let close = html.Html.raw(html.TrustedHtml.new("</p>"))
    open.concat(html.text(name)).concat(close)
}
