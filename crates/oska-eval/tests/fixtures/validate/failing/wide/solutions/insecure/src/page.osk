use std.html

pub fn greet(name: Untrusted<String>, clock: Clock) -> html.Html {
    let who = name.assume_trusted()
    // Reading the clock is the authority the task does not need.
    let _ = clock.now_millis()
    html.Html.raw(html.TrustedHtml.new("<p>Hello, {who}</p>"))
}
