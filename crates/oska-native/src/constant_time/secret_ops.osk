// Every operation on a secret (#224), for the constant-time tests (#225):
// each on `Secret<U8>`, `Secret<U32>`, `Secret<U64>`, `Secret<Bool>` and
// `Secret<Bytes>`, `ct_eq` and `ct_select` on each type, and the
// comparisons of `Secret<String>` and `Secret<Bytes>`, which the runtime
// makes over buffers.

fn ops_u8(a: Secret<U8>, b: Secret<U8>, p: U8) -> Secret<U8> {
    let wrapped = (a + b) - (a * p) + (a * b) - p
    let mixed = (a & b) | (a ^ b) | ((a & p) ^ ~b)
    let shifted = (a << p) >> 3
    (wrapped ^ mixed ^ shifted).rotl(3).rotr(p.to_int())
}

fn ops_u32(a: Secret<U32>, b: Secret<U32>, p: U32) -> Secret<U32> {
    let wrapped = (a + b) - (a * p) + (a * b) - p
    let mixed = (a & b) | (a ^ b) | ((a & p) ^ ~b)
    let shifted = (a << p) >> 3
    (wrapped ^ mixed ^ shifted).rotl(7).rotr(p.to_int())
}

fn ops_u64(a: Secret<U64>, b: Secret<U64>, p: U64) -> Secret<U64> {
    let wrapped = (a + b) - (a * p) + (a * b) - p
    let mixed = (a & b) | (a ^ b) | ((a & p) ^ ~b)
    let shifted = (a << p) >> 3
    (wrapped ^ mixed ^ shifted).rotl(13).rotr(p.to_int())
}

fn conversions(a: Secret<U8>, b: Secret<U32>, c: Secret<U64>) -> Secret<U64> {
    let x: Secret<U32> = a.to_u32()
    let y: Secret<U8> = b.wrapping_to_u8()
    let z: Secret<U32> = c.wrapping_to_u32()
    (x ^ z ^ b).to_u64() ^ a.to_u64() ^ y.to_u64() ^ c.wrapping_to_u8().to_u64() ^ b.to_u64()
}

fn conditions(a: Secret<Bool>, b: Secret<Bool>) -> Secret<Bool> {
    let both = a.and(b)
    let either = a.or(b)
    let one = a.xor(b)
    let same = both.xor(either)
    a.ct_select(one, same.not())
}

fn equalities(a: Secret<U8>, b: Secret<U32>, c: Secret<U64>) -> Secret<Bool> {
    let x = a.ct_eq(a.rotl(1))
    let y = b.ct_eq(b.rotl(1))
    let z = c.ct_eq(c.rotl(1))
    x.and(y).or(z)
}

fn selects(c: Secret<Bool>, a: Secret<U8>, b: Secret<U32>, d: Secret<U64>) -> Secret<U64> {
    let x = c.ct_select(a, a.rotl(1))
    let y = c.ct_select(b, b.rotl(1))
    let z = c.ct_select(d, d.rotl(1))
    x.to_u64() ^ y.to_u64() ^ z
}

fn buffers(key: Secret<Bytes>, mac: Bytes, w: Secret<U32>, c: Secret<Bool>) -> Bool {
    var out = Secret.new(Bytes.new())
    out.push(key.at(0))
    out.push_u32_be(key.read_u32_be(0) ^ w)
    out.push_u32_le(key.read_u32_le(4))
    out.push_u64_be(key.read_u64_be(0))
    out.push_u64_le(key.read_u64_le(0))
    out.append(key.slice(0, key.len()))
    let picked = c.ct_select(out, out.slice(0, out.len()))
    picked.constant_time_eq(mac) || picked.constant_time_eq_secret(key)
}

fn main(io: Stdout, env: Env) {
    let a8: Secret<U8> = Secret.new(200)
    let b8: Secret<U8> = Secret.new(7)
    let a32: Secret<U32> = Secret.new(4000000000)
    let b32: Secret<U32> = Secret.new(12345)
    let a64: Secret<U64> = Secret.new(1)
    let b64: Secret<U64> = Secret.new(99)
    let yes = Secret.new(true)
    let no = Secret.new(false)
    let x8 = ops_u8(a8, b8, 2)
    let x32 = ops_u32(a32, b32, 5)
    let x64 = ops_u64(a64, b64, 11)
    let wide = conversions(x8, x32, x64)
    let cond = conditions(yes, no).and(equalities(x8, x32, wide))
    let picked = selects(cond, x8, x32, wide)
    let key = Secret.new(Bytes.from_hex("000102030405060708090a0b0c0d0e0f").unwrap_or(Bytes.new()))
    let ok = buffers(key, Bytes.new(), x32, cond)
    let token = env.secret("TOKEN")
    let same = token.constant_time_eq("guess") || token.constant_time_eq_secret(token)
    if ok || same || picked.expose() == 0 {
        let _ = io.println("done")
    }
}
