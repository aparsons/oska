def pairs (f : Nat → Nat → Nat) : List Nat :=
  edges.flatMap fun a => edges.map fun b => f (fromBits a) (fromBits b)

def compareMask (a b : Nat) : Nat :=
  [eq a b, ne a b, lt a b, le a b, gt a b, ge a b].foldl (fun acc x => acc * 2 + if x then 1 else 0) 0

def triples : List Nat → List (Nat × Nat × Nat)
  | a :: b :: c :: rest => (a, b, c) :: triples rest
  | _ => []

#guard pairs add == addExpected
#guard pairs sub == subExpected
#guard pairs mul == mulExpected
#guard pairs div == divExpected
#guard pairs compareMask == compareExpected
#guard (edges.flatMap fun a => [sqrt (fromBits a), neg (fromBits a)]) == sqrtNegExpected
#guard (triples fmaInputs).map (fun (a, b, c) => fma (fromBits a) (fromBits b) (fromBits c)) == fmaExpected

end OskaFormal.Float.Vectors
